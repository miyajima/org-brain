---
import Shell from "../layouts/Shell.astro";
---
<Shell workspace><div class="workspace">
<aside id="pages-pane" class="page-sidebar" aria-label="ページ一覧"><div class="sidebar-heading"><h2>Wiki</h2><button id="new-page" class="icon" title="新しいページ" aria-label="新しいページ"><i data-lucide="file-plus"></i></button></div><form id="search-form"><input id="search-query" type="search" aria-label="Wikiを検索" placeholder="検索"/><select id="search-mode" aria-label="検索方式"><option value="lexical">全文</option><option value="hybrid">ハイブリッド</option></select></form><div class="sidebar-tabs" role="tablist"><button id="pages-tab" aria-selected="true">ページ</button><button id="sources-tab" aria-selected="false">ソース</button><button id="diagnose-tab" aria-selected="false">要確認</button></div><div id="page-list" class="page-list"></div><div class="sidebar-bottom"><label class="upload"><i data-lucide="upload"></i><span>ソースを取り込む</span><input id="source-upload" type="file" hidden/></label></div></aside>
<main class="document"><div id="error" role="alert" hidden></div><div id="empty" class="empty"><h1>Wiki</h1><button id="initialize" class="primary" hidden>Wikiを初期化</button></div><section id="document-content" hidden><header class="document-header"><div><p id="page-path"></p><h1 id="page-title"></h1></div><div class="document-tools"><button id="rename-page" class="icon" title="名前を変更" aria-label="名前を変更"><i data-lucide="pencil-line"></i></button><button id="delete-page" class="icon danger" title="ページを削除" aria-label="ページを削除"><i data-lucide="trash-2"></i></button></div></header><div class="editing-bar"><div class="segments"><button id="preview-mode" aria-pressed="true">本文</button><button id="edit-mode" aria-pressed="false">編集</button></div><span id="save-state"></span><button id="save-draft" title="下書きとして保存">下書き保存</button><button id="save-page" class="primary" title="保存"><i data-lucide="save"></i><span>保存</span></button></div><article id="preview" class="prose"></article><div id="editor" hidden></div></section></main>
<aside id="evidence-pane" class="evidence-sidebar" aria-label="根拠と履歴"><div class="sidebar-tabs" role="tablist"><button id="links-tab" aria-selected="true">リンク</button><button id="history-tab" aria-selected="false">履歴</button><button id="drafts-tab" aria-selected="false">下書き</button></div><div id="evidence-list"></div></aside>
</div><button id="pane-backdrop" class="pane-backdrop" aria-label="ペインを閉じる" hidden></button><dialog id="source-dialog"><header><h2 id="source-title"></h2><button id="close-source" class="icon" aria-label="閉じる" title="閉じる"><i data-lucide="x"></i></button></header><p id="source-version"></p><p id="source-review-reason" class="review-reason" hidden></p><pre id="source-text"></pre><a id="source-download">原本をダウンロード</a></dialog><dialog id="diff-dialog"><header><h2>変更履歴</h2><button id="close-diff" class="icon" aria-label="閉じる" title="閉じる"><i data-lucide="x"></i></button></header><div class="diff-grid"><section><h3>以前の版</h3><pre id="diff-before"></pre></section><section><h3>現在の版</h3><pre id="diff-after"></pre></section></div><button id="restore-revision" class="primary">この版を復元</button></dialog>
<dialog id="page-dialog"><form id="page-form"><header><h2 id="page-dialog-title">新しいページ</h2><button id="close-page-dialog" type="button" class="icon" aria-label="閉じる" title="閉じる"><i data-lucide="x"></i></button></header><label class="field">パス<input id="path-input" required maxlength="512" placeholder="topics/page.md"/></label><label class="field">タイトル<input id="title-input" required maxlength="500"/></label><button id="page-submit" class="primary" type="submit">作成</button></form></dialog>
<script>import "../lib/wiki";</script></Shell>
