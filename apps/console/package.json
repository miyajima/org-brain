{
  "name": "@org-brain/console",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:node": "ORGBRAIN_CONSOLE_RUNTIME=node astro build",
    "build:wiki": "astro build --config astro.wiki.config.mjs",
    "typecheck:wiki": "astro check --config astro.wiki.config.mjs --tsconfig tsconfig.wiki.json",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run --passWithNoTests --exclude \"e2e/**\"",
    "test:e2e": "playwright test",
    "test:e2e:decision": "CONSOLE_E2E_DECISION_MODE=beta playwright test e2e/decision-console-v2.spec.ts"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.1",
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/node": "11.1.9",
    "@codemirror/lang-markdown": "6.5.2",
    "@org-brain/contracts": "workspace:*",
    "astro": "7.4.2",
    "codemirror": "6.0.2",
    "diff": "8.0.4",
    "dompurify": "3.4.17",
    "lucide": "1.48.0",
    "marked": "18.0.14",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "wrangler": "4.151.3"
  }
}
