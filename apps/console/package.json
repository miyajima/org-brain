{
  "name": "@org-brain/console",
  "version": "0.3.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:node": "ORGBRAIN_CONSOLE_RUNTIME=node astro build",
    "build:wiki": "astro build --config astro.wiki.config.mjs",
    "typecheck:wiki": "astro check --config astro.wiki.config.mjs --tsconfig tsconfig.wiki.json",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run --passWithNoTests --exclude \"e2e/**\"",
    "test:e2e": "playwright test",
    "test:e2e:decision": "CONSOLE_E2E_DECISION_MODE=beta playwright test e2e/decision-console-v2.spec.ts"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.0",
    "@astrojs/cloudflare": "^13.1.7",
    "@astrojs/node": "^10.1.4",
    "@codemirror/lang-markdown": "6.5.2",
    "@org-brain/contracts": "workspace:*",
    "astro": "^6.4.8",
    "codemirror": "6.0.2",
    "diff": "8.0.4",
    "dompurify": "3.4.16",
    "lucide": "1.48.0",
    "marked": "18.0.14",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.1.4",
    "tailwindcss": "^4.1.4",
    "wrangler": "^4.80.0"
  }
}
