---
import NervousSystem from "../components/intelligence/NervousSystem.astro";
import LegacyTaskDashboard from "../components/LegacyTaskDashboard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { dashboardApiPath, dashboardPageParams, dashboardTaskPageParams, fetchDashboardData, normalizeDashboardTasks, type DashboardTask } from "../lib/dashboard-page";
import { insightsUiBehavior, processInsightsUiModeFallback, resolveRequestInsightsUiMode } from "../lib/insights-ui-mode";
import { intelligencePageCopy } from "../lib/intelligence-locale";
import { activityWindowParams, normalizeDashboardActivity, resolveActivityPeriod } from "../lib/nervous-system-ui";

const insightsUiMode = await resolveRequestInsightsUiMode(
  Astro.locals,
  processInsightsUiModeFallback()
);
const insightsBehavior = insightsUiBehavior(insightsUiMode);
const cookieHeader = Astro.request.headers.get("cookie");
const { params, apiParams, lang } = dashboardPageParams(Astro.url, cookieHeader);
const taskView = dashboardTaskPageParams(Astro.url, cookieHeader);
const activityPeriod = resolveActivityPeriod(params.get("period"));
const intelligenceCopy = intelligencePageCopy(lang);
let activityResult = { data: normalizeDashboardActivity({}), error: null as string | null };
let activityComparison = null as ReturnType<typeof normalizeDashboardActivity> | null;
let refreshUrl = "";
let taskResult = { data: [] as DashboardTask[], error: null as string | null };
if (insightsBehavior.renderInsightsHome) {
  const activityApiParams = activityWindowParams(apiParams, activityPeriod);
  const initialUrl = `/api/v1/dashboard/activity?${activityApiParams.toString()}`;
  activityResult = await fetchDashboardData(
    new URL(initialUrl, Astro.url),
    normalizeDashboardActivity,
    normalizeDashboardActivity({})
  );
  if (activityPeriod.key !== "24h") {
    const comparisonResult = await fetchDashboardData(
      new URL(`/api/v1/dashboard/activity?${activityWindowParams(apiParams, resolveActivityPeriod("24h")).toString()}`, Astro.url),
      normalizeDashboardActivity,
      normalizeDashboardActivity({})
    );
    if (!comparisonResult.error) activityComparison = comparisonResult.data;
  }
  const refreshParams = new URLSearchParams(activityApiParams);
  if (activityResult.data.newest_cursor != null) refreshParams.set("after", String(activityResult.data.newest_cursor));
  refreshUrl = `/api/v1/dashboard/activity?${refreshParams.toString()}`;
} else {
  taskResult = await fetchDashboardData(
    new URL(dashboardApiPath("/api/v1/tasks", taskView.apiParams), Astro.url),
    normalizeDashboardTasks,
    []
  );
}
---
<BaseLayout title={insightsBehavior.renderInsightsHome ? intelligenceCopy.routes.nervousTitle : "Org Brain Dashboard"} lang={lang} wide={insightsBehavior.renderInsightsHome}>
  {insightsBehavior.renderInsightsHome ? (
    <>
      {activityResult.error && (
        <div class="intelligence-route-alert" role="alert">
          <strong>{intelligenceCopy.routes.activityError}</strong>
          <span>{activityResult.error}</span>
        </div>
      )}
      <NervousSystem data={activityResult.data} comparisonData={activityComparison} loadError={activityResult.error} refreshUrl={refreshUrl} params={params} locale={lang} />
    </>
  ) : (
    <LegacyTaskDashboard
      tasks={taskResult.data}
      error={taskResult.error}
      params={taskView.params}
      lang={taskView.lang}
      page={taskView.taskPage}
      pageSize={taskView.taskPageSize}
      query={taskView.taskQuery}
      status={taskView.taskStatus}
      hasMore={taskResult.data.length > taskView.taskPageSize}
    />
  )}
</BaseLayout>
