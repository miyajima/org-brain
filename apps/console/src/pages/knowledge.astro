---
import OperatorLayout from "../layouts/OperatorLayout.astro";
import ApiForm from "../components/operator/ApiForm.astro";
import { operatorRequestUrl, operatorScope, operatorHref, viewHref, apiScope, readConsoleData, operatorIdentity, localText, knowledgeRows, asRows, displayDate, stateLabel, safeExternalHref, type KnowledgeKind, type ConsoleResult, type ConsoleRecord } from "../lib/operator-console";
const navigationUrl = operatorRequestUrl(Astro.request);
const { tenantId, projectId, lang } = operatorScope(Astro.url, Astro.request.headers.get("cookie"));
const t = localText(lang), params = Astro.url.searchParams;
const kind = ["memory", "decision", "resource"].includes(params.get("kind") || "") ? params.get("kind") as KnowledgeKind : "all";
const selectedKind = ["memory", "decision", "resource"].includes(params.get("type") || "") ? params.get("type") as KnowledgeKind : kind === "all" ? "memory" : kind;
const id = params.get("id") || params.get("selected") || "";
const tab = ["evidence", "usage", "sharing"].includes(params.get("tab") || "") ? params.get("tab")! : "content";
const q = params.get("q")?.trim() || "";
const offset = Math.max(0, Number.parseInt(params.get("offset") || "0", 10) || 0);
const limit = kind === "all" ? 6 : 25;
const scope = apiScope(Astro.url, Astro.request.headers.get("cookie"));
const post = (body: ConsoleRecord) => ({ method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ tenant_id: tenantId, project_id: projectId || null, ...body }) });
const absent: ConsoleResult = { data: null, error: null };
const [memories, decisions, resources, identity] = await Promise.all([
 kind === "all" || kind === "memory" ? q ? readConsoleData(Astro.request, "/api/v1/memories/search", post({ q, scope: "org", search_mode: "memories", limit })) : readConsoleData(Astro.request, `/api/v1/memories?${scope}&scope=org&lifecycle=all&paginated=1&sort=${params.has("attention") ? "attention" : "updated"}&limit=${limit}&offset=${offset}`) : absent,
 kind === "all" || kind === "decision" ? readConsoleData(Astro.request, "/api/v1/decision-memories/search", post({ q, limit, include_provenance: true, verification_view: true })) : absent,
 (kind === "all" || kind === "resource") && q ? readConsoleData(Astro.request, "/api/v1/resources/search", post({ q, limit })) : absent,
 operatorIdentity(Astro.request)
]);
const groups = [
 { kind: "memory" as const, label: t("記憶", "Memories", "记忆"), result: memories },
 { kind: "decision" as const, label: t("判断", "Decisions", "决策"), result: decisions },
 { kind: "resource" as const, label: t("資料", "Sources", "资料"), result: resources }
].filter(group => kind === "all" || group.kind === kind).map(group => ({ ...group, rows: knowledgeRows(group.kind, group.result.data) }));
const permissions: string[] = identity.data?.console_context?.effective_permissions || [];
const canWrite = permissions.includes("write") || permissions.includes("admin");
const canShare = permissions.includes("share") || permissions.includes("admin");
let detail: ConsoleResult = absent;
let decisionFromMemory = false;
if (id) {
 if (selectedKind === "memory") detail = await readConsoleData(Astro.request, `/api/v1/memories/${encodeURIComponent(id)}/details?${scope}`);
 if (selectedKind === "resource") detail = await readConsoleData(Astro.request, `/api/v1/resources/${encodeURIComponent(id)}/decisions?${scope}`);
 if (selectedKind === "decision") {
  detail = await readConsoleData(Astro.request, `/api/v1/decisions/${encodeURIComponent(id)}/trace?${scope}&node_limit=150&edge_limit=300&include_inferred=false`);
  if (detail.status === 404) { detail = await readConsoleData(Astro.request, `/api/v1/decision-memories/${encodeURIComponent(id)}/context?${scope}`); decisionFromMemory = true; }
 }
}
const record = selectedKind === "memory" ? detail.data?.memory : selectedKind === "resource" ? detail.data?.resource : detail.data?.decisionMemory || detail.data?.decision;
const listRecord = groups.flatMap(group=>group.rows).find(row=>row.kind===selectedKind&&row.id===id)?.raw;
const attention = record?.attention_severity || listRecord?.attention_severity;
const eligibility = record?.answer_eligibility || listRecord?.answer_eligibility;
const attentionReasons:string[] = record?.attention_reasons || listRecord?.attention_reasons || [];
const decisionVersions = [...asRows(detail.data?.whyTrustThis,"versions")].sort((a,b)=>Number(b.createdAt)-Number(a.createdAt));
const confirmationLabel = (value:string) => value === "user_confirmed" ? t("人が確認済み", "Human confirmed", "人工已确认") : stateLabel(value,lang);
const decisionStatusLabel = (value:string) => value === "uncertain" ? t("要確認", "Needs review", "待确认") : stateLabel(value,lang);
const title = record?.summary || record?.title || record?.conclusion || (record?.content ? String(record.content).slice(0, 100) : "");
const content = record?.content || record?.decision || record?.conclusion || "";
const policyType = selectedKind === "memory" ? "memory" : selectedKind === "resource" ? "knowledge_resource" : "decision_memory";
const policyResult = id && record && tab === "sharing" ? await readConsoleData(Astro.request, `/api/v1/access-policies/${policyType}/${encodeURIComponent(id)}?${scope}`) : absent;
const policy = policyResult.data?.policy;
const usage = id && record && tab === "usage" && selectedKind === "memory" ? await readConsoleData(Astro.request, `/api/v1/memory-use-contexts?${scope}&source_id=${encodeURIComponent(id)}&limit=10${params.get("before") ? `&before=${encodeURIComponent(params.get("before")!)}` : ""}`) : absent;
const rationales = asRows(detail.data, "rationales");
const traceNodes = asRows(detail.data, "nodes");
const evidence = selectedKind === "memory" ? rationales.flatMap(item => asRows(item.evidence)) : traceNodes.filter(item => ["reason", "evidence", "artifact"].includes(item.type));
const sourceRefs = asRows(record?.sourceRefs || record?.source_refs);
const labelKind = (value: string) => value === "memory" ? t("記憶", "Memory", "记忆") : value === "decision" ? t("判断", "Decision", "决策") : t("資料", "Source", "资料");
const selectedState = record?.verification_state || (record?.confirmationState === "user_confirmed" || record?.confirmation_state === "user_confirmed" ? "confirmed" : record?.status) || record?.lifecycle_state || "unverified";
const tabLinks = [ ["content", t("内容", "Content", "内容")], ["evidence", t("根拠", "Evidence", "依据")], ["usage", t("活用履歴", "Use history", "应用历史")], ["sharing", t("共有", "Access", "共享")] ];
const selectHref = (type: string, selected: string) => viewHref(navigationUrl, { id: selected, type, tab: null, saved: null, before: null });
---
<OperatorLayout title={t("知識", "Knowledge", "知识")} active="knowledge">
 <div class="op-page-heading"><div><h1>{t("知識", "Knowledge", "知识")}</h1><p>{t("何を覚え、なぜそう判断し、どう使われたか。ひとつの場所で確かめます。", "What is retained, why it matters, and how it was used. Together in one place.", "在同一个地方，了解记住了什么、为何做出判断以及如何应用。")}</p></div></div>
 {params.get("saved") === "1" && <p class="op-notice" role="status">{t("変更を保存しました。最新の内容を表示しています。", "Changes saved. You are viewing the latest content.", "更改已保存，正在显示最新内容。")}</p>}
 <form method="get" class="op-search-form" role="search"><input type="hidden" name="tenant_id" value={tenantId}/><input type="hidden" name="project_id" value={projectId}/><input type="hidden" name="lang" value={lang}/><input type="hidden" name="kind" value={kind}/><label class="op-search-input"><span class="op-sr">{t("知識を検索", "Search knowledge", "搜索知识")}</span><input name="q" type="search" value={q} placeholder={t("内容や判断の理由から検索", "Search content or reasons behind a decision", "按内容或决策理由搜索")} data-knowledge-search/></label><button type="submit">{t("検索", "Search", "搜索")}</button></form>
 <nav class="op-tabs" aria-label={t("知識の種類", "Knowledge types", "知识类型")}>{[["all",t("すべて", "All", "全部")],["memory",t("記憶", "Memories", "记忆")],["decision",t("判断", "Decisions", "决策")],["resource",t("資料", "Sources", "资料")]].map(([value,label]) => <a href={viewHref(navigationUrl, { kind: value, id: null, selected: null, type: null, offset: null, before: null, tab: null, saved: null })} aria-current={kind === value ? "page" : undefined}>{label}</a>)}</nav>
 <div class="op-knowledge" data-selected={id ? "true" : "false"}>
  <section class="op-knowledge-list" data-knowledge-list aria-label={t("検索結果", "Search results", "搜索结果")}>
   {groups.map(group => <div><div class="op-list-section"><h2 style="font-size:12px">{group.label}</h2>{kind === "all" && <a href={viewHref(navigationUrl, { kind: group.kind, id: null, type: null, offset: null, tab: null })}>{t("すべて表示", "View all", "查看全部")}</a>}</div>{group.result.error ? <div class="op-empty" role="alert">{group.result.error}<div><a href={Astro.url.pathname + Astro.url.search}>{t("再試行", "Retry", "重试")}</a></div></div> : group.rows.length ? group.rows.slice(0, kind === "all" ? 5 : limit).map(row => <a href={selectHref(row.kind, row.id)} data-knowledge-row class="op-knowledge-row" aria-current={id === row.id && selectedKind === row.kind ? "true" : undefined}><strong>{row.title}</strong><p>{row.preview}</p><div class="op-row-meta"><span class="op-badge" data-state={row.state}>{stateLabel(row.state, lang)}</span><span>{row.project}</span><time>{displayDate(row.updated, lang)}</time></div></a>) : <div class="op-empty">{group.kind === "resource" && !q ? t("資料名や内容に含まれる言葉で検索してください。", "Search using words from a source’s name or content.", "请输入资料名称或内容中的关键词。") : q ? t("一致する知識はありません。別の言葉で検索してください。", "No matching knowledge. Try other words.", "没有匹配的知识，请尝试其他关键词。") : t("この範囲にはまだ記録がありません。AIの接続を確認してください。", "No records in this scope yet. Check your AI connections.", "此范围内尚无记录，请检查AI连接。")}</div>}</div>)}
   {kind === "memory" && !q && (memories.data?.meta?.has_next || offset > 0) && <nav class="op-panel-body op-actions" aria-label={t("検索結果のページ", "Results pages", "结果分页")}>{offset > 0 && <a href={viewHref(navigationUrl, { offset: String(Math.max(0, offset-limit)), id: null, type: null })}>{t("前へ", "Previous", "上一页")}</a>}{memories.data?.meta?.has_next && <a href={viewHref(navigationUrl, { offset: String(offset+limit), id: null, type: null })}>{t("次へ", "Next", "下一页")}</a>}</nav>}
   {kind !== "all" && ((q && groups[0]?.rows.length >= limit) || resources.data?.coverage?.truncated) && <p class="op-empty">{t("結果の一部を表示しています。言葉を追加して絞り込めます。", "Showing a subset. Add search terms to narrow the results.", "仅显示部分结果，请添加关键词以缩小范围。")}</p>}
  </section>
  <section class="op-detail" data-knowledge-detail tabindex="-1" aria-label={t("知識の詳細", "Knowledge details", "知识详情")}>
   <div class="op-detail-head"><a class="op-back-list" href={viewHref(navigationUrl, { id: null, selected: null, type: null, tab: null, before: null })}>{t("一覧に戻る", "Back to results", "返回列表")}</a>
    {record && <><div class="op-row-meta"><span>{labelKind(selectedKind)}</span><span class="op-badge" data-state={selectedState}>{selectedKind === "memory" && selectedState === "verified" ? t("出典確認済み", "Source verified", "来源已确认") : stateLabel(selectedState,lang)}</span></div><h2>{title}</h2><p class="op-small">{record.project_id || record.projectId || t("プロジェクト指定なし", "No project assigned", "未指定项目")} · {displayDate(record.updated_at || record.updatedAt || record.created_at, lang)}</p><nav class="op-tabs" aria-label={t("知識の詳細表示", "Knowledge detail views", "知识详情视图")}>{tabLinks.map(([value,label]) => <a href={viewHref(navigationUrl, { tab: value, before: null, saved: null })} aria-current={tab === value ? "page" : undefined}>{label}</a>)}</nav></>}
   </div>
   <div class="op-detail-body">
    {!id ? <div class="op-empty"><strong>{t("確認する知識を選んでください", "Choose a record to inspect", "请选择要查看的知识")}</strong>{t("内容と根拠、実際の活用履歴をここに表示します。", "Its content, evidence and recorded use will appear here.", "将在这里显示内容、依据与实际应用历史。")}</div> : detail.error ? <div class="op-empty" role="alert"><strong>{t("知識を表示できません", "Cannot display this record", "无法显示此知识")}</strong>{detail.error}<p>{t("閲覧できない対象や削除された対象は表示されません。", "Unavailable or inaccessible records are not displayed.", "无法访问或已删除的对象不会显示。")}</p><a href={Astro.url.pathname + Astro.url.search}>{t("再試行", "Retry", "重试")}</a></div> : !record ? <div class="op-empty">{t("この知識は表示できません。対象の範囲とアクセス権を確認してください。", "This record is unavailable. Check the scope and your access.", "此知识无法显示，请检查范围和访问权限。")}</div> : <>
     {tab === "content" && <>{["critical","warning","blocked"].includes(attention) && <p class="op-notice" data-tone={attention === "critical" ? "error" : undefined} role="status">{eligibility === "blocked" ? t("回答への利用を保留しています", "Answer blocked pending review", "回答使用已暂停，等待检查") : t("回答への利用には確認が必要です", "Review required before answer use", "用于回答前需要确认")} {attentionReasons.includes("conflicted") && <span>{t("根拠の矛盾", "Conflicting evidence", "依据冲突")}</span>}<span class="op-small" style="display:block;margin-top:6px">{t("出典の確認状態と、現在の利用可否は別々に表示しています。", "Source verification and current eligibility are separate states.", "来源确认状态与当前是否可用分别显示。")}</span></p>}
      <h3>{t("内容", "Content", "内容")}</h3><div class="op-prose">{content || record.canonical_uri || t("本文は登録されていません。", "No content recorded.", "尚未登记正文。")}</div>
      {(record.rationale || record.reuse_rule) && <div class="op-section"><h3>{t("判断の理由・再利用する条件", "Reason and reuse conditions", "理由与复用条件")}</h3><p class="op-prose">{record.rationale || record.reuse_rule}</p></div>}
      {selectedKind === "decision" && record.version_hash && canWrite && <div class="op-actions op-section"><a class="op-button op-secondary" href={operatorHref(navigationUrl,"/settings",{section:"skills",decision_id:id})}>{t("この判断をスキルにまとめる", "Turn this decision into a skill", "将此决策整理为技能")}</a></div>}
      {selectedKind === "resource" && safeExternalHref(record.canonical_uri) && <div class="op-actions op-section"><a class="op-button op-secondary" href={safeExternalHref(record.canonical_uri)!} target="_blank" rel="noopener noreferrer">{t("原本を開く", "Open original", "打开原始资料")}</a></div>}
      {selectedKind === "memory" && <details class="op-edit"><summary>{t("技術情報", "Technical details", "技术信息")}</summary><dl class="op-definition"><dt>{t("所有者", "Owner", "所有者")}</dt><dd>{record.owner_principal || "—"}</dd><dt>{t("記録した主体", "Recorded by", "记录主体")}</dt><dd>{record.actor_id || record.created_by_principal || "—"}</dd></dl></details>}
      {selectedKind === "memory" && canWrite && <div class="op-section"><ApiForm endpoint="/api/v1/memories/refresh" hidden={{tenant_id:tenantId,memory_id:id}} submit={t("情報を再確認", "Refresh", "重新确认")}/></div>}
      {selectedKind === "decision" && decisionVersions.length > 0 && <details class="op-edit"><summary>{t("変更履歴", "Change history", "更改历史")}</summary><ul class="op-history">{decisionVersions.map((version,index)=>{const prior=decisionVersions[index+1]?.snapshot, current=version.snapshot;return <li><p>{version.note}</p><time class="op-small">{displayDate(version.createdAt,lang)}</time>{prior && current && prior.confirmationState !== current.confirmationState && <p>{confirmationLabel(prior.confirmationState)} → {confirmationLabel(current.confirmationState)}</p>}{prior && current && prior.status !== current.status && <p>{decisionStatusLabel(prior.status)} → {decisionStatusLabel(current.status)}</p>}</li>;})}</ul></details>}
      {selectedKind === "memory" && canWrite && <details class="op-edit"><summary>{t("内容を修正", "Edit content", "修改内容")}</summary><p class="op-muted" style="margin-bottom:14px">{t("上の現在の内容と比較して修正してください。修正だけで確認状態は変更されません。", "Compare your changes with the current content above. Editing does not verify a record.", "请与上方当前内容比较后修改。编辑不会改变确认状态。")}</p><form class="op-form" data-op-api-form data-endpoint="/api/v1/memories/revise"><input type="hidden" name="tenant_id" value={tenantId}/><input type="hidden" name="memory_id" value={id}/><input type="hidden" name="project_id" value={record.project_id || ""} data-value-type="nullable"/><label>{t("要約", "Summary", "摘要")}<input name="summary" value={record.summary || ""} data-value-type="nullable"/></label><label>{t("本文", "Content", "正文")}<textarea name="content" rows="8" aria-label={t("本文", "Content", "正文")} required>{record.content}</textarea></label><label>{t("タグ（カンマ区切り）", "Tags (comma-separated)", "标签（逗号分隔）")}<input name="tags" value={(record.tags || []).join(", ")} data-value-type="array"/></label><div class="op-actions"><button type="submit">{t("変更を保存", "Save changes", "保存更改")}</button></div><p data-form-status role="status" aria-live="polite"></p></form></details>}
      {selectedKind === "decision" && decisionFromMemory && canWrite && <details class="op-edit"><summary>{t("判断を修正・確認", "Revise or confirm decision", "修改或确认决策")}</summary><form class="op-form" data-op-api-form data-endpoint={`/api/v1/decision-memories/${encodeURIComponent(id)}/revise?${scope}`}><label>{t("タイトル", "Title", "标题")}<input name="title" value={record.title} required/></label><label>{t("判断", "Decision", "决策")}<textarea name="decision" aria-label={t("判断", "Decision", "决策")} required>{record.decision}</textarea></label><label>{t("理由", "Reason", "理由")}<textarea name="rationale" aria-label={t("理由", "Reason", "理由")} required>{record.rationale}</textarea></label><label>{t("改訂メモ", "Revision note", "修订备注")}<input name="note"/></label><button type="submit">{t("変更を保存", "Save changes", "保存更改")}</button><p data-form-status role="status"></p></form><form class="op-form op-edit" data-op-api-form data-endpoint={`/api/v1/decision-memories/${encodeURIComponent(id)}/confirm?${scope}`} data-confirm={t("この判断と根拠を確認済みとして記録します。", "Record this decision and its evidence as reviewed.", "将此决策及其依据记为已确认。")}><input type="hidden" name="confirmationState" value="user_confirmed"/><label>{t("確認メモ", "Review note", "确认备注")}<textarea name="confirmationNote" required/></label><button type="submit">{t("判断を確認済みにする", "Confirm decision", "确认决策")}</button><p data-form-status role="status"></p></form></details>}
      {selectedKind === "memory" && canWrite && <details class="op-edit"><summary>{t("利用状態を変更", "Change use status", "更改使用状态")}</summary><form class="op-form" data-op-api-form data-endpoint="/api/v1/memories/suppress" data-confirm={t("この記憶を通常の検索・利用対象から外します。原本は残ります。", "Exclude this memory from normal retrieval. The original is retained.", "将此记忆排除在常规检索之外，保留原始记录。")}><input type="hidden" name="tenant_id" value={tenantId}/><input type="hidden" name="memory_id" value={id}/><label>{t("利用を停止する理由", "Reason for excluding", "停用原因")}<input name="reason" required/></label><button type="submit" class="op-danger">{t("この記憶の利用を停止", "Exclude this memory", "停用此记忆")}</button><p data-form-status role="status"></p></form></details>}
     </>}
     {tab === "evidence" && <><h3>{t("根拠", "Evidence", "依据")}</h3>{record.rationale && <p class="op-prose">{record.rationale}</p>}{rationales.map(item => <div class="op-section"><h3>{item.conclusion}</h3><p class="op-prose">{item.reason_summary}</p><span class="op-badge">{stateLabel(item.confirmation_state,lang)}</span></div>)}{evidence.length ? <ul class="op-history">{evidence.map(item => <li><h3>{item.label || item.evidence_type || t("根拠資料", "Evidence source", "依据资料")}</h3><p class="op-prose">{item.summary || item.note || item.evidence_ref}</p>{item.evidence_ref && <p class="op-small">{item.evidence_ref}</p>}{item.deep_link && String(item.deep_link).startsWith("/resources?") && <a href={operatorHref(navigationUrl, "/knowledge", { kind: "resource", id: new URL(String(item.deep_link), Astro.url).searchParams.get("selected") })}>{t("資料を確認", "Inspect source", "查看资料")}</a>}</li>)}</ul> : !rationales.length && !sourceRefs.length && <p class="op-muted">{t("閲覧できる根拠はまだ登録されていません。", "No readable evidence has been recorded yet.", "尚未登记可查看的依据。")}</p>}{sourceRefs.map(item => <p class="op-prose">{item.title || item.id}</p>)}{selectedKind === "resource" && asRows(detail.data,"decisions").map(item => <a class="op-row" href={operatorHref(navigationUrl,"/knowledge",{kind:"decision",id:item.decision_ref?.source_id})}><div><strong>{item.conclusion}</strong><p>{item.reason_summary}</p></div></a>)}{detail.data?.truncated && <p class="op-notice">{t("関連情報の一部を表示しています。", "Showing a subset of related information.", "仅显示部分相关信息。")}</p>}</>}
     {tab === "usage" && <><h3>{t("活用履歴", "Use history", "应用历史")}</h3><p class="op-muted" style="margin-bottom:20px">{t("記録された段階までを表示します。記録のない段階は未確認です。", "Only recorded stages are shown as confirmed. Missing stages remain unconfirmed.", "仅将有记录的阶段显示为已确认，无记录的阶段保持未确认。")}</p>{selectedKind === "memory" ? usage.error ? <p class="op-notice" data-tone="error" role="alert">{usage.error}</p> : asRows(usage.data,"items").length ? <ul class="op-history">{asRows(usage.data,"items").map(item => <li><p>{item.context?.task || item.task_id}</p><time class="op-small">{displayDate(item.created_at,lang)}</time><div class="op-stages">{[["retrieved",t("検索で取得", "Retrieved", "已检索")],["adopted",t("採用", "Adopted", "已采用")],["executed",t("実行", "Executed", "已执行")],["outcome_confirmed",t("結果確認", "Outcome confirmed", "已确认结果")]].map(([key,label]) => <span data-confirmed={item.stages?.[key] === true ? "true" : "false"}>{label}: {item.stages?.[key] === true ? t("記録あり", "Recorded", "有记录") : t("未確認", "Unconfirmed", "未确认")}</span>)}</div>{asRows(item.evidence).map(e => <details class="op-edit"><summary>{t("確認の根拠", "Supporting evidence", "确认依据")}</summary><p class="op-prose">{e.excerpt || e.reason}</p></details>)}</li>)}</ul> : <p class="op-muted">{t("記録された利用履歴はありません。未使用と断定するものではありません。", "No recorded use history. This does not establish that the record was unused.", "暂无使用历史记录，这并不表示该知识未被使用。")}</p> : <>{traceNodes.filter(item => ["result","agent","skill"].includes(item.type)).map(item => <div class="op-section"><h3>{item.label}</h3><p class="op-prose">{item.summary}</p></div>)}{!traceNodes.some(item => ["result","agent","skill"].includes(item.type)) && <p class="op-muted">{t("確認できる活用記録はありません。", "No readable use records.", "暂无可查看的应用记录。")}</p>}</>}{usage.data?.next_cursor && <a href={viewHref(navigationUrl,{before:usage.data.next_cursor})}>{t("以前の利用履歴", "Earlier use history", "较早的应用历史")}</a>}{asRows(detail.data,"versions").length > 0 && <details class="op-edit"><summary>{t("変更履歴", "Version history", "版本历史")}</summary><ul class="op-history">{asRows(detail.data,"versions").map(item => <li><p>v{item.version} · {item.summary || item.operation}</p><time class="op-small">{displayDate(item.created_at,lang)}</time></li>)}</ul></details>}</>}
     {tab === "sharing" && <><h3>{t("共有範囲", "Access scope", "共享范围")}</h3>{policyResult.error ? <p class="op-notice" data-tone="error" role="alert">{policyResult.error}</p> : !policy ? <p class="op-muted">{t("共有設定を確認できません。", "Access settings are unavailable.", "无法确认共享设置。")}</p> : <><dl class="op-definition"><dt>{t("閲覧できる対象", "Visible to", "可查看的对象")}</dt><dd>{stateLabel(policy.scope,lang)}</dd><dt>{t("所有者", "Owner", "所有者")}</dt><dd>{policy.owner_principal || "—"}</dd><dt>{t("プロジェクト", "Project", "项目")}</dt><dd>{policy.project_id || "—"}</dd></dl>{canShare && <details class="op-edit"><summary>{t("共有範囲を変更", "Change access", "更改共享范围")}</summary><form class="op-form" data-op-api-form data-method="PUT" data-endpoint={`/api/v1/access-policies/${policyType}/${encodeURIComponent(id)}`} data-confirm={t("この知識を閲覧できる対象を変更します。共有範囲を確認してください。", "Change who can access this record. Review the scope.", "更改可以访问此知识的对象，请确认共享范围。")}><input type="hidden" name="tenant_id" value={tenantId}/><input type="hidden" name="owner_principal" value={policy.owner_principal}/><input type="hidden" name="expected_policy_version" value={policy.policy_version} data-value-type="number"/><label>{t("共有範囲", "Access scope", "共享范围")}<select name="scope">{["private","project","group","tenant","restricted"].map(value => <option value={value} selected={policy.scope === value}>{stateLabel(value,lang)}</option>)}</select></label><label>{t("プロジェクト", "Project", "项目")}<input name="project_id" value={policy.project_id || ""} data-value-type="nullable"/></label><label>{t("グループID（カンマ区切り）", "Group IDs (comma-separated)", "群组ID（逗号分隔）")}<input name="group_ids" value={(policy.group_ids || []).join(", ")} data-value-type="array"/></label><label>{t("限定対象（1行に principal:ID または group:ID）", "Restricted subjects (principal:ID or group:ID per line)", "限定对象（每行 principal:ID 或 group:ID）")}<textarea name="restricted_subjects" data-value-type="subjects">{(policy.restricted_subjects || []).map((s:ConsoleRecord) => `${s.subject_type}:${s.subject_id}`).join("\n")}</textarea></label><button type="submit">{t("共有設定を保存", "Save access", "保存共享设置")}</button><p data-form-status role="status"></p></form></details>}</>}</>}
    </>}
   </div>
  </section>
 </div>
</OperatorLayout>
