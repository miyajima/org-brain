---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { dashboardApiPath, dashboardPageParams } from "../../lib/dashboard-page";

const { tenantId } = dashboardPageParams(Astro.url, Astro.request.headers.get("cookie"));
const taskParams = new URLSearchParams({ tenant_id: tenantId, limit: "100" });
const response = await fetch(new URL(dashboardApiPath("/api/v1/tasks", taskParams), Astro.url));
const payload: any = response.ok ? await response.json() : { ok: false, data: [] };
const tasks = payload.ok ? payload.data : [];
const taskHref = (task: { id: string; project_id?: string | null }) => {
  const params = new URLSearchParams({ tenant_id: tenantId });
  if (task.project_id) params.set("project_id", task.project_id);
  return `/tasks/${encodeURIComponent(task.id)}?${params.toString()}`;
};
---
<BaseLayout title="Tasks">
  <section class="card">
    <h1>Task一覧</h1>
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Tenant</th>
          <th>Project</th>
          <th>Capability</th>
          <th>Status</th>
          <th>Updated</th>
        </tr>
      </thead>
      <tbody>
        {tasks.length === 0 ? (
          <tr><td colspan="6">Taskなし</td></tr>
        ) : tasks.map((task: any) => (
          <tr>
            <td><a href={taskHref(task)}>{task.id}</a></td>
            <td>{task.tenant_id}</td>
            <td>{task.project_id ?? "-"}</td>
            <td>{task.capability}</td>
            <td>{task.status}</td>
            <td>{new Date(task.updated_at).toLocaleString("ja-JP")}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</BaseLayout>
