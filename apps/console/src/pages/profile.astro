---
import BaseLayout from "../layouts/BaseLayout.astro";
import { dashboardPageParams } from "../lib/dashboard-page";

type ApiOk<T> = { ok: true; data: T };
type ApiErr = { ok: false; error?: { code?: string; message?: string } };
type ApiResponse<T> = ApiOk<T> | ApiErr;

type Identity = {
  tenant_id: string;
  auth: {
    principal: string;
    source: string;
    allowed_tenants: string[];
    email: string | null;
    display_name: string | null;
  };
  profile: {
    display_name: string | null;
    full_name: string | null;
    email: string | null;
    company_name: string | null;
    organization_name: string | null;
    avatar_url: string | null;
  };
};
type OwnerMapping = {
  tenant_id: string;
  producer_principal: string;
  owner_principal: string;
  created_by_principal: string;
  created_at: number;
  updated_at: number;
};

const url = Astro.url;
const { tenantId, lang } = dashboardPageParams(url, Astro.request.headers.get("cookie"));
const copy = {
  en: { identity: "Identity", title: "Profile", displayName: "Display name", fullName: "Full name", email: "Email", company: "Company name", avatar: "Avatar URL", save: "Save", saved: "Saved", saveError: "Profile could not be saved", loadError: "Profile could not be loaded", ownership: "Memory ownership", mapping: "Producer → owner mapping", mappingBody: "Choose the business owner for memories recorded by this principal. Without a mapping, the recorder remains the owner.", owner: "Owner principal", saveMapping: "Save mapping", mappingSaved: "Ownership mapping saved", mappingError: "Ownership mapping could not be saved", mappingLoadError: "Ownership mapping could not be loaded", producer: "Producer", updated: "updated" },
  ja: { identity: "本人情報", title: "プロフィール", displayName: "表示名", fullName: "氏名", email: "メール", company: "会社名", avatar: "アバターURL", save: "保存", saved: "保存しました", saveError: "プロフィールを保存できませんでした", loadError: "プロフィールを取得できませんでした", ownership: "メモリの所有者", mapping: "記録者 → 所有者の対応", mappingBody: "このprincipalが記録したメモリの業務上の所有者を指定します。未設定の場合は記録者本人が所有者になります。", owner: "所有者principal", saveMapping: "対応を保存", mappingSaved: "所有者の対応を保存しました", mappingError: "所有者の対応を保存できませんでした", mappingLoadError: "所有者の対応を取得できませんでした", producer: "記録者", updated: "更新" },
  zh: { identity: "身份", title: "个人资料", displayName: "显示名称", fullName: "姓名", email: "邮箱", company: "公司名称", avatar: "头像 URL", save: "保存", saved: "已保存", saveError: "无法保存个人资料", loadError: "无法加载个人资料", ownership: "记忆所有权", mapping: "记录者 → 所有者映射", mappingBody: "指定此 principal 所记录记忆的业务负责人。未设置时，记录者本人仍为所有者。", owner: "所有者 principal", saveMapping: "保存映射", mappingSaved: "已保存所有权映射", mappingError: "无法保存所有权映射", mappingLoadError: "无法加载所有权映射", producer: "记录者", updated: "更新于" }
}[lang];
const cookie = Astro.request.headers.get("cookie") ?? "";
let message = "";
let error = "";

async function fetchApi<T>(path: string, init?: RequestInit): Promise<ApiResponse<T> | null> {
  const response = await fetch(new URL(path, url), {
    ...init,
    headers: { cookie, ...(init?.headers ?? {}) }
  });
  const payload = (await response.json().catch(() => null)) as ApiResponse<T> | null;
  if (!response.ok) return payload ?? { ok: false, error: { message: `HTTP ${response.status}` } };
  return payload;
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "profile");
  if (action === "ownership") {
    const saved = await fetchApi("/api/v1/principal-owner-mappings/me", {
      method: "PUT",
      headers: {
        "content-type": "application/json",
        "x-csrf-token": String(form.get("csrf_token") ?? "")
      },
      body: JSON.stringify({
        tenant_id: tenantId,
        owner_principal: String(form.get("owner_principal") ?? "")
      })
    });
    if (saved?.ok) message = copy.mappingSaved;
    else error = saved?.error?.message ?? copy.mappingError;
  } else {
    const payload = {
      tenant_id: tenantId,
      display_name: String(form.get("display_name") ?? ""),
      full_name: String(form.get("full_name") ?? ""),
      email: String(form.get("email") ?? ""),
      company_name: String(form.get("company_name") ?? ""),
      avatar_url: String(form.get("avatar_url") ?? "")
    };
    const saved = await fetchApi("/api/v1/auth/me/profile", {
      method: "PUT",
      headers: {
        "content-type": "application/json",
        "x-csrf-token": String(form.get("csrf_token") ?? "")
      },
      body: JSON.stringify(payload)
    });
    if (saved?.ok) message = copy.saved;
    else error = saved?.error?.message ?? copy.saveError;
  }
}

const identityPayload = await fetchApi<Identity>(`/api/v1/auth/me?tenant_id=${encodeURIComponent(tenantId)}`);
const identity = identityPayload?.ok ? identityPayload.data : null;
if (identityPayload?.ok === false) error = identityPayload.error?.message ?? copy.loadError;
const mappingPayload = await fetchApi<OwnerMapping | null>(`/api/v1/principal-owner-mappings/me?tenant_id=${encodeURIComponent(tenantId)}`);
const mapping = mappingPayload?.ok ? mappingPayload.data : null;
if (mappingPayload?.ok === false && mappingPayload.error?.code !== "forbidden") {
  error = mappingPayload.error?.message ?? copy.mappingLoadError;
}
---
<BaseLayout title={copy.title} lang={lang}>
  <section class="admin-page">
    <header class="admin-page-header">
      <p class="surface-label">{copy.identity}</p>
      <h1>{copy.title}</h1>
      {identity && <p class="mt-3 text-sm text-zinc-400">{identity.auth.principal} · {identity.auth.source}</p>}
    </header>

    {message && <div class="admin-notice admin-notice-success" role="status">{message}</div>}
    {error && <div class="admin-notice admin-notice-error" role="alert">{error}</div>}

    <form method="post" class="grid gap-4 rounded-[22px] border border-white/8 bg-zinc-950/50 p-5 md:grid-cols-2">
      <input type="hidden" name="action" value="profile" />
      <input type="hidden" name="tenant_id" value={tenantId} />
      <input type="hidden" name="csrf_token" id="csrf-token" />
      <label>
        <span class="field-label">{copy.displayName}</span>
        <input name="display_name" value={identity?.profile.display_name ?? identity?.auth.display_name ?? ""} />
      </label>
      <label>
        <span class="field-label">{copy.fullName}</span>
        <input name="full_name" value={identity?.profile.full_name ?? ""} />
      </label>
      <label>
        <span class="field-label">{copy.email}</span>
        <input name="email" value={identity?.profile.email ?? identity?.auth.email ?? ""} />
      </label>
      <label>
        <span class="field-label">{copy.company}</span>
        <input name="company_name" value={identity?.profile.company_name ?? ""} />
      </label>
      <label class="md:col-span-2">
        <span class="field-label">{copy.avatar}</span>
        <input name="avatar_url" value={identity?.profile.avatar_url ?? ""} />
      </label>
      <div class="md:col-span-2">
        <button type="submit">{copy.save}</button>
      </div>
    </form>

    <section class="grid gap-4 rounded-[22px] border border-cyan-300/15 bg-cyan-300/[0.04] p-5">
      <div>
        <p class="surface-label">{copy.ownership}</p>
        <h2 class="mt-2 text-xl font-semibold text-white">{copy.mapping}</h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-zinc-300">{copy.mappingBody}</p>
      </div>
      <form method="post" class="grid gap-4 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
        <input type="hidden" name="action" value="ownership" />
        <input type="hidden" name="tenant_id" value={tenantId} />
        <input type="hidden" name="csrf_token" id="ownership-csrf-token" />
        <label>
          <span class="field-label">{copy.owner}</span>
          <input name="owner_principal" value={mapping?.owner_principal ?? identity?.auth.principal ?? ""} required />
        </label>
        <button type="submit">{copy.saveMapping}</button>
      </form>
      {mapping && <p class="admin-record-meta">{copy.producer}: {mapping.producer_principal} · {copy.updated} {new Date(mapping.updated_at).toLocaleString(lang === "ja" ? "ja-JP" : lang === "zh" ? "zh-CN" : "en-US")}</p>}
    </section>
  </section>
</BaseLayout>
<script>
  const csrfInput = document.querySelector<HTMLInputElement>("#csrf-token");
  if (csrfInput) csrfInput.value = sessionStorage.getItem("orgbrain_csrf") ?? "";
  const ownershipCsrfInput = document.querySelector<HTMLInputElement>("#ownership-csrf-token");
  if (ownershipCsrfInput) ownershipCsrfInput.value = sessionStorage.getItem("orgbrain_csrf") ?? "";
</script>
