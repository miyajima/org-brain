---
import { createServerApi } from "../../lib/server-api";
const serverApi = createServerApi(Astro.request);
import BaseLayout from "../../layouts/BaseLayout.astro";
import AdminPageHeader from "../../components/admin/AdminPageHeader.astro";
import LiveNotice from "../../components/admin/LiveNotice.astro";
import ConfirmationDialog from "../../components/admin/ConfirmationDialog.astro";
import { dashboardPageParams } from "../../lib/dashboard-page";
import { scopedAdminHref } from "../../lib/admin-ui";
import { adminUserStatusLabel, groupAdminCopy } from "../../lib/admin-copy";

const { tenantId, lang } = dashboardPageParams(Astro.url, Astro.request.headers.get("cookie"));
const copy = groupAdminCopy(lang);
const groupId = Astro.params.groupId ?? "";

const api = async (path: string, init: RequestInit = {}) => serverApi(new URL(path, Astro.url), {
  ...init,
  headers: init.headers
});
let message = "";
let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "member");
  const csrf = String(form.get("csrf_token") ?? "");
  let path = `/api/v1/groups/${encodeURIComponent(groupId)}/members`;
  let method = "POST";
  let body: string | undefined = JSON.stringify({
    tenant_id: tenantId,
    principal: String(form.get("principal") ?? ""),
    role: String(form.get("role") ?? "member")
  });
  if (action === "remove") {
    path += `/${encodeURIComponent(String(form.get("principal") ?? ""))}?tenant_id=${encodeURIComponent(tenantId)}`;
    method = "DELETE";
    body = undefined;
  } else if (action === "archive") {
    path = `/api/v1/groups/${encodeURIComponent(groupId)}?tenant_id=${encodeURIComponent(tenantId)}`;
    method = "DELETE";
    body = undefined;
  }
  const response = await api(path, {
    method,
    headers: { "content-type": "application/json", "x-csrf-token": csrf,
      ...(action === "remove" ? { "if-match": String(form.get("impact_digest") ?? "") } : {}) },
    body
  });
  if (response.ok) message = action === "archive" ? copy.archived : copy.updated;
  else {
    const failure = await response.json().catch(() => null) as { error?: { message?: string } } | null;
    error = failure?.error?.message ?? copy.updateError;
  }
}

const [groupResponse, directoryResponse] = await Promise.all([
  api(`/api/v1/groups/${encodeURIComponent(groupId)}?tenant_id=${encodeURIComponent(tenantId)}`),
  api(`/api/v1/directory?tenant_id=${encodeURIComponent(tenantId)}`)
]);
const groupPayload: any = await groupResponse.json().catch(() => null);
const directoryPayload: any = await directoryResponse.json().catch(() => null);
const group = groupPayload?.data?.group;
const members = groupPayload?.data?.members ?? [];
const directory = directoryPayload?.data?.users ?? [];
if (!groupResponse.ok && !message) error = groupPayload?.error?.message ?? copy.loadError;
const backHref = scopedAdminHref("/groups", Astro.url.searchParams);
const roleLabel = (value: string) => copy.roles[value as keyof typeof copy.roles] ?? value;
---
<BaseLayout title={copy.title} lang={lang}>
  <section class="admin-page">
    <AdminPageHeader eyebrow={`${tenantId} · ${group?.source ?? "local"}`} title={group?.name ?? copy.fallback} description={group?.description}>
      <a slot="actions" class="secondary-action" href={backHref}>{copy.back}</a>
    </AdminPageHeader>
    {message && <LiveNotice message={message} />}{error && <LiveNotice tone="error" message={error} />}

    {group?.source === "local" && <form id="add-group-member" method="post" class="grid gap-4 rounded-[22px] border border-white/8 bg-zinc-950/50 p-5 md:grid-cols-[1fr_12rem_auto] md:items-end" data-confirm="true" data-confirm-target-field="principal" data-confirm-impact={copy.addImpact(group?.name ?? copy.fallback)} data-confirm-recovery={copy.addRecovery}>
      <input type="hidden" name="csrf_token" class="csrf-token" />
      <input type="hidden" name="action" value="member" />
      <label><span class="field-label">{copy.user}</span><input name="principal" list="directory-users" required /></label>
      <datalist id="directory-users">{directory.map((user: any) => <option value={user.principal}>{user.display_name}</option>)}</datalist>
      <label><span class="field-label">{copy.groupRole}</span><select name="role">{Object.keys(copy.roles).map((role) => <option value={role}>{roleLabel(role)}</option>)}</select></label>
      <button type="submit">{copy.add}</button>
    </form>}

    <div class="overflow-x-auto rounded-[22px] border border-white/8">
      <table><thead><tr><th>{copy.user}</th><th>{copy.role}</th><th>{copy.status}</th><th></th></tr></thead><tbody>
        {members.map((member: any) => <tr><td><div class="admin-person-cell">{member.avatar_url && <img src={member.avatar_url} alt="" loading="lazy" />}<span><strong>{member.display_name || member.principal}</strong><details class="admin-technical-details"><summary>{copy.technical}</summary><small>{member.principal} · {member.source}</small></details></span></div></td><td>{roleLabel(member.role)}</td><td>{adminUserStatusLabel(member.status ?? "active", lang)}</td><td>{group?.source === "local" && (member.can_remove !== false ? <form method="post" class="impact-removal-form" data-impact-endpoint={`/api/v1/groups/${encodeURIComponent(groupId)}/members/${encodeURIComponent(member.principal)}/impact?tenant_id=${encodeURIComponent(tenantId)}`} data-confirm="true" data-confirm-target={member.display_name || member.principal} data-confirm-impact={copy.previewLoading} data-confirm-recovery={copy.removeRecovery}><input type="hidden" name="csrf_token" class="csrf-token" /><input type="hidden" name="action" value="remove" /><input type="hidden" name="principal" value={member.principal} /><input type="hidden" name="impact_digest" value="" /><button type="submit" disabled aria-describedby={`impact-${member.principal}`} aria-label={copy.removeAria(member.display_name || member.principal)}>{copy.remove}</button><small id={`impact-${member.principal}`} class="impact-preview-status" role="status">{copy.previewLoading}</small></form> : <p class="admin-recovery-hint">{copy.ownerRemovalHelp} <a href="#add-group-member">{copy.ownerRemovalAction}</a></p>)}</td></tr>)}
      </tbody></table>
    </div>
    {group?.source === "local" && <form method="post" data-confirm="true" data-confirm-target={group?.name ?? copy.fallback} data-confirm-impact={copy.archiveImpact} data-confirm-recovery={copy.archiveRecovery}><input type="hidden" name="csrf_token" class="csrf-token" /><input type="hidden" name="action" value="archive" /><button type="submit">{copy.archive}</button></form>}
  </section>
  <ConfirmationDialog lang={lang} />
</BaseLayout>
<script>
  document.querySelectorAll<HTMLInputElement>(".csrf-token").forEach((input) => {
    input.value = sessionStorage.getItem("orgbrain_csrf") ?? "";
  });
  const localizedImpact = {
    en: (lost: number, retained: number) => `This person will lose access to ${lost} items and retain access to ${retained} items.`,
    ja: (lost: number, retained: number) => `${lost}件へのアクセスを失い、${retained}件へのアクセスは維持されます。`,
    zh: (lost: number, retained: number) => `将失去 ${lost} 项访问权限，并保留 ${retained} 项访问权限。`
  };
  const previewError = { en: "Impact preview is unavailable. Removal is disabled.", ja: "影響を確認できないため、解除できません。", zh: "无法获取影响预览，已禁用移除操作。" };
  const pageLang = document.documentElement.lang === "ja" || document.documentElement.lang === "zh" ? document.documentElement.lang : "en";
  document.querySelectorAll<HTMLFormElement>(".impact-removal-form").forEach(async (form) => {
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    const digest = form.querySelector<HTMLInputElement>("input[name=impact_digest]");
    const status = form.querySelector<HTMLElement>(".impact-preview-status");
    try {
      const response = await fetch(form.dataset.impactEndpoint ?? "", { headers: { accept: "application/json" } });
      const payload = await response.json() as { data?: { impact_digest?: string; impact?: { lost_count?: number; retained_count?: number } } };
      if (!response.ok || !payload?.data?.impact_digest) throw new Error("impact unavailable");
      digest!.value = payload.data.impact_digest;
      const text = localizedImpact[pageLang](Number(payload.data.impact?.lost_count ?? 0), Number(payload.data.impact?.retained_count ?? 0));
      form.dataset.confirmImpact = text;
      if (status) status.textContent = text;
      if (button) button.disabled = false;
    } catch {
      if (status) status.textContent = previewError[pageLang];
    }
  });
</script>
