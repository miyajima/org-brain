---
import { createServerApi } from "../lib/server-api";
const serverApi = createServerApi(Astro.request);
import BaseLayout from "../layouts/BaseLayout.astro";
import { dashboardPageParams } from "../lib/dashboard-page";
import { domainPacksCopy } from "../lib/console-locale";

const { tenantId, lang } = dashboardPageParams(Astro.url, Astro.request.headers.get("cookie"));
const copy = domainPacksCopy(lang);

const api = async (path: string, init: RequestInit = {}) => serverApi(new URL(path, Astro.url), {
  ...init,
  headers: init.headers
});

let message = "";
let error = "";
let plan: any = null;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const packIds = form.getAll("pack_ids").map(String).filter(Boolean);
  const action = String(form.get("action") ?? "preview");
  const csrf = String(form.get("csrf_token") ?? "");
  if (!packIds.length) {
    error = copy.selectError;
  } else {
    const planResponse = await api("/api/v1/domain-packs/installations/plan", {
      method: "POST",
      headers: { "content-type": "application/json", "x-csrf-token": csrf },
      body: JSON.stringify({ tenant_id: tenantId, pack_ids: packIds })
    });
    const planPayload: any = await planResponse.json().catch(() => null);
    if (!planResponse.ok) {
      error = planPayload?.error?.message ?? copy.previewError;
    } else {
      plan = planPayload?.data;
      if (action === "install") {
        const installResponse = await api("/api/v1/domain-packs/installations", {
          method: "POST",
          headers: { "content-type": "application/json", "x-csrf-token": csrf },
          body: JSON.stringify({ tenant_id: tenantId, pack_ids: packIds, plan_digest: plan.plan_digest })
        });
        const installPayload: any = await installResponse.json().catch(() => null);
        if (installResponse.ok) message = `${installPayload?.data?.installations?.length ?? packIds.length}${copy.installed}`;
        else error = installPayload?.error?.message ?? copy.installError;
      }
    }
  }
}

const [catalogResponse, capabilityResponse] = await Promise.all([
  api(`/api/v1/domain-packs?tenant_id=${encodeURIComponent(tenantId)}`),
  api(`/api/v1/capabilities?tenant_id=${encodeURIComponent(tenantId)}`)
]);
const catalogPayload: any = await catalogResponse.json().catch(() => null);
const capabilityPayload: any = await capabilityResponse.json().catch(() => null);
const packs = catalogPayload?.data ?? [];
const builderCapability = capabilityPayload?.data?.pack_builder;
let builderHref: string | null = null;
if (builderCapability?.enabled && typeof builderCapability.href === "string") {
  const target = new URL(builderCapability.href, Astro.url);
  if (target.origin === Astro.url.origin) builderHref = `${target.pathname}${target.search}`;
}
---
<BaseLayout title={copy.title} lang={lang} wide>
  <section class="space-y-5">
    <header class="rounded-[22px] border border-white/10 bg-white/[0.04] p-6">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <p class="surface-label">{tenantId} · DOMAIN PACK PLATFORM</p>
          <h1 class="mt-2 text-3xl font-semibold">{copy.heading}</h1>
          <p class="surface-muted mt-2 max-w-3xl">{copy.body}</p>
        </div>
        {builderHref && <a class="button-secondary" href={builderHref}>Enterprise Pack Builder</a>}
      </div>
    </header>

    {message && <p class="rounded-xl border border-emerald-400/25 bg-emerald-400/10 p-3 text-emerald-100">{message}</p>}
    {error && <p class="rounded-xl border border-rose-400/25 bg-rose-400/10 p-3 text-rose-100">{error}</p>}

    <form method="post" class="space-y-4">
      <input type="hidden" name="csrf_token" id="domain-pack-csrf" />
      <div class="grid gap-4 lg:grid-cols-2">
        {packs.map((entry: any) => {
          const manifest = entry.manifest;
          return <label class="block cursor-pointer rounded-[22px] border border-white/10 bg-zinc-950/55 p-5 transition hover:border-sky-300/30">
            <div class="flex items-start gap-3">
              <input class="mt-1" type="checkbox" name="pack_ids" value={manifest.pack_id} checked />
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <h2 class="text-xl font-semibold">{manifest.title}</h2>
                  <span class="rounded-full bg-white/8 px-2 py-1 text-xs text-zinc-300">v{manifest.version}</span>
                  <span class:list={["rounded-full px-2 py-1 text-xs", entry.installation ? "bg-emerald-400/15 text-emerald-200" : "bg-sky-400/15 text-sky-200"]}>{entry.installation ? copy.installedState : copy.available}</span>
                </div>
                <p class="surface-muted mt-2">{manifest.description}</p>
                <dl class="mt-4 grid grid-cols-4 gap-2 text-center text-sm">
                  <div class="rounded-xl bg-white/[0.04] p-2"><dt class="text-zinc-500">{copy.objects}</dt><dd class="mt-1 font-semibold">{manifest.object_types.length}</dd></div>
                  <div class="rounded-xl bg-white/[0.04] p-2"><dt class="text-zinc-500">{copy.metrics}</dt><dd class="mt-1 font-semibold">{manifest.metrics.length}</dd></div>
                  <div class="rounded-xl bg-white/[0.04] p-2"><dt class="text-zinc-500">{copy.assets}</dt><dd class="mt-1 font-semibold">{manifest.assets.length}</dd></div>
                  <div class="rounded-xl bg-white/[0.04] p-2"><dt class="text-zinc-500">{copy.connector}</dt><dd class="mt-1 font-semibold">{manifest.connectors.length}</dd></div>
                </dl>
                <details class="mt-4 text-sm">
                  <summary class="cursor-pointer text-zinc-300">{copy.details}</summary>
                  <div class="mt-3 grid gap-3 md:grid-cols-2">
                    <div><p class="field-label">Managed objects</p><p class="mt-1 text-zinc-300">{manifest.object_types.map((item: any) => item.label).join(" · ")}</p></div>
                    <div><p class="field-label">Metrics</p><p class="mt-1 text-zinc-300">{manifest.metrics.map((item: any) => item.label).join(" · ")}</p></div>
                    <div><p class="field-label">Workflow / Playbook</p><p class="mt-1 text-zinc-300">{manifest.assets.map((item: any) => item.asset_key).join(" · ") || "—"}</p></div>
                    <div><p class="field-label">Provenance</p><p class="mt-1 break-all font-mono text-xs text-zinc-400">{entry.digest}</p></div>
                  </div>
                </details>
              </div>
            </div>
          </label>;
        })}
      </div>
      <div class="flex flex-wrap gap-3 rounded-[18px] border border-white/8 bg-white/[0.03] p-4">
        <button type="submit" name="action" value="preview" class="button-secondary">{copy.preview}</button>
        <button type="submit" name="action" value="install">{copy.apply}</button>
        <p class="self-center text-sm text-zinc-500">{copy.fixtureNote}</p>
      </div>
    </form>

    {plan && <section class="rounded-[22px] border border-sky-300/20 bg-sky-300/[0.05] p-5">
      <p class="surface-label">INSTALL DIFF · {plan.plan_digest}</p>
      <div class="mt-4 grid gap-3 lg:grid-cols-2">
        {plan.packs.map((pack: any) => <article class="rounded-xl border border-white/8 bg-black/20 p-4">
          <div class="flex justify-between gap-3"><strong>{pack.pack_id}</strong><span>{pack.action}</span></div>
          <p class="mt-2 text-sm text-zinc-400">対象型 {pack.creates.managed_object_types} · 指標 {pack.creates.metric_definitions} · Dashboard {pack.creates.dashboards} · 資産参照 {pack.creates.asset_references}</p>
          {Object.values(pack.preserved_custom_conflicts).flat().length > 0 && <p class="mt-2 text-sm text-amber-200">{copy.customPreserved}</p>}
        </article>)}
      </div>
    </section>}
  </section>
</BaseLayout>
<script>document.querySelector<HTMLInputElement>("#domain-pack-csrf")!.value = sessionStorage.getItem("orgbrain_csrf") ?? "";</script>
