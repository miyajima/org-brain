---
import BaseLayout from "../layouts/BaseLayout.astro";
import { dashboardApiPath, dashboardPageParams } from "../lib/dashboard-page";
import { dashboardLabel, dashboardStatusTone } from "../lib/dashboard-copy";
import { buildOperationsActions } from "../lib/operations-ui";

const { tenantId, lang } = dashboardPageParams(Astro.url, Astro.request.headers.get("cookie"));
const opsParams = new URLSearchParams({ tenant_id: tenantId });
const response = await fetch(new URL(dashboardApiPath("/api/v1/ops/status", opsParams), Astro.url));
const payload: any = response.ok ? await response.json() : { ok: false, data: null };
const status = payload.ok ? payload.data : null;
const scheduledJobs = Array.isArray(status?.scheduled_jobs) ? status.scheduled_jobs : [];
const retentionQueue = status?.retention_queue ?? {};
const actions = status ? buildOperationsActions(status) : [];
const generatedAt = typeof status?.generated_at === "number" && Number.isFinite(status.generated_at) ? status.generated_at : null;
const display = (value: unknown, suffix = "") =>
  typeof value === "number" && Number.isFinite(value) ? `${value}${suffix}` : "未計測";
const percent = (value: unknown) =>
  typeof value === "number" && Number.isFinite(value) ? `${(value * 100).toFixed(1)}%` : "未計測";
const timestamp = (value: unknown) =>
  typeof value === "number" && Number.isFinite(value)
    ? new Date(value).toLocaleString("ja-JP", { timeZone: "Asia/Tokyo" })
    : "未実行";
const duration = (value: unknown) => {
  if (typeof value !== "number" || !Number.isFinite(value)) return "未計測";
  const hours = Math.floor(value / 3_600_000);
  const minutes = Math.floor((value % 3_600_000) / 60_000);
  return `${hours}時間${minutes}分`;
};
const label = (kind: "status" | "capability" | "job" | "role" | "permission", value: string | null | undefined) =>
  dashboardLabel(kind, value, lang);
const toneClass = (value: string | null | undefined) => `ops-tone-${dashboardStatusTone(value)}`;
---

<BaseLayout title="Org Brain 運用" lang={lang}>
  <section class="card operations-hero">
    <span class="surface-chip">運用</span>
    <h1 class="mt-4 text-3xl font-semibold">運用ステータス</h1>
    <p class="surface-muted mt-2">
      権限・競合・古い記憶・検索品質・キュー状態を、テナント単位で確認します。対象: <strong>{tenantId}</strong>
    </p>
    {status && generatedAt !== null && <p class="operations-updated">最終更新: <time datetime={new Date(generatedAt).toISOString()}>{timestamp(generatedAt)}</time></p>}
    {!status && (
      <p class="mt-6 rounded-2xl border border-rose-300/20 bg-rose-300/8 p-4 text-rose-100" role="alert">
        運用データを取得できませんでした。API設定とadmin権限を確認してください。
      </p>
    )}
  </section>

  {status && (
    <>
      <section class="card ops-attention mt-6" aria-labelledby="operations-attention-title">
        <header>
          <div>
            <p class="surface-label">最初に確認</p>
            <h2 id="operations-attention-title">対応が必要な項目</h2>
          </div>
          <span class="ops-attention-count">{actions.length > 0 ? `${actions.length}項目` : "問題なし"}</span>
        </header>
        {actions.length > 0 ? (
          <div class="ops-action-list">
            {actions.slice(0, 6).map((action) => (
              <article class:list={["ops-action", `ops-action-${action.tone}`]}>
                <div>
                  <div class="ops-action-meta"><span class="ops-severity">{action.tone === "critical" ? "至急対応" : "要確認"}</span><span class="ops-action-count">{action.count}件</span></div>
                  <h3>{action.title}</h3>
                  <p>{action.reason}</p>
                </div>
                <a href={action.href}>{action.href === "#failed-tasks" ? "Taskを確認" : "詳細を確認"}</a>
              </article>
            ))}
          </div>
        ) : (
          <p class="ops-healthy" role="status"><span aria-hidden="true">✓</span>現在、優先対応が必要な項目はありません。</p>
        )}
      </section>

      <section class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4" aria-label="運用概要">
        <article class="surface-soft-card" id="memory-health">
          <p class="surface-label">記憶</p>
          <p class="mt-3 text-3xl font-semibold">{display(status.memories.total)}</p>
          <p class="surface-muted mt-2 text-sm">競合 {display(status.memories.conflicting)} / 期限切れ {display(status.memories.expired)}</p>
        </article>
        <article class="surface-soft-card" id="decision-review">
          <p class="surface-label">判断確認</p>
          <p class="mt-3 text-3xl font-semibold">{display(status.decision_review.unconfirmed)}</p>
          <p class="surface-muted mt-2 text-sm">未確認 / 低信頼 {display(status.decision_review.low_confidence)}</p>
        </article>
        <article class="surface-soft-card">
          <p class="surface-label">Taskキュー</p>
          <p class="mt-3 text-3xl font-semibold">{display(status.tasks.active)}</p>
          <p class="surface-muted mt-2 text-sm">実行中 / 失敗・隔離 {display(status.tasks.failed)} / 停滞 {display(status.tasks.stuck)}</p>
        </article>
        <article class="surface-soft-card" id="audit-quality">
          <p class="surface-label">監査（24時間）</p>
          <p class="mt-3 text-3xl font-semibold">{display(status.audit.events_24h)}</p>
          <p class="surface-muted mt-2 text-sm">拒否 {display(status.audit.denied_24h)} / 失敗 {display(status.audit.failed_24h)}</p>
        </article>
      </section>

      <section class="card mt-6" id="failed-tasks">
        <h2 class="text-xl font-semibold">失敗・隔離Task</h2>
        <p class="surface-muted mt-2 text-sm">元の作成イベントから、新しいTaskとして再実行します。</p>
        <div class="mt-5 overflow-x-auto">
          <table>
            <thead><tr><th>Task</th><th>処理</th><th>状態</th><th>更新日時</th><th>操作</th></tr></thead>
            <tbody>
              {status.tasks.failed_items.length === 0 ? (
                <tr><td colspan="5">対象なし</td></tr>
              ) : status.tasks.failed_items.map((task: any) => (
                <tr>
                  <td><code>{task.id}</code></td>
                  <td title={task.capability}>{label("capability", task.capability)}</td>
                  <td><span class={`ops-status ${toneClass(task.status)}`} title={task.status}>{label("status", task.status)}</span></td>
                  <td>{new Date(task.updated_at).toLocaleString("ja-JP")}</td>
                  <td><button class="replay-task" data-task-id={task.id} data-tenant-id={tenantId}>再実行</button></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p id="replay-result" class="surface-muted mt-3 text-sm" aria-live="polite"></p>
      </section>

      <section class="card mt-6" id="scheduled-jobs">
        <h2 class="text-xl font-semibold">定期処理</h2>
        <p class="surface-muted mt-2 text-sm">最終成功から36時間を超えたジョブは古い状態として通知されます。</p>
        <div class="mt-5 overflow-x-auto">
          <table>
            <thead><tr><th>処理</th><th>最新状態</th><th>最終成功</th><th>経過時間</th><th>次回予定</th></tr></thead>
            <tbody>
              {scheduledJobs.map((job: any) => (
                <tr>
                  <td><code title={job.job_name}>{label("job", job.job_name)}</code></td>
                  <td><span class={`ops-status ${toneClass(job.stale ? "stale" : job.latest_status)}`} title={job.latest_status}>{job.stale ? "要確認" : label("status", job.latest_status)}</span></td>
                  <td>{timestamp(job.last_success_at)}</td>
                  <td>{duration(job.success_age_ms)}</td>
                  <td>{timestamp(job.next_expected_at)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" id="retention-queue">
          <div class="surface-soft-card"><p class="surface-label">保持処理・保留</p><p class="mt-2 text-2xl">{display(retentionQueue.pending)}</p></div>
          <div class="surface-soft-card"><p class="surface-label">保持処理・期限超過</p><p class="mt-2 text-2xl">{display(retentionQueue.overdue)}</p></div>
          <div class="surface-soft-card"><p class="surface-label">保持処理・失敗</p><p class="mt-2 text-2xl">{display(retentionQueue.failed)}</p></div>
          <div class="surface-soft-card"><p class="surface-label">手動確認</p><p class="mt-2 text-2xl">{display(retentionQueue.manual_review)}</p></div>
        </div>
      </section>

      <section class="card mt-6">
        <h2 class="text-xl font-semibold">権限とロール</h2>
        <p class="surface-muted mt-2 text-sm">テナント内の固定ロール、許可される操作、現在の割り当て数を表示します。</p>
        <div class="mt-5 overflow-x-auto">
          <table>
            <thead><tr><th>ロール</th><th>許可される操作</th><th>割り当て</th><th>主体数</th></tr></thead>
            <tbody>
              {status.authorization.roles.map((role: any) => (
                <tr>
                  <td title={role.role}><code>{label("role", role.role)}</code></td>
                  <td>{role.permissions.map((permission: string) => <span class="ops-permission" title={permission}>{label("permission", permission)}</span>)}</td>
                  <td>{display(role.assignments)}</td>
                  <td>{display(role.principals)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="card mt-6">
        <h2 class="text-xl font-semibold">検索品質と索引</h2>
        <div class="mt-5 overflow-x-auto">
          <table>
            <tbody>
              <tr><th>24時間の検索数</th><td>{display(status.retrieval.searches_24h)}</td></tr>
              <tr><th>ヒット率</th><td>{percent(status.retrieval.hit_rate_24h)}</td></tr>
              <tr><th>フォールバック率</th><td>{percent(status.retrieval.fallback_rate_24h)}</td></tr>
              <tr><th>平均応答時間</th><td>{display(status.retrieval.average_latency_ms_24h, " ms")}</td></tr>
              <tr><th>意味検索インデックス</th><td>{status.retrieval.semantic_configured ? "設定済み" : "未設定"}</td></tr>
              <tr><th>文字・グラフ検索</th><td>{label("status", status.retrieval.lexical)} / {label("status", status.retrieval.graph)}</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="card mt-6">
        <h2 class="text-xl font-semibold">ガバナンスと復旧目標</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="surface-soft-card"><p class="surface-label">有効なToken</p><p class="mt-2 text-2xl">{display(status.scoped_tokens.active)}</p></div>
          <div class="surface-soft-card"><p class="surface-label">法的保持</p><p class="mt-2 text-2xl">{display(status.retention.legal_holds)}</p></div>
          <div class="surface-soft-card"><p class="surface-label">RPO目標</p><p class="mt-2 text-2xl">{display(status.slo_targets.rpo_minutes, " 分")}</p></div>
          <div class="surface-soft-card"><p class="surface-label">RTO目標</p><p class="mt-2 text-2xl">{display(status.slo_targets.rto_minutes, " 分")}</p></div>
        </div>
      </section>
    </>
  )}
</BaseLayout>

<script>
  const output = document.querySelector<HTMLElement>("#replay-result");
  document.querySelectorAll<HTMLButtonElement>(".replay-task").forEach((button) => {
    button.addEventListener("click", async () => {
      const taskId = button.dataset.taskId;
      if (!taskId || !output) return;
      button.disabled = true;
      output.textContent = `${taskId} を再実行しています…`;
      try {
        const response = await fetch(`/api/v1/ops/tasks/${encodeURIComponent(taskId)}/replay`, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ tenant_id: button.dataset.tenantId })
        });
        const payload = await response.json() as {
          ok?: boolean;
          data?: { task_id?: string };
          error?: { message?: string };
        };
        if (!response.ok || !payload.ok) throw new Error(payload?.error?.message || `HTTP ${response.status}`);
        output.textContent = `再実行Task ${payload.data?.task_id ?? "(不明)"} を作成しました。`;
      } catch (error) {
        output.textContent = error instanceof Error ? error.message : String(error);
        button.disabled = false;
      }
    });
  });
</script>

<style>
  .operations-updated { margin-top: .8rem; color: var(--console-muted); font-size: .78rem; }
  .ops-attention { border-color: rgba(255,184,77,.28); background: linear-gradient(180deg, rgba(52,33,12,.42), rgba(5,13,24,.86)); }
  .ops-attention > header { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
  .ops-attention h2 { margin-top: .3rem; font-size: 1.25rem; }
  .ops-attention-count { color: var(--console-muted); font-size: .82rem; }
  .ops-action-list { display: grid; gap: .75rem; margin-top: 1.2rem; }
  .ops-action { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-left: 3px solid var(--console-accent); border-radius: 12px; background: rgba(255,255,255,.035); padding: .9rem 1rem; }
  .ops-action-critical { border-color: var(--console-danger); background: rgba(255,92,103,.08); }
  .ops-action-warning { border-color: var(--intelligence-warning); background: rgba(255,184,77,.07); }
  .ops-action h3 { margin-top: .2rem; color: var(--console-text); font-size: .9rem; }
  .ops-action p { margin-top: .25rem; color: var(--console-muted); font-size: .78rem; line-height: 1.45; }
  .ops-action a { display: inline-flex; min-height: 44px; flex: 0 0 auto; align-items: center; border: 1px solid var(--console-border-strong); border-radius: 10px; padding: .5rem .75rem; color: var(--console-text); font-size: .76rem; font-weight: 650; }
  .ops-action-meta { display: flex; gap: .65rem; align-items: center; }
  .ops-severity { color: var(--console-danger); font-size: .68rem; font-weight: 700; letter-spacing: .08em; }
  .ops-action-warning .ops-severity { color: var(--intelligence-warning); }
  .ops-action-count { color: var(--console-muted); font-family: "Fira Code", monospace; font-size: .68rem; }
  .ops-healthy { display: flex; gap: .6rem; align-items: center; margin-top: 1.2rem; color: var(--intelligence-success); font-size: .82rem; }
  .ops-status { display: inline-flex; min-height: 1.6rem; align-items: center; border-radius: 999px; padding: .2rem .55rem; font-size: .75rem; font-weight: 650; }
  .ops-tone-healthy { background: rgba(67,220,173,.12); color: #9ff4d4; }
  .ops-tone-warning { background: rgba(255,184,77,.13); color: #ffd58a; }
  .ops-tone-critical { background: rgba(255,92,103,.14); color: #ffb4bb; }
  .ops-tone-neutral { background: rgba(255,255,255,.07); color: var(--console-muted); }
  .ops-permission { display: inline-block; margin: .12rem .4rem .12rem 0; }
  @media (max-width: 640px) { .ops-action { align-items: start; flex-direction: column; }.ops-action a { width: 100%; justify-content: center; } }
</style>
