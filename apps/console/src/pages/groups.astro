---
import { createServerApi } from "../lib/server-api";
const serverApi = createServerApi(Astro.request);
import BaseLayout from "../layouts/BaseLayout.astro";
import AdminPageHeader from "../components/admin/AdminPageHeader.astro";
import LiveNotice from "../components/admin/LiveNotice.astro";
import { dashboardPageParams } from "../lib/dashboard-page";
import { groupsCopy } from "../lib/console-locale";

type ApiOk<T> = { ok: true; data: T };
type ApiErr = { ok: false; error?: { code?: string; message?: string } };
type ApiResponse<T> = ApiOk<T> | ApiErr;
type Group = {
  id: string;
  slug: string;
  name: string;
  description: string | null;
  role: string | null;
  source: "local" | "scim";
  updated_at: number;
};

const url = Astro.url;
const { tenantId, projectId, lang } = dashboardPageParams(url, Astro.request.headers.get("cookie"));
const copy = groupsCopy(lang);

let message = "";
let error = "";

async function fetchApi<T>(path: string, init?: RequestInit): Promise<ApiResponse<T> | null> {
  const response = await serverApi(new URL(path, url), { ...init, headers: init?.headers });
  const payload = (await response.json().catch(() => null)) as ApiResponse<T> | null;
  if (!response.ok) return payload ?? { ok: false, error: { message: `HTTP ${response.status}` } };
  return payload;
}

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const saved = await fetchApi("/api/v1/groups", {
    method: "POST",
    headers: {
      "content-type": "application/json",
      "x-csrf-token": String(form.get("csrf_token") ?? "")
    },
    body: JSON.stringify({
      tenant_id: tenantId,
      name: String(form.get("name") ?? ""),
      slug: String(form.get("slug") ?? ""),
      description: String(form.get("description") ?? "")
    })
  });
  if (saved?.ok) message = copy.created;
  else error = saved?.error?.message ?? copy.createError;
}

const groupsPayload = await fetchApi<{ groups: Group[] }>(`/api/v1/groups?tenant_id=${encodeURIComponent(tenantId)}`);
const groups = groupsPayload?.ok ? groupsPayload.data.groups : [];
if (groupsPayload?.ok === false) error = groupsPayload.error?.message ?? copy.loadError;
const scopedGroupHref = (id: string) => {
  const scoped = new URLSearchParams({ tenant_id: tenantId, lang });
  if (projectId) scoped.set("project_id", projectId);
  return `/groups/${encodeURIComponent(id)}?${scoped.toString()}`;
};
---
<BaseLayout title={copy.title} lang={lang}>
  <section class="admin-page">
    <AdminPageHeader eyebrow={tenantId} title={copy.title} />

    {message && <LiveNotice message={message} />}
    {error && <LiveNotice tone="error" message={error} />}

    <form method="post" class="admin-section admin-form-grid">
      <input type="hidden" name="csrf_token" id="csrf-token" />
      <label>
        <span class="field-label">{copy.name}</span>
        <input name="name" required />
      </label>
      <label>
        <span class="field-label">{copy.slug}</span>
        <input name="slug" />
      </label>
      <label>
        <span class="field-label">{copy.description}</span>
        <input name="description" />
      </label>
      <button type="submit">{copy.create}</button>
    </form>

    <section class="grid gap-3">
      {groups.map((group) => (
        <article class="rounded-[18px] border border-white/8 bg-white/[0.035] p-4">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h2 class="text-lg font-semibold text-white">{group.name}</h2>
              <p class="mt-1 text-sm text-zinc-400">{group.slug} · {group.role ?? "member"} · {group.source}</p>
            </div>
            <a href={scopedGroupHref(group.id)} class="secondary-action">{copy.details}</a>
          </div>
          {group.description && <p class="mt-3 text-sm leading-6 text-zinc-300">{group.description}</p>}
        </article>
      ))}
      {groups.length === 0 && <p class="admin-empty" role="status">{copy.empty}</p>}
    </section>
  </section>
</BaseLayout>
<script>
  const csrfInput = document.querySelector<HTMLInputElement>("#csrf-token");
  if (csrfInput) csrfInput.value = sessionStorage.getItem("orgbrain_csrf") ?? "";
</script>
