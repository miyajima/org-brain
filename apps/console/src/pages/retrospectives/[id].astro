---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { dashboardPageParams } from "../../lib/dashboard-page";
import { knowledgeLoopCopy, knowledgeLoopError, knowledgeLoopStatus } from "../../lib/knowledge-loop-locale";
const { tenantId, lang } = dashboardPageParams(Astro.url, Astro.request.headers.get("cookie"));
const t = knowledgeLoopCopy(lang);
const id = String(Astro.params.id ?? "");
const cookie = Astro.request.headers.get("cookie") ?? "";
const api = (path: string, init: RequestInit = {}) => fetch(new URL(path, Astro.url), { ...init, headers: { cookie, ...(init.headers ?? {}) } });
let error = "";
const capabilities = await api(`/api/v1/capabilities?tenant_id=${encodeURIComponent(tenantId)}`);
const capabilityPayload: any = await capabilities.json().catch(() => null);
const writable = capabilities.ok && capabilityPayload?.data?.retrospective?.writable === true;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const response = await api(`/api/v1/retrospectives/${encodeURIComponent(id)}/items/${encodeURIComponent(String(form.get("item_id")))}/response`, {
    method: "PUT", headers: { "content-type": "application/json", "x-csrf-token": String(form.get("csrf_token") ?? "") },
    body: JSON.stringify({ tenant_id: tenantId, decision: String(form.get("decision")), note: String(form.get("note") ?? "").trim() || null })
  });
  const payload: any = await response.json().catch(() => null);
  if (response.ok) return Astro.redirect(`/retrospectives/${encodeURIComponent(id)}?tenant_id=${encodeURIComponent(tenantId)}&lang=${lang}&item=${encodeURIComponent(String(form.get("next_index") ?? "0"))}`, 303);
  error = knowledgeLoopError(lang, payload?.error?.code, payload?.error?.message ?? "Response could not be saved");
}
const response = await api(`/api/v1/retrospectives/${encodeURIComponent(id)}?tenant_id=${encodeURIComponent(tenantId)}`);
const payload: any = await response.json().catch(() => null);
const session = payload?.data;
if (!response.ok && !error) error = payload?.error?.message ?? "Retrospective could not be loaded";
const requestedIndex = Number.parseInt(Astro.url.searchParams.get("item") ?? "", 10);
const firstUnanswered = session?.items?.findIndex((item: any) => !item.response) ?? 0;
const index = Number.isInteger(requestedIndex) && requestedIndex >= 0 && requestedIndex < (session?.items?.length ?? 0) ? requestedIndex : Math.max(0, firstUnanswered);
const item = session?.items?.[index];
const evidence = (value: unknown) => {
  const raw = typeof value === "string" ? value : value && typeof value === "object" && typeof (value as any).url === "string" ? (value as any).url : String(value ?? "");
  try { const url = new URL(raw); return { label: raw, href: ["http:", "https:"].includes(url.protocol) ? raw : null }; } catch { return { label: raw, href: null }; }
};
---
<BaseLayout title={session?.title ?? t.retroTitle} lang={lang} wide>
  <section class="space-y-5"><header class="rounded-[22px] border border-white/10 bg-white/[0.04] p-6"><a class="text-sm text-zinc-400" href={`/retrospectives?tenant_id=${encodeURIComponent(tenantId)}&lang=${lang}`}>← {t.history}</a><div class="mt-3 flex flex-wrap items-end justify-between gap-4"><div><p class="surface-label">RETROSPECTIVE</p><h1 class="mt-1 text-3xl font-semibold">{session?.title ?? t.retroTitle}</h1><p class="surface-muted mt-2">{t.retroLead}</p></div><div class="text-right"><span class="rounded-full bg-white/8 px-3 py-1 text-sm">{knowledgeLoopStatus(lang, session?.status ?? "open")}</span><p class="mt-2 text-xs text-zinc-500">{t.answered} {session?.progress?.received_responses ?? 0} / {session?.progress?.eligible_responses ?? 0}</p></div></div></header>
    {error && <p class="rounded-xl border border-rose-400/25 bg-rose-400/10 p-3 text-rose-100">{error}</p>}
    {session?.viewer?.can_close && <div class="flex justify-end"><a class="button-secondary" href={`/retrospectives/${encodeURIComponent(id)}/admin?tenant_id=${encodeURIComponent(tenantId)}&lang=${lang}`}>{t.adminReview}</a></div>}
    {item ? <article class="rounded-[22px] border border-white/8 bg-zinc-950/55 p-5"><p class="text-xs text-zinc-500">{index + 1} / {session.items.length}</p><h2 class="mt-2 text-xl font-semibold">{item.title}</h2><p class="mt-4 text-lg leading-8 text-zinc-100">{item.statement}</p><div class="mt-4 rounded-xl bg-white/[0.035] p-4"><p class="text-xs font-medium text-zinc-500">{t.reason}</p><p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-zinc-300">{item.rationale || "—"}</p></div>
      {item.parent_decision_id && <a class="mt-3 inline-block text-sm" href={`/decisions/${encodeURIComponent(item.parent_decision_id)}?tenant_id=${encodeURIComponent(tenantId)}&lang=${lang}`}>Decision ↗</a>}
      {item.evidence?.length > 0 && <ul class="mt-3 space-y-1 text-sm">{item.evidence.map((entry: unknown) => { const resolved = evidence(entry); return <li>{resolved.href ? <a href={resolved.href} target="_blank" rel="noreferrer">{resolved.label} ↗</a> : <span class="text-zinc-400">{resolved.label}</span>}</li>; })}</ul>}
      {session.status === "open" && writable ? <form method="post" class="mt-5 grid gap-3"><input type="hidden" name="csrf_token" class="retro-detail-csrf"/><input type="hidden" name="item_id" value={item.id}/><input type="hidden" name="next_index" value={Math.min(index + 1, session.items.length - 1)}/><fieldset><legend class="field-label">{t.retroTitle}</legend><div class="mt-2 flex flex-wrap gap-2">{[["adopt",t.adopt],["do_not_adopt",t.reject],["defer",t.defer]].map(([value,label]) => <label class="cursor-pointer rounded-xl border border-white/10 px-4 py-3"><input type="radio" name="decision" value={value} checked={item.response?.decision === value} required/> <span class="ml-2">{label}</span></label>)}</div></fieldset><label><span class="field-label">Note</span><input name="note" value={item.response?.note ?? ""}/></label><div><button type="submit">{t.saveDecision}</button></div></form> : <p class="mt-5 text-sm text-zinc-400">{session.status === "open" ? t.readOnly : knowledgeLoopStatus(lang, "completed")}</p>}
      <nav class="mt-5 flex justify-between"><a class:list={["button-secondary", index === 0 && "pointer-events-none opacity-40"]} href={`?tenant_id=${encodeURIComponent(tenantId)}&lang=${lang}&item=${Math.max(0, index - 1)}`}>{t.back}</a><a class:list={["button-secondary", index >= session.items.length - 1 && "pointer-events-none opacity-40"]} href={`?tenant_id=${encodeURIComponent(tenantId)}&lang=${lang}&item=${Math.min(session.items.length - 1, index + 1)}`}>{t.next}</a></nav>
    </article> : <p class="surface-muted">0</p>}
  </section>
</BaseLayout>
<script>document.querySelectorAll<HTMLInputElement>(".retro-detail-csrf").forEach((input) => { input.value = sessionStorage.getItem("orgbrain_csrf") ?? ""; });</script>
