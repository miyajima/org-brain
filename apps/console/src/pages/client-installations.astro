---
import BaseLayout from "../layouts/BaseLayout.astro";
import { dashboardPageParams } from "../lib/dashboard-page";

Astro.response.headers.set("Cache-Control", "no-store");

const { tenantId, lang } = dashboardPageParams(Astro.url, Astro.request.headers.get("cookie"));
const copy = {
  en: { title: "Client installations", body: "Manage unattended hook credentials for Codex, Claude Code, and Cursor by machine and client. Interactive OAuth sessions remain managed by Cloudflare Access and each client.", revoked: "Client installation revoked.", revokeError: "Client installation could not be revoked.", pending: "Pending client installation created.", createError: "Client installation could not be created", oneTime: "This enrollment code is shown only once", expires: "Expires", secretNote: "Store it securely and separately from the service-token secret.", client: "Client", device: "Device label", devicePlaceholder: "Work Mac", create: "Create enrollment", created: "Created", lastUsed: "Last used", never: "Never used", revoke: "Revoke", empty: "No client installations yet." },
  ja: { title: "クライアント導入", body: "Codex、Claude Code、Cursorの無人hook credentialをマシン・クライアント単位で管理します。対話型OAuth sessionはCloudflare Accessと各クライアントが管理します。", revoked: "クライアント導入を無効化しました。", revokeError: "クライアント導入を無効化できませんでした。", pending: "保留中のクライアント導入を作成しました。", createError: "クライアント導入を作成できませんでした", oneTime: "登録コードは今回だけ表示されます", expires: "有効期限", secretNote: "service tokenのsecretとは分けて安全に保管してください。", client: "クライアント", device: "端末名", devicePlaceholder: "業務用Mac", create: "登録を作成", created: "作成", lastUsed: "最終利用", never: "未使用", revoke: "無効化", empty: "クライアント導入はまだありません。" },
  zh: { title: "客户端安装", body: "按设备和客户端管理 Codex、Claude Code 与 Cursor 的无人值守 hook 凭据。交互式 OAuth 会话仍由 Cloudflare Access 和各客户端管理。", revoked: "已撤销客户端安装。", revokeError: "无法撤销客户端安装。", pending: "已创建待处理的客户端安装。", createError: "无法创建客户端安装", oneTime: "此注册码仅显示一次", expires: "有效期至", secretNote: "请与 service token 密钥分开安全保存。", client: "客户端", device: "设备名称", devicePlaceholder: "工作 Mac", create: "创建注册", created: "创建于", lastUsed: "最后使用", never: "从未使用", revoke: "撤销", empty: "尚无客户端安装。" }
}[lang];
const cookie = Astro.request.headers.get("cookie") ?? "";
const accessJwt = Astro.request.headers.get("cf-access-jwt-assertion")?.trim() || "";
const api = async (path: string, init: RequestInit = {}) => {
  const headers = new Headers(init.headers);
  if (accessJwt) headers.set("cf-access-jwt-assertion", accessJwt);
  headers.set("cookie", cookie);
  return fetch(new URL(path, Astro.url), {
    ...init,
    headers
  });
};

let message = "";
let error = "";
let enrollment: { code: string; expiresAt: number } | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "create");
  const csrf = String(form.get("csrf_token") ?? "");
  if (action === "revoke") {
    const id = String(form.get("installation_id") ?? "");
    const response = await api(
      `/api/v1/mcp-client-installations/${encodeURIComponent(id)}?tenant_id=${encodeURIComponent(tenantId)}`,
      { method: "DELETE", headers: { "x-csrf-token": csrf } }
    );
    if (response.ok) message = copy.revoked;
    else error = copy.revokeError;
  } else {
    const response = await api("/api/v1/mcp-client-installations", {
      method: "POST",
      headers: { "content-type": "application/json", "x-csrf-token": csrf },
      body: JSON.stringify({
        tenant_id: tenantId,
        client_type: String(form.get("client_type") ?? ""),
        device_label: String(form.get("device_label") ?? "")
      })
    });
    const payload: any = await response.json().catch(() => null);
    if (response.ok && payload?.data?.enrollment_code) {
      enrollment = {
        code: payload.data.enrollment_code,
        expiresAt: Number(payload.data.enrollment_expires_at)
      };
      message = copy.pending;
    } else {
      const errorCode = typeof payload?.error?.code === "string" ? payload.error.code : null;
      const errorMessage = typeof payload?.error?.message === "string" ? payload.error.message : null;
      error = errorMessage ??
        `${copy.createError} (HTTP ${response.status}${errorCode ? `, ${errorCode}` : ""}).`;
    }
  }
}

const response = await api(
  `/api/v1/mcp-client-installations?tenant_id=${encodeURIComponent(tenantId)}`
);
const payload: any = await response.json().catch(() => null);
const installations: any[] = payload?.data?.installations ?? [];
const formatDate = (value: unknown) =>
  typeof value === "number" && Number.isFinite(value)
    ? new Date(value).toLocaleString(lang === "ja" ? "ja-JP" : lang === "zh" ? "zh-CN" : "en-US")
    : copy.never;
---
<BaseLayout title={copy.title} lang={lang}>
  <section class="admin-page">
    <header class="admin-page-header">
      <p class="surface-label">{tenantId}</p>
      <h1>{copy.title}</h1>
      <p>{copy.body}</p>
    </header>

    {message && <p class="admin-notice admin-notice-success" role="status">{message}</p>}
    {error && <p class="admin-notice admin-notice-error" role="alert">{error}</p>}

    {enrollment && (
      <aside class="rounded-[20px] border border-amber-300/30 bg-amber-300/[0.08] p-5">
        <p class="font-semibold text-amber-100">{copy.oneTime}</p>
        <code class="mt-3 block break-all rounded-xl bg-black/40 p-3 text-sm">{enrollment.code}</code>
        <p class="mt-2 text-xs text-amber-100/70">
          {copy.expires}: {formatDate(enrollment.expiresAt)}。{copy.secretNote}
        </p>
      </aside>
    )}

    <form method="post" class="grid gap-4 rounded-[22px] border border-white/8 bg-zinc-950/50 p-5 md:grid-cols-3">
      <input type="hidden" name="csrf_token" class="csrf-token" />
      <input type="hidden" name="action" value="create" />
      <label>
        <span class="field-label">{copy.client}</span>
        <select name="client_type" required>
          <option value="codex">Codex</option>
          <option value="claude">Claude Code</option>
          <option value="cursor">Cursor</option>
        </select>
      </label>
      <label class="md:col-span-2">
        <span class="field-label">{copy.device}</span>
        <input name="device_label" maxlength="80" placeholder={copy.devicePlaceholder} required />
      </label>
      <div class="md:col-span-3"><button type="submit">{copy.create}</button></div>
    </form>

    <div class="grid gap-3">
      {installations.map((installation) => (
        <article class="grid gap-3 rounded-[18px] border border-white/8 bg-white/[0.035] p-4 md:grid-cols-[1fr_auto] md:items-center">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <strong>{installation.device_label}</strong>
              <span class="rounded-full border border-white/10 px-2 py-0.5 text-xs">{installation.client_type}</span>
              <span class="rounded-full border border-white/10 px-2 py-0.5 text-xs">{installation.status}</span>
            </div>
            <p class="mt-2 text-xs text-zinc-500">
              {copy.created} {formatDate(installation.created_at)} · {copy.lastUsed} {formatDate(installation.last_used_at)}
            </p>
          </div>
          {installation.status !== "revoked" && (
            <form method="post">
              <input type="hidden" name="csrf_token" class="csrf-token" />
              <input type="hidden" name="action" value="revoke" />
              <input type="hidden" name="installation_id" value={installation.id} />
              <button type="submit">{copy.revoke}</button>
            </form>
          )}
        </article>
      ))}
      {installations.length === 0 && <p class="admin-empty" role="status">{copy.empty}</p>}
    </div>
  </section>
</BaseLayout>
<script>
  document.querySelectorAll<HTMLInputElement>(".csrf-token").forEach((input) => {
    input.value = sessionStorage.getItem("orgbrain_csrf") ?? "";
  });
</script>
