  }>;
  rationales: Array<{
    id: string;
    decision_type: string;
    conclusion: string;
    reason_summary: string;
    status: string;
    confirmation_state: string;
    confidence_score: number | null;
    created_at: number;
    confirmed_at: number | null;
    evidence: Array<{
      id: string;
      evidence_type: string;
      evidence_ref: string;
      relation: string;
      note: string | null;
      weight_score: number | null;
      content_hash: string | null;
