              </div>

              <div class="grid gap-3 sm:grid-cols-4">
                <div class="surface-soft-card !rounded-[22px] !p-4"><dt class="surface-label">References</dt><dd class="mt-2 text-lg font-semibold text-white">{memoryDetail?.memory?.reference_count ?? detail.reference_count}</dd></div>
                <div class="surface-soft-card !rounded-[22px] !p-4"><dt class="surface-label">Used rate</dt><dd class="mt-2 text-lg font-semibold text-white">{memoryDetail?.memory && memoryDetail.memory.reference_count ? `${Math.round((memoryDetail.memory.used_count / memoryDetail.memory.reference_count) * 100)}%` : detail.reference_count ? `${Math.round((detail.used_count / detail.reference_count) * 100)}%` : "未計測"}</dd></div>
                <div class="surface-soft-card !rounded-[22px] !p-4"><dt class="surface-label">Consumers</dt><dd class="mt-2 text-lg font-semibold text-white">{memoryDetail?.memory?.consumer_count ?? detail.consumer_count}</dd></div>
