  privacy?: { raw_transcript_persisted?: boolean; reasoning_persisted?: boolean; absolute_path_persisted?: boolean; credential_value_persisted?: boolean };
  insufficiency_reason?: string;
};
type QualityRunList = { items: QualityRun[]; meta: { returned_count: number } };
type QualityRunDetail = {
  run: QualityRun;
  dimensions: Array<{ axis: string; cohort: string; numerator: number; denominator: number; point_estimate: number | null; wilson_lower: number | null; hard_violation_count: number }>;
  cases: Array<{ id?: string; case_hash: string; project_hash?: string | null; split?: string; lesson_type?: string | null; capture_route?: string; expected_route?: string; actual_route: string; reason_codes: string[]; hard_violation_count: number; parity_mismatch: boolean; memory_id?: string | null; summary?: string | null }>;
};

type MemorySearchResult = {
  kind: "memory" | "doc";
  id: string;
  summary: string | null;
  content_preview: string;
  score: number | null;
  source: string;
  created_at: number;
  memory_kind?: MemoryKind;
  lifecycle_state?: "active" | "suppressed" | "consolidated" | "promoted";
  current_version?: number;
};

type MemoryProfileItem = {
  id: string;
  project_id: string | null;
  summary: string;
  content_preview: string;
  source: string;
  created_at: number;
  tags: string[];
  memory_kind: MemoryKind;
  lifecycle_state: "active" | "suppressed" | "consolidated" | "promoted";
  current_version: number;
  last_accessed_at: number | null;
  confidence_score: number | null;
  utility_score: number | null;
};

type SearchResponse = {
  tenant_id: string;
  project_id: string | null;
  q: string;
  rewrite_query: boolean;
  search_mode: "memories" | "hybrid";
  include_history: boolean;
  results: MemorySearchResult[];
  meta: {
    search_strategy: string;
    matched_count: number;
    returned_count: number;
    fallback_used: boolean;
    variant_count: number;
  };
};

type ProfileResponse = {
  tenant_id: string;
  project_id: string | null;
  durable: MemoryProfileItem[];
  recent: MemoryProfileItem[];
  search_results: MemorySearchResult[];
  meta: {
    durable_count: number;
    recent_count: number;
