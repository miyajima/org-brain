                    <label><span class="surface-label">Project</span><input name="project_id" value={memoryDetail?.memory?.project_id ?? detail.project_id ?? ""} /></label>
                    <label><span class="surface-label">Tags (comma separated)</span><input name="tags" value={(memoryDetail?.memory?.tags ?? detail.tags).join(", ")} /></label>
                    <label><span class="surface-label">Content</span><textarea name="content" rows="7">{memoryDetail?.memory?.content ?? detail.content}</textarea></label>
                    <button type="submit" data-memory-save>Save changes</button>
                    <p class="text-xs leading-6 text-zinc-500" data-memory-edit-status>本人またはtenant_adminが編集できます。</p>
                  </form>
                </section>
              )}

              {detail.kind === "memory" && (
                <section class="surface-soft-card !rounded-[24px] !p-4">
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <div>
