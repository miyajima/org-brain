                            <h3 class="text-xl font-semibold tracking-[-0.03em] text-white">{memoryCardCopy(item.summary, item.content).title}</h3>
                            {memoryCardCopy(item.summary, item.content).context && <p class="memory-card-context">{memoryCardCopy(item.summary, item.content).context}</p>}
