      attestation_ref: string | null;
    }>;
  }>;
};

type ApiOk<T> = { ok: true; data: T };
type ApiErr = { ok: false; error?: { code?: string; message?: string } };
type ApiResponse<T> = ApiOk<T> | ApiErr;

type DetailRecord = {
  id: string;
  kind: "memory" | "doc";
  title: string;
  summary: string;
  preview: string;
  source: string;
  project_id: string | null;
  external_key: string | null;
  created_at: number;
  tags: string[];
  score: number | null;
  content: string;
  memory_kind: MemoryKind;
  lifecycle_state: "active" | "suppressed" | "consolidated" | "promoted";
  current_version: number;
  last_accessed_at: number | null;
  confidence_score: number | null;
  utility_score: number | null;
  owner_principal: string | null;
  created_by_principal: string | null;
  deleted_at: number | null;
  reference_count: number;
  used_count: number;
  consumer_count: number;
  net_saved_tokens: number;
  injected_tokens: number;
};

type AnalyticsSummary = {
  summary: {
    reference_count: number;
    used_count: number;
    net_saved_tokens: number;
    injected_tokens: number;
  };
  rankings: {
    memories: Array<{ id: string; label: string; reference_count: number }>;
    owners: Array<{ id: string; label: string; reference_count: number }>;
  };
};

const url = Astro.url;
const params = url.searchParams;
const requestedLocale = params.get("lang");
const locale: "en" | "ja" | "zh" = requestedLocale === "ja" || requestedLocale === "zh" ? requestedLocale : "en";
const explorerCopy = {
  en: { title: "Memory Explorer", eyebrow: "Memory workspace", map: "Knowledge connections", fallbackTitle: "The accessible list is active", fallbackBody: "3D rendering is unavailable in this environment. The same filtered memories remain available here.", errorTitle: "Some memory information is unavailable", search: "Search", profile: "Profile", maintenance: "Maintenance", quality: "Quality", mine: "My memories", org: "Organization memories", active: "Active", review: "Needs review", trash: "Trash", scope: "Memory scope", lifecycle: "Memory lifecycle" },
  ja: { title: "メモリエクスプローラー", eyebrow: "メモリワークスペース", map: "知識のつながり", fallbackTitle: "検索・一覧表示に切り替えました", fallbackBody: "この環境では3D描画を利用できません。同じ条件のメモリをこの一覧で確認できます。", errorTitle: "一部のメモリ情報を取得できません", search: "検索", profile: "プロファイル", maintenance: "メンテナンス", quality: "品質", mine: "自分のメモリ", org: "組織のメモリ", active: "有効", review: "要確認", trash: "ゴミ箱", scope: "メモリの範囲", lifecycle: "メモリの状態" },
  zh: { title: "记忆浏览器", eyebrow: "记忆工作区", map: "知识关联", fallbackTitle: "已切换到搜索与列表", fallbackBody: "此环境无法使用3D渲染，仍可在此查看相同筛选条件下的记忆。", errorTitle: "部分记忆信息不可用", search: "搜索", profile: "配置", maintenance: "维护", quality: "质量", mine: "我的记忆", org: "组织记忆", active: "有效", review: "需要检查", trash: "回收站", scope: "记忆范围", lifecycle: "记忆状态" }
}[locale];
const insightsMode = await resolveRequestInsightsUiMode(Astro.locals, processInsightsUiModeFallback());
const insightsRoutesEnabled = insightsUiBehavior(insightsMode).enableInsightsRoutes;
const decisionConsoleMode = await resolveRequestDecisionConsoleMode(Astro.locals, processDecisionConsoleModeFallback());
const decisionConsoleEnabled = decisionConsoleBehavior(decisionConsoleMode).enabled;
const qualityUiMode = await resolveMemoryQualityUiMode(Astro.locals);
const qualityViewEnabled = qualityUiMode !== "off";

const tenantId = params.get("tenant_id")?.trim() || "default";
const projectId = params.get("project_id")?.trim() || "";
const scope = params.get("scope") === "org" ? "org" : "mine";
const lifecycle = ["active", "review", "trash", "all"].includes(params.get("lifecycle") ?? "")
  ? (params.get("lifecycle") as "active" | "review" | "trash" | "all")
  : "active";
const ownerPrincipal = params.get("owner_principal")?.trim() || "";
const createdByPrincipal = params.get("created_by_principal")?.trim() || "";
const sort = ["created", "updated", "usage"].includes(params.get("sort") ?? "")
  ? (params.get("sort") as "created" | "updated" | "usage")
  : "created";
const dateValue = (raw: string | null, endOfDay = false): number | null => {
  if (!raw) return null;
  const numericValue = Number(raw);
  if (Number.isFinite(numericValue)) return numericValue;
  const parsed = Date.parse(`${raw}T${endOfDay ? "23:59:59.999" : "00:00:00"}+09:00`);
  return Number.isFinite(parsed) ? parsed : null;
};
const fromTimestamp = dateValue(params.get("from_date")) ?? dateValue(params.get("from"));
const toTimestamp = dateValue(params.get("to_date"), true) ?? dateValue(params.get("to"), true);
const query = params.get("q")?.trim() || "";
const selectedId = params.get("selected")?.trim() || "";
const mapFallback = params.get("map_fallback") === "1";
const view = ["search", "profile", "maintenance", ...(qualityViewEnabled ? ["quality"] : [])].includes(params.get("view") ?? "")
  ? (params.get("view") as "search" | "profile" | "maintenance" | "quality")
  : "search";
const rewriteQuery = params.get("rewrite_query") !== "0";
const searchMode = params.get("search_mode") === "memories" ? "memories" : "hybrid";
const includeHistory = params.get("include_history") !== "0";
const entityId = params.get("entity_id")?.trim() || "";
const entityRole = params.get("entity_role")?.trim() || "";
const decisionType = params.get("decision_type")?.trim() || "";
const decisionStatus = params.get("decision_status")?.trim() || "";
const confirmationState = params.get("confirmation_state")?.trim() || "";
const reasonText = params.get("reason_text")?.trim() || "";
const pageSize = Math.min(50, Math.max(10, Number.parseInt(params.get("page_size") ?? "20", 10) || 20));
const page = Math.max(1, Number.parseInt(params.get("page") ?? "1", 10) || 1);
const offset = (page - 1) * pageSize;
const qualityRunId = params.get("run_id")?.trim() || "";
const qualityRoute = params.get("route")?.trim() || "";
const qualityLessonType = params.get("lesson_type")?.trim() || "";
const qualityActualRoute = params.get("actual_route")?.trim() || "";
const qualityIssue = params.get("issue")?.trim() || "";
const qualityProjectHash = params.get("project_hash")?.trim() || "";
const qualityParityMismatch = params.get("parity_mismatch")?.trim() || "";

function formatDate(timestamp: number): string {
  return new Intl.DateTimeFormat("ja-JP", {
    timeZone: "Asia/Tokyo",
    dateStyle: "medium",
    timeStyle: "short"
  }).format(new Date(timestamp));
}

function trimText(value: string | null | undefined, limit = 180): string {
  const normalized = String(value ?? "").replace(/\s+/g, " ").trim();
  if (!normalized) return "";
  if (normalized.length <= limit) return normalized;
  return `${normalized.slice(0, Math.max(0, limit - 1))}...`;
}

function memoryCardCopy(summary: string | null | undefined, content: string | null | undefined) {
  return memoryDisplayCopy(summary, content);
}

function makeHref(overrides: Record<string, string | null | undefined>): string {
  const next = new URLSearchParams(params);
  for (const [key, value] of Object.entries(overrides)) {
    if (value === null || value === undefined || value === "") {
      next.delete(key);
    } else {
      next.set(key, value);
    }
  }
  const queryString = next.toString();
  return queryString ? `${url.pathname}?${queryString}` : url.pathname;
}

async function fetchApi<T>(path: string, init?: RequestInit): Promise<ApiResponse<T> | null> {
  const response = await fetch(new URL(path, url), init);
  const payload = (await response.json().catch(() => null)) as ApiResponse<T> | null;
  if (!response.ok) {
    return {
      ok: false,
      error: payload && "error" in payload ? payload.error : { code: "http_error", message: `HTTP ${response.status}` }
    };
  }
  if (!payload || payload.ok === false) {
    return payload ?? { ok: false, error: { code: "parse_error", message: "Invalid JSON response" } };
  }
  return payload;
}

function buildDetailRecord(
  selected: string,
  corpusItems: MemoryRow[],
  searchResults: MemorySearchResult[],
  profileItems: MemoryProfileItem[]
): DetailRecord | null {
  const row = corpusItems.find((item) => item.id === selected);
  if (row) {
    return {
      id: row.id,
      kind: "memory",
      title: memoryCardCopy(row.summary, row.content).title,
      summary: row.summary || "",
      preview: trimText(row.content, 320),
      source: row.source,
      project_id: row.project_id,
      external_key: row.external_key,
      created_at: row.created_at,
      tags: row.tags ?? [],
      score: searchResults.find((item) => item.id === selected)?.score ?? null,
      content: row.content,
      memory_kind: row.kind,
      lifecycle_state: row.lifecycle_state,
      current_version: row.current_version,
      last_accessed_at: row.last_accessed_at,
      confidence_score: row.confidence_score,
      utility_score: row.utility_score,
      owner_principal: row.owner_principal ?? null,
      created_by_principal: row.created_by_principal ?? null,
      deleted_at: row.deleted_at ?? null,
      reference_count: row.reference_count ?? 0,
      used_count: row.used_count ?? 0,
      consumer_count: row.consumer_count ?? 0,
      net_saved_tokens: row.net_saved_tokens ?? 0,
      injected_tokens: row.injected_tokens ?? 0
    };
  }

  const searchItem = searchResults.find((item) => item.id === selected);
  if (searchItem) {
    const profileItem = profileItems.find((item) => item.id === selected);
    return {
      id: searchItem.id,
      kind: searchItem.kind,
      title: memoryCardCopy(searchItem.summary, searchItem.content_preview).title,
      summary: searchItem.summary || "",
      preview: trimText(searchItem.content_preview, 320),
      source: searchItem.source,
      project_id: profileItem?.project_id ?? null,
      external_key: null,
      created_at: searchItem.created_at,
      tags: profileItem?.tags ?? [],
      score: searchItem.score,
      content: searchItem.content_preview,
      memory_kind: profileItem?.memory_kind ?? searchItem.memory_kind ?? "episodic",
      lifecycle_state: profileItem?.lifecycle_state ?? searchItem.lifecycle_state ?? "active",
      current_version: profileItem?.current_version ?? searchItem.current_version ?? 1,
      last_accessed_at: profileItem?.last_accessed_at ?? null,
      confidence_score: profileItem?.confidence_score ?? null,
      utility_score: profileItem?.utility_score ?? null
      , owner_principal: null,
      created_by_principal: null,
      deleted_at: null,
      reference_count: 0,
      used_count: 0,
      consumer_count: 0,
      net_saved_tokens: 0,
      injected_tokens: 0
    };
  }

  const profileItem = profileItems.find((item) => item.id === selected);
  if (profileItem) {
    return {
      id: profileItem.id,
      kind: "memory",
      title: memoryCardCopy(profileItem.summary, profileItem.content_preview).title,
      summary: profileItem.summary,
      preview: trimText(profileItem.content_preview, 320),
      source: profileItem.source,
      project_id: profileItem.project_id,
      external_key: null,
      created_at: profileItem.created_at,
      tags: profileItem.tags,
      score: null,
      content: profileItem.content_preview,
      memory_kind: profileItem.memory_kind,
      lifecycle_state: profileItem.lifecycle_state,
      current_version: profileItem.current_version,
      last_accessed_at: profileItem.last_accessed_at,
      confidence_score: profileItem.confidence_score,
      utility_score: profileItem.utility_score
      , owner_principal: null,
      created_by_principal: null,
      deleted_at: null,
      reference_count: 0,
      used_count: 0,
      consumer_count: 0,
      net_saved_tokens: 0,
      injected_tokens: 0
    };
  }

  return null;
}

function buildDetailRecordFromMemoryDetail(payload: MemoryDetailResponse | null): DetailRecord | null {
  const memory = payload?.memory;
  if (!memory) return null;
  return {
    id: memory.id || payload?.memory_id || "",
    kind: "memory",
    title: memoryCardCopy(memory.summary, memory.content).title,
    summary: memory.summary || "",
    preview: trimText(memory.content, 320),
    source: memory.source || "memory",
    project_id: memory.project_id,
    external_key: memory.external_key,
    created_at: memory.created_at,
    tags: memory.tags ?? [],
    score: null,
    content: memory.content,
    memory_kind: memory.kind,
    lifecycle_state: memory.lifecycle_state as DetailRecord["lifecycle_state"],
    current_version: memory.current_version,
    last_accessed_at: memory.last_accessed_at,
    confidence_score: memory.confidence_score,
    utility_score: memory.utility_score,
    owner_principal: memory.owner_principal ?? null,
    created_by_principal: memory.created_by_principal ?? null,
    deleted_at: memory.deleted_at ?? null,
    reference_count: memory.reference_count ?? 0,
    used_count: memory.used_count ?? 0,
    consumer_count: memory.consumer_count ?? 0,
    net_saved_tokens: memory.net_saved_tokens ?? 0,
    injected_tokens: memory.injected_tokens ?? 0
  };
}

function addSuggestion(counts: Map<string, number>, raw: string | null | undefined, weight = 1) {
  const normalized = String(raw ?? "").trim().toLowerCase();
  if (!normalized) return;
  if (normalized.length < 3) return;

  const blocked = new Set([
    "org-bus",
    "canonical-memory",
    "memory-digest",
    "compacted",
    "memory_measurement",
    "hook",
    "promoted",
    "maintenance",
    "memory",
    "none",
    "default"
  ]);

  if (blocked.has(normalized)) return;
  counts.set(normalized, (counts.get(normalized) ?? 0) + weight);
}

function extractSearchTerms(value: string | null | undefined): string[] {
  return (String(value ?? "").toLowerCase().match(/[a-z][a-z0-9-]{2,}/g) ?? []).slice(0, 8);
}

function rowCardClass(selected: boolean): string {
  return [
    "memory-list-row group relative min-w-0 overflow-hidden rounded-[18px] border px-4 py-3 transition duration-200",
    selected
      ? "border-sky-300/45 bg-sky-300/[0.08] ring-1 ring-sky-300/15"
      : "border-white/8 bg-white/[0.035] hover:border-sky-200/25 hover:bg-white/[0.055]"
  ].join(" ");
}

function tabClass(active: boolean): string {
  return [
    "inline-flex min-h-9 items-center justify-center rounded-[10px] border px-3 text-xs font-semibold transition duration-200",
    active
      ? "border-sky-300/40 bg-sky-300/15 text-sky-50"
      : "border-white/8 bg-white/[0.04] text-zinc-300 hover:border-white/18 hover:bg-white/[0.06] hover:text-white"
  ].join(" ");
}

const listPayload = await fetchApi<MemoryListPage>(
  `/api/v1/memories?tenant_id=${encodeURIComponent(tenantId)}&scope=${scope}&project_id=${encodeURIComponent(projectId)}&owner_principal=${encodeURIComponent(ownerPrincipal)}&created_by_principal=${encodeURIComponent(createdByPrincipal)}&lifecycle=${lifecycle}&include_trashed=1&from=${fromTimestamp ?? ""}&to=${toTimestamp ?? ""}&sort=${sort}&limit=${pageSize}&offset=${offset}&paginated=1`
);

const analyticsPayload = await fetchApi<AnalyticsSummary>(
  `/api/v1/dashboard/memory-analytics?tenant_id=${encodeURIComponent(tenantId)}&scope=${scope}&perspective=${scope === "mine" ? "spread" : "work"}&project_id=${encodeURIComponent(projectId)}&owner_principal=${encodeURIComponent(ownerPrincipal)}&from=${fromTimestamp ?? Date.now() - 30 * 24 * 60 * 60 * 1000}&to=${toTimestamp ?? Date.now()}`
);

const searchPayload =
  query.length > 0
    ? await fetchApi<SearchResponse>("/api/v1/memories/search", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          tenant_id: tenantId,
          project_id: projectId || null,
          q: query,
          limit: 12,
          rewrite_query: rewriteQuery,
          search_mode: searchMode,
          include_history: includeHistory,
          entity_id: entityId || undefined,
          entity_role: entityRole || undefined,
          decision_type: decisionType || undefined,
          decision_status: decisionStatus || undefined,
          confirmation_state: confirmationState || undefined,
          reason_text: reasonText || undefined
        })
      })
    : null;

const profilePayload = await fetchApi<ProfileResponse>("/api/v1/memories/profile", {
  method: "POST",
  headers: { "content-type": "application/json" },
  body: JSON.stringify({
    tenant_id: tenantId,
    project_id: projectId || null,
    limit_durable: 8,
    limit_recent: 8,
    rewrite_query: rewriteQuery,
    search_mode: searchMode
  })
});

const qualityRunsPayload = qualityViewEnabled
  ? await fetchApi<QualityRunList>(`/api/v1/memory-quality/runs?tenant_id=${encodeURIComponent(tenantId)}&limit=20`)
  : null;
const selectedQualityRunId = qualityRunId || (qualityRunsPayload?.ok ? qualityRunsPayload.data.items[0]?.id ?? "" : "");
const qualityRunPayload = qualityViewEnabled && selectedQualityRunId
  ? await fetchApi<QualityRunDetail>(`/api/v1/memory-quality/runs/${encodeURIComponent(selectedQualityRunId)}?tenant_id=${encodeURIComponent(tenantId)}&route=${encodeURIComponent(qualityRoute)}&lesson_type=${encodeURIComponent(qualityLessonType)}&actual_route=${encodeURIComponent(qualityActualRoute)}&issue=${encodeURIComponent(qualityIssue)}&project_hash=${encodeURIComponent(qualityProjectHash)}&parity_mismatch=${encodeURIComponent(qualityParityMismatch)}`)
  : null;
const qualityRuns = qualityRunsPayload?.ok ? qualityRunsPayload.data.items : [];
const qualityDetail = qualityRunPayload?.ok ? qualityRunPayload.data : null;

const listPage = listPayload?.ok ? listPayload.data : null;
const corpusItems = listPage?.items ?? [];
const searchResults = searchPayload?.ok ? searchPayload.data.results : [];
const profile = profilePayload?.ok ? profilePayload.data : null;
const durableRows = profile?.durable ?? [];
const recentRows = profile?.recent ?? [];
const maintenanceRows = corpusItems.filter((item) =>
  item.tags.some((tag) => ["canonical-memory", "memory-digest", "compacted"].includes(tag))
);
const maintenanceTagCounts = maintenanceRows.reduce<Record<string, number>>((acc, item) => {
  for (const tag of item.tags) {
    if (!["canonical-memory", "memory-digest", "compacted"].includes(tag)) continue;
    acc[tag] = (acc[tag] ?? 0) + 1;
  }
  return acc;
}, {});
const maintenanceProjectCounts = maintenanceRows.reduce<Record<string, number>>((acc, item) => {
  const project = item.project_id || "no-project";
  acc[project] = (acc[project] ?? 0) + 1;
  return acc;
}, {});
const maintenanceProjectRows = Object.entries(maintenanceProjectCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 4);
const recentHighlights = recentRows.slice(0, 3);
const searchLandingRows = (recentHighlights.length > 0 ? recentHighlights : durableRows.slice(0, 3)).slice(0, 3);
const searchLandingKind = recentHighlights.length > 0 ? "recent" : "durable";
const quickPickRows = (recentHighlights.length > 0 ? recentHighlights : durableRows.slice(0, 3)).slice(0, 3);

const suggestionCounts = new Map<string, number>();
for (const row of recentRows) {
  for (const tag of row.tags) addSuggestion(suggestionCounts, tag, 3);
  for (const term of extractSearchTerms(row.summary)) addSuggestion(suggestionCounts, term, 3);
}
for (const row of durableRows) {
  for (const tag of row.tags) addSuggestion(suggestionCounts, tag, 2);
  for (const term of extractSearchTerms(row.summary)) addSuggestion(suggestionCounts, term, 2);
}
for (const row of corpusItems.slice(0, 24)) {
  for (const tag of row.tags) addSuggestion(suggestionCounts, tag, 1);
  for (const term of extractSearchTerms(row.summary || row.content)) addSuggestion(suggestionCounts, term, 1);
}
for (const seed of ["policy", "diagnosis", "deploy", "maintenance", "command-result", "workaround"]) {
  addSuggestion(suggestionCounts, seed, 1);
}

const searchSuggestions = Array.from(suggestionCounts.entries())
  .sort((left, right) => right[1] - left[1])
  .map(([term]) => term)
  .slice(0, 8);

const datalistSuggestions = [
  ...new Set(
    [
      ...searchSuggestions,
      ...recentRows.map((item) => trimText(item.summary, 80)),
      ...durableRows.map((item) => trimText(item.summary, 80))
    ].filter(Boolean)
  )
].slice(0, 12);

const rowDetail = buildDetailRecord(selectedId, corpusItems, searchResults, [...durableRows, ...recentRows]);
const preloadedDetailPayload =
  selectedId && !rowDetail
    ? await fetchApi<MemoryDetailResponse>(`/api/v1/memories/${encodeURIComponent(selectedId)}/details?tenant_id=${encodeURIComponent(tenantId)}`)
    : null;
const detail = rowDetail ?? (preloadedDetailPayload?.ok ? buildDetailRecordFromMemoryDetail(preloadedDetailPayload.data) : null);
const detailPayload = detail?.kind === "memory"
  ? preloadedDetailPayload ?? await fetchApi<MemoryDetailResponse>(`/api/v1/memories/${encodeURIComponent(detail.id)}/details?tenant_id=${encodeURIComponent(tenantId)}`)
  : preloadedDetailPayload;
const memoryDetail = detailPayload?.ok ? detailPayload.data : null;
const accessPayload = decisionConsoleEnabled && detail?.kind === "memory"
  ? await fetchApi<{ policy: Record<string, unknown>; utilizing_agents: Array<Record<string, unknown>> }>(`/api/v1/access-policies/memory/${encodeURIComponent(detail.id)}?tenant_id=${encodeURIComponent(tenantId)}&project_id=${encodeURIComponent(detail.project_id ?? projectId)}`)
  : null;
const loadErrors = [...new Set([
  listPayload?.ok === false ? listPayload.error?.message ?? "Memory list could not be loaded" : null,
  searchPayload?.ok === false ? searchPayload.error?.message ?? "Memory search could not be loaded" : null,
  profilePayload?.ok === false ? profilePayload.error?.message ?? "Memory profile could not be loaded" : null,
  detailPayload?.ok === false ? detailPayload.error?.message ?? "Memory detail could not be loaded" : null
  , analyticsPayload?.ok === false ? analyticsPayload.error?.message ?? "Memory analytics could not be loaded" : null
  , qualityRunsPayload?.ok === false ? qualityRunsPayload.error?.message ?? "Quality runs could not be loaded" : null
  , qualityRunPayload?.ok === false ? qualityRunPayload.error?.message ?? "Quality run could not be loaded" : null
  , accessPayload?.ok === false ? accessPayload.error?.message ?? "Memory access policy could not be loaded" : null
].filter(Boolean) as string[])];

const prevPageHref = listPage?.meta.has_prev ? makeHref({ page: String(page - 1), selected: "" }) : null;
const nextPageHref = listPage?.meta.has_next ? makeHref({ page: String(page + 1), selected: "" }) : null;
const searchTabHref = makeHref({ view: "search", page: String(page) });
const profileTabHref = makeHref({ view: "profile", selected: "" });
const maintenanceTabHref = makeHref({ view: "maintenance", page: String(page), selected: "" });
const qualityTabHref = makeHref({ view: "quality", page: "1", selected: "" });
const activeTabHref = makeHref({ lifecycle: "active", page: "1", selected: "" });
const reviewTabHref = makeHref({ lifecycle: "review", page: "1", selected: "" });
const trashTabHref = makeHref({ lifecycle: "trash", page: "1", selected: "" });
const clearQueryHref = makeHref({ q: "", selected: "", page: "1" });
const constellationParams = new URLSearchParams({ tenant_id: tenantId });
if (projectId) constellationParams.set("project_id", projectId);
const requestedLang = params.get("lang");
if (requestedLang === "en" || requestedLang === "ja" || requestedLang === "zh") constellationParams.set("lang", requestedLang);
const constellationHref = `/memories/constellation?${constellationParams.toString()}`;
---
<BaseLayout title={explorerCopy.title} lang={locale} wide>
  {mapFallback && (
    <div class="intelligence-route-alert" role="status">
      <strong>{explorerCopy.fallbackTitle}</strong>
      <span>{explorerCopy.fallbackBody}</span>
    </div>
  )}
  <section class="memory-explorer space-y-4">
    <header class="memory-page-header">
      <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
        <div class="space-y-2">
          <p class="surface-label">{explorerCopy.eyebrow}</p>
          <h1 class="text-4xl font-semibold tracking-[-0.055em] text-white sm:text-5xl">{explorerCopy.title}</h1>
        </div>
        {insightsRoutesEnabled && <a class="memory-map-link" href={constellationHref}><span>{explorerCopy.map}</span><span aria-hidden="true">↗</span></a>}
      </div>
    </header>

    {loadErrors.length > 0 && <AdminStatePanel state="partial" title={explorerCopy.errorTitle} description={loadErrors.join(" · ")} />}

    <section class="memory-command-surface">
      <div class="memory-command-nav">
        <div class="flex flex-wrap gap-2">
          <a class={tabClass(view === "search")} href={searchTabHref}>{explorerCopy.search}</a>
          <a class={tabClass(view === "profile")} href={profileTabHref}>{explorerCopy.profile}</a>
          <a class={tabClass(view === "maintenance")} href={maintenanceTabHref}>{explorerCopy.maintenance}</a>
          {qualityViewEnabled && <a class={tabClass(view === "quality")} href={qualityTabHref}>{explorerCopy.quality} {qualityUiMode === "beta" ? "β" : ""}</a>}
        </div>
        <div class="flex flex-wrap gap-2" aria-label={explorerCopy.scope}>
          <a class={tabClass(scope === "mine")} href={makeHref({ scope: "mine", owner_principal: "", lifecycle: lifecycle === "trash" ? "active" : lifecycle, page: "1", selected: "" })}>{explorerCopy.mine}</a>
          <a class={tabClass(scope === "org")} href={makeHref({ scope: "org", page: "1", selected: "" })}>{explorerCopy.org}</a>
        </div>
        <div class="flex flex-wrap gap-2" aria-label={explorerCopy.lifecycle}>
          <a class={tabClass(lifecycle === "active")} href={activeTabHref}>{explorerCopy.active}</a>
          <a class={tabClass(lifecycle === "review")} href={reviewTabHref}>{explorerCopy.review}</a>
          <a class={tabClass(lifecycle === "trash")} href={trashTabHref}>{explorerCopy.trash}</a>
        </div>
      </div>

      <div class="memory-metrics" data-memory-metrics>
        <div class="memory-metric">
          <p class="surface-label">{query ? "検索結果" : "このビュー"}</p>
          <strong>{query && searchPayload?.ok ? searchPayload.data.meta.returned_count : listPage?.meta.total ?? 0}</strong>
          <span>{query ? "表示中の一致" : scope === "mine" ? "owner = 自分" : "閲覧可能な組織メモリ"}</span>
        </div>
        <div class="memory-metric">
          <p class="surface-label">参照</p>
          <strong>{analyticsPayload?.ok ? analyticsPayload.data.summary.reference_count : "—"}</strong>
          <span>期間内の参照イベント</span>
        </div>
        <div class="memory-metric">
          <p class="surface-label">最も参照</p>
          <strong class="memory-metric-label">{scope === "org" && analyticsPayload?.ok && analyticsPayload.data.rankings.memories[0] ? analyticsPayload.data.rankings.memories[0].label : "—"}</strong>
          <span>{scope === "org" && analyticsPayload?.ok && analyticsPayload.data.rankings.memories[0] ? `${analyticsPayload.data.rankings.memories[0].reference_count} refs` : "組織ビューで表示"}</span>
        </div>
        <div class="memory-metric">
          <p class="surface-label">純削減</p>
          <strong>{analyticsPayload?.ok ? analyticsPayload.data.summary.net_saved_tokens.toLocaleString() : "—"}</strong>
          <span>計測済みの純削減tokens</span>
        </div>
      </div>

      <details class="memory-search-panel" data-memory-search-panel>
        <summary>
          <span><strong>検索・フィルター</strong><small>{query ? `“${trimText(query, 34)}”` : `${projectId || "全プロジェクト"} · ${ownerPrincipal || (scope === "mine" ? "自分" : "全所有者")}`}</small></span>
          <span class="memory-search-chevron" aria-hidden="true"></span>
        </summary>
        <div class="memory-search-body">
        <form class="grid gap-4 xl:grid-cols-[minmax(0,1fr)_12rem]" method="get" action="/memories">
          <input type="hidden" name="view" value={view} />
          <input type="hidden" name="page" value="1" />
          <input type="hidden" name="scope" value={scope} />
          <input type="hidden" name="lifecycle" value={lifecycle} />
          <label class="relative block">
            <span class="surface-label">Search memories</span>
            <svg class="memory-search-icon pointer-events-none absolute h-4 w-4 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </svg>
            <input
              class="pl-11"
              type="search"
              name="q"
              value={query}
              list="memory-search-suggestions"
              placeholder="policy / diagnosis / deploy / maintenance"
            />
          </label>
          <button type="submit">Search memory</button>
        </form>
        <datalist id="memory-search-suggestions">
          {datalistSuggestions.map((term) => <option value={term} />)}
        </datalist>

        <div class="memory-popular-searches">
          <div class="flex flex-wrap items-center gap-2">
            <p class="surface-label mr-2">Popular searches</p>
            {searchSuggestions.map((term) => (
              <a
                class="inline-flex min-h-9 items-center rounded-full border border-white/10 bg-white/[0.04] px-3 text-sm font-medium text-zinc-200 transition duration-200 hover:-translate-y-0.5 hover:border-amber-300/30 hover:bg-amber-300/10 hover:text-white"
                href={makeHref({ q: term, selected: "", page: "1" })}
              >
                {term}
              </a>
            ))}
            {query && (
              <a class="inline-flex min-h-9 items-center rounded-full border border-white/10 bg-white/[0.03] px-3 text-sm text-zinc-300 transition duration-200 hover:border-white/20 hover:text-white" href={clearQueryHref}>
                Clear search
              </a>
            )}
          </div>
        </div>

        <details class="memory-advanced-panel">
          <summary>詳細条件</summary>
          <div class="memory-advanced-body">
          <form class="grid gap-3 md:grid-cols-2 xl:grid-cols-5" method="get" action="/memories">
            <input type="hidden" name="view" value={view} />
            <input type="hidden" name="q" value={query} />
            <input type="hidden" name="page" value="1" />
            <input type="hidden" name="scope" value={scope} />
            <input type="hidden" name="lifecycle" value={lifecycle} />
            <label>
              <span class="surface-label">Tenant</span>
              <input name="tenant_id" value={tenantId} />
            </label>
            <label>
              <span class="surface-label">Project</span>
              <input name="project_id" value={projectId} placeholder="optional project filter" />
            </label>
            <label>
              <span class="surface-label">Owner</span>
              <input name="owner_principal" value={ownerPrincipal} placeholder={scope === "mine" ? "自分" : "user:..."} disabled={scope === "mine"} />
            </label>
            <label>
              <span class="surface-label">Creator</span>
              <input name="created_by_principal" value={createdByPrincipal} placeholder="user / agent" />
            </label>
            <label>
              <span class="surface-label">Sort</span>
              <select name="sort">
                <option value="created" selected={sort === "created"}>新しい順</option>
                <option value="updated" selected={sort === "updated"}>更新順</option>
                <option value="usage" selected={sort === "usage"}>参照数順</option>
              </select>
            </label>
            <label>
              <span class="surface-label">From</span>
              <input type="date" name="from_date" value={fromTimestamp ? new Date(fromTimestamp).toISOString().slice(0, 10) : ""} />
            </label>
            <label>
              <span class="surface-label">To</span>
              <input type="date" name="to_date" value={toTimestamp ? new Date(toTimestamp).toISOString().slice(0, 10) : ""} />
            </label>
            <label>
              <span class="surface-label">Search mode</span>
              <select name="search_mode">
                <option value="hybrid" selected={searchMode === "hybrid"}>hybrid</option>
                <option value="memories" selected={searchMode === "memories"}>memories</option>
              </select>
            </label>
            <label>
              <span class="surface-label">Rewrite query</span>
              <select name="rewrite_query">
                <option value="1" selected={rewriteQuery}>on</option>
                <option value="0" selected={!rewriteQuery}>off</option>
              </select>
            </label>
            <label>
              <span class="surface-label">History context</span>
              <select name="include_history">
                <option value="1" selected={includeHistory}>on</option>
                <option value="0" selected={!includeHistory}>off</option>
              </select>
            </label>
            <label>
              <span class="surface-label">Page size</span>
              <select name="page_size">
                <option value="10" selected={pageSize === 10}>10</option>
                <option value="20" selected={pageSize === 20}>20</option>
                <option value="50" selected={pageSize === 50}>50</option>
              </select>
            </label>
            <label>
              <span class="surface-label">Rationale state</span>
              <select name="confirmation_state">
                <option value="" selected={confirmationState === ""}>any</option>
                <option value="user_confirmed" selected={confirmationState === "user_confirmed"}>confirmed</option>
                <option value="user_corrected" selected={confirmationState === "user_corrected"}>corrected</option>
                <option value="inferred_unconfirmed" selected={confirmationState === "inferred_unconfirmed"}>inferred</option>
              </select>
            </label>
            <label>
              <span class="surface-label">Decision type</span>
              <input name="decision_type" value={decisionType} placeholder="policy / diagnose" />
            </label>
            <label>
              <span class="surface-label">Entity ID</span>
              <input name="entity_id" value={entityId} placeholder="optional entity id" />
            </label>
            <label>
              <span class="surface-label">Reason text</span>
              <input name="reason_text" value={reasonText} placeholder="reason contains..." />
            </label>
            <input type="hidden" name="entity_role" value={entityRole} />
            <input type="hidden" name="decision_status" value={decisionStatus} />
            <button class="md:col-span-2 xl:col-span-5" type="submit">Apply filters</button>
          </form>

          <div class="memory-search-behavior">
            <strong>履歴コンテキスト: {includeHistory ? "ON" : "OFF"}</strong>
            <span>最近参照した内容を検索候補に含める設定です。検索語が空のときは「最近のメモリ」を表示します。</span>
          </div>
          </div>
        </details>
        </div>
      </details>
    </section>

    <div class="grid gap-4 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start xl:grid-cols-[minmax(0,1fr)_22rem]">
      <section class="space-y-5">
        <div class="card memory-results-card">
          {view === "quality" ? (
            <div class="space-y-5" data-quality-view data-readonly="true">
              <div class="flex flex-wrap items-end justify-between gap-4">
                <div><p class="surface-label">Read-only quality gate</p><h2 class="mt-2 text-3xl font-semibold tracking-[-0.04em] text-white">Ingestion quality runs</h2></div>
                <span class="surface-chip">{qualityDetail?.run.status ?? "no run"}</span>
              </div>
              <form method="get" action="/memories" class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
                <input type="hidden" name="view" value="quality" /><input type="hidden" name="tenant_id" value={tenantId} />
                <label><span class="surface-label">Run</span><select name="run_id">{qualityRuns.map((run) => <option value={run.id} selected={run.id === selectedQualityRunId}>{run.id} · {run.input_source}</option>)}</select></label>
                <label><span class="surface-label">Capture route</span><select name="route"><option value="">all</option>{["realtime_hook", "initial_import", "manual", "repair", "legacy"].map((value) => <option value={value} selected={qualityRoute === value}>{value}</option>)}</select></label>
                <label><span class="surface-label">Lesson type</span><select name="lesson_type"><option value="">all</option>{["success", "decision", "failure"].map((value) => <option value={value} selected={qualityLessonType === value}>{value}</option>)}</select></label>
                <label><span class="surface-label">Actual route</span><select name="actual_route"><option value="">all</option>{["active", "quarantine", "excluded"].map((value) => <option value={value} selected={qualityActualRoute === value}>{value}</option>)}</select></label>
                <label><span class="surface-label">Issue</span><input name="issue" value={qualityIssue} placeholder="reason code" /></label>
                <label><span class="surface-label">Project hash</span><input name="project_hash" value={qualityProjectHash} placeholder="hashed project id" /></label>
                <label><span class="surface-label">Parity</span><select name="parity_mismatch"><option value="">all</option><option value="1" selected={qualityParityMismatch === "1"}>mismatch only</option><option value="0" selected={qualityParityMismatch === "0"}>matching only</option></select></label>
                <button type="submit">Apply read-only filters</button>
              </form>
              {qualityDetail ? (
                <>
                  <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4" data-quality-run-summary>
                    <div class="surface-soft-card"><span class="surface-label">Sessions</span><strong class="mt-3 block text-3xl text-white">{qualityDetail.run.counts?.sessions ?? "—"}</strong></div>
                    <div class="surface-soft-card"><span class="surface-label">Projects</span><strong class="mt-3 block text-3xl text-white">{qualityDetail.run.counts?.projects ?? "—"}</strong></div>
                    <div class="surface-soft-card"><span class="surface-label">Cases</span><strong class="mt-3 block text-3xl text-white">{qualityDetail.run.counts?.cases ?? qualityDetail.cases.length}</strong></div>
                    <div class="surface-soft-card"><span class="surface-label">Gate reason</span><strong class="mt-3 block text-base text-white">{qualityDetail.run.insufficiency_reason || "thresholds evaluated"}</strong></div>
                  </div>
                  {qualityDetail.run.privacy && <div class="surface-soft-card text-sm text-zinc-300" data-quality-privacy>
                    Private bundle: transcript {qualityDetail.run.privacy.raw_transcript_persisted ? "persisted" : "not persisted"} · reasoning {qualityDetail.run.privacy.reasoning_persisted ? "persisted" : "not persisted"} · absolute path {qualityDetail.run.privacy.absolute_path_persisted ? "persisted" : "not persisted"} · credential value {qualityDetail.run.privacy.credential_value_persisted ? "persisted" : "not persisted"}
                  </div>}
                  <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
                    {qualityDetail.dimensions.map((item) => <div class="surface-soft-card" data-quality-axis={item.axis}><span class="surface-label">{item.axis}</span><strong class="mt-3 block text-3xl text-white">{item.point_estimate == null ? "—" : `${(item.point_estimate * 100).toFixed(1)}%`}</strong><p class="mt-2 text-xs text-zinc-400">Wilson lower {item.wilson_lower == null ? "—" : `${(item.wilson_lower * 100).toFixed(1)}%`} · hard {item.hard_violation_count}</p></div>)}
                  </div>
                  <div class="space-y-3">
                    {qualityDetail.cases.length > 0 ? qualityDetail.cases.map((item) => <article class={rowCardClass(false)} data-quality-case data-route={item.actual_route} data-parity-mismatch={String(item.parity_mismatch)}>
                      <div class="memory-row-meta"><span>{item.capture_route || "redacted"}</span><span>{item.lesson_type || "untyped"}</span><span>{item.split || "redacted"}</span><span>{item.project_hash || "no-project"}</span></div>
                      <h3 class="mt-2 text-lg font-semibold text-white">{item.summary || item.case_hash}</h3>
                      <div class="mt-3 flex flex-wrap gap-2"><span class="surface-chip">expected {item.expected_route}</span><span class="surface-chip">actual {item.actual_route}</span>{item.parity_mismatch && <span class="surface-chip">parity mismatch</span>}{item.hard_violation_count > 0 && <span class="surface-chip">hard {item.hard_violation_count}</span>}{item.reason_codes.map((reason) => <span class="surface-chip">{reason}</span>)}</div>
                      {item.memory_id && <a class="mt-4 inline-flex text-sm text-sky-200" href={makeHref({ view: "search", selected: item.memory_id })}>Open authorized memory detail →</a>}
                    </article>) : <div class="surface-soft-card"><strong class="text-white">No quality cases.</strong><p class="mt-2 text-sm text-zinc-400">条件を変えるか、quality runを実行してください。</p></div>}
                  </div>
                </>
              ) : <div class="surface-soft-card"><strong class="text-white">No quality runs.</strong><p class="mt-2 text-sm text-zinc-400">privateまたはsynthetic runを作成すると、ここに7軸とroute差分が表示されます。</p></div>}
            </div>
          ) : view === "search" ? (
            <div class="space-y-6">
              {!query && searchLandingRows.length > 0 && (
                <section class="space-y-4">
                  <div>
                    <p class="surface-label">{searchLandingKind === "recent" ? "Recent" : "Durable"}</p>
                    <h2 class="mt-2 text-2xl font-semibold tracking-[-0.04em] text-white">
                      {searchLandingKind === "recent" ? "最近のメモリ" : "おすすめのメモリ"}
                    </h2>
                  </div>
                  <div class="grid gap-4 lg:grid-cols-3">
                    {searchLandingRows.map((item) => (
                      <a class={rowCardClass(selectedId === item.id)} href={makeHref({ selected: item.id })}>
