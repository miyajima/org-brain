                            </div>
                          ))}
                        </div>
                      )}
                    </div>
                  )}
                  {memoryDetail.memory?.reuse_rule && (
                    <div class="surface-soft-card !rounded-[24px] !p-4">
                      <p class="surface-label">Reuse rule</p>
                      <p class="mt-3 text-sm leading-7 text-zinc-300">{memoryDetail.memory.reuse_rule}</p>
                    </div>
                  )}
                  <div class="surface-soft-card !rounded-[24px] !p-4">
                    <p class="surface-label">Rationales</p>
                    <div class="mt-3 space-y-3">
                      {memoryDetail.rationales.length > 0 ? memoryDetail.rationales.map((rationale) => (
                        <div class="rounded-2xl border border-white/8 bg-white/[0.04] p-4">
                          <div class="flex flex-wrap gap-2">
                            <span class="surface-chip">{rationale.decision_type}</span>
                            <span class="surface-chip">{rationale.confirmation_state}</span>
                            <span class="surface-chip">{rationale.status}</span>
                          </div>
                          <h3 class="mt-3 text-base font-semibold text-white">{rationale.conclusion}</h3>
                          <p class="mt-2 text-sm leading-7 text-zinc-300">{rationale.reason_summary}</p>
                          {rationale.evidence.length > 0 && (
                            <div class="mt-3 space-y-2">
                              {rationale.evidence.map((evidence) => (
                                <p class="break-all rounded-xl border border-white/8 bg-black/20 px-3 py-2 text-xs leading-6 text-zinc-400">
                                  {evidence.relation} / {evidence.evidence_type}: {evidence.evidence_ref}
                                  {evidence.content_hash && <> / hash {evidence.content_hash.slice(0, 12)}</>}
                                </p>
                              ))}
                            </div>
                          )}
                        </div>
                      )) : <p class="text-sm leading-7 text-zinc-400">No rationale rows for this memory.</p>}
                    </div>
                  </div>

                  <div class="surface-soft-card !rounded-[24px] !p-4">
                    <p class="surface-label">Versions</p>
                    <div class="mt-3 space-y-2">
                      {memoryDetail.versions.length > 0 ? memoryDetail.versions.map((version) => (
                        <div class="rounded-2xl border border-white/8 bg-white/[0.04] px-4 py-3">
                          <div class="flex flex-wrap items-center justify-between gap-2">
                            <strong class="text-sm font-semibold text-white">v{version.version} / {version.operation}</strong>
                            <span class="text-xs uppercase tracking-[0.16em] text-zinc-500">{formatDate(version.created_at)}</span>
                          </div>
                          <p class="mt-2 text-xs leading-6 text-zinc-400">{version.summary || `${version.kind} / ${version.lifecycle_state}`}</p>
                          {(version.actor_type || version.actor_id) && (
                            <p class="mt-1 break-all text-xs leading-6 text-zinc-500">
                              actor: {version.actor_type || "unknown"} / {version.actor_id || "unknown"}
                            </p>
                          )}
                        </div>
                      )) : <p class="text-sm leading-7 text-zinc-400">No version history available.</p>}
                    </div>
                  </div>
                </section>
              )}

              {detail.content && detail.content !== detail.preview && (
                <details class="surface-soft-card !rounded-[24px] !p-4">
                  <summary class="cursor-pointer text-sm font-semibold text-white">Raw content</summary>
                  <pre class="mt-3">{detail.content}</pre>
                </details>
              )}
            </div>
          ) : (
            <div class="mt-5 space-y-4">
              <div class="surface-soft-card !rounded-[24px] !p-4">
                <strong class="text-base font-semibold text-white">検索前のクイックピック</strong>
                <p class="mt-2 text-sm leading-7 text-zinc-400">recent lane からすぐ開けるようにしています。検索語が定まっていないときはここから入れます。</p>
              </div>
              <div class="space-y-3">
                {quickPickRows.length > 0 ? quickPickRows.map((item) => (
                  <a class={rowCardClass(false)} href={makeHref({ selected: item.id })}>
                    <p class="surface-label">{item.source}</p>
                    <h3 class="mt-2 text-lg font-semibold tracking-[-0.03em] text-white">{memoryCardCopy(item.summary, item.content_preview).title}</h3>
                    {memoryCardCopy(item.summary, item.content_preview).context && <p class="memory-card-context">{memoryCardCopy(item.summary, item.content_preview).context}</p>}
                    <p class="mt-2 text-sm leading-7 text-zinc-400">{memoryCardCopy(item.summary, item.content_preview).preview}</p>
                  </a>
                )) : (
                  <div class="surface-soft-card !rounded-[24px] !p-4 text-sm text-zinc-400">まだ quick pick に出せる memory がありません。</div>
                )}
              </div>
            </div>
          )}
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

