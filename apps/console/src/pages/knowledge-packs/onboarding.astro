<script>
  const csrf = sessionStorage.getItem("orgbrain_csrf") ?? "";
  document.querySelectorAll<HTMLInputElement>(".knowledge-pack-csrf").forEach((input) => { input.value = csrf; });

  const pageRoot = document.querySelector<HTMLElement>(".kp-page");
  const validationTitle = pageRoot?.dataset.validationTitle ?? "Review the required fields";
  const requiredError = pageRoot?.dataset.requiredError ?? "This field is required.";
  const invalidError = pageRoot?.dataset.invalidError ?? "Enter a valid value.";
  const focusAfterSubmitKey = "orgbrain_knowledge_pack_focus_after_submit";
  type FormField = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;

  const formFields = (form: HTMLFormElement): FormField[] => Array.from(
    form.querySelectorAll("input:not([type=hidden]), textarea, select")
  ) as unknown as FormField[];
  const fieldLabel = (field: FormField) => {
    if (field instanceof HTMLInputElement && field.type === "radio") {
      return field.closest("fieldset")?.querySelector("legend")?.textContent?.trim() || field.name;
    }
    return field.closest("label")?.querySelector(":scope > span")?.textContent?.trim() || field.name;
  };
  const removeGeneratedErrors = (form: HTMLFormElement) => {
    form.querySelectorAll("[data-inline-error]").forEach((node) => node.parentNode?.removeChild(node));
    formFields(form).forEach((field) => {
      field.removeAttribute("aria-invalid");
      const describedBy = (field.getAttribute("aria-describedby") ?? "")
        .split(/\s+/)
        .filter((id) => id && !id.startsWith("knowledge-pack-error-"));
      if (describedBy.length) field.setAttribute("aria-describedby", describedBy.join(" "));
      else field.removeAttribute("aria-describedby");
    });
  };
  const ensureErrorSummary = (form: HTMLFormElement) => {
    let summary = form.querySelector<HTMLElement>("[data-form-errors]");
    if (summary) return summary;
    summary = document.createElement("div");
    summary.className = "kp-form-errors";
    summary.dataset.formErrors = "";
    summary.setAttribute("role", "alert");
    summary.tabIndex = -1;
    summary.hidden = true;
    const title = document.createElement("strong");
    title.textContent = validationTitle;
    summary.appendChild(title);
    summary.appendChild(document.createElement("ul"));
    form.insertBefore(summary, form.firstChild);
    return summary;
  };
  const renderValidation = (form: HTMLFormElement, focusSummary: boolean) => {
    const summary = ensureErrorSummary(form);
    const list = summary.querySelector("ul");
    if (!list) return;
    removeGeneratedErrors(form);
    while (list.firstChild) list.removeChild(list.firstChild);

    const seenRadioGroups = new Set<string>();
    const invalidFields = formFields(form).filter((field) => !field.disabled && !field.validity.valid).filter((field) => {
      if (!(field instanceof HTMLInputElement) || field.type !== "radio") return true;
      if (seenRadioGroups.has(field.name)) return false;
      seenRadioGroups.add(field.name);
      return true;
    });

    invalidFields.forEach((field, index) => {
      const isRadio = field instanceof HTMLInputElement && field.type === "radio";
      const group = isRadio
        ? formFields(form).filter((candidate) => candidate instanceof HTMLInputElement && candidate.type === "radio" && candidate.name === field.name)
        : [field];
      if (!field.id) field.id = `knowledge-pack-field-${field.name || "value"}-${index + 1}`;
      const errorId = `knowledge-pack-error-${field.id}`;
      const message = field.validity.valueMissing ? requiredError : invalidError;
      const inline = document.createElement("span");
      inline.id = errorId;
      inline.className = "kp-inline-error";
      inline.dataset.inlineError = "";
      inline.textContent = message;
      const inlineTarget = isRadio ? field.closest("fieldset") : field.closest("label");
      inlineTarget?.appendChild(inline);
      group.forEach((candidate) => {
        candidate.setAttribute("aria-invalid", "true");
        const describedBy = new Set((candidate.getAttribute("aria-describedby") ?? "").split(/\s+/).filter(Boolean));
        describedBy.add(errorId);
        candidate.setAttribute("aria-describedby", [...describedBy].join(" "));
      });
      const item = document.createElement("li");
      const link = document.createElement("a");
      link.href = `#${field.id}`;
      link.textContent = `${fieldLabel(field)}: ${message}`;
      link.addEventListener("click", (event) => {
        event.preventDefault();
        field.focus();
      });
      item.appendChild(link);
      list.appendChild(item);
    });

    summary.hidden = invalidFields.length === 0;
    if (invalidFields.length > 0) {
      form.dataset.validationShown = "true";
      if (focusSummary) summary.focus();
    } else {
      delete form.dataset.validationShown;
    }
  };

  document.querySelectorAll<HTMLFormElement>("[data-validation-form]").forEach((form) => {
    ensureErrorSummary(form);
    let validationScheduled = false;
    form.addEventListener("invalid", (event) => {
      event.preventDefault();
      if (validationScheduled) return;
      validationScheduled = true;
      queueMicrotask(() => {
        validationScheduled = false;
        renderValidation(form, true);
      });
    }, true);
    formFields(form).forEach((field) => {
      const refresh = () => { if (form.dataset.validationShown) renderValidation(form, false); };
      field.addEventListener("input", refresh);
      field.addEventListener("change", refresh);
    });
  });

  document.querySelectorAll<HTMLFormElement>("[data-guided-form]").forEach((form) => {
    form.addEventListener("submit", () => {
      sessionStorage.setItem(focusAfterSubmitKey, "true");
      form.setAttribute("aria-busy", "true");
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) { button.disabled = true; button.textContent = button.dataset.savingLabel ?? "Saving…"; }
    });
  });

  document.querySelectorAll<HTMLAnchorElement>("[data-focus-step-link]").forEach((link) => {
    link.addEventListener("click", () => sessionStorage.setItem(focusAfterSubmitKey, "true"));
  });

  const updateScopeRequirements = (form: HTMLFormElement) => {
    const visibility = (form.querySelector("[data-scope-visibility]") as HTMLInputElement | null)?.value;
    const project = form.querySelector<HTMLInputElement>("[data-scope-project]");
    if (project) {
      project.required = visibility === "project";
      project.disabled = visibility !== "project";
    }
    form.querySelectorAll<HTMLElement>("[data-project-required]").forEach((mark) => { mark.hidden = visibility !== "project"; });
  };
  document.querySelectorAll<HTMLFormElement>("[data-scope-form]").forEach((form) => {
    updateScopeRequirements(form);
    form.addEventListener("change", () => updateScopeRequirements(form));
  });

  document.querySelectorAll<HTMLElement>("[data-goal-row]").forEach((row) => {
    const direction = row.querySelector("[data-goal-direction]") as HTMLInputElement | null;
    const update = () => {
      const range = direction?.value === "range";
      row.querySelectorAll<HTMLElement>("[data-target-single]").forEach((field) => { field.hidden = range; });
      row.querySelectorAll<HTMLElement>("[data-target-range]").forEach((field) => { field.hidden = !range; });
      row.querySelectorAll<HTMLInputElement>('[name="target_value"]').forEach((input) => { input.required = !range && Boolean((row.querySelector('[name="metric_key"]') as HTMLInputElement | null)?.value); });
      row.querySelectorAll<HTMLInputElement>('[name="target_min"], [name="target_max"]').forEach((input) => { input.required = range; });
      row.querySelectorAll<HTMLElement>("[data-target-single] [data-target-required]").forEach((mark) => { mark.hidden = range || !(row.querySelector('[name="metric_key"]') as HTMLInputElement | null)?.value; });
      row.querySelectorAll<HTMLElement>("[data-target-range] [data-target-required]").forEach((mark) => { mark.hidden = !range; });
    };
    direction?.addEventListener("change", update);
    row.querySelector('[name="metric_key"]')?.addEventListener("change", update);
    update();
  });

  document.querySelectorAll<HTMLElement>("[data-source-row]").forEach((row) => {
    const mode = row.querySelector("[data-source-mode]") as HTMLInputElement | null;
    const update = () => {
      const value = mode?.value ?? "unknown";
      const manual = row.querySelector<HTMLElement>("[data-source-manual]");
      const connector = row.querySelector<HTMLElement>("[data-source-connector]");
      const unknown = row.querySelector<HTMLElement>("[data-source-unknown]");
      if (manual) manual.hidden = value !== "manual";
      if (connector) connector.hidden = value !== "connector";
      if (unknown) unknown.hidden = value !== "unknown";
      const initial = row.querySelector<HTMLInputElement>('[name="initial_value"]');
      const connection = row.querySelector<HTMLInputElement>('[name="connection_ref"]');
      if (initial) initial.required = value === "manual";
      if (connection) connection.required = value === "connector";
      row.querySelectorAll<HTMLElement>("[data-manual-required]").forEach((mark) => { mark.hidden = value !== "manual"; });
      row.querySelectorAll<HTMLElement>("[data-connector-required]").forEach((mark) => { mark.hidden = value !== "connector"; });
    };
    mode?.addEventListener("change", update);
    update();
  });

  document.querySelectorAll<HTMLFormElement>("[data-auto-advance]").forEach((form) => {
    const mode = form.dataset.autoAdvance;
    form.addEventListener("change", (event) => {
      if (formFields(form).some((field) => !field.disabled && !field.validity.valid)) return;
      if (mode === "selection" && event.target instanceof HTMLInputElement && event.target.type === "radio") form.requestSubmit();
      if (mode === "selection" && event.target instanceof HTMLSelectElement && form.matches("[data-scope-form]")) form.requestSubmit();
    });
  });

  const serverError = document.querySelector<HTMLElement>("[data-server-error]");
  const shouldFocusStep = sessionStorage.getItem(focusAfterSubmitKey) === "true";
  sessionStorage.removeItem(focusAfterSubmitKey);
  requestAnimationFrame(() => {
    if (serverError) serverError.focus();
    else if (shouldFocusStep) document.querySelector<HTMLElement>(".kp-stage-heading, .kp-completed")?.focus({ preventScroll: true });
  });
</script>
