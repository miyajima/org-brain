---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { dashboardPageParams } from "../../lib/dashboard-page";
import { knowledgePackOnboardingCopy } from "../../lib/console-locale";

const { tenantId, projectId, lang } = dashboardPageParams(
  Astro.url,
  Astro.request.headers.get("cookie")
);
const copy = knowledgePackOnboardingCopy(lang);
const cookie = Astro.request.headers.get("cookie") ?? "";
const api = async (path: string, init: RequestInit = {}) => fetch(new URL(path, Astro.url), {
  ...init,
  headers: { cookie, ...(init.headers ?? {}) }
});
const jsonMutation = async (
  path: string,
  method: "POST" | "PATCH",
  body: Record<string, unknown>,
  csrf: string,
  idempotencyKey?: string
) => api(path, {
  method,
  headers: {
    "content-type": "application/json",
    "x-csrf-token": csrf,
    ...(idempotencyKey ? { "x-idempotency-key": idempotencyKey } : {})
  },
  body: JSON.stringify(body)
});
const scopedUrl = (sessionId?: string | null, scopedProjectId: string | null = projectId, viewStep?: string | null) => {
  const url = new URL("/knowledge-packs/onboarding", Astro.url);
  url.searchParams.set("tenant_id", tenantId);
  url.searchParams.set("lang", lang);
  if (scopedProjectId) url.searchParams.set("project_id", scopedProjectId);
  if (sessionId) url.searchParams.set("session_id", sessionId);
  if (viewStep) url.searchParams.set("view_step", viewStep);
  return `${url.pathname}${url.search}`;
};
const numberOrNull = (value: FormDataEntryValue | null) => {
  const text = String(value ?? "").trim();
  if (!text) return null;
  const number = Number(text);
  return Number.isFinite(number) ? number : null;
};
const timestampOrNull = (value: FormDataEntryValue | null) => {
  const text = String(value ?? "").trim();
  if (!text) return null;
  const timestamp = Date.parse(text.length === 10 ? `${text}T23:59:59.999+09:00` : text);
  return Number.isFinite(timestamp) ? timestamp : null;
};

let error = "";
let requestedSessionId = Astro.url.searchParams.get("session_id")?.trim() || null;
let requestKey: string = crypto.randomUUID();
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "");
  const csrf = String(form.get("csrf_token") ?? "");
  const idempotencyKey = String(form.get("idempotency_key") ?? crypto.randomUUID());
  requestKey = idempotencyKey;
  const formSessionId = String(form.get("session_id") ?? requestedSessionId ?? "").trim();
  const revision = Number(form.get("revision") ?? 0);
  let response: Response | null = null;

  if (action === "start") {
    response = await jsonMutation(
      "/api/v1/knowledge-pack-onboardings",
      "POST",
      { tenant_id: tenantId, project_id: projectId },
      csrf,
      idempotencyKey
    );
  } else if (action === "save_step" && formSessionId) {
    const step = String(form.get("step") ?? "");
    let answer: Record<string, unknown> = {};
    if (step === "purpose") {
      answer = {
        name: String(form.get("name") ?? ""),
        objective: String(form.get("objective") ?? "")
      };
    } else if (step === "template") {
      answer = { pack_ids: form.getAll("pack_ids").map(String).filter(Boolean) };
    } else if (step === "scope") {
      answer = {
        project_id: String(form.get("scope_project_id") ?? "").trim() || null,
        scope_type: String(form.get("scope_type") ?? "tenant")
      };
    } else if (step === "goals") {
      const metricKeys = form.getAll("metric_key").map(String);
      const directions = form.getAll("direction").map(String);
      const targetValues = form.getAll("target_value");
      const targetMins = form.getAll("target_min");
      const targetMaxes = form.getAll("target_max");
      const dueDates = form.getAll("due_at");
      const reasons = form.getAll("reason").map(String);
      answer = {
        goals: metricKeys.flatMap((metricKey, index) => {
          if (!metricKey) return [];
          const direction = directions[index] || "increase";
          return [{
            metric_key: metricKey,
            direction,
            target_value: direction === "range" ? null : numberOrNull(targetValues[index] ?? null),
            target_min: direction === "range" ? numberOrNull(targetMins[index] ?? null) : null,
            target_max: direction === "range" ? numberOrNull(targetMaxes[index] ?? null) : null,
            due_at: timestampOrNull(dueDates[index] ?? null),
            reason: reasons[index]?.trim() || null
          }];
        })
      };
    } else if (step === "data_sources") {
      const metricKeys = form.getAll("source_metric_key").map(String);
      const modes = form.getAll("source_mode").map(String);
      const values = form.getAll("initial_value");
      const observed = form.getAll("observed_at");
      const connections = form.getAll("connection_ref").map(String);
      const evidence = form.getAll("evidence_ref").map(String);
      answer = {
        sources: metricKeys.map((metricKey, index) => {
          const mode = modes[index] || "unknown";
          return {
            metric_key: metricKey,
            mode,
            initial_value: mode === "manual" ? numberOrNull(values[index] ?? null) : null,
            observed_at: mode === "manual" ? timestampOrNull(observed[index] ?? null) : null,
            connection_ref: mode === "connector" ? connections[index]?.trim() || null : null,
            evidence_ref: mode === "manual" ? evidence[index]?.trim() || null : null
          };
        })
      };
    }
    response = await jsonMutation(
      `/api/v1/knowledge-pack-onboardings/${encodeURIComponent(formSessionId)}/steps/${encodeURIComponent(step)}`,
      "PATCH",
      { tenant_id: tenantId, project_id: projectId, revision, answer },
      csrf
    );
  } else if (action === "plan" && formSessionId) {
    response = await jsonMutation(
      `/api/v1/knowledge-pack-onboardings/${encodeURIComponent(formSessionId)}/plan`,
      "POST",
      { tenant_id: tenantId, project_id: projectId, revision },
      csrf,
      idempotencyKey
    );
  } else if (action === "complete" && formSessionId) {
    response = await jsonMutation(
      `/api/v1/knowledge-pack-onboardings/${encodeURIComponent(formSessionId)}/complete`,
      "POST",
      {
        tenant_id: tenantId,
        project_id: projectId,
        plan_digest: String(form.get("plan_digest") ?? "")
      },
      csrf,
      idempotencyKey
    );
  }

  if (response) {
    const payload: any = await response.json().catch(() => null);
    if (!response.ok) {
      error = payload?.error?.message ?? copy.mutationError;
      requestedSessionId = formSessionId || requestedSessionId;
    } else {
      const session = payload?.data?.onboarding ?? payload?.data;
      const sessionId = session?.id ?? formSessionId;
      if (action === "save_step" && session?.current_step === "review" && sessionId) {
        const planResponse = await jsonMutation(
          `/api/v1/knowledge-pack-onboardings/${encodeURIComponent(sessionId)}/plan`,
          "POST",
          {
            tenant_id: tenantId,
            project_id: session.project_id,
            revision: session.revision
          },
          csrf,
          `${idempotencyKey}-plan`
        );
        const planPayload: any = await planResponse.json().catch(() => null);
        if (!planResponse.ok) {
          error = planPayload?.error?.message ?? copy.mutationError;
          requestedSessionId = sessionId;
        } else {
          return Astro.redirect(scopedUrl(
            sessionId,
            planPayload?.data?.onboarding?.project_id ?? session.project_id
          ), 303);
        }
      } else {
        return Astro.redirect(scopedUrl(sessionId, session?.project_id ?? projectId), 303);
      }
    }
  }
}

const catalogUrl = `/api/v1/domain-packs?tenant_id=${encodeURIComponent(tenantId)}`;
const capabilityUrl = `/api/v1/capabilities?tenant_id=${encodeURIComponent(tenantId)}`;
const [catalogResponse, capabilityResponse, sessionResponse] = await Promise.all([
  api(catalogUrl),
  api(capabilityUrl),
  requestedSessionId
    ? api(`/api/v1/knowledge-pack-onboardings/${encodeURIComponent(requestedSessionId)}?tenant_id=${encodeURIComponent(tenantId)}${projectId ? `&project_id=${encodeURIComponent(projectId)}` : ""}`)
    : Promise.resolve(null)
]);
const catalogPayload: any = await catalogResponse.json().catch(() => null);
const capabilityPayload: any = await capabilityResponse.json().catch(() => null);
const sessionPayload: any = sessionResponse ? await sessionResponse.json().catch(() => null) : null;
const packs: any[] = Array.isArray(catalogPayload?.data) ? catalogPayload.data : [];
const capability = capabilityPayload?.data?.knowledge_pack_onboarding;
const writable = capability?.writable === true;
const session: any = sessionPayload?.data ?? null;
if (requestedSessionId && sessionResponse && !sessionResponse.ok && !error) {
  error = sessionPayload?.error?.message ?? copy.loadError;
}

const stepKeys = ["purpose", "template", "scope", "goals", "data_sources", "review", "completed"];
const currentStepIndex = session ? Math.max(0, stepKeys.indexOf(session.current_step)) : 0;
const requestedViewStep = Astro.url.searchParams.get("view_step");
const requestedViewIndex = requestedViewStep ? stepKeys.indexOf(requestedViewStep) : -1;
const displayStep = session?.state === "completed"
  ? "completed"
  : requestedViewIndex >= 0 && requestedViewIndex <= currentStepIndex
    ? requestedViewStep
    : session?.current_step ?? "purpose";
const displayStepIndex = Math.max(0, stepKeys.indexOf(displayStep));
const previousStep = displayStepIndex > 0 ? stepKeys[displayStepIndex - 1] : null;
const stepStates = stepKeys.map((step, index) => ({
  step,
  index,
  available: index <= currentStepIndex,
  active: displayStep === step,
  complete: index < currentStepIndex || session?.state === "completed"
}));
const statusLabel = session?.state === "completed"
  ? copy.statusCompleted
  : session?.state === "planned"
    ? copy.statusPlanned
    : copy.statusInProgress;
const selectedPackIds: string[] = session?.answers?.template?.pack_ids ?? [];
const selectedPacks = packs.filter((entry) => selectedPackIds.includes(entry.manifest?.pack_id));
const metricMap = new Map<string, any>();
for (const entry of selectedPacks) {
  for (const metric of entry.manifest?.metrics ?? []) metricMap.set(metric.key, metric);
}
const availableMetrics = [...metricMap.values()];
const defaultDueAt = new Date(Date.now() + 30 * 86_400_000).toISOString().slice(0, 10);
const goals: any[] = session?.answers?.goals?.goals ?? [];
const goalRows = Array.from({ length: 3 }, (_, index) => goals[index] ?? {
  metric_key: "",
  direction: "increase",
  target_value: null,
  target_min: null,
  target_max: null,
  due_at: null,
  reason: null
});
const sourceByMetric = new Map<string, any>((session?.answers?.data_sources?.sources ?? []).map((source: any) => [source.metric_key, source]));
const stepHref = (step: string) => scopedUrl(session?.id, session?.project_id ?? projectId, step);
const conflictCount = (value: unknown) => Object.values((value ?? {}) as Record<string, unknown[]>)
  .reduce((total, items) => total + (Array.isArray(items) ? items.length : 0), 0);
const dateValue = (timestamp: number | null | undefined) => timestamp ? new Date(timestamp).toISOString().slice(0, 10) : "";
const dateTimeValue = (timestamp: number | null | undefined) => timestamp ? new Date(timestamp).toISOString().slice(0, 16) : "";
---
<BaseLayout title={copy.title} lang={lang} wide>
  <section
    class="kp-page space-y-5"
    data-validation-title={copy.validationTitle}
    data-required-error={copy.requiredError}
    data-invalid-error={copy.invalidError}
  >
    <header class="kp-header">
      <div>
        <p class="surface-label">{copy.eyebrow} · {tenantId}</p>
        <h1>{copy.heading}</h1>
        <p class="surface-muted">{copy.body}</p>
      </div>
      {session && <span class:list={["kp-status", `is-${session.state}`]}>{statusLabel}</span>}
    </header>

    {error && <div class="kp-error" role="alert" tabindex="-1" data-server-error>
      <strong>{copy.mutationError}</strong>
      <span>{error}</span>
      {session || writable
        ? <a href="#knowledge-pack-form">{copy.retryForm}</a>
        : <a href={scopedUrl()}>{copy.retryLoad}</a>}
    </div>}

    {!session ? <section class="kp-intro">
      <div class="kp-intro-mark" aria-hidden="true">K</div>
      <div>
        <h2>{copy.purposeTitle}</h2>
        <p class="surface-muted">{copy.purposeBody}</p>
        {writable ? <form id="knowledge-pack-form" method="post" class="mt-5" data-guided-form>
          <input type="hidden" name="csrf_token" class="knowledge-pack-csrf" />
          <input type="hidden" name="action" value="start" />
          <input type="hidden" name="idempotency_key" value={requestKey} />
          <button type="submit" data-saving-label={copy.saving}>{copy.start}</button>
        </form> : <p class="kp-disabled">{copy.disabled}</p>}
      </div>
    </section> : <div class="kp-shell">
      {!writable && <p class="kp-disabled" role="status">{copy.disabled}</p>}
      <nav class="kp-rail" aria-label={copy.progressLabel}>
        <p class="surface-label">{session.id}</p>
        <div class="kp-mobile-progress">
          <span>{copy.stepLabel} {displayStepIndex + 1} / {stepKeys.length}</span>
          <strong>{copy.steps[displayStepIndex]}</strong>
          {previousStep && session.state !== "completed" && <a href={stepHref(previousStep)} data-focus-step-link>{copy.back}</a>}
        </div>
        <ol>
          {stepStates.map(({ step, index, available, active, complete }) => <li class:list={[active && "is-active", complete && "is-complete"]}>
              {available && step !== "completed" && session.state !== "completed"
                ? <a href={stepHref(step)} aria-current={active ? "step" : undefined} data-focus-step-link>
                    <span>{complete ? "✓" : index + 1}</span><strong>{copy.steps[index]}</strong>
                  </a>
                : <div aria-current={active ? "step" : undefined}>
                    <span>{complete ? "✓" : index + 1}</span><strong>{copy.steps[index]}</strong>
                  </div>}
            </li>)}
        </ol>
        <p class="kp-resume-note">{copy.body}</p>
      </nav>

      <section class="kp-stage" data-knowledge-pack-step={displayStep} aria-labelledby="knowledge-pack-step-title">
        {displayStep === "purpose" && <>
          <div class="kp-stage-heading" tabindex="-1"><p>01 / 07</p><h2 id="knowledge-pack-step-title">{copy.purposeTitle}</h2><span>{copy.purposeBody}</span></div>
          <form hidden={!writable} id="knowledge-pack-form" method="post" class="kp-form" data-guided-form data-validation-form>
            <input type="hidden" name="csrf_token" class="knowledge-pack-csrf" />
            <input type="hidden" name="session_id" value={session.id} />
            <input type="hidden" name="revision" value={session.revision} />
            <input type="hidden" name="idempotency_key" value={requestKey} />
            <input type="hidden" name="action" value="save_step" />
            <input type="hidden" name="step" value="purpose" />
            <label><span>{copy.name} <em class="kp-required">{copy.required}</em></span><input name="name" required maxlength="160" value={session.answers?.purpose?.name ?? ""} /></label>
            <label><span>{copy.objective} <em class="kp-required">{copy.required}</em></span><textarea name="objective" required maxlength="2000" rows="5">{session.answers?.purpose?.objective ?? ""}</textarea></label>
            <button type="submit" data-saving-label={copy.saving}>{copy.saveNext}</button>
          </form>
        </>}

        {displayStep === "template" && <>
          <div class="kp-stage-heading" tabindex="-1"><p>02 / 07</p><h2 id="knowledge-pack-step-title">{copy.templateTitle}</h2><span>{copy.templateBody}</span></div>
          <form hidden={!writable} id="knowledge-pack-form" method="post" class="kp-form" data-guided-form data-validation-form data-auto-advance="selection">
            <input type="hidden" name="csrf_token" class="knowledge-pack-csrf" />
            <input type="hidden" name="session_id" value={session.id} />
            <input type="hidden" name="revision" value={session.revision} />
            <input type="hidden" name="idempotency_key" value={requestKey} />
            <input type="hidden" name="action" value="save_step" />
            <input type="hidden" name="step" value="template" />
            <fieldset class="kp-template-fieldset">
              <legend>{copy.templateTitle} <em class="kp-required">{copy.required}</em></legend>
              <div class="kp-template-grid">
                {packs.filter((entry) => entry.manifest?.classification !== "organization_overlay").map((entry) => <label class="kp-template-card">
                  <input type="radio" name="pack_ids" value={entry.manifest.pack_id} checked={selectedPackIds.includes(entry.manifest.pack_id)} required />
                  <span class="kp-template-indicator" aria-hidden="true"></span>
                  <span><strong>{entry.manifest.title}</strong><small>{entry.manifest.description}</small></span>
                  <em>{entry.manifest.metrics?.length ?? 0} {copy.metric}</em>
                </label>)}
              </div>
            </fieldset>
            <button type="submit" data-saving-label={copy.saving}>{copy.saveNext}</button>
          </form>
        </>}

        {displayStep === "scope" && <>
          <div class="kp-stage-heading" tabindex="-1"><p>03 / 07</p><h2 id="knowledge-pack-step-title">{copy.scopeTitle}</h2><span>{copy.scopeBody}</span></div>
          <form hidden={!writable} id="knowledge-pack-form" method="post" class="kp-form" data-guided-form data-validation-form data-auto-advance="selection" data-scope-form>
            <input type="hidden" name="csrf_token" class="knowledge-pack-csrf" />
            <input type="hidden" name="session_id" value={session.id} />
            <input type="hidden" name="revision" value={session.revision} />
            <input type="hidden" name="idempotency_key" value={requestKey} />
            <input type="hidden" name="action" value="save_step" />
            <input type="hidden" name="step" value="scope" />
            <label><span>{copy.visibility}</span><select name="scope_type" data-scope-visibility>
              <option value="tenant" selected={(session.answers?.scope?.scope_type ?? (session.project_id ? "project" : "tenant")) === "tenant"}>{copy.tenantScope}</option>
              <option value="project" selected={(session.answers?.scope?.scope_type ?? (session.project_id ? "project" : "tenant")) === "project"}>{copy.projectScope}</option>
            </select></label>
            <label><span>{copy.project} <em class="kp-required" data-project-required hidden>{copy.required}</em></span><input name="scope_project_id" data-scope-project maxlength="128" value={session.answers?.scope?.project_id ?? session.project_id ?? ""} /></label>
            <button type="submit" data-saving-label={copy.saving}>{copy.saveNext}</button>
          </form>
        </>}

        {displayStep === "goals" && <>
          <div class="kp-stage-heading" tabindex="-1"><p>04 / 07</p><h2 id="knowledge-pack-step-title">{copy.goalsTitle}</h2><span>{copy.goalsBody}</span></div>
          <form hidden={!writable} id="knowledge-pack-form" method="post" class="kp-form" data-guided-form data-validation-form>
            <input type="hidden" name="csrf_token" class="knowledge-pack-csrf" />
            <input type="hidden" name="session_id" value={session.id} />
            <input type="hidden" name="revision" value={session.revision} />
            <input type="hidden" name="idempotency_key" value={requestKey} />
            <input type="hidden" name="action" value="save_step" />
            <input type="hidden" name="step" value="goals" />
            <div class="kp-goal-list">
              {goalRows.map((goal, index) => <fieldset class="kp-goal" data-goal-row>
                <legend>{index === 0 ? copy.goalsTitle : `${copy.addOptional} ${index + 1}`}</legend>
                <div class="kp-fields-2">
                  <label><span>{copy.metric} {index === 0 && <em class="kp-required">{copy.required}</em>}</span><select name="metric_key" required={index === 0}>
                    <option value="">—</option>
                    {availableMetrics.map((metric) => <option value={metric.key} selected={goal.metric_key === metric.key}>{metric.label}</option>)}
                  </select></label>
                  <label><span>{copy.direction}</span><select name="direction" data-goal-direction>
                    {[["increase", "↑"], ["decrease", "↓"], ["maintain", "="], ["range", "↔"]].map(([value, mark]) => <option value={value} selected={goal.direction === value}>{mark} {value}</option>)}
                  </select></label>
                </div>
                <div class="kp-fields-3">
                  <label data-target-single><span>{copy.target} <em class="kp-required" data-target-required hidden>{copy.required}</em></span><input type="number" inputmode="decimal" step="any" name="target_value" value={goal.target_value ?? ""} /></label>
                  <label data-target-range><span>{copy.minimum} <em class="kp-required" data-target-required hidden>{copy.required}</em></span><input type="number" inputmode="decimal" step="any" name="target_min" value={goal.target_min ?? ""} /></label>
                  <label data-target-range><span>{copy.maximum} <em class="kp-required" data-target-required hidden>{copy.required}</em></span><input type="number" inputmode="decimal" step="any" name="target_max" value={goal.target_max ?? ""} /></label>
                </div>
                <div class="kp-fields-2">
                  <label><span>{copy.deadline}</span><input type="date" name="due_at" min={new Date().toISOString().slice(0, 10)} value={dateValue(goal.due_at) || (index === 0 ? defaultDueAt : "")} /></label>
                  <label><span>{copy.reason}</span><input name="reason" maxlength="2000" value={goal.reason ?? ""} /></label>
                </div>
              </fieldset>)}
            </div>
            <button type="submit" data-saving-label={copy.saving}>{copy.saveNext}</button>
          </form>
        </>}

        {displayStep === "data_sources" && <>
          <div class="kp-stage-heading" tabindex="-1"><p>05 / 07</p><h2 id="knowledge-pack-step-title">{copy.sourcesTitle}</h2><span>{copy.sourcesBody}</span></div>
          <form hidden={!writable} id="knowledge-pack-form" method="post" class="kp-form" data-guided-form data-validation-form>
            <input type="hidden" name="csrf_token" class="knowledge-pack-csrf" />
            <input type="hidden" name="session_id" value={session.id} />
            <input type="hidden" name="revision" value={session.revision} />
            <input type="hidden" name="idempotency_key" value={requestKey} />
            <input type="hidden" name="action" value="save_step" />
            <input type="hidden" name="step" value="data_sources" />
            <div class="kp-goal-list">
              {goals.map((goal) => {
                const metric = metricMap.get(goal.metric_key);
                const source = sourceByMetric.get(goal.metric_key) ?? { mode: "unknown" };
                return <fieldset class="kp-goal" data-source-row>
                  <legend>{metric?.label ?? goal.metric_key}</legend>
                  <input type="hidden" name="source_metric_key" value={goal.metric_key} />
                  <label><span>{copy.sourceMode}</span><select name="source_mode" data-source-mode>
                    <option value="unknown" selected={source.mode === "unknown"}>{copy.unknown}</option>
                    <option value="manual" selected={source.mode === "manual"}>{copy.manual}</option>
                    {metric?.source_type === "connector" && <option value="connector" selected={source.mode === "connector"}>{copy.connector}</option>}
                  </select></label>
                  <p class="kp-unknown-note" data-source-unknown>{copy.unknownWarning}</p>
                  <div class="kp-fields-2" data-source-manual>
                    <label><span>{copy.currentValue} <em class="kp-required" data-manual-required hidden>{copy.required}</em></span><input type="number" inputmode="decimal" step="any" name="initial_value" value={source.initial_value ?? ""} /></label>
                    <label><span>{copy.observedAt}</span><input type="datetime-local" name="observed_at" value={dateTimeValue(source.observed_at)} /></label>
                    <label class="kp-span-2"><span>{copy.evidenceRef}</span><input name="evidence_ref" maxlength="2048" value={source.evidence_ref ?? ""} placeholder="https://… / resource:…" /></label>
                  </div>
                  <div data-source-connector>
                    <label><span>{copy.connectionRef} <em class="kp-required" data-connector-required hidden>{copy.required}</em></span><input name="connection_ref" maxlength="512" value={source.connection_ref ?? ""} placeholder="connection:github-actions:primary" /></label>
                  </div>
                </fieldset>;
              })}
            </div>
            <button type="submit" data-saving-label={copy.saving}>{copy.saveNext}</button>
          </form>
        </>}

        {displayStep === "review" && <>
          <div class="kp-stage-heading" tabindex="-1"><p>06 / 07</p><h2 id="knowledge-pack-step-title">{copy.reviewTitle}</h2><span>{copy.reviewBody}</span></div>
          {session.plan ? <div class="kp-review">
            <div class="kp-digest"><span>PLAN DIGEST</span><code>{session.plan.plan_digest}</code></div>
            <article class="kp-review-pack">
              <span>Knowledge Pack</span><h3>{session.plan.knowledge_pack.manifest.title}</h3>
              <p>{session.plan.knowledge_pack.manifest.description}</p>
              <code>{session.plan.knowledge_pack.manifest.pack_id}</code>
            </article>
            <div class="kp-review-grid">
              {session.plan.installation.packs.map((pack: any) => <article>
                <span>{pack.action}</span><strong>{pack.pack_id}</strong><small>v{pack.version}</small>
                {conflictCount(pack.preserved_custom_conflicts) > 0 && <em>{conflictCount(pack.preserved_custom_conflicts)} custom definitions preserved</em>}
              </article>)}
            </div>
            <div class="kp-review-grid">
              <article>
                <span>{copy.visibility}</span>
                <strong>{session.answers?.scope?.scope_type === "project" ? copy.projectScope : copy.tenantScope}</strong>
                {session.answers?.scope?.project_id && <small>{session.answers.scope.project_id}</small>}
              </article>
              {session.plan.goals.map((goal: any) => <article><span>{copy.metric}</span><strong>{goal.metric_key}</strong><small>{goal.direction} · {goal.direction === "range" ? `${goal.target_min}–${goal.target_max}` : goal.target_value}</small></article>)}
              {session.plan.data_sources.map((source: any) => <article><span>{copy.sourceMode}</span><strong>{source.metric_key}</strong><small>{source.mode}</small></article>)}
            </div>
            <p class="kp-fixture-note">✓ {copy.fixtureNote}</p>
            <form hidden={!writable} method="post" class="kp-complete-form" data-guided-form>
              <input type="hidden" name="csrf_token" class="knowledge-pack-csrf" />
              <input type="hidden" name="session_id" value={session.id} />
              <input type="hidden" name="revision" value={session.revision} />
              <input type="hidden" name="idempotency_key" value={requestKey} />
              <input type="hidden" name="action" value="complete" />
              <input type="hidden" name="plan_digest" value={session.plan.plan_digest} />
              <button type="submit" data-saving-label={copy.saving}>{copy.install}</button>
            </form>
          </div> : <form hidden={!writable} method="post" class="kp-form" data-guided-form>
            <input type="hidden" name="csrf_token" class="knowledge-pack-csrf" />
            <input type="hidden" name="session_id" value={session.id} />
            <input type="hidden" name="revision" value={session.revision} />
            <input type="hidden" name="idempotency_key" value={requestKey} />
            <input type="hidden" name="action" value="plan" />
            <button type="submit" data-saving-label={copy.saving}>{copy.createPlan}</button>
          </form>}
        </>}

        {displayStep === "completed" && <div class="kp-completed" tabindex="-1">
          <div class="kp-complete-mark" aria-hidden="true">✓</div>
          <p>07 / 07</p><h2 id="knowledge-pack-step-title">{copy.completedTitle}</h2><span>{copy.completedBody}</span>
          <dl>
            <div><dt>Knowledge Pack</dt><dd>{session.completion?.knowledge_pack?.pack_id}</dd></div>
            <div><dt>{copy.target}</dt><dd>{session.completion?.targets?.length ?? 0}</dd></div>
            <div><dt>{copy.currentValue}</dt><dd>{session.completion?.snapshots?.length ?? 0}</dd></div>
          </dl>
          <div class="kp-complete-actions">
            <a class="button-primary" href={`${session.completion?.workspace_href}?tenant_id=${encodeURIComponent(tenantId)}${session.project_id ? `&project_id=${encodeURIComponent(session.project_id)}` : ""}&lang=${lang}`}>{copy.openWorkspace}</a>
            <a class="button-secondary" href={`/domain-packs?tenant_id=${encodeURIComponent(tenantId)}&lang=${lang}`}>{copy.managePacks}</a>
          </div>
        </div>}
      </section>
    </div>}
  </section>
</BaseLayout>

