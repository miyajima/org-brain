---
import BaseLayout from "../layouts/BaseLayout.astro";
import { dashboardPageParams } from "../lib/dashboard-page";

const { tenantId, projectId, lang } = dashboardPageParams(Astro.url, Astro.request.headers.get("cookie"));
const cookie = Astro.request.headers.get("cookie") ?? "";
const api = (path: string, init: RequestInit = {}) => fetch(new URL(path, Astro.url), { ...init, headers: { cookie, ...(init.headers ?? {}) } });
let message = "";
let error = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const csrf = String(form.get("csrf_token") ?? "");
  const action = String(form.get("action") ?? "");
  let response: Response | null = null;
  if (action === "snapshot") {
    response = await api(`/api/v1/dashboard/organization/knowledge-packs/${encodeURIComponent(String(form.get("installation_id")))}/goals/${encodeURIComponent(String(form.get("goal_link_id")))}/snapshots`, {
      method: "POST",
      headers: { "content-type": "application/json", "x-csrf-token": csrf, "x-idempotency-key": crypto.randomUUID() },
      body: JSON.stringify({ tenant_id: tenantId, value: Number(form.get("value")), observed_at: Date.now(), evidence_ref: String(form.get("evidence_ref") ?? "").trim() || null })
    });
  } else if (action === "import") {
    response = await api(`/api/v1/metric-source-bindings/${encodeURIComponent(String(form.get("source_binding_id")))}/import`, {
      method: "POST",
      headers: { "content-type": "application/json", "x-csrf-token": csrf, "x-idempotency-key": crypto.randomUUID() },
      body: JSON.stringify({ tenant_id: tenantId })
    });
  }
  const payload: any = response ? await response.json().catch(() => null) : null;
  if (response?.ok) message = action === "import" ? "取り込みを開始しました。完了後に値が更新されます。" : "現状値を記録しました。";
  else if (response) error = payload?.error?.message ?? "更新できませんでした。";
}
const response = await api(`/api/v1/dashboard/organization?tenant_id=${encodeURIComponent(tenantId)}${projectId ? `&project_id=${encodeURIComponent(projectId)}` : ""}`);
const payload: any = await response.json().catch(() => null);
const dashboard = payload?.data ?? { knowledge: { decisions: 0, rules: 0, rationales: 0 }, goals: [] };
if (!response.ok && !error) error = payload?.error?.message ?? "ダッシュボードを読み込めませんでした。";
const number = (value: unknown) => typeof value === "number" ? new Intl.NumberFormat(lang).format(value) : "—";
const target = (goal: any) => goal.target.direction === "range" ? `${number(goal.target.min)}〜${number(goal.target.max)}` : number(goal.target.value);
---
<BaseLayout title="組織ダッシュボード" lang={lang} wide>
  <section class="space-y-5">
    <header class="rounded-[22px] border border-white/10 bg-white/[0.04] p-6">
      <p class="surface-label">MEASURE · REVIEW · IMPROVE</p>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-4">
        <div><h1 class="text-3xl font-semibold">判断と目標を、同じ場所で運用する</h1><p class="surface-muted mt-2">Knowledge Packの目標、実測値、共有された判断軸を確認します。unknownは0として扱いません。</p></div>
        <div class="flex gap-2"><a class="button-secondary" href={`/retrospectives?tenant_id=${encodeURIComponent(tenantId)}&lang=${lang}`}>ふりかえり</a><a class="button-secondary" href={`/improvement-actions?tenant_id=${encodeURIComponent(tenantId)}&lang=${lang}`}>改善アクション</a></div>
      </div>
    </header>
    {message && <p class="rounded-xl border border-emerald-400/25 bg-emerald-400/10 p-3 text-emerald-100">{message}</p>}
    {error && <p class="rounded-xl border border-rose-400/25 bg-rose-400/10 p-3 text-rose-100">{error}</p>}
    <section class="grid gap-3 sm:grid-cols-3">
      {[['決定事項', dashboard.knowledge.decisions], ['共有ルール', dashboard.knowledge.rules], ['判断理由', dashboard.knowledge.rationales]].map(([label, value]) => <article class="rounded-[18px] border border-white/8 bg-black/20 p-5"><p class="text-sm text-zinc-400">{label}</p><p class="mt-2 text-3xl font-semibold">{value}</p></article>)}
    </section>
    <section class="rounded-[22px] border border-white/8 bg-white/[0.025] p-5">
      <div class="flex flex-wrap items-end justify-between gap-3"><div><p class="surface-label">KNOWLEDGE PACK GOALS</p><h2 class="mt-1 text-xl font-semibold">目標と現状値</h2></div><a href={`/knowledge-packs/onboarding?tenant_id=${encodeURIComponent(tenantId)}${projectId ? `&project_id=${encodeURIComponent(projectId)}` : ''}&lang=${lang}`}>Knowledge Packを追加</a></div>
      <div class="mt-4 grid gap-4 lg:grid-cols-2">
        {dashboard.goals.map((goal: any) => <article class="rounded-2xl border border-white/8 bg-zinc-950/55 p-5">
          <div class="flex items-start justify-between gap-3"><div><p class="text-xs text-zinc-500">{goal.pack_title}</p><h3 class="mt-1 font-semibold">{goal.metric_label}</h3></div><span class:list={["rounded-full px-2 py-1 text-xs", goal.current.state === "measured" ? "bg-emerald-400/15 text-emerald-200" : "bg-amber-400/15 text-amber-200"]}>{goal.current.state}</span></div>
          <div class="mt-5 grid grid-cols-2 gap-3"><div><p class="text-xs text-zinc-500">現状</p><p class="mt-1 text-3xl font-semibold">{number(goal.current.value)} <span class="text-sm text-zinc-500">{goal.unit}</span></p></div><div><p class="text-xs text-zinc-500">目標</p><p class="mt-1 text-2xl font-semibold">{target(goal)} <span class="text-sm text-zinc-500">{goal.unit}</span></p></div></div>
          {goal.source.binding_id ? <form method="post" class="mt-5"><input type="hidden" name="csrf_token" class="measurement-csrf"/><input type="hidden" name="action" value="import"/><input type="hidden" name="source_binding_id" value={goal.source.binding_id}/><button type="submit">GitHub Actionsから取り込む</button><p class="mt-2 text-xs text-zinc-500">{goal.source.status} · 最終成功 {goal.source.last_success_at ? new Date(goal.source.last_success_at).toLocaleString(lang) : '未実行'}</p></form> : <form method="post" class="mt-5 grid gap-3 sm:grid-cols-[1fr_1fr_auto]"><input type="hidden" name="csrf_token" class="measurement-csrf"/><input type="hidden" name="action" value="snapshot"/><input type="hidden" name="installation_id" value={goal.link.knowledge_pack_installation_id}/><input type="hidden" name="goal_link_id" value={goal.link.id}/><label><span class="field-label">現状値</span><input name="value" type="number" step="any" required/></label><label><span class="field-label">根拠URL・参照</span><input name="evidence_ref" placeholder="https://…"/></label><button class="self-end" type="submit">記録</button></form>}
        </article>)}
        {dashboard.goals.length === 0 && <div class="rounded-xl border border-dashed border-white/10 p-8 text-center"><p class="text-zinc-300">目標はまだありません。</p><p class="surface-muted mt-2">Knowledge Packを作成すると、ここから計測を開始できます。</p></div>}
      </div>
    </section>
  </section>
</BaseLayout>
<script>document.querySelectorAll<HTMLInputElement>(".measurement-csrf").forEach((input) => { input.value = sessionStorage.getItem("orgbrain_csrf") ?? ""; });</script>
