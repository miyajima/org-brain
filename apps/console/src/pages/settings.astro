---
import OperatorLayout from "../layouts/OperatorLayout.astro";
import ApiForm from "../components/operator/ApiForm.astro";
import AccessSettings from "../components/operator/AccessSettings.astro";
import AgentWorkspace from "../components/operator/AgentWorkspace.astro";
import SkillGeneration from "../components/operator/SkillGeneration.astro";
import TaskWorkspace from "../components/operator/TaskWorkspace.astro";
import PackWorkspace from "../components/operator/PackWorkspace.astro";
import MetricWorkspace from "../components/operator/MetricWorkspace.astro";
import RetrospectiveWorkspace from "../components/operator/RetrospectiveWorkspace.astro";
import ImprovementWorkspace from "../components/operator/ImprovementWorkspace.astro";
import { loadConsoleCapabilities } from "../lib/capabilities";
import { operatorRequestUrl, operatorScope, operatorHref, viewHref, apiScope, readConsoleData, operatorIdentity, localText, asRows, displayDate, displayNumber, stateLabel, type ConsoleResult } from "../lib/operator-console";
const navigationUrl = operatorRequestUrl(Astro.request);
const { tenantId, projectId, lang } = operatorScope(Astro.url, Astro.request.headers.get("cookie"));
const t = localText(lang), scope = apiScope(Astro.url, Astro.request.headers.get("cookie"));
const [identity, capabilities] = await Promise.all([operatorIdentity(Astro.request), loadConsoleCapabilities(Astro.request)]);
const context = identity.data?.console_context;
const permissions: string[] = context?.effective_permissions || [];
const canWrite = permissions.includes("write") || permissions.includes("admin");
const admin = permissions.includes("admin");
const organizational = context?.mode !== "personal";
const canShare = admin || permissions.includes("share");
const nav = [
 { group:t("組織と権限", "Organization & access", "组织与权限"), items:[
  { id:"organization", label:t("組織", "Organization", "组织"), description:t("組織名、参加条件、所有者の設定", "Organization details, joining rules and ownership", "组织名称、加入条件和所有者设置"), allowed:organizational && context?.can_manage_groups },
  { id:"users", label:t("ユーザー", "Users", "用户"), description:t("招待、利用状態、役割の管理", "Invitations, status and roles", "邀请、使用状态和角色管理"), allowed:organizational && context?.can_manage_users },
  { id:"groups", label:t("グループ", "Groups", "群组"), description:t("チームごとのメンバーとアクセス", "Team members and access", "各团队成员与访问权限"), allowed:organizational && context?.can_manage_groups },
  { id:"categories", label:t("業務分類", "Business categories", "业务分类"), description:t("業務別の知識の整理", "Organize knowledge by business area", "按业务整理知识"), allowed:organizational && context?.can_manage_groups },
  { id:"profile", label:t("プロフィール", "Profile", "个人资料"), description:t("自分の表示名と所属情報", "Your display name and affiliation", "个人显示名称与所属信息"), allowed:!!identity.data }
 ]},
 { group:t("AI接続と配布", "AI connections & delivery", "AI连接与分配"), items:[
  { id:"connections", label:t("AIの接続", "AI connections", "AI连接"), description:t("接続する端末の登録と無効化", "Register and revoke connected devices", "登记和停用连接设备"), allowed:context?.can_manage_clients },
  { id:"agents", label:t("エージェント", "Agents", "代理"), description:t("AIの役割と渡す知識の構成", "AI roles and assigned knowledge", "AI角色与知识分配"), allowed:!!identity.data },
  { id:"skills", label:t("スキル", "Skills", "技能"), description:t("確認済みの知識から作る作業手順", "Reusable procedures from reviewed knowledge", "基于已确认知识的可复用流程"), allowed:!!identity.data }
 ]},
 { group:t("運用と拡張", "Operations & extensions", "运维与扩展"), items:[
  { id:"operations", label:t("処理状況", "Processing", "处理状态"), description:t("失敗、定期実行、処理のやり直し", "Failures, scheduled work and recovery", "失败、定期任务与恢复"), allowed:admin || permissions.includes("task:replay") },
  ...[
   ["packs","domain_packs",t("業務パック", "Domain packs", "业务包"),t("業務別の知識と指標を導入", "Install domain knowledge and metrics", "安装业务知识与指标")],
   ["metrics","domain_metrics",t("業務指標", "Business metrics", "业务指标"),t("指標、観測値、目標の管理", "Metrics, observations and targets", "指标、观察值与目标管理")],
   ["retrospectives","retrospective",t("振り返り", "Retrospectives", "复盘"),t("振り返りの実施と履歴", "Run and review retrospectives", "开展和查看复盘")],
   ["improvements","improvement_actions",t("改善アクション", "Improvement actions", "改进行动"),t("改善の実行状況と検証", "Track and verify improvements", "跟踪和验证改进")]
  ].map(([id,cap,label,description]) => ({ id,label,description,allowed:capabilities?.[cap]?.enabled === true }))
 ]}
];
const items = nav.flatMap(group => group.items).filter(item => item.allowed);
const requested = Astro.url.searchParams.get("section") || "overview";
const selected = items.find(item => item.id === requested);
const section = requested === "overview" ? "overview" : selected?.id || "unavailable";
const query = Astro.url.searchParams.get("q") || "";
const offset = Math.max(0,parseInt(Astro.url.searchParams.get("offset") || "0",10) || 0);
const selectedId = Astro.url.searchParams.get("id") || Astro.url.searchParams.get("agent_id") || Astro.url.searchParams.get("skill_id") || "";
const endpoints: Record<string,string> = {
 organization:"/api/v1/organization",users:"/api/v1/users",groups:"/api/v1/groups",categories:"/api/v1/business-categories",connections:"/api/v1/mcp-client-installations",agents:"/api/v1/agents",skills:"/api/v1/skills",operations:"/api/v1/ops/status",packs:"/api/v1/domain-packs",metrics:"/api/v1/metrics/query",retrospectives:"/api/v1/retrospectives",improvements:"/api/v1/improvement-actions"
};
const endpoint = ["packs","metrics","retrospectives","improvements"].includes(section) ? undefined : endpoints[section];
const result: ConsoleResult = endpoint ? await readConsoleData(Astro.request,`${endpoint}?${scope}&limit=25&offset=${offset}${query ? `&q=${encodeURIComponent(query)}` : ""}`) : {data:null,error:null};
const records = asRows(result.data,"users","groups","categories","installations","items","agents","assets","metrics","packs");
const [agentDetail,skillDetail] = await Promise.all([
 section === "agents" && selectedId ? readConsoleData(Astro.request,`/api/v1/agents/${encodeURIComponent(selectedId)}?${scope}`) : {data:null,error:null},
 section === "skills" && selectedId ? readConsoleData(Astro.request,`/api/v1/skills/${encodeURIComponent(selectedId)}?${scope}`) : {data:null,error:null}
]);
const selectedRecord = section === "agents" ? agentDetail.data?.agent : section === "skills" ? skillDetail.data?.asset : records.find(item => String(item.id || item.principal) === selectedId);
const groupDetail = section === "groups" && selectedId ? await readConsoleData(Astro.request,`/api/v1/groups/${encodeURIComponent(selectedId)}?${scope}`) : {data:null,error:null};
const publishedSkills = section === "agents" && selectedRecord ? await readConsoleData(Astro.request,`/api/v1/skills?${scope}&status=published&limit=100`) : {data:null,error:null};
const ownerMappings = section === "organization" && result.data ? await readConsoleData(Astro.request,`/api/v1/principal-owner-mappings?${scope}`) : {data:null,error:null};
const organization = result.data || {};
const profile = identity.data?.profile || {};
const save = t("変更を保存", "Save changes", "保存更改");
const roles: Array<[string,string]> = [["reader",t("閲覧者", "Reader", "查看者")],["contributor",t("編集者", "Contributor", "编辑者")],["tenant_admin",t("管理者", "Administrator", "管理员")],["auditor",t("監査者", "Auditor", "审计者")]];
const roleLabel = (value:string) => roles.find(([key])=>key===value)?.[1] || value;

---
<OperatorLayout title={t("管理", "Manage", "管理")} active="settings">
 <div class="op-page-heading"><div><h1>{t("管理", "Manage", "管理")}</h1><p>{t("知識が安心して使われるための、組織・接続・運用の設定。", "Organization, connections and operations that keep knowledge useful and trusted.", "通过组织、连接与运维设置，让知识可靠地发挥作用。")}</p></div></div>
 {Astro.request.method === "GET" && Astro.url.searchParams.get("saved") === "1" && <p class="op-notice" role="status">{t("変更を保存しました。", "Changes saved.", "更改已保存。")}</p>}
 {identity.error && <p class="op-notice" data-tone="error" role="alert">{t("現在の権限を確認できません。管理操作は表示していません。", "Your permissions could not be verified. Management actions are unavailable.", "无法确认当前权限，暂不显示管理操作。")} <a href={Astro.url.pathname+Astro.url.search}>{t("再試行", "Retry", "重试")}</a></p>}
 <div class="op-settings-layout"><nav class="op-settings-nav" aria-label={t("管理項目", "Management sections", "管理项目")}><a href={operatorHref(navigationUrl,"/settings")} aria-current={section === "overview" ? "page":undefined}>{t("管理のホーム", "Management home", "管理首页")}</a>{nav.map(group => <>{group.items.some(item=>item.allowed) && <h2>{group.group}</h2>}{group.items.filter(item=>item.allowed).map(item=><a href={operatorHref(navigationUrl,"/settings",{section:item.id})} aria-current={section===item.id?"page":undefined}>{item.label}</a>)}</>)}</nav>
 <div class="op-settings-content">
  {section === "overview" && <>{nav.map(group => group.items.some(item=>item.allowed) && <section class="op-panel"><div class="op-panel-heading"><h2>{group.group}</h2></div>{group.items.filter(item=>item.allowed).map(item=><a class="op-row" href={operatorHref(navigationUrl,"/settings",{section:item.id})}><div class="op-row-main"><strong>{item.label}</strong><p>{item.description}</p></div><span class="op-row-end">{t("開く", "Open", "打开")}</span></a>)}</section>)}</>}
  {section === "unavailable" && <section class="op-panel"><div class="op-empty" role="alert"><strong>{t("この管理項目は利用できません", "This management section is unavailable", "此管理项目不可用")}</strong>{t("アクセス権または機能の提供状態を確認してください。", "Check your access and feature availability.", "请检查访问权限与功能状态。")}</div></section>}
  {selected && <div class="op-settings-intro"><h2>{selected.label}</h2><p>{selected.description}</p></div>}
  {(agentDetail.error || skillDetail.error) && <p class="op-notice" data-tone="error" role="alert">{agentDetail.error || skillDetail.error}</p>}
  {result.error && <p class="op-notice" data-tone="error" role="alert">{result.error} <a href={Astro.url.pathname+Astro.url.search}>{t("再試行", "Retry", "重试")}</a></p>}
  {section === "organization" && result.data && <section class="op-panel"><div class="op-panel-heading"><h3>{t("組織の基本情報", "Organization details", "组织基本信息")}</h3></div><div class="op-panel-body"><ApiForm endpoint="/api/v1/organization" method="PATCH" hidden={{tenant_id:tenantId}} submit={save} fields={[
   {name:"display_name",label:t("組織名", "Display name", "组织名称"),value:organization.display_name,required:true},
   {name:"slug",label:t("組織の識別名", "Organization slug", "组织标识"),value:organization.slug,required:true},
   {name:"allowed_email_domains",label:t("参加を許可するメールドメイン（カンマ区切り）", "Allowed email domains (comma-separated)", "允许加入的邮箱域名（逗号分隔）"),value:(organization.allowed_email_domains||[]).join(", "),dataType:"array"},
   {name:"email_self_registration_enabled",label:t("許可したドメインからの参加を有効にする", "Allow registration from approved domains", "允许获准域名的用户注册"),type:"checkbox",value:organization.email_self_registration_enabled}
  ]}/></div></section>}
  {section === "organization" && result.data && <section class="op-panel"><details class="op-disclosure"><summary>{t("記録するAIと所有者の対応", "Recording clients and owners", "记录客户端与所有者的对应")}</summary><p class="op-muted" style="margin-bottom:18px">{t("AIが記録した知識を、どのユーザーの所有として扱うかを設定します。", "Choose which user owns knowledge recorded by an AI client.", "设置由AI客户端记录的知识归属于哪个用户。")}</p>{ownerMappings.error && <p class="op-notice" data-tone="error">{ownerMappings.error}</p>}{asRows(ownerMappings.data).map(item=><dl class="op-definition"><dt>{item.producer_principal}</dt><dd>{item.owner_principal}</dd></dl>)}<ApiForm endpoint="/api/v1/principal-owner-mappings" method="PUT" hidden={{tenant_id:tenantId}} submit={t("対応を保存", "Save mapping", "保存对应关系")} fields={[{name:"producer_principal",label:t("記録するAIの識別子", "Recording client principal", "记录客户端标识"),required:true},{name:"owner_principal",label:t("所有者の識別子", "Owner principal", "所有者标识"),required:true}]}/></details></section>}
  {section === "profile" && identity.data && <section class="op-panel"><div class="op-panel-heading"><h3>{t("自分の情報", "Your details", "个人信息")}</h3></div><div class="op-panel-body"><p class="op-muted" style="margin-bottom:20px">{profile.email || identity.data.auth?.email}</p><details class="op-edit" style="margin-bottom:20px"><summary>{t("技術情報", "Technical details", "技术信息")}</summary><dl class="op-definition"><dt>{t("本人の識別子", "Principal", "身份标识")}</dt><dd>{identity.data.auth?.principal || "—"}</dd><dt>{t("認証方式", "Authentication", "认证方式")}</dt><dd>{identity.data.auth?.source || "—"}</dd></dl></details><ApiForm endpoint="/api/v1/auth/me/profile" method="PUT" hidden={{tenant_id:tenantId}} submit={save} fields={[
   {name:"display_name",label:t("表示名", "Display name", "显示名称"),value:profile.display_name,required:true},
   {name:"full_name",label:t("氏名", "Full name", "姓名"),value:profile.full_name},
   {name:"company_name",label:t("会社名", "Company name", "公司名称"),value:profile.company_name},
   {name:"organization_name",label:t("所属", "Organization", "所属组织"),value:profile.organization_name}
  ]}/></div></section>}
  {["agents","skills"].includes(section) && <form class="op-search-form" role="search"><input type="hidden" name="section" value={section}/><input type="hidden" name="tenant_id" value={tenantId}/><input type="hidden" name="project_id" value={projectId}/><input type="hidden" name="lang" value={lang}/><label class="op-search-input"><span class="op-sr">{section==="agents"?t("エージェントを検索", "Search agents", "搜索代理"):t("スキルを検索", "Search skills", "搜索技能")}</span><input type="search" name="q" value={query} placeholder={t("名前や用途から検索", "Search by name or purpose", "按名称或用途搜索")}/></label><button type="submit">{t("検索", "Search", "搜索")}</button></form>}
  {section === "users" && !result.error && <>
   <form class="op-search-form" role="search"><input type="hidden" name="section" value="users"/><input type="hidden" name="tenant_id" value={tenantId}/><input type="hidden" name="lang" value={lang}/><input type="hidden" name="project_id" value={projectId}/><label class="op-search-input"><span class="op-sr">{t("ユーザーを検索", "Search users", "搜索用户")}</span><input type="search" name="q" value={query} placeholder={t("名前・メールアドレス", "Name or email", "姓名或邮箱")}/></label><button type="submit">{t("検索", "Search", "搜索")}</button></form>
   <section class="op-panel"><div class="op-panel-heading"><h3>{t("登録済みのユーザー", "Existing users", "已登记用户")}</h3><span class="op-small">{displayNumber(result.data?.meta?.total,lang)}</span></div>{records.map(user=><details class="op-disclosure"><summary>{user.full_name || user.display_name} <span class="op-badge">{roleLabel(user.role)}</span> <span class="op-small">{user.email}</span></summary><ApiForm endpoint={`/api/v1/users/${encodeURIComponent(user.principal)}?${scope}`} method="PATCH" hidden={{tenant_id:tenantId}} submit={save} confirm={t(`${user.display_name} の利用状態と権限を変更します。`, `Change ${user.display_name}’s status and access.`, `更改 ${user.display_name} 的使用状态和权限。`)} fields={[
    {name:"display_name",label:t("表示名", "Display name", "显示名称"),value:user.display_name,required:true},
    {name:"full_name",label:t("氏名", "Full name", "姓名"),value:user.full_name,disabled:user.full_name_source==="scim"},
    {name:"role",label:t("役割", "Role", "角色"),type:"select",value:user.role,options:roles},
    {name:"status",label:t("利用状態", "Status", "使用状态"),type:"select",value:user.status,options:["invited","active","suspended","deprovisioned"].map(value=>[value,stateLabel(value,lang)])}
   ]}/></details>)}{!records.length && <p class="op-empty">{t("一致するユーザーはありません。", "No matching users.", "没有匹配的用户。")}</p>}{result.data?.meta?.has_next && <div class="op-panel-body"><a href={viewHref(navigationUrl,{offset:String(offset+25)})}>{t("次のユーザー", "Next users", "下一页用户")}</a></div>}{offset>0 && <div class="op-panel-body"><a href={viewHref(navigationUrl,{offset:String(Math.max(0,offset-25))})}>{t("前のユーザー", "Previous users", "上一页用户")}</a></div>}</section>
   <section class="op-panel"><details class="op-disclosure"><summary>{t("ユーザーを招待", "Invite user", "邀请用户")}</summary><ApiForm endpoint="/api/v1/users" hidden={{tenant_id:tenantId}} submit={t("招待を作成", "Create invitation", "创建邀请")} confirmFields="email,role" recovery={t("招待後も利用状態と役割を変更できます。", "Status and role can be changed after invitation.", "邀请后仍可更改使用状态和角色。 ")} confirm={t("入力したメールアドレスのユーザーを、指定した役割で組織へ招待します。", "Invite the specified email to this organization with the selected role.", "以所选角色邀请指定邮箱的用户加入组织。")} fields={[
    {name:"email",label:t("メールアドレス", "Email", "邮箱"),type:"email",required:true},
    {name:"display_name",label:t("表示名", "Display name", "显示名称"),required:true},
    {name:"full_name",label:t("氏名（任意）", "Full name (optional)", "姓名（可选）"),dataType:"nullable"},
    {name:"role",label:t("役割", "Role", "角色"),type:"select",value:"reader",options:roles}
   ]}/></details></section>
  </>}
  {section === "groups" && !result.error && <><section class="op-panel">{records.map(group=><a class="op-row" href={viewHref(navigationUrl,{id:group.id})}><div class="op-row-main"><strong>{group.name}</strong><p>{group.description}</p></div><span class="op-row-end">{t("メンバーを確認", "View members", "查看成员")}</span></a>)}{!records.length&&<p class="op-empty">{t("グループはまだありません。", "No groups yet.", "暂无群组。")}</p>}</section>{groupDetail.error&&<p class="op-notice" data-tone="error">{groupDetail.error}</p>}{groupDetail.data&&<section class="op-panel"><div class="op-panel-heading"><h3>{groupDetail.data.group?.name}</h3></div>{asRows(groupDetail.data,"members").map(member=><details class="op-disclosure"><summary>{member.display_name||member.principal}<span class="op-small">{member.role}</span></summary><details class="op-edit"><summary>{t("技術情報", "Technical details", "技术信息")}</summary><p class="op-small">{member.principal}</p></details>{member.can_remove && groupDetail.data?.group?.source === "local" ? <ApiForm endpoint={`/api/v1/groups/${encodeURIComponent(selectedId)}/members/${encodeURIComponent(member.principal)}?${scope}`} method="DELETE" submit={t("削除の影響を確認", "Review removal impact", "查看移除影响")} impactEndpoint={`/api/v1/groups/${encodeURIComponent(selectedId)}/members/${encodeURIComponent(member.principal)}/impact?${scope}`}/> : <div style="padding-bottom:18px"><p class="op-muted">{member.removal_block_reason === "self_owner" ? t("所有者である自分自身は解除できません。別の所有者を追加してください。", "You cannot remove yourself while you are an owner. Add another owner first.", "作为所有者，您无法移除自己。请先添加其他所有者。"):t("このメンバーはここから解除できません。管理権限を確認してください。", "This member cannot be removed here. Check your permissions.", "无法在此移除此成员，请检查管理权限。")}</p><a href="#add-group-member">{t("別の所有者を追加", "Add another owner", "添加其他所有者")}</a></div>}</details>)}{groupDetail.data.group?.source==="local"&&<div class="op-panel-body" id="add-group-member"><ApiForm endpoint={`/api/v1/groups/${encodeURIComponent(selectedId)}/members`} hidden={{tenant_id:tenantId}} submit={t("メンバーを追加", "Add member", "添加成员")} confirm={t("このグループへのアクセスを付与します。", "Grant access through this group.", "通过此群组授予访问权限。")} fields={[{name:"principal",label:t("ユーザーの識別子", "User principal", "用户标识"),required:true},{name:"role",label:t("グループ内の役割", "Group role", "群组角色"),type:"select",value:"member",options:[["member",t("メンバー", "Member", "成员")],["owner",t("所有者", "Owner", "所有者")]]}]}/></div>}</section>}<section class="op-panel"><details class="op-disclosure"><summary>{t("グループを作成", "Create group", "创建群组")}</summary><ApiForm endpoint="/api/v1/groups" hidden={{tenant_id:tenantId}} submit={t("作成", "Create", "创建")} fields={[{name:"name",label:t("グループ名", "Group name", "群组名称"),required:true},{name:"slug",label:t("識別名", "Slug", "标识")},{name:"description",label:t("説明", "Description", "说明"),type:"textarea"}]}/></details></section></>}
  {section==="categories"&&!result.error&&<><section class="op-panel">{records.map(item=><details class="op-disclosure"><summary>{item.label}</summary><ApiForm endpoint={`/api/v1/business-categories/${encodeURIComponent(item.id)}`} method="PATCH" hidden={{tenant_id:tenantId}} submit={save} fields={[{name:"label",label:t("分類名", "Label", "分类名称"),value:item.label,required:true},{name:"slug",label:t("識別名", "Slug", "标识"),value:item.slug,required:true},{name:"description",label:t("説明", "Description", "说明"),value:item.description},{name:"is_active",label:t("有効", "Active", "有效"),type:"checkbox",value:item.is_active===true}]}/></details>)}{!records.length&&<p class="op-empty">{t("業務分類はまだありません。", "No categories yet.", "暂无业务分类。")}</p>}</section><section class="op-panel"><details class="op-disclosure"><summary>{t("業務分類を追加", "Add category", "添加业务分类")}</summary><ApiForm endpoint="/api/v1/business-categories" hidden={{tenant_id:tenantId}} submit={t("追加", "Add", "添加")} fields={[{name:"label",label:t("分類名", "Label", "分类名称"),required:true},{name:"slug",label:t("識別名", "Slug", "标识"),required:true},{name:"description",label:t("説明", "Description", "说明")},{name:"is_active",label:t("有効", "Active", "有效"),type:"checkbox",value:true}]}/></details></section></>}
