---
import BaseLayout from "../layouts/BaseLayout.astro";
const tenantId = Astro.url.searchParams.get("tenant_id")?.trim() || "default";
const cookie = Astro.request.headers.get("cookie") ?? "";
const api = async (path: string, init: RequestInit = {}) => fetch(new URL(path, Astro.url), {
  ...init, headers: { cookie, ...(init.headers ?? {}) }
});
let message = ""; let error = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const response = await api("/api/v1/organization", { method: "PATCH", headers: {
    "content-type": "application/json",
    "x-csrf-token": String(form.get("csrf_token") ?? "")
  }, body: JSON.stringify({
    tenant_id: tenantId,
    slug: String(form.get("slug") ?? ""),
    display_name: String(form.get("display_name") ?? ""),
    allowed_email_domains: String(form.get("allowed_email_domains") ?? "").split(/[\s,]+/u).filter(Boolean),
    email_self_registration_enabled: form.get("email_self_registration_enabled") === "on"
  }) });
  if (response.ok) message = "Saved"; else error = "Organization could not be saved";
}
const response = await api(`/api/v1/organization?tenant_id=${encodeURIComponent(tenantId)}`);
const payload: any = await response.json().catch(() => null);
const organization = payload?.data;
---
<BaseLayout title="Organization">
  <section class="space-y-5">
    <header class="rounded-[22px] border border-white/10 bg-white/[0.04] p-5"><p class="surface-label">{tenantId}</p><h1 class="mt-2 text-3xl font-semibold">Organization</h1></header>
    {message && <p class="text-emerald-200">{message}</p>}{error && <p class="text-rose-200">{error}</p>}
    <form method="post" class="grid gap-4 rounded-[22px] border border-white/8 bg-zinc-950/50 p-5 md:grid-cols-2">
      <input type="hidden" name="csrf_token" id="csrf-token" />
      <label><span class="field-label">Display name</span><input name="display_name" value={organization?.display_name ?? tenantId} required /></label>
      <label><span class="field-label">Slug</span><input name="slug" value={organization?.slug ?? tenantId} required /></label>
      <label class="md:col-span-2"><span class="field-label">Allowed email domains</span><input name="allowed_email_domains" value={(organization?.allowed_email_domains ?? []).join(", ")} /></label>
      <label class="flex items-center gap-2"><input type="checkbox" name="email_self_registration_enabled" checked={organization?.email_self_registration_enabled} /> Allow email self-registration</label>
      <div class="md:col-span-2"><button type="submit">Save</button></div>
    </form>
  </section>
</BaseLayout>
<script>
  const csrfInput = document.querySelector<HTMLInputElement>("#csrf-token");
  if (csrfInput) csrfInput.value = sessionStorage.getItem("orgbrain_csrf") ?? "";
</script>
