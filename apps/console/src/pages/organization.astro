---
import { createServerApi } from "../lib/server-api";
const serverApi = createServerApi(Astro.request);
import BaseLayout from "../layouts/BaseLayout.astro";
import AdminPageHeader from "../components/admin/AdminPageHeader.astro";
import LiveNotice from "../components/admin/LiveNotice.astro";
import { dashboardPageParams } from "../lib/dashboard-page";
import { organizationCopy } from "../lib/console-locale";
const { tenantId, lang } = dashboardPageParams(Astro.url, Astro.request.headers.get("cookie"));
const copy = organizationCopy(lang);

const api = async (path: string, init: RequestInit = {}) => serverApi(new URL(path, Astro.url), {
  ...init, headers: init.headers
});
let message = ""; let error = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "organization");
  const response = action === "mapping"
    ? await api("/api/v1/principal-owner-mappings", {
        method: "PUT",
        headers: {
          "content-type": "application/json",
          "x-csrf-token": String(form.get("csrf_token") ?? "")
        },
        body: JSON.stringify({
          tenant_id: tenantId,
          producer_principal: String(form.get("producer_principal") ?? ""),
          owner_principal: String(form.get("owner_principal") ?? "")
        })
      })
    : await api("/api/v1/organization", { method: "PATCH", headers: {
        "content-type": "application/json",
        "x-csrf-token": String(form.get("csrf_token") ?? "")
      }, body: JSON.stringify({
        tenant_id: tenantId,
        slug: String(form.get("slug") ?? ""),
        display_name: String(form.get("display_name") ?? ""),
        allowed_email_domains: String(form.get("allowed_email_domains") ?? "").split(/[\s,]+/u).filter(Boolean),
        email_self_registration_enabled: form.get("email_self_registration_enabled") === "on"
      }) });
  if (response.ok) message = action === "mapping" ? copy.mappingSaved : copy.saved;
  else error = action === "mapping" ? copy.mappingError : copy.saveError;
}
const response = await api(`/api/v1/organization?tenant_id=${encodeURIComponent(tenantId)}`);
const payload: any = await response.json().catch(() => null);
const organization = payload?.data;
const mappingsResponse = await api(`/api/v1/principal-owner-mappings?tenant_id=${encodeURIComponent(tenantId)}`);
const mappingsPayload: any = await mappingsResponse.json().catch(() => null);
const mappings = mappingsResponse.ok && Array.isArray(mappingsPayload?.data) ? mappingsPayload.data : [];
---
<BaseLayout title={copy.title} lang={lang}>
  <section class="admin-page">
    <AdminPageHeader eyebrow={tenantId} title={copy.title} />
    {message && <LiveNotice message={message} />}{error && <LiveNotice tone="error" message={error} />}
    <form method="post" class="admin-section admin-form-grid">
      <input type="hidden" name="action" value="organization" />
      <input type="hidden" name="csrf_token" id="csrf-token" />
      <label><span class="field-label">{copy.displayName}</span><input name="display_name" value={organization?.display_name ?? tenantId} required /></label>
      <label><span class="field-label">{copy.slug}</span><input name="slug" value={organization?.slug ?? tenantId} required /></label>
      <label><span class="field-label">{copy.domains}</span><input name="allowed_email_domains" value={(organization?.allowed_email_domains ?? []).join(", ")} /></label>
      <label class="checkbox-label"><input type="checkbox" name="email_self_registration_enabled" checked={organization?.email_self_registration_enabled} /> {copy.selfRegistration}</label>
      <div class="admin-form-actions"><button type="submit">{copy.save}</button></div>
    </form>

    <section class="grid gap-4 rounded-[22px] border border-amber-300/15 bg-amber-300/[0.04] p-5">
      <div>
        <p class="surface-label">{copy.ownership}</p>
        <h2 class="mt-2 text-xl font-semibold text-white">{copy.mappings}</h2>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-zinc-300">{copy.mappingBody}</p>
        <p class="mt-2 max-w-2xl text-xs leading-5 text-zinc-500">{copy.principalHelp}</p>
      </div>
      <form method="post" class="grid gap-4 md:grid-cols-2 md:items-end">
        <input type="hidden" name="action" value="mapping" />
        <input type="hidden" name="csrf_token" id="mapping-csrf-token" />
        <label><span class="field-label">{copy.producer}</span><input name="producer_principal" placeholder="service:codex-hook" required /></label>
        <label><span class="field-label">{copy.owner}</span><input name="owner_principal" placeholder="user:member" required /></label>
        <div class="md:col-span-2"><button type="submit">{copy.saveMapping}</button></div>
      </form>
      {mappings.length > 0 ? (
        <div class="overflow-x-auto rounded-xl border border-white/8">
          <table class="w-full text-left text-sm">
            <thead class="bg-white/[0.04] text-xs uppercase tracking-[0.14em] text-zinc-400"><tr><th class="px-3 py-3">{copy.producer}</th><th class="px-3 py-3">{copy.owner}</th><th class="px-3 py-3">{copy.updated}</th></tr></thead>
            <tbody>{mappings.map((mapping: any) => <tr class="border-t border-white/8 text-zinc-300"><td class="px-3 py-3 font-mono text-xs">{mapping.producer_principal}</td><td class="px-3 py-3 font-mono text-xs">{mapping.owner_principal}</td><td class="px-3 py-3 text-xs text-zinc-400">{new Date(mapping.updated_at).toLocaleString(lang === "ja" ? "ja-JP" : lang === "zh" ? "zh-CN" : "en-US")}</td></tr>)}</tbody>
          </table>
        </div>
      ) : <p class="admin-empty" role="status">{copy.empty}</p>}
    </section>
  </section>
</BaseLayout>
<script>
  const csrfInput = document.querySelector<HTMLInputElement>("#csrf-token");
  if (csrfInput) csrfInput.value = sessionStorage.getItem("orgbrain_csrf") ?? "";
  const mappingCsrfInput = document.querySelector<HTMLInputElement>("#mapping-csrf-token");
  if (mappingCsrfInput) mappingCsrfInput.value = sessionStorage.getItem("orgbrain_csrf") ?? "";
</script>
