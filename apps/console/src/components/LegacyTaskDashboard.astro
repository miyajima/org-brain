---
import {
  DASHBOARD_TASK_STATUSES,
  type DashboardTask
} from "../lib/dashboard-page";
import { dashboardLabel, dashboardStatusTone } from "../lib/dashboard-copy";
import { taskDashboardCopy } from "../lib/console-locale";

const {
  tasks,
  error = null,
  params,
  lang = "en",
  page = 0,
  pageSize = 20,
  query = "",
  status = "",
  hasMore = false
} = Astro.props as {
  tasks: DashboardTask[];
  error?: string | null;
  params: URLSearchParams;
  lang?: "en" | "ja" | "zh";
  page?: number;
  pageSize?: number;
  query?: string;
  status?: string;
  hasMore?: boolean;
};

const copy = taskDashboardCopy(lang);

const visibleTasks = tasks.slice(0, pageSize);
const statuses = [...new Set([
  ...DASHBOARD_TASK_STATUSES,
  ...visibleTasks.map((task) => task.status)
])];
const path = Astro.url.pathname;
const scopedParams = () => {
  const next = new URLSearchParams();
  for (const key of ["tenant_id", "project_id", "lang"]) {
    const value = params.get(key);
    if (value) next.set(key, value);
  }
  return next;
};
const pageHref = (nextPage: number) => {
  const next = new URLSearchParams(params);
  if (nextPage > 0) next.set("task_page", String(nextPage));
  else next.delete("task_page");
  return `${path}?${next.toString()}`;
};
const clearHref = () => {
  const next = scopedParams();
  return `${path}?${next.toString()}`;
};
const hiddenScope = [...scopedParams().entries()];
const retryHref = `${path}${Astro.url.search}`;
const taskHref = (taskId: string) => {
  const next = scopedParams();
  return `/tasks/${encodeURIComponent(taskId)}${next.size ? `?${next.toString()}` : ""}`;
};
const countSuffix = hasMore ? "+" : "";
const resultLabel = copy.results
  .replace("{count}", String(visibleTasks.length))
  .replace("{suffix}", countSuffix)
  .replace("{page}", String(page + 1));
const counters = visibleTasks.reduce<Record<string, number>>((acc, task) => {
  acc[task.status] = (acc[task.status] ?? 0) + 1;
  return acc;
}, {});
const label = (kind: "status" | "capability", value: string) => dashboardLabel(kind, value, lang);
---

{error && (
  <div class="intelligence-route-alert" role="alert">
    <strong>{copy.unavailable}</strong>
    <span>{error}</span>
    <a href={retryHref}>{copy.retry}</a>
  </div>
)}

<section class="card legacy-dashboard-card">
  <header class="legacy-dashboard-header">
    <div>
      <span class="surface-chip">{copy.preview}</span>
      <h1>{copy.title}</h1>
      <p class="muted">{copy.description}</p>
    </div>
    <p class="surface-muted">{copy.tenant}: <strong>{params.get("tenant_id") ?? "default"}</strong></p>
  </header>

  <form class="legacy-task-filters" method="get" action={path}>
    {hiddenScope.map(([key, value]) => <input type="hidden" name={key} value={value} />)}
    <label>
      <span>{copy.search}</span>
      <input type="search" name="task_q" value={query} placeholder={copy.searchPlaceholder} maxlength="120" />
    </label>
    <label>
      <span>{copy.status}</span>
      <select name="task_status">
        <option value="" selected={!status}>{copy.all}</option>
        {statuses.map((value) => <option value={value} selected={status === value}>{label("status", value)}</option>)}
      </select>
    </label>
    <button type="submit">{copy.apply}</button>
    {(query || status) && <a class="secondary-action" href={clearHref()}>{copy.clear}</a>}
  </form>

  {!error && (
    <>
      <div class="legacy-dashboard-summary" role="status">
        <span>{resultLabel}</span>
        {hasMore && <span>{copy.more}</span>}
      </div>

      <section class="legacy-status-summary" aria-labelledby="legacy-status-title">
        <h2 id="legacy-status-title">{copy.currentPage}</h2>
        <dl>
          {Object.keys(counters).length === 0 ? (
            <div><dt>{status ? label("status", status) : copy.all}</dt><dd>0</dd></div>
          ) : Object.entries(counters).map(([taskStatus, count]) => (
            <div><dt>{label("status", taskStatus)}</dt><dd>{count}</dd></div>
          ))}
        </dl>
      </section>

      <div class="overflow-x-auto">
        <table>
          <thead>
            <tr><th scope="col">{copy.taskId}</th><th scope="col">{copy.capability}</th><th scope="col">{copy.status}</th><th scope="col">{copy.updated}</th></tr>
          </thead>
          <tbody>
            {visibleTasks.length === 0 ? (
              <tr><td colspan="4">{copy.empty}</td></tr>
            ) : visibleTasks.map((task) => (
              <tr>
                <td><a href={taskHref(task.id)}>{task.id}</a></td>
                <td title={task.capability}>{label("capability", task.capability)}</td>
                <td><span class={`task-status task-status-${dashboardStatusTone(task.status)}`} title={task.status}>{label("status", task.status)}</span></td>
                <td>{new Date(task.updated_at).toLocaleString(lang === "ja" ? "ja-JP" : lang === "zh" ? "zh-CN" : "en-US")}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {(page > 0 || hasMore) && (
        <nav class="legacy-task-pagination" aria-label={copy.pagination}>
          {page > 0 ? <a href={pageHref(page - 1)}>{copy.previous}</a> : <span aria-hidden="true">{copy.previous}</span>}
          <span aria-current="page">{page + 1}</span>
          {hasMore ? <a href={pageHref(page + 1)}>{copy.next}</a> : <span aria-hidden="true">{copy.next}</span>}
        </nav>
      )}
    </>
  )}
</section>

<style>
  .legacy-dashboard-card { display: grid; gap: 1.25rem; }
  .legacy-dashboard-header { display: flex; align-items: start; justify-content: space-between; gap: 1rem; }
  .legacy-dashboard-header h1 { margin-top: .8rem; }
  .legacy-task-filters { display: grid; grid-template-columns: minmax(0, 1fr) 14rem auto auto; align-items: end; gap: .75rem; padding: 1rem; border: 1px solid var(--console-border); border-radius: 1rem; background: rgba(255,255,255,.03); }
  .legacy-task-filters label { display: grid; gap: .35rem; }
  .legacy-task-filters label span { color: var(--console-muted); font-size: .78rem; }
  .legacy-task-filters button { min-height: 3rem; }
  .legacy-dashboard-summary { display: flex; justify-content: space-between; gap: 1rem; color: var(--console-muted); font-size: .88rem; }
  .legacy-status-summary { display: grid; gap: .6rem; }
  .legacy-status-summary h2 { font-size: .9rem; color: var(--console-muted); }
  .legacy-status-summary dl { display: flex; flex-wrap: wrap; gap: .6rem; margin: 0; }
  .legacy-status-summary dl div { display: flex; gap: .45rem; padding: .45rem .7rem; border: 1px solid var(--console-border); border-radius: 999px; }
  .legacy-status-summary dt { color: var(--console-muted); }
  .legacy-status-summary dd { margin: 0; font-weight: 700; }
  .task-status { display: inline-flex; min-height: 1.6rem; align-items: center; border-radius: 999px; padding: .2rem .55rem; font-size: .75rem; font-weight: 650; }
  .task-status-healthy { background: rgba(67,220,173,.12); color: #9ff4d4; }.task-status-warning { background: rgba(255,184,77,.13); color: #ffd58a; }.task-status-critical { background: rgba(255,92,103,.14); color: #ffb4bb; }.task-status-neutral { background: rgba(255,255,255,.07); color: var(--console-muted); }
  .legacy-task-pagination { display: flex; justify-content: center; align-items: center; gap: .9rem; }
  .legacy-task-pagination span[aria-current="page"] { min-width: 2rem; text-align: center; font-weight: 700; }
  @media (max-width: 760px) {
    .legacy-dashboard-header, .legacy-dashboard-summary { display: grid; }
    .legacy-task-filters { grid-template-columns: 1fr; }
  }
</style>
