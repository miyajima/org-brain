---
import { readConsoleData, apiScope, asRows, localText, operatorRequestUrl, viewHref, operatorScope, stateLabel, displayDate, type OperatorLocale } from "../../lib/operator-console";
import { dashboardLabel } from "../../lib/dashboard-copy";
import { DASHBOARD_TASK_STATUSES } from "../../lib/dashboard-page";
interface Props { id?:string; lang:OperatorLocale; }
const {id="",lang}=Astro.props, t=localText(lang), url=operatorRequestUrl(Astro.request), scope=apiScope(url),{tenantId,projectId}=operatorScope(url);
const query=url.searchParams.get("task_q")?.trim().slice(0,200)||"";
const status=url.searchParams.get("task_status")?.trim()||"";
const page=Math.min(10000,Math.max(0,Number.parseInt(url.searchParams.get("task_page")||"0",10)||0));
const taskParams=new URLSearchParams(scope);taskParams.set("limit","26");taskParams.set("offset",String(page*25));if(query)taskParams.set("q",query);if(status)taskParams.set("status",status);
const [result,events]=await Promise.all([
 readConsoleData(Astro.request,id?`/api/v1/tasks/${encodeURIComponent(id)}?${scope}`:`/api/v1/tasks?${taskParams}`),
 id?readConsoleData(Astro.request,`/api/v1/tasks/${encodeURIComponent(id)}/events?${scope}&limit=50`):{data:null,error:null}
]);
const task=result.data, rows=asRows(result.data,"items"), retry=url.pathname+url.search;
const title=(value:string)=>dashboardLabel("capability",value,lang);
---
<section class="op-panel" data-task-workspace><div class="op-panel-heading"><h3>{id?t("選択した処理", "Selected task", "所选任务"):t("最近のタスク", "Recent tasks", "最近任务")}</h3>{id&&<a href={viewHref(url,{id:null})}>{t("一覧に戻る", "Back to tasks", "返回列表")}</a>}</div>
 {!id&&<form class="op-task-search op-panel-body" role="search"><input type="hidden" name="tenant_id" value={tenantId}/><input type="hidden" name="project_id" value={projectId}/><input type="hidden" name="lang" value={lang}/><input type="hidden" name="section" value="operations"/><label>{t("タスクを検索", "Search tasks", "搜索任务")}<input type="search" name="task_q" value={query}/></label><label>{t("ステータス", "Status", "状态")}<select name="task_status"><option value="">{t("すべて", "All", "全部")}</option>{DASHBOARD_TASK_STATUSES.map(value=><option value={value} selected={status===value}>{stateLabel(value,lang)}</option>)}</select></label><button type="submit">{t("検索", "Search", "搜索")}</button></form>}
 {result.error?<div class="op-panel-body"><p class="op-notice" data-tone="error" role="alert"><strong>{id?(result.status===404?t("タスクが見つかりません", "Task not found", "找不到任务"):t("タスク詳細を取得できませんでした", "Task details could not be loaded", "无法获取任务详情")):t("タスクを取得できませんでした", "Tasks could not be loaded", "无法获取任务")}</strong><br/>{result.error}</p><div class="op-actions"><a href={retry}>{t("再試行", "Retry", "重试")}</a></div></div>:id&&task?<div class="op-panel-body"><h3>{title(task.capability||task.id)}</h3><dl class="op-definition"><dt>{t("状態", "Status", "状态")}</dt><dd>{stateLabel(task.status||"unknown",lang)}</dd><dt>{t("更新", "Updated", "更新")}</dt><dd>{displayDate(task.updated_at,lang)}</dd><dt>{t("プロジェクト", "Project", "项目")}</dt><dd>{task.project_id||"—"}</dd></dl><h4>{t("イベント履歴", "Event history", "事件历史")}</h4>{events.error?<p class="op-notice" data-tone="error" role="alert"><strong>{t("イベント履歴の一部を取得できませんでした", "Some task events could not be loaded", "部分任务事件无法加载")}</strong><br/>{events.error}</p>:<ul class="op-history">{asRows(events.data).map(item=><li><p>{item.summary||item.kind||item.type||item.event_type}</p>{typeof item.payload?.reason==="string"&&<p>{item.payload.reason}</p>}<time class="op-small">{displayDate(item.created_at||item.occurred_at,lang)}</time></li>)}</ul>}<div class="op-actions"><a href={retry}>{t("再試行", "Retry", "重试")}</a></div></div>:<>{rows.slice(0,25).map(item=><a class="op-row" href={viewHref(url,{id:item.id})}><div class="op-row-main"><strong>{title(item.capability||item.id)}</strong><p>{displayDate(item.updated_at,lang)}</p></div><span class="op-badge" data-state={item.status}>{stateLabel(item.status||"unknown",lang)}</span></a>)}{!rows.length&&<p class="op-empty">{t("この範囲にタスクの記録はありません。", "No tasks recorded in this scope.", "此范围内没有任务记录。")}</p>}<nav class="op-actions op-panel-body" aria-label={t("タスクのページ", "Task pages", "任务分页")}>{page>0&&<a href={viewHref(url,{task_page:String(page-1)})}>{t("前へ", "Previous", "上一页")}</a>}<span class="op-small">{t(`${page+1}ページ目`, `Page ${page+1}`, `第${page+1}页`)}</span>{rows.length>25&&<a href={viewHref(url,{task_page:String(page+1)})}>{t("次へ", "Next", "下一页")}</a>}</nav></>}
</section>
