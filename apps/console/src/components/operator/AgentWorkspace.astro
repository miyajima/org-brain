---
import ApiForm from "./ApiForm.astro";
import { localText, asRows, type OperatorLocale, type ConsoleRecord } from "../../lib/operator-console";
interface Props { id:string; details:ConsoleRecord; skills:ConsoleRecord[]; tenantId:string; projectId:string; lang:OperatorLocale; canWrite:boolean; }
const { id,details,skills,tenantId,projectId,lang,canWrite } = Astro.props;
const t=localText(lang), loadout=details.loadout;
const bindings=new Map(asRows(details,"bindings").map(item=>[item.skill_asset_id,item]));
const candidates=new Map(skills.map(item=>[item.id,item]));
for(const binding of bindings.values()) if(!candidates.has(binding.skill_asset_id)) candidates.set(binding.skill_asset_id,{id:binding.skill_asset_id,name:binding.asset_name||binding.skill_asset_id,published_version_id:binding.published_version_id});
const allSkills=[...candidates.values()];
const scope=new URLSearchParams({tenant_id:tenantId});if(projectId)scope.set("project_id",projectId);
---
{loadout && canWrite && details.can_replace_bindings !== true && <p class="op-notice">{t("すべての配布設定を確認できないため、置換保存はできません。管理者に共有範囲の確認を依頼してください。", "Replacement is unavailable because the complete delivery configuration could not be verified. Ask an administrator to check access.", "无法确认完整的分配设置，因此不能覆盖保存。请联系管理员检查权限。")}</p>}
{loadout && canWrite && details.can_replace_bindings === true && <details class="op-edit"><summary>{t("渡すスキルと優先度を編集", "Edit assigned skills and priority", "编辑分配的技能与优先级")}</summary><ApiForm endpoint={`/api/v1/agents/${encodeURIComponent(id)}/loadouts/${encodeURIComponent(loadout.id)}?${scope}`} method="PUT" hidden={{tenant_id:tenantId}} submit={t("配布構成を保存", "Save delivery settings", "保存分配设置")} formKind="loadout" fields={[{name:"name",label:t("構成の名前", "Loadout name", "配置名称"),value:loadout.name,required:true}]}>
 <div class="op-bindings">{allSkills.map(skill=>{const binding=bindings.get(skill.id);return <fieldset data-op-binding data-skill-id={skill.id} data-published-version={skill.published_version_id||""} data-binding-original={JSON.stringify(binding || null)}><legend>{skill.name}</legend><label><input type="checkbox" name="enabled" checked={!!binding}/> {t("このスキルを渡す", "Include this skill", "分配此技能")}</label><label>{t("使い方", "Usage", "使用方式")}<select name="usage_mode"><option value="always" selected={binding?.usage_mode==="always"}>{t("常に使用", "Always", "始终使用")}</option><option value="auto" selected={!binding||binding.usage_mode==="auto"}>{t("自動", "Automatic", "自动")}</option><option value="on_demand" selected={binding?.usage_mode==="on_demand"}>{t("必要時", "On demand", "按需")}</option></select></label><label>{t("優先度", "Priority", "优先级")}<input name="priority" type="number" min="0" max="100" value={binding?.priority??50}/></label><label>{t("利用する版", "Version policy", "版本策略")}<select name="version_policy"><option value="latest_published" selected={!binding||binding.version_policy==="latest_published"}>{t("最新の公開版", "Latest published", "最新发布版")}</option><option value="pinned" selected={binding?.version_policy==="pinned"} disabled={!binding?.pinned_version_id}>{t("現在の固定版を保持", "Keep pinned version", "保留当前固定版")}{binding?.pinned_version_id ? ` · ${binding.pinned_version_id}` : ""}</option>{skill.published_version_id && <option value="pinned_current">{t("現在の公開版へ固定し直す", "Pin current published version", "重新固定当前发布版")}</option>}</select></label></fieldset>;})}</div>
 {!skills.length && <p class="op-muted">{t("公開済みのスキルを作成すると、ここで配布できます。", "Publish a skill before assigning it here.", "发布技能后，即可在此进行分配。")}</p>}
 </ApiForm></details>}
<details class="op-edit"><summary>{t("AIに渡される内容を事前確認", "Preview the context AI will receive", "预览将提供给AI的上下文")}</summary><p class="op-muted" style="margin-bottom:16px">{t("利用実績には記録しません。権限と現在の構成に基づくプレビューです。", "This preview does not record a use. It follows current permissions and delivery settings.", "此预览不会记录为实际使用，结果基于当前权限和分配设置。")}</p><ApiForm endpoint={`/api/v1/agents/${encodeURIComponent(id)}/context-preview?${scope}`} hidden={{tenant_id:tenantId,record_usage:false}} submit={t("渡される内容を確認", "Preview context", "预览上下文")} responseMode="preview" fields={[{name:"task_text",label:t("実行する仕事の内容", "Task to preview", "要预览的任务"),type:"textarea",required:true},{name:"max_tokens",label:t("最大トークン数", "Token limit", "令牌上限"),type:"number",value:4000,dataType:"number",required:true}]}>
 <div data-preview-result hidden aria-live="polite"><h3>{t("自動で渡されるスキル", "Injected skills", "自动提供的技能")}</h3><ul data-preview-list="injected_skills"></ul><h3 class="op-section">{t("必要時に参照するスキル", "On-demand skills", "按需引用的技能")}</h3><ul data-preview-list="on_demand_skills"></ul><h3 class="op-section">{t("除外されたものと理由", "Omitted skills and reasons", "已排除的技能及原因")}</h3><ul data-preview-list="omitted"></ul></div>
 </ApiForm></details>
