---
import brandMark from "../../../../../assets/brand/org-brain-avatar.png";
import IntelligencePoller from "./IntelligencePoller.astro";
import { intelligenceDateLocale, intelligencePageCopy, type IntelligenceLocale } from "../../lib/intelligence-locale";
import { dashboardLabel } from "../../lib/dashboard-copy";
import {
  activityCapabilityForEvent,
  activityEventContext,
  ACTIVITY_PERIODS,
  bucketActivityTimeline,
  buildActivityCapabilitySummaries,
  buildProjectPulses,
  eventDeepLink,
  relativeTime,
  resolveActivityCapability,
  resolveActivityPeriod,
  type ActivityCapabilityKey,
  type ActivityEvent,
  type DashboardActivity,
  type ObservedAgent
} from "../../lib/nervous-system-ui";

const {
  data,
  loadError = null,
  refreshUrl,
  params,
  locale = "en"
} = Astro.props as { data: DashboardActivity; loadError?: string | null; refreshUrl: string; params: URLSearchParams; locale?: IntelligenceLocale };
const copy = intelligencePageCopy(locale);
const period = resolveActivityPeriod(params.get("period"));
const periodLabel = copy.nervous.periods[period.key];
const periodCopy = (template: string) => template.replace("{period}", periodLabel);
const hasActivityContent = data.events.length > 0 || data.observed_agents.length > 0;
const actors = data.observed_agents.slice(0, 6);
const allProjects = buildProjectPulses(data.events);
const projects = allProjects.slice(0, 5);
const activeCapability = resolveActivityCapability(params.get("activity_capability"));
const timelineEvents = activeCapability
  ? data.events.filter((event) => activityCapabilityForEvent(event) === activeCapability)
  : data.events;
const selectedEventId = params.get("event");
const selectedEvent = selectedEventId ? timelineEvents.find((event) => event.id === selectedEventId) ?? null : null;
const now = data.generated_at || Date.now();
const start = now - period.durationMs;
const formatTime = (timestamp: number) => timestamp
  ? new Intl.DateTimeFormat(intelligenceDateLocale(locale), { timeZone: "Asia/Tokyo", month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }).format(new Date(timestamp))
  : copy.nervous.timeUnknown;
const dateTime = (timestamp: number) => new Date(timestamp).toISOString();
const pointY = (index: number, count: number) => count <= 1 ? 220 : 72 + index * (296 / (count - 1));
const timelineBuckets = bucketActivityTimeline(timelineEvents, start, now, 12);
const timelinePeak = Math.max(1, ...timelineBuckets.map((bucket) => bucket.count));
const recentTimelineEvents = timelineEvents.slice(0, 6);
const remainingTimelineEvents = timelineEvents.slice(recentTimelineEvents.length);
const scope = new URLSearchParams();
for (const key of ["tenant_id", "project_id", "lang"]) {
  const value = params.get(key);
  if (value) scope.set(key, value);
}
const selectEventHref = (event: ActivityEvent) => {
  const next = new URLSearchParams(params);
  next.set("event", event.id);
  const pathname = Astro.url.pathname === "/" ? "/" : "/overview";
  return `${pathname}?${next.toString()}`;
};
const selectedDeepLink = selectedEvent ? eventDeepLink(selectedEvent, scope) : null;
const selectedActorId = selectedEvent?.actor.id ?? null;
const selectedProjectId = selectedEvent?.project_id ?? null;
const selectedCapability = selectedEvent ? activityCapabilityForEvent(selectedEvent) : null;
const highlightedCapability = activeCapability ?? selectedCapability;
const severityLabel = (severity: ActivityEvent["severity"]) => copy.common.severity[severity];
const activityPathname = Astro.url.pathname === "/" ? "/" : "/overview";
const actorEvent = (actor: ObservedAgent) => data.events.find((event) => event.actor.id === actor.id) ?? null;
const actorHref = (actor: ObservedAgent) => {
  const event = actorEvent(actor);
  return event ? selectEventHref(event) : `${activityPathname}?${scope.toString()}#activity-timeline`;
};
const projectEvent = (project: { id: string }) => data.events.find((event) => event.project_id === project.id) ?? null;
const projectHref = (project: { id: string }) => {
  const event = projectEvent(project);
  return event ? selectEventHref(event) : `${activityPathname}?${scope.toString()}#activity-timeline`;
};
const capabilityDefinitions = {
  remember: { title: copy.nervous.remember, note: copy.nervous.storeStructure, x: 462, y: 87 },
  understand: { title: copy.nervous.understand, note: copy.nervous.searchRelate, x: 636, y: 87 },
  evaluate: { title: copy.nervous.evaluate, note: copy.nervous.trustFreshness, x: 462, y: 271 },
  apply: { title: copy.nervous.use, note: copy.nervous.shareGenerate, x: 636, y: 271 }
} satisfies Record<ActivityCapabilityKey, { title: string; note: string; x: number; y: number }>;
const capabilitySummaries = buildActivityCapabilitySummaries(data.events).map((summary) => ({
  ...summary,
  ...capabilityDefinitions[summary.key]
}));
const compactSummary = (value: string) => Array.from(value).slice(0, 15).join("");
const activityEventSummary = (event: ActivityEvent) => {
  if (locale !== "ja") return event.summary;
  const subject = event.subject.label || event.subject.id;
  if (event.type === "task.failed") return `Task「${subject}」が失敗しました。`;
  if (event.type === "memory.read") return `「${subject}」を参照しました。`;
  if (event.type === "memory.write") return `「${subject}」を更新しました。`;
  if (event.type === "memory.retrieval") return `「${subject}」を検索しました。`;
  return event.summary;
};
const activityEventType = (eventType: string) => dashboardLabel("event", eventType, locale);
const activityVerb = (event: ActivityEvent) => {
  if (locale === "ja") {
    if (event.type === "memory.read") return "参照";
    if (event.type === "memory.write") return "更新";
    if (event.type === "memory.retrieval") return "検索";
    if (event.type === "memory.effect") return "効果測定";
  }
  if (locale === "en") {
    if (event.type === "memory.read") return "Read";
    if (event.type === "memory.write") return "Write";
    if (event.type === "memory.retrieval") return "Search";
    if (event.type === "memory.effect") return "Effect";
  }
  return activityEventType(event.type);
};
const timelineEventPresentation = (event: ActivityEvent) => {
  const context = activityEventContext(event);
  return {
    title: context.structured ? context.title : activityEventSummary(event),
    context: [event.actor.label, activityVerb(event), context.project, context.category].filter(Boolean)
  };
};
const capabilityHref = (key: ActivityCapabilityKey) => {
  const next = new URLSearchParams(params);
  next.delete("event");
  if (activeCapability === key) next.delete("activity_capability");
  else next.set("activity_capability", key);
  return `${activityPathname}?${next.toString()}#activity-timeline`;
};
const capabilityAriaLabel = (key: ActivityCapabilityKey, title: string) => activeCapability === key
  ? copy.nervous.showAllActivity
  : copy.nervous.filterByCapability.replace("{capability}", title);
const timelineCountLabel = activeCapability
  ? copy.nervous.filteredEventCount
      .replace("{capability}", capabilityDefinitions[activeCapability].title)
      .replace("{count}", String(timelineEvents.length))
      .replace("{total}", String(data.events.length))
  : `${data.events.length} ${copy.common.events}`;
const periodHref = (key: typeof ACTIVITY_PERIODS[number]["key"]) => {
  const next = new URLSearchParams(params);
  next.delete("event");
  if (key === "24h") next.delete("period");
  else next.set("period", key);
  return `${activityPathname}?${next.toString()}`;
};
const dayTicks = period.key === "3d"
  ? [3, 2, 1, 0]
  : period.key === "7d"
    ? [7, 6, 5, 4, 3, 2, 1, 0]
    : [30, 25, 20, 15, 10, 5, 0];
const timelineTicks = period.key === "24h"
  ? [24, 20, 16, 12, 8, 4, 0].map((hours) => ({ key: `hour-${hours}`, label: hours === 0 ? copy.nervous.now : copy.nervous.hoursAgo.replace("{hours}", String(hours)) }))
  : dayTicks.map((days) => ({ key: `day-${days}`, label: days === 0 ? copy.nervous.now : copy.nervous.daysAgo.replace("{days}", String(days)) }));
const timelineAxisLabels = [
  timelineTicks.at(0)?.label ?? periodLabel,
  relativeTime(start + period.durationMs / 2, now, locale),
  copy.nervous.now
];
const uiCopy = {
  en: {
    unavailableTitle: "Activity cannot be judged",
    unavailableBody: "The activity request failed. Retry before treating this as a healthy or empty state.",
    executing: "Executing now",
    observed: "Observed in this period",
    lastSeen: "Last observed",
    provenance: "Observed from",
    recentEvents: "Latest events",
    remainingEvents: "Earlier events",
    projectRule: "Only projects attached to returned events are shown. Other projects are outside the current project filter.",
    topologyGuide: "Agents on the left produce or consume knowledge. Org Brain groups those events into four capabilities, then connects them to projects on the right. Select a capability to filter Replay below."
  },
  ja: {
    unavailableTitle: "活動状況を判断できません",
    unavailableBody: "活動データを取得できませんでした。正常・空状態として扱わず、更新後に判断してください。",
    executing: "現在実行中",
    observed: "この期間に観測",
    lastSeen: "最終観測",
    provenance: "観測元",
    recentEvents: "直近のイベント",
    remainingEvents: "それ以前のイベント",
    projectRule: "返却イベントに関連付いたプロジェクトだけを表示します。他プロジェクトは現在のプロジェクトフィルター対象外です。",
    topologyGuide: "左は活動したAI、中央は知識の扱い方、右は関連プロジェクトです。線は期間内の実イベントの流れを示します。中央の項目を選ぶと、下のReplayをその種類に絞り込みます。"
  },
  zh: {
    unavailableTitle: "无法判断活动状态",
    unavailableBody: "活动数据获取失败，请刷新后再判断。",
    executing: "当前执行中",
    observed: "本期间观察到",
    lastSeen: "最后观察",
    provenance: "观察来源",
    recentEvents: "最近事件",
    remainingEvents: "更早事件",
    projectRule: "只显示与返回事件相关的项目，其他项目不在当前项目筛选范围内。",
    topologyGuide: "左侧是活动中的AI，中间是知识处理方式，右侧是相关项目。连线表示本期间的真实事件流。选择中间项目可筛选下方Replay。"
  }
}[locale];
const agentEventKinds = (actorId: string) => [...new Set(data.events.filter((event) => event.actor.id === actorId).map((event) => event.type))];
const agentStateLabel = (actor: ObservedAgent) => actor.state === "active" && actor.active_task_count > 0 ? uiCopy.executing : uiCopy.observed;
---
<section class="intelligence-surface nervous-system" aria-labelledby="nervous-system-title">
  <header class="intelligence-header">
    <div>
      <p class="intelligence-eyebrow">{copy.nervous.eyebrow}</p>
      <h1 id="nervous-system-title">{copy.nervous.title}</h1>
    </div>
    <div class="header-actions">
      <nav class="activity-period" aria-label={copy.nervous.periodLabel}>
        <span>{copy.nervous.periodLabel}</span>
        <div>
          {ACTIVITY_PERIODS.map((option) => (
            <a href={periodHref(option.key)} aria-current={option.key === period.key ? "page" : undefined}>{copy.nervous.periods[option.key]}</a>
          ))}
        </div>
      </nav>
      <a class="secondary-action" href="#activity-timeline">{periodCopy(copy.nervous.replayPeriod)}</a>
      <IntelligencePoller refreshUrl={refreshUrl} initialData={data} generatedAt={data.generated_at} locale={locale} incrementalField={data.newest_cursor != null ? "events" : undefined} windowMs={period.durationMs} />
    </div>
  </header>

  {loadError && (
    <section class="data-unavailable" role="status"><strong>{uiCopy.unavailableTitle}</strong><p>{uiCopy.unavailableBody}</p></section>
  )}

  {!loadError && selectedEvent && (
    <section class="selected-event" aria-labelledby="selected-event-title">
      <div class="selected-event-summary">
        <span class:list={["event-dot", `event-dot-${selectedEvent.severity}`]}></span>
        <div><p class="intelligence-eyebrow">{copy.nervous.selectedEvent} · {severityLabel(selectedEvent.severity)}</p><h2 id="selected-event-title">{activityEventSummary(selectedEvent)}</h2><p>{selectedEvent.actor.label} → {selectedEvent.target?.label || selectedEvent.subject.label}</p></div>
      </div>
      <dl>
        <div><dt>{copy.nervous.target}</dt><dd>{selectedEvent.subject.label}</dd></div>
        <div><dt>{copy.nervous.status}</dt><dd>{selectedEvent.status ? dashboardLabel("status", selectedEvent.status, locale) : selectedEvent.type}</dd></div>
        <div><dt>{copy.nervous.occurredAt}</dt><dd><time datetime={dateTime(selectedEvent.occurred_at)}>{formatTime(selectedEvent.occurred_at)}</time></dd></div>
      </dl>
      {selectedDeepLink && <a class="secondary-action" href={selectedDeepLink}>{selectedEvent.task_id ? copy.nervous.openTask : copy.nervous.openTrace}</a>}
    </section>
  )}

  {!loadError && (!hasActivityContent ? (
    <div class="intelligence-empty" role="status">
      <strong>{copy.nervous.noActivityTitle}</strong>
      <span>{copy.nervous.noActivityBody}</span>
    </div>
  ) : (
    <section class="activity-topology" aria-labelledby="activity-topology-heading">
      <header>
        <div>
          <h2 id="activity-topology-heading">{copy.nervous.topologyTitle}</h2>
          <p>{uiCopy.topologyGuide}</p>
        </div>
      </header>
      <div class="system-stage">
      <div class="topology-heading topology-heading-actors">{copy.nervous.agentsHeading}</div>
      <div class="topology-heading topology-heading-brain">{copy.nervous.brainHeading}</div>
      <div class="topology-heading topology-heading-projects">{copy.nervous.projectsHeading}</div>

      <svg class="topology-map" viewBox="0 0 1200 440" role="img" aria-labelledby="topology-title topology-description">
        <title id="topology-title">{copy.nervous.topologyTitle}</title>
        <desc id="topology-description">{periodCopy(copy.nervous.topologyDescriptionPeriod)}</desc>
        <defs>
          <filter id="blue-glow" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="6" result="blur"></feGaussianBlur>
            <feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
          </filter>
          <linearGradient id="flow-blue" x1="0" x2="1"><stop offset="0" stop-color="#55b8ff" stop-opacity="0.35"></stop><stop offset="0.48" stop-color="#1687ff"></stop><stop offset="1" stop-color="#75c9ff"></stop></linearGradient>
          <linearGradient id="flow-critical" x1="0" x2="1"><stop offset="0" stop-color="#1687ff"></stop><stop offset="1" stop-color="#ff5c67"></stop></linearGradient>
        </defs>

        {actors.map((actor, index) => {
          const y = pointY(index, actors.length);
          return (
            <g>
              <path class:list={["flow", "flow-in", actor.id === selectedActorId && "flow-selected"]} d={`M 142 ${y} C 300 ${y}, 360 220, 548 220`}></path>
              {[0.25, 0.52, 0.76].map((progress) => <circle class:list={["flow-pulse", actor.id === selectedActorId && "flow-pulse-selected"]} cx={142 + progress * 406} cy={y + (220 - y) * progress} r="3.4"></circle>)}
            </g>
          );
        })}
        {projects.map((project, index) => {
          const y = pointY(index, projects.length);
          return (
              <g>
                <path class:list={["flow", "flow-out", project.criticalCount > 0 && "flow-critical", project.id === selectedProjectId && "flow-selected"]} d={`M 652 220 C 835 220, 900 ${y}, 1048 ${y}`}></path>
                <circle class="flow-pulse flow-pulse-out" cx="850" cy={220 + (y - 220) * .5} r="3.4"><title>{project.eventCount} {copy.common.events}</title></circle>
              </g>
          );
        })}

        <circle class="brain-aura" cx="600" cy="220" r="74"></circle>
        <circle class="brain-ring" cx="600" cy="220" r="56"></circle>
        <image href={brandMark.src} x="562" y="182" width="76" height="76" preserveAspectRatio="xMidYMid slice"></image>

        {actors.map((actor, index) => {
          const y = pointY(index, actors.length);
          const initial = actor.label.replace(/[^A-Za-z0-9一-龠ぁ-んァ-ヶ]/gu, "").slice(0, 2).toUpperCase() || "AI";
          return (
            <a href={actorHref(actor)} class="topology-entity-link" aria-label={`${actor.label} · ${agentStateLabel(actor)}`}>
            <g class:list={[actor.id === selectedActorId && "topology-entity-selected"]}>
              <title>{actor.label} · {agentStateLabel(actor)} · {uiCopy.lastSeen} {formatTime(actor.last_seen_at)} · {uiCopy.provenance} {agentEventKinds(actor.id).join(" / ") || copy.nervous.timeUnknown}</title>
              <circle class="actor-ring" cx="80" cy={y} r="31"></circle>
              <text class="actor-initial" x="80" y={y + 5} text-anchor="middle">{initial}</text>
              <circle class={actor.state === "active" && actor.active_task_count > 0 ? "agent-state agent-state-active" : "agent-state"} cx="105" cy={y - 23} r="4"><title>{agentStateLabel(actor)}</title></circle>
              <text class="actor-label" x="122" y={y - 5}>{actor.label}</text>
              <text class="actor-detail" x="122" y={y + 15}>{agentStateLabel(actor)} · {relativeTime(actor.last_seen_at, now, locale)}</text>
              <text class="actor-counter" x="122" y={y + 34}>{copy.common.read} {actor.read_count} · {copy.common.write} {actor.write_count}</text>
            </g>
            </a>
          );
        })}

        {projects.map((project, index) => {
          const y = pointY(index, projects.length);
          return (
            <a href={projectHref(project)} class="topology-entity-link" aria-label={`${project.label} · ${project.eventCount} ${copy.common.events}`}>
            <g class:list={[project.id === selectedProjectId && "topology-entity-selected"]}>
              <rect class={project.criticalCount > 0 ? "project-card project-card-critical" : "project-card"} x="1048" y={y - 34} width="144" height="68" rx="12"></rect>
              <text class="project-label" x="1064" y={y - 6}>{project.label.slice(0, 20)}</text>
              <text class="project-detail" x="1064" y={y + 15}>{project.eventCount} {copy.common.events} · {project.criticalCount} {copy.common.critical}</text>
            </g>
            </a>
          );
        })}

        {capabilitySummaries.map((capability) => {
          const centerX = capability.x + 51;
          const latest = capability.latestEvent ? activityEventSummary(capability.latestEvent) : copy.nervous.noCapabilityActivity;
          return (
            <a
              class:list={["brain-capability-link", highlightedCapability === capability.key && "brain-capability-active"]}
              href={capabilityHref(capability.key)}
              aria-label={capabilityAriaLabel(capability.key, capability.title)}
              aria-current={activeCapability === capability.key ? "true" : undefined}
            >
              <g class="brain-capability">
              <title>{capability.title}: {capability.count} {copy.common.events}. {latest}</title>
                <rect x={capability.x} y={capability.y} width="102" height="82" rx="12"></rect>
                <text x={centerX} y={capability.y + 24} text-anchor="middle">{capability.title}</text>
                <text class="capability-note" x={centerX} y={capability.y + 41} text-anchor="middle">{capability.note}</text>
                <text class="capability-count" x={centerX} y={capability.y + 58} text-anchor="middle">{copy.nervous.capabilityCount.replace("{count}", String(capability.count))}</text>
                <text class="capability-latest" x={centerX} y={capability.y + 73} text-anchor="middle">{compactSummary(latest)}</text>
              </g>
            </a>
          );
        })}
      </svg>

      <div class="topology-fallback">
        <section aria-labelledby="capability-list-title">
          <h2 id="capability-list-title">{copy.nervous.capabilitiesHeading}</h2>
          <ul class="capability-fallback-list">
            {capabilitySummaries.map((capability) => (
              <li>
                <a href={capabilityHref(capability.key)} aria-current={activeCapability === capability.key ? "true" : undefined}>
                  <strong>{capability.title} · {copy.nervous.capabilityCount.replace("{count}", String(capability.count))}</strong>
                  <span>{capability.note} · {capability.latestEvent ? activityEventSummary(capability.latestEvent) : copy.nervous.noCapabilityActivity}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
        <section aria-labelledby="actors-list-title">
          <h2 id="actors-list-title">{copy.nervous.observedAgents}</h2>
          <ul>
            {actors.map((actor) => <li><a href={actorHref(actor)}><strong>{actor.label}</strong><span>{agentStateLabel(actor)} · {uiCopy.lastSeen} {relativeTime(actor.last_seen_at, now, locale)} · {uiCopy.provenance} {agentEventKinds(actor.id).join(" / ") || copy.nervous.timeUnknown}</span></a></li>)}
          </ul>
        </section>
        <section aria-labelledby="projects-list-title">
          <h2 id="projects-list-title">{copy.nervous.relatedProjects}</h2>
          <ul>
            {projects.map((project) => <li><a href={projectHref(project)}><strong>{project.label}</strong><span>{project.eventCount} {copy.common.events} · {relativeTime(project.lastSeenAt, now, locale)}</span></a></li>)}
          </ul>
          <p class="project-scope-note">{uiCopy.projectRule}</p>
        </section>
      </div>

      </div>
    </section>
  ))}

  {!loadError && <section class="activity-timeline" id="activity-timeline" aria-labelledby="activity-timeline-title">
    <header><div><p class="intelligence-eyebrow">{copy.nervous.replayEyebrow}</p><h2 id="activity-timeline-title">{periodCopy(copy.nervous.replayTitlePeriod)}</h2></div><span>{timelineCountLabel}</span></header>
    {timelineEvents.length > 0 ? (
      <div class="timeline-overview">
        <div class="timeline-chart" role="list" aria-label={periodCopy(copy.nervous.replayTitlePeriod)}>
          {timelineBuckets.map((bucket) => bucket.latestEvent ? (
            <a
              class:list={["timeline-bucket", bucket.warningCount > 0 && "timeline-bucket-warning", bucket.criticalCount > 0 && "timeline-bucket-critical"]}
              href={selectEventHref(bucket.latestEvent)}
              role="listitem"
              aria-label={`${bucket.count} ${copy.common.events}, ${formatTime(bucket.startAt)} – ${formatTime(bucket.endAt)}`}
              title={`${bucket.count} ${copy.common.events} · ${activityEventSummary(bucket.latestEvent)}`}
            >
              <span class="timeline-bucket-count">{bucket.count}</span>
              <span class="timeline-bucket-bar" style={`--bar-height:${Math.max(8, Math.round(bucket.count / timelinePeak * 100))}%`}></span>
            </a>
          ) : (
            <span class="timeline-bucket timeline-bucket-empty" role="listitem" aria-label={`0 ${copy.common.events}`}><span class="timeline-bucket-bar"></span></span>
          ))}
        </div>
        <div class="timeline-axis" aria-hidden="true">{timelineAxisLabels.map((label) => <span>{label}</span>)}</div>
      </div>
    ) : <div class="intelligence-empty compact">{copy.nervous.noPeriodEvents}</div>}
    {timelineEvents.length > 0 && (
      <>
        <div class="timeline-legend" aria-label={copy.nervous.eventTypes}>
          {[...new Set(timelineEvents.map((event) => event.type))].slice(0, 8).map((type) => <span>{activityEventType(type)}</span>)}
        </div>
        <section class="timeline-recent" aria-labelledby="timeline-recent-title">
          <h3 id="timeline-recent-title">{uiCopy.recentEvents}</h3>
          <ol>
            {recentTimelineEvents.map((event) => {
              const presentation = timelineEventPresentation(event);
              return <li><a href={selectEventHref(event)} aria-current={selectedEvent?.id === event.id ? "true" : undefined} title={activityEventSummary(event)}><span class="timeline-event-context">{presentation.context.map((item) => <em>{item}</em>)}</span><strong>{presentation.title}</strong><span class="timeline-event-meta"><time datetime={dateTime(event.occurred_at)}>{formatTime(event.occurred_at)}</time><em>{severityLabel(event.severity)}</em></span></a></li>;
            })}
          </ol>
        </section>
        {remainingTimelineEvents.length > 0 && <details class="timeline-event-list">
          <summary>{uiCopy.remainingEvents} <span>{remainingTimelineEvents.length}</span></summary>
          <ol>
            {remainingTimelineEvents.map((event) => {
