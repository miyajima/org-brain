---
import ConsoleSurfaceNav from "./ConsoleSurfaceNav.astro";
import IntelligencePoller from "./IntelligencePoller.astro";
import InsightPageGuide from "./InsightPageGuide.astro";
import InsightScopeRail from "./InsightScopeRail.astro";
import RecommendedActions from "./RecommendedActions.astro";
import { intelligenceDateLocale, intelligencePageCopy, type IntelligenceLocale } from "../../lib/intelligence-locale";
import { dashboardLabel, memoryDisplayCopy } from "../../lib/dashboard-copy";
import { insightBriefingTitle, knowledgeHealthyCopy, knowledgeMetricInterpretations, knowledgeRecommendedActions, pageGuide } from "../../lib/insight-guidance";
import {
  chooseFocusNode,
  filterKnowledgeGraph,
  graphDeepLink,
  knowledgeGraphCanvasSize,
  knowledgeNodeVisualKind,
  layoutKnowledgeGraph,
  type KnowledgeGraph,
  type KnowledgeGraphNode,
  type KnowledgeNodeType,
  type KnowledgeNodeVisualKind
} from "../../lib/knowledge-graph-ui";

const { data, loadError = null, refreshUrl, params, locale = "en" } = Astro.props as {
  data: KnowledgeGraph;
  loadError?: string | null;
  refreshUrl: string;
  params: URLSearchParams;
  locale?: IntelligenceLocale;
};
const copy = intelligencePageCopy(locale);
const selectedId = params.get("selected");
const requestedView = params.get("view");
const view: "graph" | "list" = requestedView === "list" ? "list" : "graph";
const nodeTypes: Array<{ value: KnowledgeNodeType | "all"; label: string }> = [
  { value: "all", label: copy.constellation.nodeTypes.all },
  { value: "memory", label: copy.constellation.nodeTypes.memory },
  { value: "decision", label: copy.constellation.nodeTypes.decision },
  { value: "resource", label: copy.constellation.nodeTypes.resource },
  { value: "entity", label: copy.constellation.nodeTypes.entity },
  { value: "project", label: copy.constellation.nodeTypes.project },
  { value: "task", label: copy.constellation.nodeTypes.task }
];
const requestedType = params.get("type");
const activeType: KnowledgeNodeType | "all" = nodeTypes.some((item) => item.value === requestedType)
  ? requestedType as KnowledgeNodeType | "all"
  : "all";
const graph = filterKnowledgeGraph(data, activeType);
const graphCanvas = knowledgeGraphCanvasSize(graph.nodes.length);
const positioned = layoutKnowledgeGraph(graph, selectedId, graphCanvas.width, graphCanvas.height);
const positionById = new Map(positioned.map((node) => [node.id, node]));
const selected = chooseFocusNode(graph.nodes, selectedId);
const scope = new URLSearchParams();
for (const key of ["tenant_id", "project_id", "lang"]) {
  const value = params.get(key);
  if (value) scope.set(key, value);
}
const selectHref = (node: KnowledgeGraphNode) => {
  const next = new URLSearchParams(params);
  next.set("selected", node.id);
  return `/memories/constellation?${next.toString()}`;
};
const viewHref = (nextView: "graph" | "list") => {
  const next = new URLSearchParams(params);
  if (nextView === "graph") next.delete("view");
  else next.set("view", nextView);
  return `/memories/constellation?${next.toString()}`;
};
const selectedDeepLink = selected ? graphDeepLink(selected, scope) : null;
const hasDirectRecord = selected ? ["memory", "decision", "resource", "task"].includes(selected.type) : false;
const guide = pageGuide("connections", locale);
const recommendedActions = knowledgeRecommendedActions(selected, hasDirectRecord ? selectedDeepLink : null, locale);
const healthyCopy = knowledgeHealthyCopy(locale, Boolean(selected));
const briefingTitle = insightBriefingTitle(locale);
const metricInterpretations = selected ? knowledgeMetricInterpretations(selected, locale) : null;
const graphIsDense = graph.nodes.length > 30;
const formatDate = (value: number | null | undefined) => value
  ? new Intl.DateTimeFormat(intelligenceDateLocale(locale), { timeZone: "Asia/Tokyo", dateStyle: "medium" }).format(new Date(value))
  : copy.common.unavailable;
const dateTime = (value: number) => new Date(value).toISOString();
const percent = (value: number | null) => value == null ? copy.common.notMeasured : `${Math.round(value * 100)}%`;
const visualKind = (node: KnowledgeGraphNode) => knowledgeNodeVisualKind(node);
const visualKindLabel = (kind: KnowledgeNodeVisualKind) => copy.constellation.visualKinds[kind];
const diamondPoints = (x: number, y: number, radius: number) => `${x},${y - radius} ${x + radius},${y} ${x},${y + radius} ${x - radius},${y}`;
const trianglePoints = (x: number, y: number, radius: number) => `${x},${y - radius} ${x + radius * .9},${y + radius * .72} ${x - radius * .9},${y + radius * .72}`;
const hexagonPoints = (x: number, y: number, radius: number) => Array.from({ length: 6 }, (_, index) => {
  const angle = Math.PI / 3 * index;
  return `${x + Math.cos(angle) * radius},${y + Math.sin(angle) * radius}`;
}).join(" ");
const activeVisualKinds = [...new Set(graph.nodes.map((node) => visualKind(node)))];
const nodeTypeLabel = (type: KnowledgeNodeType) => copy.constellation.nodeTypes[type];
const nodeKindLabel = (kind: string) => dashboardLabel("nodeKind", kind, locale);
const displayCopy = (node: KnowledgeGraphNode) => node.type === "memory"
  ? memoryDisplayCopy(node.label, node.summary)
  : { title: node.label, context: null, preview: node.summary || "", rawLabel: node.label };
const nodeLabelLines = (node: KnowledgeGraphNode) => {
  const label = displayCopy(node).title;
  const maxChars = 18;
  const clipped = label.length > maxChars * 2 ? `${label.slice(0, maxChars * 2 - 1)}…` : label;
  return [clipped.slice(0, maxChars), clipped.slice(maxChars, maxChars * 2)].filter(Boolean);
};
const clusterShapes = graph.clusters.map((cluster) => {
  const members = cluster.node_ids.map((id) => positionById.get(id)).filter(Boolean) as typeof positioned;
  if (members.length < 2) return null;
  const x = members.reduce((sum, node) => sum + node.x, 0) / members.length;
  const y = members.reduce((sum, node) => sum + node.y, 0) / members.length;
  const radius = Math.min(132, Math.max(54, ...members.map((node) => Math.hypot(node.x - x, node.y - y) + node.radius + 12)));
  return { ...cluster, x, y, radius };
}).filter(Boolean);
const selectedRelations = selected ? graph.edges.filter((edge) => edge.source === selected.id || edge.target === selected.id) : [];
const selectionFallback = params.get("notice") === "selection-fallback";
const dataState: "ready" | "empty" | "partial" | "error" = loadError ? "error" : data.truncated ? "partial" : graph.nodes.length > 0 ? "ready" : "empty";
const uiCopy = {
  en: {
    source: "Org Brain knowledge graph",
    window: "2 relationship levels",
    included: "Nodes and relationships returned for the current project, area filter, and two-level neighborhood.",
    excluded: "Other projects, nodes beyond two relationship levels, and omitted nodes above the response limit.",
    unavailableTitle: "Knowledge connections cannot be judged",
    unavailableBody: "The graph request failed. Retry before treating the graph as empty or complete.",
    fallbackTitle: "The requested knowledge was not found",
    fallbackBody: "The URL was normalized and the most connected available knowledge was selected instead.",
    relationHeading: "Relationships from this knowledge",
    viewLabel: "View mode",
    graphView: "Graph",
    listView: "List",
    outgoing: "outgoing",
    incoming: "incoming",
    mutual: "mutual",
    missing: "Not recorded"
  },
  ja: {
    source: "Org Brain 知識グラフ",
    window: "関連2段階",
    included: "現在のプロジェクト・領域フィルター・関連2段階で返却されたノードと関係。",
    excluded: "他プロジェクト、関連3段階以降、応答上限を超えて省略されたノード。",
    unavailableTitle: "知識のつながりを判断できません",
    unavailableBody: "知識グラフを取得できませんでした。空または完全なグラフとして扱わず、更新後に判断してください。",
    fallbackTitle: "指定された知識は見つかりませんでした",
    fallbackBody: "URLを正規化し、利用可能な知識のうち接続の多い項目を代わりに選択しました。",
    relationHeading: "この知識からの関係",
    viewLabel: "表示方法",
    graphView: "グラフ",
    listView: "一覧",
    outgoing: "この知識から",
    incoming: "この知識へ",
    mutual: "相互",
    missing: "未記録"
  },
  zh: {
    source: "Org Brain 知识图谱",
    window: "2层关系",
    included: "当前项目、区域筛选和两层关系内返回的节点与关系。",
    excluded: "其他项目、三层以外以及超过响应上限的节点。",
    unavailableTitle: "无法判断知识关联",
    unavailableBody: "知识图谱获取失败，请刷新后再判断。",
    fallbackTitle: "未找到指定知识",
    fallbackBody: "URL已规范化，并改为选择可用知识中连接最多的项目。",
    relationHeading: "此知识的关系",
    viewLabel: "显示方式",
    graphView: "图谱",
    listView: "列表",
    outgoing: "从此知识出发",
    incoming: "指向此知识",
    mutual: "相互",
    missing: "未记录"
  }
}[locale];
---
<section class="intelligence-surface constellation" aria-labelledby="constellation-title">
  <header class="constellation-header">
    <div>
      <p class="intelligence-eyebrow">{copy.constellation.eyebrow}</p>
      <h1 id="constellation-title">{copy.constellation.title}</h1>
      <p>{copy.constellation.description}</p>
    </div>
    <div class="constellation-controls">
      <form method="get" action="/memories/constellation">
        {scope.get("tenant_id") && <input type="hidden" name="tenant_id" value={scope.get("tenant_id")} />}
        {scope.get("project_id") && <input type="hidden" name="project_id" value={scope.get("project_id")} />}
        {scope.get("lang") && <input type="hidden" name="lang" value={scope.get("lang")} />}
        <label>
          <span>{copy.constellation.search}</span>
          <input type="search" name="q" value={params.get("q") ?? ""} placeholder={copy.constellation.searchPlaceholder} maxlength="120" />
        </label>
        <label>
          <span>{copy.constellation.area}</span>
          <select name="type" onchange="this.form?.requestSubmit()">
            {nodeTypes.map((item) => <option value={item.value} selected={activeType === item.value}>{item.label}</option>)}
          </select>
        </label>
        <button type="submit">{copy.constellation.apply}</button>
      </form>
      <IntelligencePoller refreshUrl={refreshUrl} initialData={data} generatedAt={data.generated_at} label={copy.constellation.pollerLabel} locale={locale} />
    </div>
  </header>

  <div class="constellation-surface-nav"><ConsoleSurfaceNav section="memories" params={params} locale={locale} /></div>
  <InsightPageGuide guide={guide} />
  <InsightScopeRail params={params} locale={locale} windowLabel={uiCopy.window} sourceLabel={uiCopy.source} included={uiCopy.included} excluded={uiCopy.excluded} state={dataState} generatedAt={data.generated_at} />
  {selectionFallback && <section class="selection-fallback" role="status"><strong>{uiCopy.fallbackTitle}</strong><p>{uiCopy.fallbackBody}</p></section>}
  {loadError ? (
    <section class="data-unavailable" role="status"><strong>{uiCopy.unavailableTitle}</strong><p>{uiCopy.unavailableBody}</p></section>
  ) : (
    <RecommendedActions locale={locale} title={briefingTitle} actions={recommendedActions} emptyTitle={healthyCopy.title} emptyBody={healthyCopy.body} />
  )}

  {!loadError && <nav class="constellation-view-switcher" aria-label={uiCopy.viewLabel}>
    <span>{uiCopy.viewLabel}</span>
    <a href={viewHref("graph")} aria-current={view === "graph" ? "page" : undefined}>{uiCopy.graphView}</a>
    <a href={viewHref("list")} aria-current={view === "list" ? "page" : undefined}>{uiCopy.listView}</a>
  </nav>}

  {!loadError && <div class:list={["constellation-layout", `view-${view}`]}>
    <aside class="node-inspector" aria-labelledby="node-inspector-title">
      {selected ? (
        <>
          <div class="inspector-heading">
            <span class:list={["inspector-emblem", `inspector-${visualKind(selected)}`]}><span>{visualKindLabel(visualKind(selected)).slice(0, 2)}</span></span>
            <div><p class="intelligence-eyebrow">{nodeTypeLabel(selected.type)}</p><h2 id="node-inspector-title">{displayCopy(selected).title}</h2>{displayCopy(selected).context && <p class="memory-context">{displayCopy(selected).context}</p>}<p>{selected.updated_at ? <time datetime={dateTime(selected.updated_at)}>{formatDate(selected.updated_at)}</time> : formatDate(selected.updated_at)} · {nodeKindLabel(selected.kind)}</p></div>
          </div>
          {selected.project_id && <span class="project-pill">{selected.project_id}</span>}
          <section><p class="inspector-label">{copy.constellation.summary}</p><p class="inspector-copy">{selected.summary || copy.constellation.noSummary}</p></section>
          <section>
            <p class="inspector-label">{copy.constellation.trustUse}</p>
            <dl class="inspector-metrics">
              <div><dt>{copy.constellation.confidence}</dt><dd>{percent(selected.confidence)}</dd>{metricInterpretations && <small>{metricInterpretations.confidence}</small>}</div>
              <div><dt>{copy.constellation.usage30}</dt><dd>{selected.usage_count_30d_recorded ? selected.usage_count_30d : uiCopy.missing}</dd>{metricInterpretations && <small>{metricInterpretations.usage}</small>}</div>
              <div><dt>{copy.constellation.degree}</dt><dd>{selected.degree_recorded ? selected.degree : uiCopy.missing}</dd>{metricInterpretations && <small>{metricInterpretations.links}</small>}</div>
              <div><dt>{copy.constellation.lastUsed}</dt><dd>{selected.last_used_at ? <time datetime={dateTime(selected.last_used_at)}>{formatDate(selected.last_used_at)}</time> : formatDate(selected.last_used_at)}</dd></div>
            </dl>
          </section>
          <section>
            <p class="inspector-label">{copy.constellation.impact}</p>
            <ul class="impact-list">
              <li><span>{copy.constellation.status}</span><strong>{selected.status ? dashboardLabel("status", selected.status, locale) : copy.constellation.unset}</strong></li>
              <li><span>{copy.constellation.clusters}</span><strong>{selected.cluster_ids.length}</strong></li>
              <li><span>{copy.constellation.relatedEdges}</span><strong>{graph.edges.filter((edge) => edge.source === selected.id || edge.target === selected.id).length}</strong></li>
            </ul>
          </section>
          <section class="inspector-relations">
            <p class="inspector-label">{uiCopy.relationHeading}</p>
            {selectedRelations.length > 0 ? <ul>{selectedRelations.map((edge) => {
              const other = positionById.get(edge.source === selected.id ? edge.target : edge.source);
              const direction = edge.directed ? edge.source === selected.id ? uiCopy.outgoing : uiCopy.incoming : uiCopy.mutual;
              return <li><strong>{dashboardLabel("relation", edge.relation, locale)}</strong><span>{direction}</span><small>{other ? displayCopy(other).title : ""}</small></li>;
            })}</ul> : <p class="inspector-copy">{metricInterpretations?.links}</p>}
          </section>
          <div class="inspector-actions">
            {hasDirectRecord && <a class="primary-action" href={selectedDeepLink}>{copy.constellation.openRecord}</a>}
            <a class="secondary-action" href={viewHref("list")}>{copy.constellation.exploreList}</a>
          </div>
        </>
      ) : <div class="intelligence-empty compact" id="node-inspector-title">{copy.constellation.selectNode}</div>}
    </aside>

      <div class="graph-panel">
      <div class="graph-legend" aria-label={copy.constellation.nodeTypesAria}>
        {activeVisualKinds.map((kind) => <span class={`legend-${kind}`}>{visualKindLabel(kind)}</span>)}
      </div>

      {positioned.length > 0 ? (
        <div class:list={["graph-viewport", graphIsDense && "graph-viewport-dense"]} style={`--graph-canvas-width:${graphCanvas.width}px;--graph-canvas-height:${graphCanvas.height}px`} role="region" aria-label={copy.constellation.mapTitle} tabindex="0">
        <svg class="knowledge-map" viewBox={`0 0 ${graphCanvas.width} ${graphCanvas.height}`} preserveAspectRatio="xMidYMid meet" role="img" aria-labelledby="knowledge-map-title knowledge-map-description">
          <title id="knowledge-map-title">{copy.constellation.mapTitle}</title>
          <desc id="knowledge-map-description">{copy.constellation.mapDescription}</desc>
          <defs>
            <filter id="node-glow" x="-80%" y="-80%" width="260%" height="260%"><feGaussianBlur stdDeviation="9" result="blur"></feGaussianBlur><feMerge><feMergeNode in="blur"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge></filter>
            <marker id="edge-arrow" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L7,3 z" fill="#5baeff"></path></marker>
          </defs>
          {clusterShapes.map((cluster) => cluster && <g class="cluster"><circle cx={cluster.x} cy={cluster.y} r={cluster.radius}></circle><text x={cluster.x} y={cluster.y - cluster.radius + 18} text-anchor="middle">{cluster.label}</text></g>)}
          {graph.edges.map((edge) => {
            const source = positionById.get(edge.source);
            const target = positionById.get(edge.target);
            if (!source || !target) return null;
            const highlighted = selected && (edge.source === selected.id || edge.target === selected.id);
            return <g><line aria-hidden="true" class:list={["knowledge-edge", highlighted && "knowledge-edge-highlighted"]} x1={source.x} y1={source.y} x2={target.x} y2={target.y} stroke-width={Math.max(1, Math.min(3, edge.weight))} marker-end={edge.directed ? "url(#edge-arrow)" : undefined}></line>{highlighted && <text class="edge-label" x={(source.x + target.x) / 2} y={(source.y + target.y) / 2 - 7} text-anchor="middle">{dashboardLabel("relation", edge.relation, locale)}{edge.directed ? " →" : " ↔"}</text>}</g>;
          })}
          {positioned.map((node) => {
            const kind = visualKind(node);
            const radius = node.radius;
            const semanticLabel = visualKindLabel(kind);
            return (
              <a class:list={["knowledge-node", `node-${kind}`, node.selected && "knowledge-node-selected", node.neighbor && "knowledge-node-neighbor"]} href={selectHref(node)} tabindex="0" aria-label={`${semanticLabel}: ${displayCopy(node).title}${node.status ? `, ${copy.constellation.status}: ${dashboardLabel("status", node.status, locale)}` : ""}`} aria-current={node.selected ? "true" : undefined}>
                <circle class="node-aura" cx={node.x} cy={node.y} r={radius + (node.selected ? 14 : 8)}></circle>
                {kind === "warning" ? (
                  <polygon class="node-core" points={diamondPoints(node.x, node.y, radius)}></polygon>
                ) : kind === "lesson" ? (
                  <polygon class="node-core" points={trianglePoints(node.x, node.y, radius)}></polygon>
                ) : kind === "project" ? (
                  <polygon class="node-core" points={hexagonPoints(node.x, node.y, radius)}></polygon>
                ) : kind === "decision" || kind === "evidence" ? (
                  <rect class="node-core" x={node.x - radius * .78} y={node.y - radius * .78} width={radius * 1.56} height={radius * 1.56} rx={kind === "decision" ? radius * .22 : radius * .05}></rect>
                ) : kind === "task" ? (
                  <rect class="node-core" x={node.x - radius} y={node.y - radius * .62} width={radius * 2} height={radius * 1.24} rx={radius * .62}></rect>
                ) : (
                  <circle class="node-core" cx={node.x} cy={node.y} r={radius}></circle>
                )}
                <text class="node-symbol" x={node.x} y={node.y + 5} text-anchor="middle">{semanticLabel.slice(0, 2)}</text>
                {nodeLabelLines(node).map((line, index) => <text class="node-label" x={node.x} y={node.y + radius + 19 + index * 12} text-anchor="middle">{line}</text>)}
                <text class="node-meta" x={node.x} y={node.y + radius + 46} text-anchor="middle">{semanticLabel} · {nodeKindLabel(node.kind)}</text>
                <title>{semanticLabel}: {node.label} / {node.summary}</title>
              </a>
            );
          })}
        </svg>
        </div>
      ) : (
        <div class="intelligence-empty" role="status"><strong>{copy.constellation.emptyTitle}</strong><span>{copy.constellation.emptyBody}</span></div>
      )}

      <div class="graph-status">
        <span>{graph.nodes.length} {copy.common.nodes}</span><span>{graph.edges.length} {copy.common.edges}</span>
        {data.truncated && <span class="graph-warning">{data.omitted_node_count > 0 ? `${data.omitted_node_count} ${copy.common.omitted}` : copy.constellation.relationsTruncated}</span>}
      </div>
    </div>

  </div>}

  {!loadError && <section class="knowledge-node-list" id="knowledge-node-list" aria-labelledby="knowledge-node-list-title">
    <header><div><p class="intelligence-eyebrow">{copy.constellation.accessibleList}</p><h2 id="knowledge-node-list-title">{copy.constellation.visibleKnowledge}</h2></div><span>{graph.nodes.length} {copy.common.items}</span></header>
    <ul>
      {graph.nodes.map((node) => (
        <li class:list={[selected?.id === node.id && "is-selected"]}>
          <a href={selectHref(node)} aria-current={selected?.id === node.id ? "true" : undefined}><span class={`list-tone list-tone-${visualKind(node)}`} aria-hidden="true"></span><span class="knowledge-node-copy"><strong title={node.label}>{displayCopy(node).title}</strong>{displayCopy(node).context && <small class="memory-context">{displayCopy(node).context}</small>}<small>{visualKindLabel(visualKind(node))} · {nodeTypeLabel(node.type)} · {nodeKindLabel(node.kind)}{node.status ? ` · ${copy.constellation.status}: ${dashboardLabel("status", node.status, locale)}` : ""} · {node.project_id || copy.common.global}</small>{displayCopy(node).preview && <span class="knowledge-node-preview">{displayCopy(node).preview}</span>}</span><span>{node.degree_recorded ? node.degree : uiCopy.missing} {node.degree_recorded ? copy.common.links : ""}</span></a>
        </li>
      ))}
    </ul>
    {graph.edges.length > 0 && (
      <details class="knowledge-edge-list" id="knowledge-edge-list">
        <summary>{copy.constellation.visibleRelations} <span>{graph.edges.length} {copy.common.items}</span></summary>
        <ul>
          {graph.edges.map((edge) => {
            const source = positionById.get(edge.source);
            const target = positionById.get(edge.target);
            if (!source || !target) return null;
            return (
              <li>
                <a href={selectHref(source)}>{displayCopy(source).title}</a>
                <span><strong>{dashboardLabel("relation", edge.relation, locale)}</strong><small>{edge.directed ? copy.constellation.directed : copy.constellation.mutual}</small></span>
                <a href={selectHref(target)}>{displayCopy(target).title}</a>
              </li>
            );
          })}
        </ul>
      </details>
    )}
  </section>}
</section>

<script>
  for (const node of document.querySelectorAll<SVGAElement>(".knowledge-node")) {
    if (node.dataset.keyboardBound === "true") continue;
    node.dataset.keyboardBound = "true";
    node.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" && event.key !== " ") return;
      event.preventDefault();
      const href = node.getAttribute("href");
      if (href) window.location.assign(href);
    });
  }
</script>

<style>
  .constellation { min-height: calc(100vh - 7rem); }
  .constellation-header { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 1.5rem; align-items: end; padding: 1rem 0 .8rem; }
  .constellation-header h1 { margin-top: .42rem; color: var(--intelligence-text); font-size: clamp(1.8rem,3vw,2.75rem); letter-spacing: -.04em; }.constellation-header > div > p:last-child { margin-top: .6rem; color: var(--intelligence-muted); line-height: 1.7; }
  .constellation-surface-nav { margin: 0 0 .75rem; }
  .intelligence-eyebrow { color: var(--intelligence-blue-bright); font-family: "Fira Code", monospace; font-size: .68rem; letter-spacing: .15em; text-transform: uppercase; }
  .selection-fallback,.data-unavailable { display: grid; gap: .35rem; margin-bottom: 1rem; border: 1px solid var(--intelligence-border); border-radius: 13px; background: rgba(22,135,255,.07); padding: .8rem 1rem; }.selection-fallback strong,.data-unavailable strong { color: var(--intelligence-text); font-size: .8rem; }.selection-fallback p,.data-unavailable p { color: var(--intelligence-muted); font-size: .72rem; line-height: 1.5; }.data-unavailable { min-height: 9rem; place-content: center; border-color: color-mix(in srgb,var(--intelligence-danger) 38%,transparent); background: color-mix(in srgb,var(--intelligence-danger) 7%,transparent); text-align: center; }.data-unavailable strong { color: #ffd7db; }
