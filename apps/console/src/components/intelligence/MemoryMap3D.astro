  .memory-map-view-trace { display: inline-flex; width: max-content; min-height: 44px; align-items: center; margin-top: .45rem; border: 1px solid rgba(99,189,255,.38); border-radius: 11px; background: rgba(22,135,255,.12); padding: .55rem .8rem; color: #dff5ff; font-size: .875rem; font-weight: 650; }
  .memory-map-view-trace[hidden] { display: none; }
