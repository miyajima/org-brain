    .memory-map-command-row .memory-map-selection-status { white-space: normal; }
    .memory-map-search-results { right: 0; width: 100%; max-height: min(27rem, calc(100vh - 9rem)); }
    .memory-map-workspace .memory-map-pathway { grid-template-columns: 1fr; }
    .memory-map-workspace .memory-map-pathway-header { display: none; }
    .memory-map-workspace .memory-map-pathway-steps { grid-template-columns: repeat(2,minmax(0,1fr)); }
    .memory-map-workspace .memory-map-pathway-steps::before,
    .memory-map-workspace .memory-map-pathway-steps li::after { display: none; }
    .memory-map-workspace .memory-map-pathway-steps button { min-height: 44px; }
    .memory-map-workspace .memory-map-pathway-copy small,
    .memory-map-workspace .memory-map-pathway-state { display: none; }
