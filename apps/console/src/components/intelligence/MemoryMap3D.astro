  @media (max-width: 900px) {
    .memory-map-command-row { grid-template-columns: minmax(0,1fr) auto; }
    .memory-map-command-row .memory-map-selection-status { grid-column: 1; grid-row: 2; }
    .memory-map-command-row .memory-map-view-trace { grid-column: 2; grid-row: 2; }
    .memory-map-command-row .memory-map-controls { grid-column: 2; grid-row: 1; }
    .memory-map-command-row .memory-map-controls-body { position: fixed; top: auto; right: .75rem; left: .75rem; width: auto; }
    .memory-map-layout,
    .memory-map-shell.has-trace-selection .memory-map-layout { display: block; padding-bottom: 7.5rem; }
    .memory-map-workspace .memory-map-pathway { margin-bottom: .45rem; }
  }
  @media (max-width: 620px) {
    .memory-map-header h1 { font-size: 1.65rem; }
