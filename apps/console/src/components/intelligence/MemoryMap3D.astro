---
type MemoryMapNode = {
  id: string;
  node_type?: "memory" | "decision" | "project" | "entity" | "tenant";
  memory_id: string | null;
  decision_id?: string | null;
  related_memory_id?: string | null;
  entity_id?: string | null;
  entity_type?: string | null;
  entity_link_count?: number;
  cross_project_link_count?: number;
  member_count?: number;
  tenant_id?: string | null;
  label: string;
  summary?: string | null;
  project_id: string | null;
  owner_principal: string | null;
  created_by_principal: string | null;
  reference_count: number;
  consumer_count: number;
  used_count: number;
  utilization_rate: number | null;
  net_saved_tokens: number;
  injected_tokens: number;
  updated_at?: number | null;
  cluster_key?: string;
  decision_type?: string | null;
  confirmation_state?: string | null;
  confidence_score?: number | null;
  fx?: number;
  fy?: number;
  fz?: number;
};

type MemoryMapData = {
  scope: "mine" | "org";
  cluster_mode: boolean;
  total_count: number;
  visible_count?: number;
  memory_visible_count?: number;
  project_count?: number;
  entity_count?: number;
  decision_count?: number;
  related_count?: number;
  relationship_count?: number;
  cross_project_link_count?: number;
  truncated?: boolean;
  nodes: MemoryMapNode[];
  links: Array<{ id: string; source: string; target: string; relation: string; directed?: boolean; inferred?: boolean; weight?: number; confidence?: number | null; cross_project?: boolean }>;
  clusters: Array<{ id: string; kind: string; label: string; node_ids: string[] }>;
};

const { data, tenantId = "default", projectId = "", query = "", ownerPrincipal = "", fromDate = "", toDate = "", scope = "org", selectedId: initialSelectedId = "", locale = "en", mapCopy = {}, traceCopy = {} } = Astro.props as {
  data: MemoryMapData;
  tenantId?: string;
  projectId?: string;
  query?: string;
  ownerPrincipal?: string;
  fromDate?: string;
  toDate?: string;
  scope?: "mine" | "org";
  selectedId?: string;
  locale?: "en" | "ja" | "zh";
  mapCopy?: Record<string, unknown>;
  traceCopy?: Record<string, unknown>;
};
const mapText = (key: string, fallback: string) => typeof mapCopy[key] === "string" ? String(mapCopy[key]) : fallback;
const traceText = (key: string, fallback: string) => typeof traceCopy[key] === "string" ? String(traceCopy[key]) : fallback;
const serialized = JSON.stringify(data);
const listParams = new URLSearchParams({ tenant_id: tenantId, scope });
if (projectId) listParams.set("project_id", projectId);
if (query) listParams.set("q", query);
if (ownerPrincipal) listParams.set("owner_principal", ownerPrincipal);
if (fromDate) listParams.set("from_date", fromDate);
if (toDate) listParams.set("to_date", toDate);
const listHref = `/memories?${listParams.toString()}`;
const fallbackParams = new URLSearchParams(listParams);
fallbackParams.set("map_fallback", "1");
const fallbackHref = `/memories?${fallbackParams.toString()}`;
const projectOptionMap = new Map<string, string>();
for (const node of data.nodes) {
  if (node.node_type === "project" && node.project_id) projectOptionMap.set(node.project_id, node.label || node.project_id);
}
const projectOptions = [...projectOptionMap.entries()].sort(([left], [right]) => left.localeCompare(right));
const ownerOptions = [...new Set(
  data.nodes
    .filter((node) => node.node_type === "memory" && node.owner_principal)
    .map((node) => node.owner_principal as string)
)].sort((left, right) => left.localeCompare(right));
const filterSummary = [
  query ? `“${query}”` : null,
  projectId ? projectOptionMap.get(projectId) || projectId : mapText("allProjects", "All projects"),
  ownerPrincipal || (scope === "mine" ? mapText("myMemories", "My memories") : mapText("allOwners", "All owners")),
  fromDate || toDate ? `${fromDate || "…"} – ${toDate || "…"}` : mapText("anyPeriod", "Any period")
].filter(Boolean).join(" · ");
---
<section class="memory-map-shell" data-memory-map-root data-map={serialized} data-list-href={fallbackHref} data-tenant-id={tenantId} data-project-id={projectId} data-scope={scope} data-selected-id={initialSelectedId} data-locale={locale} data-map-copy={JSON.stringify(mapCopy)} data-trace-copy={JSON.stringify(traceCopy)}>
  <header class="memory-map-header">
    <div>
      <p class="intelligence-eyebrow">{mapText("mapEyebrow", "Memory constellation / WebGL")}</p>
      <h1>{mapText("memoryMapTitle", "3D memory map")}</h1>
    </div>
  </header>

  <section class="memory-map-command-bar" data-map-command-bar aria-labelledby="memory-map-node-picker-title">
    <h2 id="memory-map-node-picker-title" class="sr-only">{traceText("keyboardSelection", "Search and select a node")}</h2>
    <div class="memory-map-command-row">
      <label class="memory-map-search memory-map-accessible-search">
        <span class="sr-only">{traceText("keyboardSearch", "Filter decisions and memories")}</span>
        <input
          type="search"
          data-map-search
          data-map-accessible-search
          value={query}
          placeholder={traceText("keyboardSearchPlaceholder", "Search nodes")}
          role="combobox"
          aria-controls="memory-map-search-results"
          aria-expanded="false"
          aria-autocomplete="list"
          autocomplete="off"
        />
      </label>
      <p class="memory-map-selection-status" data-map-selection-status role="status" aria-live="polite"></p>
      <a class="memory-map-view-trace" data-map-view-trace href="#memory-map-pathway-title" hidden>{traceText("viewDecisionPath", "View decision path")}</a>
      <details class="memory-map-controls" data-map-controls>
        <summary class="memory-map-controls-summary">
          <span class="memory-map-controls-copy">
            <strong>{mapText("searchFilters", "Search & filters")}</strong>
            <span>{filterSummary}</span>
          </span>
          <span class="memory-map-controls-chevron" aria-hidden="true"></span>
        </summary>
        <div class="memory-map-controls-body">
          <div class="memory-map-toolbar">
            <div class="memory-map-presets" aria-label={mapText("presetsAria", "Map color presets")}>
              <button type="button" class="is-active" data-map-preset="project">{mapText("projectPreset", "Project")}</button>
              <button type="button" data-map-preset="owner">{mapText("ownerPreset", "Owner")}</button>
              <button type="button" data-map-preset="utilization">{mapText("utilizationPreset", "Utilization")}</button>
            </div>
            <a class="memory-map-list-link" href={listHref}>{mapText("openList", "Open memory list")}</a>
          </div>
          <form class="memory-map-filters" method="get" action="/memories/constellation">
            <input type="hidden" name="tenant_id" value={tenantId} />
            <input type="hidden" name="scope" value={scope} />
            <label><span>{mapText("projectLabel", "Project")}</span><select name="project_id"><option value="" selected={!projectId}>{mapText("allProjects", "All projects")}</option>{projectOptions.map(([value, label]) => <option value={value} selected={projectId === value}>{label}</option>)}</select></label>
            <label><span>{mapText("ownerLabel", "Owner")}</span><select name="owner_principal" disabled={scope === "mine"}><option value="" selected={!ownerPrincipal}>{scope === "mine" ? mapText("myMemories", "My memories") : mapText("allOwners", "All owners")}</option>{ownerOptions.map((value) => <option value={value} selected={ownerPrincipal === value}>{value}</option>)}</select></label>
            <fieldset class="memory-map-date-range" aria-label={`${mapText("from", "From")} / ${mapText("to", "To")}`}><label><span>{mapText("from", "From")}</span><input type="date" name="from_date" value={fromDate} /></label><span class="memory-map-range-arrow" aria-hidden="true">→</span><label><span>{mapText("to", "To")}</span><input type="date" name="to_date" value={toDate} /></label></fieldset>
            <button type="submit">{mapText("applyFilters", "Apply filters")}</button>
          </form>
        </div>
      </details>
    </div>
    <div class="memory-map-search-results" data-map-search-results id="memory-map-search-results" hidden>
      <p class="memory-map-accessible-count" data-map-accessible-count aria-live="polite"></p>
      <ul data-map-accessible-list></ul>
    </div>
  </section>

  <div class="memory-map-layout">
    <div class="memory-map-workspace">
      <section class="memory-map-pathway" data-map-pathway aria-labelledby="memory-map-pathway-title">
        <header class="memory-map-pathway-header">
          <p class="intelligence-eyebrow">{traceText("pathwayEyebrow", "Decision lineage")}</p>
          <h2 id="memory-map-pathway-title">{traceText("pathwayTitle", "The path of a decision")}</h2>
          <p>{traceText("pathwayIntro", "Follow what was decided, why it was chosen, what supports it, and where it was reflected.")}</p>
        </header>
        <ol class="memory-map-pathway-steps" aria-label={traceText("pathwayTitle", "The path of a decision")}>
          {([
            ["decision", "01", traceText("stepDecision", "Decision"), traceText("stepDecisionDescription", "What was decided")],
            ["reason", "02", traceText("stepReason", "Reason"), traceText("stepReasonDescription", "Why it was chosen")],
            ["evidence", "03", traceText("stepEvidence", "Evidence"), traceText("stepEvidenceDescription", "What supports it")],
            ["artifact", "04", traceText("stepArtifact", "Artifact"), traceText("stepArtifactDescription", "Where it was reflected")]
          ] as const).map(([id, index, label, description]) => (
            <li data-trace-step-item={id} data-state="concept">
              <button type="button" data-trace-step={id} aria-current={id === "decision" ? "step" : undefined}>
                <span class="memory-map-pathway-index">{index}</span>
                <span class="memory-map-pathway-copy"><strong data-trace-step-label>{label}</strong><small data-trace-step-description>{description}</small></span>
                <span class="memory-map-pathway-state" data-trace-step-state aria-hidden="true"></span>
              </button>
            </li>
          ))}
        </ol>
        <p class="memory-map-pathway-prompt" data-trace-pathway-prompt>{traceText("conceptPrompt", "Select a decision node to inspect a real path.")}</p>
      </section>
      <div class="memory-map-stage-shell" data-map-stage-shell>
        <div class="memory-map-stage" data-map-stage role="application" aria-label={mapText("mapAriaLabel", "3D memory map")}></div>
        <svg class="memory-map-glow-overlay" data-map-glow-overlay aria-hidden="true" focusable="false">
          <defs>
            <filter id="memory-map-gaussian-glow" x="-50%" y="-50%" width="200%" height="200%" color-interpolation-filters="sRGB">
              <feGaussianBlur stdDeviation="3.5" />
            </filter>
          </defs>
          <g data-map-svg-glow filter="url(#memory-map-gaussian-glow)"></g>
        </svg>
      </div>
      <div class="memory-map-fallback" data-map-fallback hidden>
        <div class="memory-map-fallback-note"><strong>{mapText("fallbackTitle", "3D view is unavailable; the accessible list remains available")}</strong><span>{mapText("fallbackBody", "Search, select a node, and inspect its decision path on this page. You can also open the full memory list with the same filters.")}</span><a data-map-fallback-link href={fallbackHref}>{mapText("openMemoryList", "Open memory list")}</a></div>
        <ul data-map-fallback-list></ul>
      </div>
    </div>
    <aside class="memory-map-inspector" data-map-inspector aria-label={traceText("pathwayTitle", "The path of a decision")} data-sheet-state="peek">
      <div class="memory-map-sheet-controls" aria-label={traceText("panelControls", "Trace panel controls")}>
        <button type="button" data-trace-sheet-expand>{traceText("expandPanel", "Expand")}</button>
        <button type="button" data-trace-sheet-collapse>{traceText("collapsePanel", "Collapse")}</button>
      </div>
      <p class="intelligence-eyebrow" data-map-trace-workspace-eyebrow>{traceText("currentPath", "This decision path")}</p>
      <span class="memory-map-node-kind" data-map-inspector-kind>{mapText("nothingSelected", "Nothing selected")}</span>
      <h2 data-map-inspector-title>{mapText("selectNode", "Select a node.")}</h2>
      <p data-map-inspector-summary>{mapText("selectNodeHint", "Select a node to inspect its owner, references, and net savings.")}</p>
      <p class="memory-map-inspector-status" data-map-inspector-status role="status" aria-live="polite" hidden></p>
      <section class="memory-map-inspector-section memory-map-trace-workspace" data-map-inspector-rationales-section>
        <h3 class="sr-only" data-map-trace-heading tabindex="-1">{traceText("pathwayTitle", "The path of a decision")}</h3>
        <p class="memory-map-trace-status" data-map-trace-status role="status" aria-live="polite" hidden></p>
        <div class="memory-map-inspector-records" data-map-inspector-rationales></div>
      </section>
      <details class="memory-map-technical" data-map-technical hidden>
        <summary>{traceText("technicalDetails", "Technical details")}</summary>
        <div class="memory-map-technical-body memory-map-inspector-detail" data-map-inspector-detail hidden>
          <dl class="memory-map-inspector-summary-grid">
            <div><dt>{mapText("projectLabel", "Project")}</dt><dd data-map-inspector-project>—</dd></div>
            <div><dt>{mapText("ownerLabel", "Owner")}</dt><dd data-map-inspector-owner>—</dd></div>
            <div><dt>{mapText("referencesLabel", "References")}</dt><dd data-map-inspector-refs>—</dd></div>
            <div><dt>{mapText("utilizationLabel", "Utilization")}</dt><dd data-map-inspector-utilization>—</dd></div>
            <div><dt>{mapText("netSavedLabel", "Net saved")}</dt><dd data-map-inspector-saved>—</dd></div>
          </dl>
          <dl class="memory-map-inspector-metadata" data-map-inspector-metadata></dl>
          <section class="memory-map-inspector-section" data-map-inspector-tags-section hidden>
            <h3>{mapText("tagsLabel", "Tags")}</h3>
            <div class="memory-map-tag-list" data-map-inspector-tags></div>
          </section>
          <section class="memory-map-inspector-section" data-map-inspector-content-section hidden>
            <h3>{mapText("contentLabel", "Content")}</h3>
            <pre class="memory-map-inspector-content" data-map-inspector-content></pre>
          </section>
          <section class="memory-map-inspector-section" data-map-inspector-versions-section hidden>
            <h3>{mapText("historyLabel", "History")}</h3>
            <div class="memory-map-inspector-records" data-map-inspector-versions></div>
          </section>
        </div>
      </details>
      <a class="memory-map-open" data-map-inspector-link href="/memories" target="_blank" rel="noreferrer" hidden>{mapText("openMemory", "Open in memory library")}</a>
    </aside>
  </div>

  <dialog class="memory-map-resource-dialog" data-map-resource-dialog aria-labelledby="memory-map-resource-dialog-title">
    <div class="memory-map-resource-dialog-surface">
      <header class="memory-map-resource-dialog-header">
        <div>
          <p class="intelligence-eyebrow" data-map-resource-dialog-role></p>
          <h2 id="memory-map-resource-dialog-title" data-map-resource-dialog-title>{traceText("resourcePreview", "Artifact preview")}</h2>
        </div>
        <button type="button" class="memory-map-resource-dialog-close" data-map-resource-dialog-close aria-label={traceText("closePreview", "Close preview")}>×</button>
      </header>
      <p class="memory-map-resource-dialog-note" data-map-resource-dialog-note hidden></p>
      <div class="memory-map-resource-dialog-reference" data-map-resource-dialog-reference></div>
      <dl class="memory-map-resource-dialog-meta" data-map-resource-dialog-meta></dl>
      <footer class="memory-map-resource-dialog-actions">
        <button type="button" data-map-resource-dialog-done>{traceText("closePreview", "Close preview")}</button>
        <a href="/resources" target="_blank" rel="noreferrer" data-map-resource-dialog-link>{traceText("openDetailsNewTab", "Open details in a new tab")}</a>
      </footer>
    </div>
  </dialog>

  <footer class="memory-map-footer">
    <div class="memory-map-legend"><div class="memory-map-project-legend" data-project-legend></div><span class="legend-line legend-line-source"></span><span>{mapText("sourceNodeLegend", "line color = source node")}</span><span class="legend-arrow">→</span><span>{mapText("directedRelationLegend", "directed relation")}</span></div>
  </footer>
</section>

<script>
  import type { MemoryMapTraceResponse } from "@org-brain/contracts";
  import { buildMemoryMapTraceView, evidenceClaimKeys, normalizeTraceStep, TRACE_STEP_IDS, type TraceStepId } from "../../lib/memory-map-trace-view";

  type MapNode = {
    id: string;
    node_type?: "memory" | "decision" | "project" | "entity" | "tenant";
    memory_id: string | null;
    decision_id?: string | null;
    related_memory_id?: string | null;
    entity_id?: string | null;
    entity_type?: string | null;
    entity_link_count?: number;
    cross_project_link_count?: number;
    member_count?: number;
    tenant_id?: string | null;
    label: string;
    summary?: string | null;
    project_id: string | null;
    owner_principal: string | null;
    created_by_principal: string | null;
    reference_count: number;
    consumer_count: number;
    used_count: number;
    utilization_rate: number | null;
    net_saved_tokens: number;
    injected_tokens: number;
    updated_at?: number | null;
    cluster_key?: string;
    decision_type?: string | null;
    confirmation_state?: string | null;
    confidence_score?: number | null;
    fx?: number;
    fy?: number;
    fz?: number;
  };

  type MemoryDetailPayload = {
    ok?: boolean;
    error?: { message?: string };
    data?: {
      memory_id: string;
      memory: {
        id?: string;
        source?: string | null;
        external_key?: string | null;
        created_at?: number | null;
        kind?: string | null;
        current_version?: number | null;
        last_accessed_at?: number | null;
        confidence_score?: number | null;
        utility_score?: number | null;
        actor_type?: string | null;
        actor_id?: string | null;
        owner_principal?: string | null;
        created_by_principal?: string | null;
        deleted_at?: number | null;
        deleted_by_principal?: string | null;
        delete_reason?: string | null;
        project_id?: string | null;
        content?: string | null;
        summary?: string | null;
        tags?: string[];
        lifecycle_state?: string | null;
        updated_at?: number | null;
        reference_count?: number | null;
        used_count?: number | null;
        consumer_count?: number | null;
        net_saved_tokens?: number | null;
        injected_tokens?: number | null;
      } | null;
      versions: Array<{
        version: number;
        operation: string;
        summary: string | null;
        kind: string;
        lifecycle_state: string;
        actor_type: string | null;
        actor_id: string | null;
        created_at: number;
      }>;
      rationales: Array<{
        id: string;
        decision_type: string;
        conclusion: string;
        reason_summary: string;
        status: string;
        confirmation_state: string;
        confidence_score: number | null;
        created_at: number;
        confirmed_at: number | null;
        evidence: Array<{
          id: string;
          evidence_type: string;
          evidence_ref: string;
          relation: string;
          note: string | null;
          weight_score: number | null;
        }>;
      }>;
      meta?: { usage_id?: string; verification_sampled?: boolean };
    };
  };

  type MemoryMapTracePayload = {
    ok?: boolean;
    error?: { message?: string };
    data?: {
      selected: {
        node_type: "memory" | "decision";
        id: string;
        memory_id: string;
        decision_rationale_id: string | null;
      };
      memory: {
        id: string;
        project_id: string | null;
        kind: string;
        summary: string | null;
        lifecycle_state: string;
        verification_state: string;
        verified_at: number | null;
        reuse_rule: string | null;
        learning: Record<string, unknown> | null;
        versions: Array<{
          version: number;
          operation: string;
          summary: string | null;
          kind: string;
          lifecycle_state: string;
          actor_type: string | null;
          actor_id: string | null;
          created_at: number;
        }>;
      };
      selected_rationale_id: string | null;
      rationales: Array<{
        id: string;
        decision_type: string;
        conclusion: string;
        reason_summary: string;
        status: string;
        confirmation_state: string;
        confidence_score: number | null;
        created_at: number;
        confirmed_at: number | null;
        derived: {
          lesson_type: string | null;
          trigger: string | null;
          question: string | null;
          decision_key: string | null;
          decision: string | null;
          selected_value: string | null;
          rationale: string | null;
          alternatives: Array<{ alternative: string; reason_rejected: string | null }>;
          constraints: string[];
          reuse_when: string | null;
          outcome: string | null;
          symptom: string | null;
          failed_approach: string | null;
          root_cause: string | null;
          correction: string | null;
          verified_outcome: string | null;
          avoidance_rule: string | null;
        };
        evidence: Array<{
          id: string;
          evidence_type: string;
          evidence_ref: string;
          relation: string;
          note: string | null;
          weight_score: number | null;
          content_hash: string | null;
          observed_at: number | null;
          attestation_ref: string | null;
        }>;
        resources: {
          sources: Array<{
            link: { role: string; resource_version_id: string | null; locator: Record<string, unknown> | null; note: string | null; confirmation_state: string; excerpt_digest: string | null };
            resource: { id: string; title: string; resource_kind: string; canonical_uri: string; source_system: string; lifecycle_state: string; current_version_id: string | null };
            version: { id: string; source_version: string | null; content_hash: string; captured_at: number; extraction_state: string; pinned: boolean } | null;
            freshness: string;
            availability: "readable";
          }>;
          artifacts: Array<{
            link: { role: string; resource_version_id: string | null; locator: Record<string, unknown> | null; note: string | null; confirmation_state: string; excerpt_digest: string | null };
            resource: { id: string; title: string; resource_kind: string; canonical_uri: string; source_system: string; lifecycle_state: string; current_version_id: string | null };
            version: { id: string; source_version: string | null; content_hash: string; captured_at: number; extraction_state: string; pinned: boolean } | null;
            freshness: string;
            availability: "readable";
          }>;
        };
      }>;
      completeness: {
        rationale_count: number;
        evidence_count: number;
        source_count: number;
        artifact_count: number;
        missing: string[];
        partial: boolean;
        truncated: boolean;
      };
    };
  };

  const root = document.querySelector<HTMLElement>("[data-memory-map-root]");
  if (root) {
    const data = JSON.parse(root.dataset.map || "{}") as { nodes: MapNode[]; links: Array<{ id?: string; source: string; target: string; relation: string; directed?: boolean; inferred?: boolean; weight?: number; confidence?: number | null; cross_project?: boolean }>; cluster_mode: boolean; total_count?: number; visible_count?: number; memory_visible_count?: number; project_count?: number; entity_count?: number; decision_count?: number; related_count?: number; relationship_count?: number; cross_project_link_count?: number; truncated?: boolean };
    const stage = root.querySelector<HTMLElement>("[data-map-stage]");
    const glowOverlay = root.querySelector<SVGSVGElement>("[data-map-glow-overlay]");
    const svgGlowGroup = root.querySelector<SVGGElement>("[data-map-svg-glow]");
    const fallback = root.querySelector<HTMLElement>("[data-map-fallback]");
    const fallbackList = root.querySelector<HTMLUListElement>("[data-map-fallback-list]");
    const search = root.querySelector<HTMLInputElement>("[data-map-search]");
    const inspectorTitle = root.querySelector<HTMLElement>("[data-map-inspector-title]");
    const inspectorSummary = root.querySelector<HTMLElement>("[data-map-inspector-summary]");
    const inspectorProject = root.querySelector<HTMLElement>("[data-map-inspector-project]");
    const inspectorOwner = root.querySelector<HTMLElement>("[data-map-inspector-owner]");
    const inspectorRefs = root.querySelector<HTMLElement>("[data-map-inspector-refs]");
    const inspectorUtilization = root.querySelector<HTMLElement>("[data-map-inspector-utilization]");
    const inspectorSaved = root.querySelector<HTMLElement>("[data-map-inspector-saved]");
    const inspectorKind = root.querySelector<HTMLElement>("[data-map-inspector-kind]");
