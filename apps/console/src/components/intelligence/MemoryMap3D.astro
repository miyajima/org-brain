  .memory-map-pathway-steps button {
    min-height: 3.65rem;
    border-color: transparent;
    background: transparent;
  }
  .memory-map-pathway-steps li::after {
    content: "";
    position: absolute;
    z-index: -1;
    top: 1.38rem;
    left: calc(50% + 1.25rem);
    width: calc(100% - 2.5rem);
    height: 2px;
    background: rgba(99,189,255,.34);
    box-shadow: 0 0 10px rgba(99,189,255,.16);
  }
  .memory-map-pathway-steps li:nth-child(2)::after { background: rgba(255,184,77,.4); box-shadow: 0 0 10px rgba(255,184,77,.15); }
  .memory-map-pathway-steps li:nth-child(3)::after { background: rgba(67,220,173,.4); box-shadow: 0 0 10px rgba(67,220,173,.15); }
  .memory-map-pathway-steps li:last-child::after { display: none; }
