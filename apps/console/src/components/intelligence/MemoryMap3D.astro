    });
    const selectableNodes = data.nodes.filter((candidate) => candidate.node_type === "decision" || candidate.node_type === "memory");
    const pickerNodeLabel = (node: MapNode) => presentNarrative(displayNodeLabel(node))
      .replace(/^[^|]+\|\s*[^|]+\|\s*/u, "")
      .replace(/^[a-z][a-z0-9_-]*:\s*/iu, "")
      .trim();
    const pickerNodeKind = (node: MapNode) => {
      const failure = node.decision_type === "failure_prevention"
        || /(?:^|\|)\s*failure\s*(?:\||$)/iu.test(node.label)
        || /^failure_prevention\s*:/iu.test(node.label);
      if (failure) return traceText("failureKind", "Failure learning");
      return node.node_type === "decision" ? mapText("decisionKind", "Decision") : mapText("memoryKind", "Memory");
    };
    const renderAccessibleChoices = (rawQuery = "") => {
      if (!accessibleList) return;
      const query = rawQuery.trim().toLocaleLowerCase();
      const matches = selectableNodes.filter((node) => {
        if (!query) return true;
        return [pickerNodeLabel(node), pickerNodeKind(node), node.id, node.project_id || "", node.confirmation_state || ""]
          .some((value) => value.toLocaleLowerCase().includes(query));
      });
      const orderedMatches = selectedId
        ? [...matches.filter((node) => node.id === selectedId), ...matches.filter((node) => node.id !== selectedId)]
        : matches;
      const visible = orderedMatches.slice(0, 6);
      accessibleList.innerHTML = "";
      for (const node of visible) {
        const item = document.createElement("li");
        const button = document.createElement("button");
        button.type = "button";
        button.className = "memory-map-accessible-node";
        button.dataset.mapAccessibleNodeId = node.id;
        button.setAttribute("aria-pressed", String(node.id === selectedId));
        appendText(button, "strong", pickerNodeLabel(node));
        appendText(button, "span", pickerNodeKind(node), "memory-map-accessible-node-kind");
        appendText(button, "span", `${mapText("projectLabel", "Project")}: ${node.project_id || mapText("notSet", "Not set")}`, "memory-map-accessible-node-project");
        appendText(button, "span", `${mapText("confirmationLabel", "Confirmation")}: ${stateValueLabel(node.confirmation_state || mapText("notSet", "Not set"))}`, "memory-map-accessible-node-state");
        button.addEventListener("click", () => {
          selectNode(node, { keyboard: true });
          focusGraphNode(node);
        });
        item.appendChild(button);
        accessibleList.appendChild(item);
      }
      if (accessibleCount) {
        accessibleCount.textContent = traceText("pickerCount", "Showing {visible} of {total}")
          .replace("{visible}", String(visible.length))
          .replace("{total}", String(matches.length));
      }
    };
    refreshAccessibleChoices = () => renderAccessibleChoices(accessibleSearch?.value || "");
    openSearchResults = () => {
      if (!searchResults || !accessibleSearch) return;
      searchResults.hidden = false;
      accessibleSearch.setAttribute("aria-expanded", "true");
    };
    closeSearchResults = () => {
      if (!searchResults || !accessibleSearch) return;
      searchResults.hidden = true;
      accessibleSearch.setAttribute("aria-expanded", "false");
    };
    renderAccessibleChoices();
    accessibleSearch?.addEventListener("focus", () => {
      renderAccessibleChoices(accessibleSearch.value);
      openSearchResults();
    });
    accessibleSearch?.addEventListener("input", () => {
      renderAccessibleChoices(accessibleSearch.value);
      openSearchResults();
    });
    accessibleSearch?.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        closeSearchResults();
        return;
      }
      if (event.key !== "ArrowDown" && event.key !== "Enter") return;
      const firstChoice = accessibleList?.querySelector<HTMLButtonElement>("[data-map-accessible-node-id]");
      if (!firstChoice) return;
      event.preventDefault();
      if (event.key === "Enter") firstChoice.click();
      else firstChoice.focus();
    });
    commandBar?.addEventListener("keydown", (event) => {
      const choice = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-map-accessible-node-id]");
      if (!choice) return;
      if (event.key === "Escape") {
        event.preventDefault();
        closeSearchResults();
        accessibleSearch?.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (!commandBar?.contains(event.target as Node)) closeSearchResults();
    });
    for (const button of root.querySelectorAll<HTMLButtonElement>("[data-map-preset]")) {
      button.addEventListener("click", () => {
        preset = button.dataset.mapPreset || "project";
        root.querySelectorAll("[data-map-preset]").forEach((candidate) => candidate.classList.toggle("is-active", candidate === button));
        renderLegend();
        updateGraph();
      });
    }
    if (!supports3D()) {
      redirectToList(mapText("fallbackTitle", "3D view is unavailable; the accessible list remains available"));
    } else if (stage) {
      (async () => {
        try {
          const [module, THREE] = await Promise.race([
            Promise.all([
              import("3d-force-graph"),
              import("three")
            ]),
            new Promise<never>((_, reject) => window.setTimeout(() => reject(new Error("3D library load timeout")), 15000))
          ]);
          const ForceGraph3D = module.default as unknown as new (element: HTMLElement) => GraphInstance;
          threeInstance = THREE;
          svgProjectionVector = new THREE.Vector3();
          graph = new ForceGraph3D(stage)
            .backgroundColor("#050a12")
            .showNavInfo(false)
            .nodeLabel((node: MapNode) => {
              if (node.node_type === "tenant") return `${mapText("tenantRoot", "Tenant root")} · ${node.label}<br/>${node.member_count || 0} ${mapText("projectsLabel", "projects")} · ${node.reference_count || 0} ${mapText("memoriesLabel", "memories")}`;
              if (node.node_type === "project") return `${mapText("projectHub", "Project hub")} · ${node.label}<br/>${node.member_count || node.reference_count} ${mapText("membersLabel", "members")}`;
              if (node.node_type === "entity") return `${mapText("sharedConcept", "Shared concept")} · ${node.label}<br/>${node.reference_count} ${mapText("memoriesLabel", "memories")}`;
              if (node.node_type === "decision") return `${mapText("decisionKind", "Decision")} · ${node.label}<br/>${node.confirmation_state || mapText("notSet", "unconfirmed")}`;
              return `${node.label}<br/>${node.owner_principal || mapText("noAssignment", "Unassigned")} · ${node.reference_count} ${mapText("refsLabel", "refs")}`;
            })
            .nodeThreeObject((node: MapNode) => createGlowNodeObject(node, THREE))
            .nodeThreeObjectExtend(false)
            .nodeVal(nodeValue)
            .nodeColor(colorFor)
            .nodeOpacity(0.92)
            .linkColor(linkColorFor)
            .linkVisibility(linkVisible)
            .linkWidth(linkWidthFor)
            .linkCurvature(linkCurvatureFor)
            .linkOpacity(0.6)
            .linkDirectionalArrowLength((link: GraphLink) => link.directed === false ? 0 : 2.4)
            .linkDirectionalArrowRelPos(1)
            .linkDirectionalParticles(linkParticlesFor)
            .linkDirectionalParticleSpeed(0.012)
            .linkDirectionalParticleWidth(1.3)
            .linkDirectionalParticleColor(linkColorFor)
            .onNodeClick((node: MapNode) => selectNode(node))
            .onBackgroundClick(() => selectNode(null))
            .graphData({ nodes: data.nodes, links: data.links });
          updateGlowAppearance();
          graph.width(stage.clientWidth).height(stage.clientHeight);
          graph.d3Force("charge")?.strength?.(-65);
          window.setTimeout(() => {
            if (pendingFocusId) return;
            if (!hasFocusedNode) centerGraph(650);
          }, 900);
          window.setTimeout(() => {
            if (pendingFocusId) return;
            if (!hasFocusedNode) centerGraph(500);
          }, 2400);
          if (pendingFocusId) {
            const pendingNode = data.nodes.find((node) => node.id === pendingFocusId);
            if (pendingNode) window.setTimeout(() => focusGraphNode(pendingNode), 1100);
          }
          stage.hidden = false;
          if (fallback) fallback.hidden = true;
          startSvgGlowLoop();
          resizeObserver?.observe(stage);
          stage.querySelector("canvas")?.addEventListener("webglcontextlost", () => {
            redirectToList(mapText("fallbackTitle", "3D view is unavailable; the accessible list remains available"));
          }, { once: true });
          window.setTimeout(() => {
            const canvas = stage.querySelector("canvas");
            const bounds = stage.getBoundingClientRect();
            if (!canvas || canvas.width < 2 || canvas.height < 2 || bounds.width < 10 || bounds.height < 10) {
              redirectToList(mapText("mapRenderFallback", "The 3D view could not be rendered, so the list is shown."));
            }
          }, 2500);
          if (data.nodes.length > 0 && !budgetedGlow) {
            window.setInterval(() => {
              glowPhase = (Math.sin(Date.now() / 560) + 1) / 2;
              updateGlowAppearance();
              graph?.nodeColor?.(colorFor);
              graph?.nodeVal?.(nodeValue);
            }, 90);
          }
        } catch (error) {
          console.error("MemoryMap3D initialization failed", error);
          redirectToList(mapText("mapRenderFallback", "The 3D view could not be rendered, so the list is shown."));
        }
      })();
    }
  }
</script>

