---
type MemoryMapNode = {
  id: string;
  node_type?: "memory" | "decision" | "project" | "entity" | "tenant";
  memory_id: string | null;
  decision_id?: string | null;
  related_memory_id?: string | null;
  entity_id?: string | null;
  entity_type?: string | null;
  entity_link_count?: number;
  cross_project_link_count?: number;
  member_count?: number;
  tenant_id?: string | null;
  label: string;
  summary?: string | null;
  project_id: string | null;
  owner_principal: string | null;
  created_by_principal: string | null;
  reference_count: number;
  consumer_count: number;
  used_count: number;
  utilization_rate: number | null;
  net_saved_tokens: number;
  injected_tokens: number;
  updated_at?: number | null;
  cluster_key?: string;
  decision_type?: string | null;
  confirmation_state?: string | null;
  confidence_score?: number | null;
  fx?: number;
  fy?: number;
  fz?: number;
};

type MemoryMapData = {
  scope: "mine" | "org";
  cluster_mode: boolean;
  total_count: number;
  visible_count?: number;
  memory_visible_count?: number;
  project_count?: number;
  entity_count?: number;
  decision_count?: number;
  related_count?: number;
  relationship_count?: number;
  cross_project_link_count?: number;
  truncated?: boolean;
  nodes: MemoryMapNode[];
  links: Array<{ id: string; source: string; target: string; relation: string; directed?: boolean; inferred?: boolean; weight?: number; confidence?: number | null; cross_project?: boolean }>;
  clusters: Array<{ id: string; kind: string; label: string; node_ids: string[] }>;
};

const { data, tenantId = "default", projectId = "", query = "", ownerPrincipal = "", fromDate = "", toDate = "", scope = "org", selectedId: initialSelectedId = "" } = Astro.props as {
  data: MemoryMapData;
  tenantId?: string;
  projectId?: string;
  query?: string;
  ownerPrincipal?: string;
  fromDate?: string;
  toDate?: string;
  scope?: "mine" | "org";
  selectedId?: string;
};
const serialized = JSON.stringify(data);
const listParams = new URLSearchParams({ tenant_id: tenantId, scope });
if (projectId) listParams.set("project_id", projectId);
if (query) listParams.set("q", query);
if (ownerPrincipal) listParams.set("owner_principal", ownerPrincipal);
if (fromDate) listParams.set("from_date", fromDate);
if (toDate) listParams.set("to_date", toDate);
const listHref = `/memories?${listParams.toString()}`;
const fallbackParams = new URLSearchParams(listParams);
fallbackParams.set("map_fallback", "1");
const fallbackHref = `/memories?${fallbackParams.toString()}`;
const projectOptionMap = new Map<string, string>();
for (const node of data.nodes) {
  if (node.node_type === "project" && node.project_id) projectOptionMap.set(node.project_id, node.label || node.project_id);
}
const projectOptions = [...projectOptionMap.entries()].sort(([left], [right]) => left.localeCompare(right));
const ownerOptions = [...new Set(
  data.nodes
    .filter((node) => node.node_type === "memory" && node.owner_principal)
    .map((node) => node.owner_principal as string)
)].sort((left, right) => left.localeCompare(right));
const filterSummary = [
  query ? `“${query}”` : null,
  projectId ? projectOptionMap.get(projectId) || projectId : "All projects",
  ownerPrincipal || (scope === "mine" ? "My memories" : "All owners"),
  fromDate || toDate ? `${fromDate || "…"} – ${toDate || "…"}` : "Any period"
].filter(Boolean).join(" · ");
---
<section class="memory-map-shell" data-memory-map-root data-map={serialized} data-list-href={fallbackHref} data-tenant-id={tenantId} data-project-id={projectId} data-scope={scope} data-selected-id={initialSelectedId}>
  <header class="memory-map-header">
    <div>
      <p class="intelligence-eyebrow">Memory constellation / WebGL</p>
      <h1>3D memory map</h1>
    </div>
  </header>

  <details class="memory-map-controls" data-map-controls>
    <summary class="memory-map-controls-summary">
      <span class="memory-map-controls-copy">
        <strong>Search &amp; filters</strong>
        <span>{filterSummary}</span>
      </span>
      <span class="memory-map-controls-chevron" aria-hidden="true"></span>
    </summary>
    <div class="memory-map-controls-body">
      <div class="memory-map-toolbar">
        <label class="memory-map-search"><span>Search map</span><input type="search" data-map-search value={query} placeholder="memory ID / summary / owner" /></label>
        <div class="memory-map-presets" aria-label="Map color presets">
          <button type="button" class="is-active" data-map-preset="project">Project</button>
          <button type="button" data-map-preset="owner">Owner</button>
          <button type="button" data-map-preset="utilization">Utilization</button>
        </div>
        <a class="memory-map-list-link" href={listHref}>一覧で見る</a>
      </div>
      <form class="memory-map-filters" method="get" action="/memories/constellation">
        <input type="hidden" name="tenant_id" value={tenantId} />
        <input type="hidden" name="scope" value={scope} />
        <label><span>Project</span><select name="project_id"><option value="" selected={!projectId}>All projects</option>{projectOptions.map(([value, label]) => <option value={value} selected={projectId === value}>{label}</option>)}</select></label>
        <label><span>Owner</span><select name="owner_principal" disabled={scope === "mine"}><option value="" selected={!ownerPrincipal}>{scope === "mine" ? "自分" : "All owners"}</option>{ownerOptions.map((value) => <option value={value} selected={ownerPrincipal === value}>{value}</option>)}</select></label>
        <fieldset class="memory-map-date-range" aria-label="Period"><label><span>From</span><input type="date" name="from_date" value={fromDate} /></label><span class="memory-map-range-arrow" aria-hidden="true">→</span><label><span>To</span><input type="date" name="to_date" value={toDate} /></label></fieldset>
        <button type="submit">Apply filters</button>
      </form>
    </div>
  </details>

  <div class="memory-map-layout">
    <div class="memory-map-stage-shell" data-map-stage-shell>
      <div class="memory-map-stage" data-map-stage role="application" aria-label="3D memory map"></div>
      <svg class="memory-map-glow-overlay" data-map-glow-overlay aria-hidden="true" focusable="false">
        <defs>
          <filter id="memory-map-gaussian-glow" x="-50%" y="-50%" width="200%" height="200%" color-interpolation-filters="sRGB">
            <feGaussianBlur stdDeviation="3.5" />
          </filter>
        </defs>
        <g data-map-svg-glow filter="url(#memory-map-gaussian-glow)"></g>
      </svg>
    </div>
    <div class="memory-map-fallback" data-map-fallback hidden>
      <div class="memory-map-fallback-note"><strong>3D表示を利用できないため一覧へ移動します</strong><span>同じ条件のメモリ一覧を開いています。自動で移動しない場合は、下のリンクを使用してください。</span><a data-map-fallback-link href={fallbackHref}>メモリ一覧を開く</a></div>
      <ul data-map-fallback-list></ul>
    </div>
    <aside class="memory-map-inspector" data-map-inspector aria-live="polite">
      <p class="intelligence-eyebrow">Selected node</p>
      <span class="memory-map-node-kind" data-map-inspector-kind>Nothing selected</span>
      <h2 data-map-inspector-title>ノードを選択</h2>
      <p data-map-inspector-summary>星を選択すると、所有者・参照数・純削減を確認できます。</p>
      <dl class="memory-map-inspector-summary-grid">
        <div><dt>Project</dt><dd data-map-inspector-project>—</dd></div>
        <div><dt>Owner</dt><dd data-map-inspector-owner>—</dd></div>
        <div><dt>References</dt><dd data-map-inspector-refs>—</dd></div>
        <div><dt>Utilization</dt><dd data-map-inspector-utilization>—</dd></div>
        <div><dt>Net saved</dt><dd data-map-inspector-saved>—</dd></div>
      </dl>
      <p class="memory-map-inspector-status" data-map-inspector-status hidden></p>
      <div class="memory-map-inspector-detail" data-map-inspector-detail hidden>
        <dl class="memory-map-inspector-metadata" data-map-inspector-metadata></dl>
        <section class="memory-map-inspector-section" data-map-inspector-tags-section hidden>
          <h3>Tags</h3>
          <div class="memory-map-tag-list" data-map-inspector-tags></div>
        </section>
        <section class="memory-map-inspector-section" data-map-inspector-content-section hidden>
          <h3>本文</h3>
          <pre class="memory-map-inspector-content" data-map-inspector-content></pre>
        </section>
        <section class="memory-map-inspector-section" data-map-inspector-rationales-section hidden>
          <h3>判断・根拠</h3>
          <div class="memory-map-inspector-records" data-map-inspector-rationales></div>
        </section>
        <section class="memory-map-inspector-section" data-map-inspector-versions-section hidden>
          <h3>変更履歴</h3>
          <div class="memory-map-inspector-records" data-map-inspector-versions></div>
        </section>
      </div>
      <a class="memory-map-open" data-map-inspector-link href="/memories">メモリライブラリで開く</a>
    </aside>
  </div>

  <footer class="memory-map-footer">
    <div class="memory-map-legend"><div class="memory-map-project-legend" data-project-legend></div><span class="legend-line legend-line-source"></span><span>line color = source node</span><span class="legend-arrow">→</span><span>directed relation</span></div>
  </footer>
</section>

<script>
  type MapNode = {
    id: string;
    node_type?: "memory" | "decision" | "project" | "entity" | "tenant";
    memory_id: string | null;
    decision_id?: string | null;
    related_memory_id?: string | null;
    entity_id?: string | null;
    entity_type?: string | null;
    entity_link_count?: number;
    cross_project_link_count?: number;
    member_count?: number;
    tenant_id?: string | null;
    label: string;
    summary?: string | null;
    project_id: string | null;
    owner_principal: string | null;
    created_by_principal: string | null;
    reference_count: number;
    consumer_count: number;
    used_count: number;
    utilization_rate: number | null;
    net_saved_tokens: number;
    injected_tokens: number;
    updated_at?: number | null;
    cluster_key?: string;
    decision_type?: string | null;
    confirmation_state?: string | null;
    confidence_score?: number | null;
    fx?: number;
    fy?: number;
    fz?: number;
  };

  type MemoryDetailPayload = {
    ok?: boolean;
    error?: { message?: string };
    data?: {
      memory_id: string;
      memory: {
        id?: string;
        source?: string | null;
        external_key?: string | null;
        created_at?: number | null;
        kind?: string | null;
        current_version?: number | null;
        last_accessed_at?: number | null;
        confidence_score?: number | null;
        utility_score?: number | null;
        actor_type?: string | null;
        actor_id?: string | null;
        owner_principal?: string | null;
        created_by_principal?: string | null;
        deleted_at?: number | null;
        deleted_by_principal?: string | null;
        delete_reason?: string | null;
        project_id?: string | null;
        content?: string | null;
        summary?: string | null;
        tags?: string[];
        lifecycle_state?: string | null;
        updated_at?: number | null;
        reference_count?: number | null;
        used_count?: number | null;
        consumer_count?: number | null;
        net_saved_tokens?: number | null;
        injected_tokens?: number | null;
      } | null;
      versions: Array<{
        version: number;
        operation: string;
        summary: string | null;
        kind: string;
        lifecycle_state: string;
        actor_type: string | null;
        actor_id: string | null;
        created_at: number;
      }>;
      rationales: Array<{
        id: string;
        decision_type: string;
        conclusion: string;
        reason_summary: string;
        status: string;
        confirmation_state: string;
        confidence_score: number | null;
        created_at: number;
        confirmed_at: number | null;
        evidence: Array<{
          id: string;
          evidence_type: string;
          evidence_ref: string;
          relation: string;
          note: string | null;
          weight_score: number | null;
        }>;
      }>;
      meta?: { usage_id?: string; verification_sampled?: boolean };
    };
  };

  const root = document.querySelector<HTMLElement>("[data-memory-map-root]");
  if (root) {
    const data = JSON.parse(root.dataset.map || "{}") as { nodes: MapNode[]; links: Array<{ id?: string; source: string; target: string; relation: string; directed?: boolean; inferred?: boolean; weight?: number; confidence?: number | null; cross_project?: boolean }>; cluster_mode: boolean; total_count?: number; visible_count?: number; memory_visible_count?: number; project_count?: number; entity_count?: number; decision_count?: number; related_count?: number; relationship_count?: number; cross_project_link_count?: number; truncated?: boolean };
    const stage = root.querySelector<HTMLElement>("[data-map-stage]");
    const glowOverlay = root.querySelector<SVGSVGElement>("[data-map-glow-overlay]");
    const svgGlowGroup = root.querySelector<SVGGElement>("[data-map-svg-glow]");
    const fallback = root.querySelector<HTMLElement>("[data-map-fallback]");
    const fallbackList = root.querySelector<HTMLUListElement>("[data-map-fallback-list]");
    const search = root.querySelector<HTMLInputElement>("[data-map-search]");
    const inspectorTitle = root.querySelector<HTMLElement>("[data-map-inspector-title]");
    const inspectorSummary = root.querySelector<HTMLElement>("[data-map-inspector-summary]");
    const inspectorProject = root.querySelector<HTMLElement>("[data-map-inspector-project]");
    const inspectorOwner = root.querySelector<HTMLElement>("[data-map-inspector-owner]");
    const inspectorRefs = root.querySelector<HTMLElement>("[data-map-inspector-refs]");
    const inspectorUtilization = root.querySelector<HTMLElement>("[data-map-inspector-utilization]");
    const inspectorSaved = root.querySelector<HTMLElement>("[data-map-inspector-saved]");
    const inspectorKind = root.querySelector<HTMLElement>("[data-map-inspector-kind]");
    const inspectorStatus = root.querySelector<HTMLElement>("[data-map-inspector-status]");
    const inspectorDetail = root.querySelector<HTMLElement>("[data-map-inspector-detail]");
    const inspectorMetadata = root.querySelector<HTMLElement>("[data-map-inspector-metadata]");
    const inspectorTagsSection = root.querySelector<HTMLElement>("[data-map-inspector-tags-section]");
    const inspectorTags = root.querySelector<HTMLElement>("[data-map-inspector-tags]");
    const inspectorContentSection = root.querySelector<HTMLElement>("[data-map-inspector-content-section]");
    const inspectorContent = root.querySelector<HTMLElement>("[data-map-inspector-content]");
    const inspectorRationalesSection = root.querySelector<HTMLElement>("[data-map-inspector-rationales-section]");
    const inspectorRationales = root.querySelector<HTMLElement>("[data-map-inspector-rationales]");
    const inspectorVersionsSection = root.querySelector<HTMLElement>("[data-map-inspector-versions-section]");
    const inspectorVersions = root.querySelector<HTMLElement>("[data-map-inspector-versions]");
    const projectLegend = root.querySelector<HTMLElement>("[data-project-legend]");
    const inspectorLink = root.querySelector<HTMLAnchorElement>("[data-map-inspector-link]");
    let fallbackScheduled = false;
    let preset = "project";
    let selectedId = root.dataset.selectedId || "";
    type GraphLink = { id?: string; source: string | MapNode; target: string | MapNode; relation?: string; directed?: boolean; inferred?: boolean; weight?: number; confidence?: number | null; cross_project?: boolean };
    type GraphInstance = {
      backgroundColor(value: string): GraphInstance;
      width(value: number): GraphInstance;
      height(value: number): GraphInstance;
      showNavInfo(value: boolean): GraphInstance;
      nodeLabel(fn: (node: MapNode) => string): GraphInstance;
      nodeVal(fn: (node: MapNode) => number): GraphInstance;
      nodeColor(fn: (node: MapNode) => string): GraphInstance;
      nodeThreeObject(fn: (node: MapNode) => unknown): GraphInstance;
      nodeThreeObjectExtend(value: boolean): GraphInstance;
      nodeOpacity(value: number): GraphInstance;
      nodeVisibility(fn: (node: MapNode) => boolean): GraphInstance;
      linkColor(fn: (link: GraphLink) => string): GraphInstance;
      linkVisibility(fn: (link: GraphLink) => boolean): GraphInstance;
      linkWidth(fn: (link: GraphLink) => number): GraphInstance;
      linkCurvature(fn: (link: GraphLink) => number): GraphInstance;
      linkOpacity(value: number): GraphInstance;
      linkDirectionalArrowLength(value: number | ((link: GraphLink) => number)): GraphInstance;
      linkDirectionalArrowRelPos(value: number): GraphInstance;
      linkDirectionalParticles(fn: (link: GraphLink) => number): GraphInstance;
      linkDirectionalParticleSpeed(value: number): GraphInstance;
      linkDirectionalParticleWidth(value: number): GraphInstance;
      linkDirectionalParticleColor(fn: (link: GraphLink) => string): GraphInstance;
      onBackgroundClick(fn: (event: MouseEvent) => void): GraphInstance;
      d3Force(name: string): { strength?(value: number): unknown } | null;
      camera(): unknown;
      cameraPosition(): { x: number; y: number; z: number };
      cameraPosition(position: { x?: number; y?: number; z?: number }, lookAt?: { x: number; y: number; z: number }, transitionMs?: number): GraphInstance;
      zoomToFit(durationMs?: number, padding?: number, nodeFilter?: (node: MapNode) => boolean): GraphInstance;
      onNodeClick(fn: (node: MapNode) => void): GraphInstance;
      graphData(value: { nodes: MapNode[]; links: GraphLink[] }): GraphInstance;
    };
    let graph: GraphInstance | null = null;
    let threeInstance: any = null;
    let svgProjectionVector: any = null;
    let glowPhase = 0;
    let selectedRelatedIds = new Set<string>();
    let pendingFocusId = "";
    let hasFocusedNode = false;
    let svgGlowLoopActive = false;
    type GlowLayer = {
      scale: { set(x: number, y: number, z: number): void };
      material: { color: { set(value: string): void }; opacity: number };
      coreSize: number;
    };
    const glowLayers = new Map<string, { core: GlowLayer; halo: GlowLayer; outer: GlowLayer }>();
    let glowTexture: any = null;

    const palette = [
      "#4bb8ff", "#9c87ff", "#ffb454", "#42d6ac",
      "#ff6f91", "#d9e85f", "#6f98ff", "#ef8fd1",
      "#56d6dc", "#ff8d5c", "#9bd95b", "#c6a0ff",
      "#f4ce5f", "#5fa8ff", "#ff9dbb", "#72d9ad"
    ];
    const projectKeys = [...new Set(
      data.nodes
        .filter((node) => node.node_type === "project" && node.project_id)
        .map((node) => node.project_id as string)
    )].sort((left, right) => left.localeCompare(right));
    const projectColorIndex = new Map(projectKeys.map((key, index) => [key, index % palette.length]));
    const hashColor = (value: string | null | undefined) => {
      const key = String(value || "unassigned");
      const assignedIndex = projectColorIndex.get(key);
      if (assignedIndex !== undefined) return palette[assignedIndex];
      let hash = 0;
      for (const character of key) hash = (hash * 31 + character.charCodeAt(0)) >>> 0;
      return palette[hash % palette.length];
    };
    const nodeId = (item: string | MapNode) => typeof item === "string" ? item : item.id;
    const isSelectedLink = (link: GraphLink) => Boolean(selectedId && [link.source, link.target].some((item) => nodeId(item) === selectedId));
    const isCrossProjectLink = (link: GraphLink) => Boolean(link.cross_project) || link.relation?.startsWith("shared-cross:") || link.relation?.startsWith("entity-cross:") || link.relation?.startsWith("cross:");
    const isTenantLink = (link: GraphLink) => link.relation?.startsWith("tenant:") ?? false;
    const relatedNodeIdsFor = (id: string) => {
      const related = new Set<string>();
      if (!id) return related;
      related.add(id);

      const firstHop = new Set<string>();
      for (const link of data.links) {
        const source = nodeId(link.source);
        const target = nodeId(link.target);
        if (source === id) firstHop.add(target);
        if (target === id) firstHop.add(source);
      }
      for (const neighbor of firstHop) related.add(neighbor);

      // Project, concept, and decision hubs are intentionally treated as
      // one-hop bridges so the connected memory cluster keeps its project
      // colors when one memory is selected.
      const hubIds = [...firstHop].filter((neighbor) => {
        const node = data.nodes.find((candidate) => candidate.id === neighbor);
        return node?.node_type === "tenant" || node?.node_type === "project" || node?.node_type === "entity" || node?.node_type === "decision";
      });
      if (hubIds.length > 0) {
        const hubs = new Set(hubIds);
        for (const link of data.links) {
          const source = nodeId(link.source);
          const target = nodeId(link.target);
          if (hubs.has(source)) related.add(target);
          if (hubs.has(target)) related.add(source);
        }
      }
      return related;
    };
    const directRelatedNodeIdsFor = (id: string) => {
      const related = new Set<string>(id ? [id] : []);
      if (!id) return related;
      for (const link of data.links) {
        const source = nodeId(link.source);
        const target = nodeId(link.target);
        if (source === id) related.add(target);
        if (target === id) related.add(source);
      }
      return related;
    };
    const baseColorFor = (node: MapNode) => {
      if (node.node_type === "tenant") return "#f4d58b";
      if (node.node_type === "entity") return preset === "utilization" ? "#8496a3" : "#d8e6ee";
      if (node.node_type === "project") {
        if (preset === "owner") return "#c3a7ff";
        if (preset === "utilization") return "#8d9aa3";
        return hashColor(node.project_id);
      }
      if (node.node_type === "decision") {
        if (preset === "owner") return "#ffbf72";
        if (preset === "utilization") return "#8c7a68";
        return hashColor(node.project_id);
      }
      if (preset === "owner") return hashColor(node.owner_principal);
      if (preset === "utilization") {
        if (node.utilization_rate === null) return "#5e7180";
        const hue = Math.max(0, Math.min(125, node.utilization_rate * 125));
        return `hsl(${hue} 84% 62%)`;
      }
      return hashColor(node.project_id);
    };
    const colorFor = (node: MapNode) => {
      if (node.id === selectedId) return "#ffffff";
      if (selectedId && !selectedRelatedIds.has(node.id)) return "rgba(107,135,158,.2)";
      return baseColorFor(node);
    };
    const nodeValue = (node: MapNode) => {
      const base = node.node_type === "tenant"
        ? Math.max(14, Math.log2((node.member_count || node.reference_count) + 2) * 3.2)
        : node.node_type === "project"
          ? Math.max(7, Math.log2((node.member_count || node.reference_count) + 2) * 5)
        : node.node_type === "entity"
          ? Math.max(1.7, Math.log2(node.reference_count + 2) * 1.8)
          : node.node_type === "decision" ? 1.4 : Math.max(1.5, Math.log2(node.reference_count + 2) * 2.4);
      return base;
    };
    const totalNodeCount = Number(data.total_count ?? data.nodes.length);
    // Calculate once at display start: sparse maps need a readable halo, while
    // dense maps keep the same visual language without turning into a light wall.
    const budgetedGlow = totalNodeCount > 1500 || data.nodes.length > 1500;
    const ambientGlowIntensity = Math.max(0.78, Math.min(1.5, 2.2 - Math.log10(Math.max(1, totalNodeCount)) * 0.25));
    const ambientGlowSize = 0.82 + ambientGlowIntensity * 0.28;
    const svgAmbientOpacity = Math.min(budgetedGlow ? 0.4 : 0.62, (budgetedGlow ? 0.26 : 0.28) * ambientGlowIntensity);
    const svgGlowBudget = budgetedGlow ? 192 : 256;
    const glowImportance = (node: MapNode) => {
      const typeWeight = node.node_type === "tenant"
        ? 1_000_000_000
        : node.node_type === "project"
          ? 100_000_000
          : node.node_type === "entity" || node.node_type === "decision" ? 10_000_000 : 0;
      return typeWeight + node.reference_count * 100 + node.consumer_count * 10 + Math.max(0, node.net_saved_tokens);
    };
    const svgGlowNodes = [...data.nodes]
      .sort((left, right) => glowImportance(right) - glowImportance(left))
      .slice(0, svgGlowBudget);
