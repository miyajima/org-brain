          const item = document.createElement("li");
          item.innerHTML = `<span class="fallback-node-dot" style="background:${colorFor(node)}"></span><div><strong></strong><small></small></div><b></b>`;
          const strong = item.querySelector("strong");
          const small = item.querySelector("small");
          const count = item.querySelector("b");
          if (strong) strong.textContent = node.label;
          if (small) small.textContent = `${node.project_id || "no-project"} · ${node.owner_principal || "unassigned"}`;
          if (count) count.textContent = `${node.reference_count} refs`;
          item.addEventListener("click", () => selectNode(node));
          fallbackList.appendChild(item);
        }
      }
      if (inspectorSummary && reason) inspectorSummary.textContent = `${reason} ${inspectorSummary.textContent || ""}`.trim();
    };
    const redirectToList = (reason: string) => {
      renderFallback(reason);
      if (fallbackScheduled) return;
      fallbackScheduled = true;
      window.setTimeout(() => {
        window.location.replace(root.dataset.listHref || "/memories");
      }, 450);
    };
    const supports3D = () => {
      const mobile = window.matchMedia("(max-width: 760px)").matches;
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const canvas = document.createElement("canvas");
      const webgl = Boolean(canvas.getContext("webgl") || canvas.getContext("experimental-webgl"));
      return !mobile && !reduced && webgl;
    };
    const updateGraph = () => {
      if (!graph) return;
      updateGlowAppearance();
      graph?.nodeColor?.(colorFor);
      graph?.nodeVal?.(nodeValue);
      graph?.nodeVisibility?.(visible);
      graph?.linkColor?.(linkColorFor);
      graph?.linkVisibility?.(linkVisible);
      graph?.linkWidth?.(linkWidthFor);
    };
    const centerGraph = (durationMs = 450) => {
      if (!graph) return;
      graph.zoomToFit(durationMs, 32);
      window.setTimeout(() => {
        if (!graph) return;
        const positionedNodes = data.nodes as Array<MapNode & { x?: number; y?: number; z?: number }>;
        const placed = positionedNodes.filter((node) => [node.x, node.y, node.z].every((value) => typeof value === "number" && Number.isFinite(value)));
        if (placed.length === 0) return;
        const bounds = placed.reduce((acc, node) => ({
          minX: Math.min(acc.minX, node.x as number),
          maxX: Math.max(acc.maxX, node.x as number),
          minY: Math.min(acc.minY, node.y as number),
          maxY: Math.max(acc.maxY, node.y as number),
          minZ: Math.min(acc.minZ, node.z as number),
          maxZ: Math.max(acc.maxZ, node.z as number)
        }), { minX: Infinity, maxX: -Infinity, minY: Infinity, maxY: -Infinity, minZ: Infinity, maxZ: -Infinity });
        const center = {
          x: (bounds.minX + bounds.maxX) / 2,
          y: (bounds.minY + bounds.maxY) / 2,
          z: (bounds.minZ + bounds.maxZ) / 2
        };
        if (!Object.values(center).every((value) => Number.isFinite(value))) return;
        const camera = graph.cameraPosition();
        graph.cameraPosition({ x: camera.x + center.x, y: camera.y + center.y, z: camera.z + center.z }, center, durationMs);
      }, Math.max(120, durationMs));
    };
    let resizeTimer = 0;
    const resizeObserver = stage && typeof ResizeObserver !== "undefined"
      ? new ResizeObserver(() => {
          if (!graph || !stage) return;
          graph.width(stage.clientWidth).height(stage.clientHeight);
          window.clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(() => centerGraph(350), 120);
        })
      : null;
    search?.addEventListener("input", updateGraph);
    for (const button of root.querySelectorAll<HTMLButtonElement>("[data-map-preset]")) {
      button.addEventListener("click", () => {
        preset = button.dataset.mapPreset || "project";
        root.querySelectorAll("[data-map-preset]").forEach((candidate) => candidate.classList.toggle("is-active", candidate === button));
        renderLegend();
        updateGraph();
      });
    }
    if (!supports3D()) {
      redirectToList(data.cluster_mode ? "クラスタ表示へ切り替えられないため一覧表示にします。" : "モバイル、WebGL非対応、または軽減モーション設定のため一覧表示にします。");
    } else if (stage) {
      (async () => {
        try {
          const [module, THREE] = await Promise.race([
            Promise.all([
              import("3d-force-graph"),
              import("three")
            ]),
            new Promise<never>((_, reject) => window.setTimeout(() => reject(new Error("3D library load timeout")), 5000))
          ]);
          const ForceGraph3D = module.default as unknown as new (element: HTMLElement) => GraphInstance;
          threeInstance = THREE;
          svgProjectionVector = new THREE.Vector3();
          graph = new ForceGraph3D(stage)
            .backgroundColor("#050a12")
            .showNavInfo(false)
            .nodeLabel((node: MapNode) => {
              if (node.node_type === "tenant") return `Tenant root · ${node.label}<br/>${node.member_count || 0} projects · ${node.reference_count || 0} memories`;
              if (node.node_type === "project") return `Project hub · ${node.label}<br/>${node.member_count || node.reference_count} members`;
              if (node.node_type === "entity") return `Shared concept · ${node.label}<br/>${node.reference_count} memories`;
              if (node.node_type === "decision") return `Decision · ${node.label}<br/>${node.confirmation_state || "unconfirmed"}`;
              return `${node.label}<br/>${node.owner_principal || "unassigned"} · ${node.reference_count} refs`;
            })
            .nodeThreeObject((node: MapNode) => createGlowNodeObject(node, THREE))
            .nodeThreeObjectExtend(false)
            .nodeVal(nodeValue)
            .nodeColor(colorFor)
            .nodeOpacity(0.92)
            .linkColor(linkColorFor)
            .linkVisibility(linkVisible)
            .linkWidth(linkWidthFor)
            .linkCurvature(linkCurvatureFor)
            .linkOpacity(0.6)
            .linkDirectionalArrowLength((link: GraphLink) => link.directed === false ? 0 : 2.4)
            .linkDirectionalArrowRelPos(1)
            .linkDirectionalParticles(linkParticlesFor)
            .linkDirectionalParticleSpeed(0.012)
            .linkDirectionalParticleWidth(1.3)
            .linkDirectionalParticleColor(linkColorFor)
            .onNodeClick(selectNode)
            .onBackgroundClick(() => selectNode(null))
            .graphData({ nodes: data.nodes, links: data.links });
          updateGlowAppearance();
          graph.width(stage.clientWidth).height(stage.clientHeight);
          graph.d3Force("charge")?.strength?.(-65);
          window.setTimeout(() => {
            if (pendingFocusId) return;
            if (!hasFocusedNode) centerGraph(650);
          }, 900);
          window.setTimeout(() => {
            if (pendingFocusId) return;
            if (!hasFocusedNode) centerGraph(500);
          }, 2400);
          if (pendingFocusId) {
            const pendingNode = data.nodes.find((node) => node.id === pendingFocusId);
            if (pendingNode) window.setTimeout(() => focusGraphNode(pendingNode), 1100);
          }
          stage.hidden = false;
          if (fallback) fallback.hidden = true;
          startSvgGlowLoop();
          resizeObserver?.observe(stage);
          stage.querySelector("canvas")?.addEventListener("webglcontextlost", () => {
            redirectToList("3D描画が停止したため一覧表示にします。");
          }, { once: true });
          window.setTimeout(() => {
            const canvas = stage.querySelector("canvas");
            const bounds = stage.getBoundingClientRect();
            if (!canvas || canvas.width < 2 || canvas.height < 2 || bounds.width < 10 || bounds.height < 10) {
              redirectToList("3D描画を確認できなかったため一覧表示にします。");
            }
          }, 2500);
          if (data.nodes.length > 0 && !budgetedGlow) {
            window.setInterval(() => {
              glowPhase = (Math.sin(Date.now() / 560) + 1) / 2;
              updateGlowAppearance();
              graph?.nodeColor?.(colorFor);
              graph?.nodeVal?.(nodeValue);
            }, 90);
          }
        } catch (error) {
          console.error("MemoryMap3D initialization failed", error);
          redirectToList("3Dライブラリの読み込みに失敗したため一覧表示にします。");
        }
      })();
    }
  }
</script>

