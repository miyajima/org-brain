    .memory-map-workspace .memory-map-fallback {
      width: 100%;
      height: 27.5rem;
      min-height: 27.5rem;
      max-height: 27.5rem;
    }
    .memory-map-workspace .memory-map-stage,
    .memory-map-workspace .memory-map-fallback { height: 100%; min-height: 0; }
    .memory-map-layout .memory-map-inspector {
