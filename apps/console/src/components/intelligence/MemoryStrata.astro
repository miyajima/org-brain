---
import ConsoleSurfaceNav from "./ConsoleSurfaceNav.astro";
import InsightPageGuide from "./InsightPageGuide.astro";
import InsightScopeRail from "./InsightScopeRail.astro";
import IntelligencePoller from "./IntelligencePoller.astro";
import RecommendedActions from "./RecommendedActions.astro";
import {
  historyHealthyCopy,
  historyRecommendedActions,
  insightBriefingTitle,
  pageGuide
} from "../../lib/insight-guidance";
import { intelligenceDateLocale, intelligencePageCopy, type IntelligenceLocale } from "../../lib/intelligence-locale";
import {
  STRATA_LANES,
  buildAdjacentRevisionDiffs,
  buildStrataTimeline,
  layoutStrataTimelineRows,
  strataDeepLink,
  strataTimelineTrackWidth,
  timelineBounds,
  timelinePercent,
  type StrataDetailPayload,
  type StrataPayload,
  type StrataTimelineEvent
} from "../../lib/memory-strata-ui";

const { data, detail, loadError = null, refreshUrl, params, locale = "en" } = Astro.props as {
  data: StrataPayload;
  detail: StrataDetailPayload | null;
  loadError?: string | null;
  refreshUrl: string;
  params: URLSearchParams;
  locale?: IntelligenceLocale;
};
const copy = intelligencePageCopy(locale);
const plainHistoryCopy = {
  en: {
    currentSummary: "Current content",
    latestChange: "Latest change",
    evidence: "Evidence",
    reviewState: "Review state",
    noChange: "No revision recorded yet",
    noReview: "No review candidate right now",
    technicalDetails: "Technical details",
    revisions: "recorded changes",
    changeReason: "Change reason",
    reviewer: "Reviewer",
    noReviewer: "Not recorded",
    statuses: { canonical: "Currently adopted", promoted: "Formally adopted", active: "Active", current: "Current", confirmed: "Confirmed", proposed: "Proposed", inferred_unconfirmed: "Not yet confirmed", user_confirmed: "Confirmed by a member" },
    operations: { promote: "Formally adopted", promoted: "Formally adopted", capture: "Initial record", confirm: "Confirmed", create: "Initial proposal", revision: "Revision", current: "Current" }
  },
  ja: {
    currentSummary: "現在の内容",
    latestChange: "直近の変更",
    evidence: "根拠",
    reviewState: "レビュー状態",
    noChange: "変更履歴はまだありません",
    noReview: "現在の確認候補はありません",
    technicalDetails: "技術詳細",
    revisions: "件の変更記録",
    changeReason: "変更理由",
    reviewer: "確認者",
    noReviewer: "未記録",
    statuses: { canonical: "現在採用されている内容", promoted: "正式採用", active: "有効", current: "現在", confirmed: "確認済み", proposed: "提案中", inferred_unconfirmed: "未確認", user_confirmed: "メンバー確認済み" },
    operations: { promote: "正式採用", promoted: "正式採用", capture: "初回記録", confirm: "確認", create: "初回提案", revision: "内容更新", current: "現在" }
  },
  zh: {
    currentSummary: "当前内容",
    latestChange: "最近变更",
    evidence: "依据",
    reviewState: "审核状态",
    noChange: "尚无变更记录",
    noReview: "当前没有待确认项",
    technicalDetails: "技术详情",
    revisions: "条变更记录",
    changeReason: "变更原因",
    reviewer: "确认者",
    noReviewer: "未记录",
    statuses: { canonical: "当前采用的内容", promoted: "正式采用", active: "有效", current: "当前", confirmed: "已确认", proposed: "提议中", inferred_unconfirmed: "未确认", user_confirmed: "成员已确认" },
    operations: { promote: "正式采用", promoted: "正式采用", capture: "首次记录", confirm: "确认", create: "首次提议", revision: "内容更新", current: "当前" }
  }
}[locale];
const friendlyState = (value: string) => (plainHistoryCopy.statuses as Record<string, string>)[value.toLowerCase()] ?? value;
const friendlyOperation = (value: string) => (plainHistoryCopy.operations as Record<string, string>)[value.toLowerCase()] ?? value;
const events = buildStrataTimeline(data, detail);
const bounds = timelineBounds(events, data.generated_at || Date.now());
const strataTrackWidth = strataTimelineTrackWidth(events);
const timelinePlacements = layoutStrataTimelineRows(events, bounds, strataTrackWidth);
const lanePlacements = (lane: typeof STRATA_LANES[number]["id"]) => timelinePlacements.filter((point) => point.event.lane === lane);
const laneRowCount = (lane: typeof STRATA_LANES[number]["id"]) => Math.max(1, ...lanePlacements(lane).map((point) => point.row + 1));
const hasStackedRows = timelinePlacements.some((point) => point.row > 0);
const todayPercent = timelinePercent(data.generated_at || Date.now(), bounds);
const selectedChain = detail?.chain ?? null;
const revisionDiffs = selectedChain ? buildAdjacentRevisionDiffs(selectedChain.revisions) : [];
const newestRevision = revisionDiffs.at(-1)?.revision ?? null;
const attentionChains = data.chains.filter((chain) => chain.attention).slice(0, 6);
const scope = new URLSearchParams();
for (const key of ["tenant_id", "project_id", "lang"]) {
  const value = params.get(key);
  if (value) scope.set(key, value);
}
const formatDate = (value: number | null | undefined) => value
  ? new Intl.DateTimeFormat(intelligenceDateLocale(locale), { timeZone: "Asia/Tokyo", year: "numeric", month: "2-digit", day: "2-digit" }).format(new Date(value))
  : copy.strata.dateUnknown;
const dateTime = (value: number) => new Date(value).toISOString();
const formatMonth = (value: number) => new Intl.DateTimeFormat(intelligenceDateLocale(locale), { timeZone: "Asia/Tokyo", year: "numeric", month: "long" }).format(new Date(value));
const formatOptionalDate = (value: number | null | undefined) => value == null ? "—" : formatDate(value);
const snapshotField = (snapshot: Record<string, unknown> | undefined, keys: string[]) => {
  if (!snapshot) return null;
  for (const key of keys) {
    if (Object.prototype.hasOwnProperty.call(snapshot, key)) return { key, value: snapshot[key] };
  }
  return null;
};
const fieldLabels: Record<string, string> = copy.strata.fieldLabels;
const fieldLabel = (field: string) => fieldLabels[field] ?? field;
const formatSnapshotValue = (field: string, value: unknown) => {
  if (value === undefined) return copy.strata.fieldMissing;
  if (value === null) return "null";
  if (typeof value === "number" && /(?:_at|At|valid_|valid[A-Z]|captured)/.test(field) && value > 0) return formatDate(value);
  if (typeof value === "string") return value.length > 180 ? `${value.slice(0, 177)}…` : value;
  if (typeof value === "number" || typeof value === "boolean") return String(value);
  try {
    const serialized = JSON.stringify(value);
    return serialized.length > 180 ? `${serialized.slice(0, 177)}…` : serialized;
  } catch {
    return copy.strata.unrenderable;
  }
};
const currentConfirmation = snapshotField(newestRevision?.snapshot, ["confirmation_state", "confirmationState"]);
const currentStatus = snapshotField(newestRevision?.snapshot, ["status", "current_state", "lifecycle_state", "extraction_state"]);
const currentSupersession = snapshotField(newestRevision?.snapshot, ["superseded_by", "supersededBy"]);
const selectChainHref = (event: StrataTimelineEvent) => {
  const next = new URLSearchParams(params);
  next.set("source_type", event.sourceType);
  next.set("source_id", event.sourceId);
  return `/decisions/history?${next.toString()}`;
};
const selectedDeepLink = selectedChain ? strataDeepLink(selectedChain.source_type, selectedChain.source_id, scope) : null;
const guide = pageGuide("history", locale);
const recommendedActions = historyRecommendedActions(data, detail, selectedDeepLink, locale);
const healthyCopy = historyHealthyCopy(locale, data.chains.length > 0);
const briefingTitle = insightBriefingTitle(locale);
const primaryReviewAction = recommendedActions[0] ?? null;
const otherAttentionChains = attentionChains.filter((chain) => chain.id !== selectedChain?.id);
const reviewCandidateCount = recommendedActions.length + otherAttentionChains.length;
const dataState: "ready" | "empty" | "partial" | "error" = loadError
  ? "error"
  : data.truncated || data.has_more || Boolean(detail?.truncated.revisions || detail?.truncated.sources || selectedChain?.partial)
    ? "partial"
    : data.chains.length > 0 ? "ready" : "empty";
const uiCopy = {
  en: { source: "Org Brain knowledge history", window: "Recorded lineage", included: "History, revisions, relationships, and sources matching the current project and lineage filter.", excluded: "Other projects, filtered lineage types, and revisions or sources omitted by response limits.", unavailableTitle: "Knowledge history cannot be judged", unavailableBody: "The history request failed. Retry before treating the lineage as empty or reviewed." },
  ja: { source: "Org Brain 知識履歴", window: "記録済みの全期間", included: "現在のプロジェクト・系譜フィルターに合う履歴、変更、関係、参照元。", excluded: "他プロジェクト、フィルター外の系譜、応答上限で省略された変更・参照元。", unavailableTitle: "知識の履歴を判断できません", unavailableBody: "履歴データを取得できませんでした。空・確認済みとして扱わず、更新後に判断してください。" },
  zh: { source: "Org Brain 知识历史", window: "已记录的全部期间", included: "符合当前项目和谱系筛选的历史、修订、关系和来源。", excluded: "其他项目、筛选外谱系以及因响应上限省略的记录。", unavailableTitle: "无法判断知识历史", unavailableBody: "历史数据获取失败，请刷新后再判断。" }
}[locale];
const ticks = Array.from({ length: 4 }, (_, index) => bounds.start + ((bounds.end - bounds.start) * index) / 3);
const tone = (event: StrataTimelineEvent) => {
  if (event.attention?.severity === "critical") return "critical";
  if (event.attention || /conflict|stale|expired|superseded|deprecated|invalid/i.test(event.state)) return "warning";
  if (event.selected || /current|active|confirmed|reviewed/i.test(event.state)) return "canonical";
  return "support";
};
const describeEvent = (event: StrataTimelineEvent) => `${event.title}, ${formatDate(event.timestamp)}, ${friendlyOperation(event.operation)}, ${friendlyState(event.state)}`;
---
<section class="intelligence-surface memory-strata" aria-labelledby="strata-title">
  <header class="strata-header">
    <div>
      <ConsoleSurfaceNav section="decisions" params={params} locale={locale} />
      <p class="intelligence-eyebrow">{copy.strata.eyebrow}</p>
      <h1 id="strata-title">{copy.strata.title}</h1>
      <p>{copy.strata.description}</p>
    </div>
    <div class="strata-actions">
      {reviewCandidateCount > 0 && <a class="primary-action" href="#strata-attention">{copy.strata.reviewChanges} ({reviewCandidateCount})</a>}
      <IntelligencePoller refreshUrl={refreshUrl} initialData={data} generatedAt={data.generated_at} locale={locale} />
    </div>
  </header>

  <InsightPageGuide guide={guide} />
  <InsightScopeRail params={params} locale={locale} windowLabel={uiCopy.window} sourceLabel={uiCopy.source} included={uiCopy.included} excluded={uiCopy.excluded} state={dataState} generatedAt={data.generated_at} />
  {loadError ? (
    <section class="data-unavailable" role="status"><strong>{uiCopy.unavailableTitle}</strong><p>{uiCopy.unavailableBody}</p></section>
  ) : (
    <RecommendedActions locale={locale} title={briefingTitle} actions={recommendedActions} emptyTitle={healthyCopy.title} emptyBody={healthyCopy.body} />
  )}

  {!loadError && <div class="strata-filterbar">
    <form method="get" action="/decisions/history">
      {scope.get("tenant_id") && <input type="hidden" name="tenant_id" value={scope.get("tenant_id")} />}
      {scope.get("lang") && <input type="hidden" name="lang" value={scope.get("lang")} />}
      <label><span>{copy.strata.project}</span><input name="project_id" value={params.get("project_id") ?? ""} placeholder={copy.strata.all} /></label>
      <label><span>{copy.strata.lineageType}</span><select name="type"><option value="">{copy.strata.all}</option>{STRATA_LANES.map((lane) => <option value={lane.id} selected={params.get("type") === lane.id}>{copy.strata.lanes[lane.id].label}</option>)}</select></label>
      <button type="submit">{copy.strata.apply}</button>
    </form>
    {selectedChain && <div class="selected-chain-summary"><span>{copy.strata.selected}</span><strong>{selectedChain.title}</strong><small>{selectedChain.revision_count} {copy.common.revisions} · {selectedChain.source_count} {copy.common.sources}</small>{selectedDeepLink && <a href={selectedDeepLink}>{copy.strata.openCanonical}</a>}</div>}
  </div>}

  {!loadError && selectedChain && (
    <section class="history-overview" aria-label={plainHistoryCopy.currentSummary}>
      <dl>
        <div><dt>{plainHistoryCopy.currentSummary}</dt><dd>{selectedChain.title}</dd><small>{friendlyState(selectedChain.current_state)}</small></div>
        <div><dt>{plainHistoryCopy.latestChange}</dt><dd>{newestRevision?.summary ?? plainHistoryCopy.noChange}</dd><small>{newestRevision ? `${friendlyOperation(newestRevision.operation)} · ${formatDate(newestRevision.recorded_at)}` : plainHistoryCopy.noChange}</small></div>
        <div><dt>{plainHistoryCopy.evidence}</dt><dd>{selectedChain.source_count} {copy.common.sources}</dd><small>{selectedChain.revision_count} {plainHistoryCopy.revisions}</small></div>
        <div><dt>{plainHistoryCopy.reviewState}</dt><dd>{primaryReviewAction?.title ?? plainHistoryCopy.noReview}</dd><small>{primaryReviewAction?.evidence ?? friendlyState(selectedChain.current_state)}</small></div>
      </dl>
    </section>
  )}

  {!loadError && (events.length > 0 ? (
    <>
      <section class="strata-board" aria-labelledby="strata-board-title">
        <h2 id="strata-board-title" class="sr-only">{copy.strata.timelineAria}</h2>
        <div class="strata-canvas" style={`width:calc(12.5rem + ${strataTrackWidth}px)`}>
          <div class="strata-axis" style={`width:${strataTrackWidth}px`} aria-hidden="true">{ticks.map((tick) => <span style={`left:${timelinePercent(tick, bounds)}%`}>{formatMonth(tick)}</span>)}</div>
          <div class="strata-track-overlay" style={`width:${strataTrackWidth}px`} aria-hidden="true">
            <div class="today-marker" style={`left:${todayPercent}%`}><span>{copy.strata.today} {formatDate(data.generated_at || Date.now())}</span></div>
          </div>
          {!hasStackedRows && (
            <svg class="lineage-lines" style={`width:${strataTrackWidth}px`} viewBox="0 0 1000 590" preserveAspectRatio="none" aria-hidden="true">
              {selectedChain && events.filter((event) => event.selected).slice(1).map((event, index) => {
                const previous = events.filter((candidate) => candidate.selected)[index];
                const laneIndex = STRATA_LANES.findIndex((lane) => lane.id === event.lane);
                const previousLaneIndex = STRATA_LANES.findIndex((lane) => lane.id === previous.lane);
                const previousX = ((timelinePlacements.find((point) => point.event.id === previous.id)?.x ?? 0) / strataTrackWidth) * 1000;
                const currentX = ((timelinePlacements.find((point) => point.event.id === event.id)?.x ?? 0) / strataTrackWidth) * 1000;
                return <path pathLength="1" d={`M ${previousX} ${76 + previousLaneIndex * 102} C ${previousX + 48} ${76 + previousLaneIndex * 102}, ${currentX - 48} ${76 + laneIndex * 102}, ${currentX} ${76 + laneIndex * 102}`}></path>;
              })}
            </svg>
          )}
          <div class="strata-lanes">
            {STRATA_LANES.map((lane) => {
              const placements = lanePlacements(lane.id);
              const rows = laneRowCount(lane.id);
              const laneHeight = Math.max(102, rows * 76 + 18);
              return (
                <section class:list={["strata-lane", `strata-lane-${lane.id}`]} style={`height:${laneHeight}px`} aria-labelledby={`lane-${lane.id}`}>
                  <header><span class="lane-marker" aria-hidden="true"></span><div><h3 id={`lane-${lane.id}`}>{copy.strata.lanes[lane.id].label}</h3><p>{copy.strata.lanes[lane.id].sublabel}</p></div></header>
                  <div class="lane-track" style={`width:${strataTrackWidth}px`}>
                    {Array.from({ length: rows }, (_, row) => <span class="lane-row-line" style={`top:${row * 76 + 47}px`} aria-hidden="true"></span>)}
                    {placements.map(({ event, x, row }) => (
                      <a
                        class:list={["strata-event", `strata-event-${tone(event)}`, selectedChain?.id === event.chainId && "strata-event-selected"]}
                        style={`left:${x}px;top:${row * 76 + 14}px`}
                        href={selectChainHref(event)}
                        aria-label={describeEvent(event)}
                        aria-current={selectedChain?.id === event.chainId ? "true" : undefined}
                      >
                        <strong>{event.title}</strong>
                        <time datetime={dateTime(event.timestamp)}>{formatDate(event.timestamp)}</time>
                        <small>{friendlyOperation(event.operation)} · {friendlyState(event.state)}{event.partial ? ` · ${copy.common.partial}` : ""}</small>
                      </a>
                    ))}
                  </div>
                </section>
              );
            })}
          </div>
          <footer class="strata-legend">
            <span class="legend-canonical">{copy.strata.legendCanonical}</span>
            <span class="legend-support">{copy.strata.legendSupport}</span>
            <span class="legend-warning">{copy.strata.legendWarning}</span>
            {data.truncated && <span class="legend-truncated">{copy.strata.legendTruncated}</span>}
          </footer>
        </div>
      </section>

      <section class="strata-mobile" aria-labelledby="strata-mobile-title">
        <h2 id="strata-mobile-title">{copy.strata.mobileTitle}</h2>
        <ol>
          {[...events].sort((left, right) => right.timestamp - left.timestamp).map((event) => (
            <li class={`mobile-event mobile-event-${tone(event)}`}>
              <span>{copy.strata.lanes[event.lane].label}</span>
              <a href={selectChainHref(event)} aria-current={selectedChain?.id === event.chainId ? "true" : undefined}><strong>{event.title}</strong><small><time datetime={dateTime(event.timestamp)}>{formatDate(event.timestamp)}</time> · {friendlyOperation(event.operation)} · {friendlyState(event.state)}</small></a>
            </li>
          ))}
        </ol>
      </section>
    </>
  ) : (
    <div class="intelligence-empty" role="status"><strong>{copy.strata.emptyTitle}</strong><span>{copy.strata.emptyBody}</span></div>
  ))}

  {!loadError && selectedChain && detail && (
    <section class="selected-chain-history" id="selected-chain-history" aria-labelledby="selected-chain-history-title">
      <header class="history-heading">
        <div>
          <p class="intelligence-eyebrow">{copy.strata.selectedEyebrow}</p>
          <h2 id="selected-chain-history-title">{copy.strata.historyTitle}</h2>
          <p>{selectedChain.title}</p>
        </div>
        <span>{selectedChain.revisions.length} {copy.common.revisions}</span>
      </header>

      {(detail.truncated.revisions || detail.truncated.sources) && (
        <div class="history-truncation" role="status">
          {detail.truncated.revisions && <span>{copy.strata.revisionsTruncated}</span>}
          {detail.truncated.sources && <span>{copy.strata.sourcesTruncated}</span>}
        </div>
      )}

      <details class="history-technical">
        <summary>{plainHistoryCopy.technicalDetails}</summary>
        <dl class="history-current-state" aria-label={copy.strata.currentStateAria}>
          <div><dt>{copy.strata.currentState}</dt><dd>{selectedChain.current_state}</dd></div>
          <div><dt>{copy.strata.snapshotState}</dt><dd>{currentStatus ? formatSnapshotValue(currentStatus.key, currentStatus.value) : copy.common.notRecorded}</dd></div>
          <div><dt>{copy.strata.confirmationState}</dt><dd>{currentConfirmation ? formatSnapshotValue(currentConfirmation.key, currentConfirmation.value) : copy.common.notRecorded}</dd></div>
          <div><dt>{copy.strata.validFrom}</dt><dd>{formatOptionalDate(selectedChain.valid_from)}</dd></div>
          <div><dt>{copy.strata.validUntil}</dt><dd>{formatOptionalDate(selectedChain.valid_until)}</dd></div>
          <div><dt>{copy.strata.supersession}</dt><dd>{currentSupersession ? formatSnapshotValue(currentSupersession.key, currentSupersession.value) : copy.common.notRecorded}</dd></div>
          <div><dt>{copy.strata.snapshot}</dt><dd>{selectedChain.partial ? copy.common.partial : copy.common.complete}</dd></div>
        </dl>
      </details>

      <div class="history-detail-layout">
        <section class="revision-history" aria-labelledby="revision-history-title">
          <h3 id="revision-history-title">{copy.strata.revisions}</h3>
          {revisionDiffs.length > 0 ? (
            <ol>
              {[...revisionDiffs].reverse().map((diff) => {
                const revision = diff.revision;
                const confirmation = snapshotField(revision.snapshot, ["confirmation_state", "confirmationState"]);
                const status = snapshotField(revision.snapshot, ["status", "current_state", "lifecycle_state", "extraction_state"]);
                const supersession = snapshotField(revision.snapshot, ["superseded_by", "supersededBy"]);
                return (
                  <li class:list={["revision-card", revision.partial && "revision-partial"]}>
                    <header>
                      <div><span>{friendlyOperation(revision.operation)}</span><time datetime={dateTime(revision.recorded_at)}>{formatDate(revision.recorded_at)}</time></div>
                      <strong>{friendlyState(revision.state)}</strong>
                      {revision.partial && <span class="partial-badge">{copy.common.partial}</span>}
                    </header>
                    <dl class="revision-context"><div><dt>{plainHistoryCopy.changeReason}</dt><dd>{revision.summary}</dd></div><div><dt>{plainHistoryCopy.reviewer}</dt><dd>{revision.actor_id || plainHistoryCopy.noReviewer}</dd></div></dl>
                    <details class="revision-technical">
                      <summary>{plainHistoryCopy.technicalDetails}</summary>
                      <dl class="revision-metadata">
                        {status && <div><dt>{fieldLabel(status.key)}</dt><dd>{formatSnapshotValue(status.key, status.value)}</dd></div>}
                        {confirmation && <div><dt>{copy.strata.confirmationState}</dt><dd>{formatSnapshotValue(confirmation.key, confirmation.value)}</dd></div>}
                        <div><dt>{copy.strata.validFrom}</dt><dd>{formatOptionalDate(revision.valid_from)}</dd></div>
                        <div><dt>{copy.strata.validUntil}</dt><dd>{formatOptionalDate(revision.valid_until)}</dd></div>
                        {supersession && <div><dt>{copy.strata.supersession}</dt><dd>{formatSnapshotValue(supersession.key, supersession.value)}</dd></div>}
                      </dl>
                    </details>
                    <div class="revision-diff" aria-label={diff.previousRevision ? copy.strata.changesFrom.replace("{id}", diff.previousRevision.id) : copy.strata.firstRecord}>
                      <h4>{diff.previousRevision ? copy.strata.changesSincePrevious : copy.strata.firstRecord}</h4>
                      {!diff.previousRevision ? (
                        <p>{copy.strata.noPreviousRevision}</p>
                      ) : !diff.comparable ? (
                        <p>{copy.strata.missingSnapshots}</p>
                      ) : diff.changes.length === 0 ? (
                        <p>{copy.strata.noComparableChanges}</p>
                      ) : (
                        <ul>
                          {diff.changes.map((change) => (
                            <li>
                              <span class={`change-kind change-${change.kind}`}>{copy.strata.changeKinds[change.kind]}</span>
                              <strong>{fieldLabel(change.field)}</strong>
                              <div class="change-values">
                                <span><small>{copy.strata.before}</small><code>{formatSnapshotValue(change.field, change.before)}</code></span>
                                <span aria-hidden="true">→</span>
                                <span><small>{copy.strata.after}</small><code>{formatSnapshotValue(change.field, change.after)}</code></span>
                              </div>
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </li>
                );
              })}
            </ol>
          ) : <div class="history-empty">{copy.strata.noRevisions}</div>}
        </section>

        <aside class="history-evidence" aria-label={copy.strata.relationsSourcesAria}>
          <section>
            <h3>{copy.strata.relations} <span>{selectedChain.relations.length}</span></h3>
            {selectedChain.relations.length > 0 ? (
              <ul>{selectedChain.relations.map((relation) => <li><strong>{relation.relation}</strong><span>{relation.target_type} · {relation.target_id}</span><small>{formatOptionalDate(relation.valid_from)} → {formatOptionalDate(relation.valid_until)}</small></li>)}</ul>
            ) : <p>{copy.strata.noRelations}</p>}
          </section>
          <section>
            <h3>{copy.strata.sources} <span>{selectedChain.sources.length}</span></h3>
            {selectedChain.sources.length > 0 ? (
              <ul>{selectedChain.sources.map((source) => <li><strong>{source.title}</strong><span>{source.relation} · {source.resource_id}</span><small>{source.unresolved ? copy.strata.unresolved : formatOptionalDate(source.captured_at)}</small></li>)}</ul>
            ) : <p>{copy.strata.noSources}</p>}
          </section>
        </aside>
      </div>
    </section>
  )}

  {!loadError && <section class="strata-attention" id="strata-attention" aria-labelledby="strata-attention-title">
