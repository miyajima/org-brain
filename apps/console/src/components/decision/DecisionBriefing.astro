---
import type { ConsoleLocale, DecisionBriefing } from "../../lib/decision-console-ui";
import { scopedHref } from "../../lib/decision-console-ui";

const {
  data,
  error = null,
  params,
  locale = "en",
  beta = false
} = Astro.props as {
  data: DecisionBriefing;
  error?: string | null;
  params: URLSearchParams;
  locale?: ConsoleLocale;
  beta?: boolean;
};

const copy = {
  en: {
    eyebrow: "Decision intelligence",
    title: "Decision Briefing",
    lead: "See what changed, why it matters, and where action is needed—without leaving the decision trail.",
    beta: "Staging preview",
    search: "Search decisions and reasons",
    all: "All",
    new: "New",
    changed: "Changed",
    expired: "Expired",
    unconfirmed: "Unconfirmed",
    artifact_missing: "Missing artifact",
    share_pending: "Waiting to share",
    reason: "Why",
    artifacts: "Artifacts",
    updated: "Updated",
    create: "Record a decision",
    map: "Open trace map",
    retry: "Try again",
    noItems: "No decisions need attention in this scope.",
    noMatch: "No decisions match this filter.",
    errorTitle: "The briefing could not be refreshed",
    truncated: "Showing the highest-priority decisions. Narrow the project scope to see more."
  },
  ja: {
    eyebrow: "Decision intelligence",
    title: "Decision Briefing",
    lead: "何が変わり、なぜ重要で、次に何をすべきかを、決定の流れから離れずに確認できます。",
    beta: "ステージングプレビュー",
    search: "決定と理由を検索",
    all: "すべて",
    new: "新規",
    changed: "変更",
    expired: "期限切れ",
    unconfirmed: "未確認",
    artifact_missing: "成果物未接続",
    share_pending: "共有待ち",
    reason: "理由",
    artifacts: "成果物",
    updated: "更新",
    create: "決定を記録",
    map: "決定の道筋マップを開く",
    retry: "再試行",
    noItems: "この範囲で対応が必要な決定はありません。",
    noMatch: "条件に一致する決定はありません。",
    errorTitle: "Briefingを更新できませんでした",
    truncated: "優先度の高い決定を表示しています。プロジェクト範囲を絞ると続きを確認できます。"
  },
  zh: {
    eyebrow: "Decision intelligence",
    title: "Decision Briefing",
    lead: "无需离开决策链，即可了解发生了什么变化、为何重要以及下一步行动。",
    beta: "预发布预览",
    search: "搜索决策与理由",
    all: "全部",
    new: "新增",
    changed: "已变更",
    expired: "已过期",
    unconfirmed: "未确认",
    artifact_missing: "未连接成果",
    share_pending: "待共享",
    reason: "理由",
    artifacts: "成果",
    updated: "更新",
    create: "记录决策",
    map: "打开追踪地图",
    retry: "重试",
    noItems: "此范围内没有需要处理的决策。",
    noMatch: "没有符合筛选条件的决策。",
    errorTitle: "无法刷新简报",
    truncated: "正在显示优先级最高的决策。缩小项目范围可查看更多。"
  }
}[locale];

const filters = ["all", "new", "changed", "expired", "unconfirmed", "artifact_missing", "share_pending"] as const;
const requestedFilter = params.get("briefing_filter")?.trim() ?? "";
const initialFilter = filters.includes(requestedFilter as (typeof filters)[number])
  ? requestedFilter
  : "all";
const initialQuery = params.get("briefing_q")?.trim().slice(0, 120) ?? "";
const flagLabels = Object.fromEntries(filters.map((key) => [key, copy[key]]));
const dateLocale = locale === "ja" ? "ja-JP" : locale === "zh" ? "zh-CN" : "en-US";
const formatDate = (value: number) => value
  ? new Intl.DateTimeFormat(dateLocale, { dateStyle: "medium", timeStyle: "short", timeZone: "Asia/Tokyo" }).format(new Date(value))
  : "—";
const actionLabel = (action: string, fallback: string) => ({
  open: locale === "ja" ? "決定を開く" : locale === "zh" ? "打开决策" : "Open decision",
  review: locale === "ja" ? "有効性を確認" : locale === "zh" ? "检查有效性" : "Review validity",
  confirm: locale === "ja" ? "決定を確認" : locale === "zh" ? "确认决策" : "Confirm decision",
  connect_artifact: locale === "ja" ? "成果物を接続" : locale === "zh" ? "连接成果" : "Connect artifact",
  share: locale === "ja" ? "共有範囲を確認" : locale === "zh" ? "检查共享范围" : "Review access"
}[action] ?? fallback);
---
<section class="decision-briefing" data-decision-briefing data-briefing-filter={initialFilter} data-briefing-query={initialQuery}>
  <header class="decision-page-header">
    <div>
      <p class="decision-eyebrow">{copy.eyebrow}</p>
      <div class="decision-title-line">
        <h1>{copy.title}</h1>
        {beta && <span class="decision-beta-pill">{copy.beta}</span>}
      </div>
      <p class="decision-page-lead">{copy.lead}</p>
    </div>
    <div class="decision-header-actions">
      <a class="decision-action decision-action-secondary" href={scopedHref("/map", params)}>{copy.map}</a>
      <a class="decision-action" href={scopedHref("/decisions/new", params)}>{copy.create}</a>
    </div>
  </header>

  {error && (
    <div class="decision-alert" role="alert">
      <strong>{copy.errorTitle}</strong>
      <span>{error}</span>
      <a class="decision-action decision-action-secondary decision-alert-action" href={scopedHref("/", params)}>{copy.retry}</a>
    </div>
  )}

  <div class="decision-stat-grid" aria-label={copy.title}>
    {filters.slice(1).map((filter) => (
      <button class="decision-stat" type="button" data-briefing-filter={filter} aria-pressed={initialFilter === filter}>
        <span>{copy[filter]}</span>
        <strong>{data.counts[filter] ?? 0}</strong>
      </button>
    ))}
  </div>

  <div class="decision-briefing-toolbar">
    <div class="decision-filter-tabs" role="group" aria-label={copy.title}>
      {filters.map((filter) => (
        <button type="button" data-briefing-filter={filter} aria-pressed={initialFilter === filter}>{copy[filter]}</button>
      ))}
    </div>
    <label class="decision-search-field">
      <span>{copy.search}</span>
      <input type="search" name="briefing_q" value={initialQuery} placeholder={copy.search} data-briefing-search />
    </label>
  </div>

  <div class="decision-card-list" data-briefing-list>
    {data.items.map((item, index) => (
      <article
        class="decision-brief-card"
        data-briefing-card
        data-flags={item.flags.join(" ")}
        data-search={`${item.title} ${item.decision} ${item.reason_summary}`.toLocaleLowerCase(locale)}
        style={`--decision-index:${index}`}
      >
        <div class="decision-brief-main">
          <div class="decision-card-meta">
            <span class:list={["decision-status-dot", `is-${item.status}`]}></span>
            <span>{item.status}</span>
            {item.project_id && <span>{item.project_id}</span>}
          </div>
          <h2><a href={scopedHref(`/decisions/${encodeURIComponent(item.id)}`, params)}>{item.title}</a></h2>
          <p class="decision-statement">{item.decision}</p>
          <div class="decision-reason-row">
            <span>{copy.reason}</span>
            <p>{item.reason_summary || "—"}</p>
          </div>
          <div class="decision-flag-row">
            {item.flags.map((flag) => <span>{flagLabels[flag] ?? flag}</span>)}
          </div>
        </div>
        <aside class="decision-brief-aside">
          <dl>
            <div><dt>{copy.artifacts}</dt><dd>{item.artifact_count}</dd></div>
            <div><dt>{copy.updated}</dt><dd><time datetime={new Date(item.updated_at).toISOString()}>{formatDate(item.updated_at)}</time></dd></div>
          </dl>
          <a class="decision-action" href={scopedHref(item.next_action.href, params)}>{actionLabel(item.next_action.action, item.next_action.label)}</a>
        </aside>
      </article>
    ))}
  </div>

  <div class="decision-empty" data-briefing-empty hidden>{copy.noMatch}</div>
  {!error && data.items.length === 0 && <div class="decision-empty">{copy.noItems}</div>}
  {data.truncated && <p class="decision-truncation-note">{copy.truncated}</p>}
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-decision-briefing]");
  if (root) {
    const cards = [...root.querySelectorAll<HTMLElement>("[data-briefing-card]")];
    const controls = [...root.querySelectorAll<HTMLButtonElement>("[data-briefing-filter]")];
    const search = root.querySelector<HTMLInputElement>("[data-briefing-search]");
    const empty = root.querySelector<HTMLElement>("[data-briefing-empty]");
    const allowedFilters = new Set(controls.map((control) => control.dataset.briefingFilter || "all"));
    let active = allowedFilters.has(root.dataset.briefingFilter || "") ? root.dataset.briefingFilter || "all" : "all";
    const syncUrl = () => {
      const url = new URL(window.location.href);
      const query = search?.value.trim() ?? "";
      if (active === "all") url.searchParams.delete("briefing_filter");
      else url.searchParams.set("briefing_filter", active);
      if (query) url.searchParams.set("briefing_q", query);
      else url.searchParams.delete("briefing_q");
      window.history.replaceState({}, "", `${url.pathname}${url.search}${url.hash}`);
    };
    const refresh = (updateUrl = true) => {
      const query = search?.value.trim().toLocaleLowerCase() ?? "";
      let visible = 0;
      for (const card of cards) {
        const matchesFilter = active === "all" || (card.dataset.flags ?? "").split(" ").includes(active);
        const matchesQuery = !query || (card.dataset.search ?? "").includes(query);
        card.hidden = !(matchesFilter && matchesQuery);
        if (!card.hidden) visible += 1;
      }
      if (empty) empty.hidden = visible > 0;
      for (const control of controls) control.setAttribute("aria-pressed", String(control.dataset.briefingFilter === active));
      if (updateUrl) syncUrl();
    };
    for (const control of controls) control.addEventListener("click", () => {
      active = control.dataset.briefingFilter || "all";
      refresh();
    });
    search?.addEventListener("input", () => refresh());
    const syncFromUrl = () => {
      const url = new URL(window.location.href);
      const requested = url.searchParams.get("briefing_filter") || "all";
      active = allowedFilters.has(requested) ? requested : "all";
      if (search) search.value = url.searchParams.get("briefing_q")?.trim().slice(0, 120) || "";
      refresh(false);
    };
    window.addEventListener("popstate", syncFromUrl);
    refresh(false);
  }
</script>
