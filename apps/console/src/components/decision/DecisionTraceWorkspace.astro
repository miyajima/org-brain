---
import AccessDrawer from "./AccessDrawer.astro";
import type { ConsoleLocale, DecisionTrace, DecisionTraceNode } from "../../lib/decision-console-ui";
import { scopedHref } from "../../lib/decision-console-ui";

const {
  trace,
  error = null,
  params,
  locale = "en",
  tenantId,
  projectId = null
} = Astro.props as {
  trace: DecisionTrace;
  error?: string | null;
  params: URLSearchParams;
  locale?: ConsoleLocale;
  tenantId: string;
  projectId?: string | null;
};

const copy = {
  en: { eyebrow: "Decision trace", reason: "Reason", evidence: "Evidence", artifact: "Artifacts", skill: "Skills", agent: "Using agents", result: "Results", decision: "Decision", empty: "Nothing connected yet", preview: "Selected item", details: "Technical details", skillize: "Turn this knowledge into a Skill", map: "Open Decision Trace Map", access: "Access", unavailable: "This decision trail could not be loaded", nodesHidden: "Some items were omitted by the display limit.", back: "Back to briefing" },
  ja: { eyebrow: "Decision trace", reason: "理由", evidence: "根拠", artifact: "成果物", skill: "Skill", agent: "利用Agent", result: "結果", decision: "決定", empty: "まだ接続されていません", preview: "選択中の要素", details: "技術的な詳細", skillize: "この知識をSkill化", map: "Decision Trace Mapを開く", access: "アクセス", unavailable: "決定の流れを読み込めませんでした", nodesHidden: "表示上限により一部の要素を省略しています。", back: "Briefingへ戻る" },
  zh: { eyebrow: "Decision trace", reason: "理由", evidence: "依据", artifact: "成果", skill: "Skill", agent: "使用中的Agent", result: "结果", decision: "决策", empty: "尚未连接", preview: "当前选择", details: "技术详情", skillize: "将此知识转为Skill", map: "打开决策追踪地图", access: "访问", unavailable: "无法加载决策链", nodesHidden: "部分项目因显示上限而省略。", back: "返回简报" }
}[locale];
const stageOrder = ["decision", "reason", "evidence", "artifact", "skill", "agent", "result"] as const;
const stageLabels = Object.fromEntries(stageOrder.map((stage) => [stage, copy[stage]]));
const byStage = Object.fromEntries(stageOrder.map((stage) => [stage, trace.nodes.filter((node) => node.stage === stage)])) as Record<string, DecisionTraceNode[]>;
const selected = trace.nodes.find((node) => node.stage === "decision") ?? trace.nodes[0] ?? null;
const decisionId = typeof trace.decision.id === "string" ? trace.decision.id : selected?.id.replace(/^decision:/u, "") ?? "";
const decisionTitle = typeof trace.decision.title === "string" ? trace.decision.title : selected?.label ?? copy.decision;
const decisionStatement = typeof trace.decision.decision === "string" ? trace.decision.decision : selected?.summary ?? "";
const versionHash = typeof trace.decision.version_hash === "string" ? trace.decision.version_hash : "";
const skillParams = new URLSearchParams(params);
skillParams.set("decision_id", decisionId);
if (versionHash) skillParams.set("source_hash", versionHash);
skillParams.set("start", "generate");
const mapParams = new URLSearchParams(params);
mapParams.set("decision_id", decisionId);
const serializedNodes = JSON.stringify(trace.nodes).replace(/</gu, "\\u003c");
---
<section class="decision-detail-workspace" data-trace-workspace data-stage-labels={JSON.stringify(stageLabels)}>
  <header class="decision-page-header decision-detail-header">
    <div>
      <a class="decision-back-link" href={scopedHref("/", params)}>← {copy.back}</a>
      <p class="decision-eyebrow">{copy.eyebrow}</p>
      <h1>{decisionTitle}</h1>
      <p class="decision-page-lead">{decisionStatement}</p>
    </div>
    <div class="decision-header-actions">
      <AccessDrawer
        resourceType="decision_memory"
        resourceId={decisionId}
        tenantId={tenantId}
        projectId={projectId}
        policy={trace.access_policy}
        utilizingAgents={byStage.agent.map((node) => ({ name: node.label, id: node.id }))}
        locale={locale}
      />
      <a class="decision-action decision-action-secondary" href={`/map?${mapParams.toString()}`}>{copy.map}</a>
      <a class="decision-action" href={`/skills?${skillParams.toString()}`}>{copy.skillize}</a>
    </div>
  </header>

  {error && <div class="decision-alert" role="alert"><strong>{copy.unavailable}</strong><span>{error}</span></div>}
  {trace.truncated && <div class="decision-truncation-note" role="status">{copy.nodesHidden} ({trace.omitted_node_count} / {trace.omitted_edge_count})</div>}

  <div class="decision-trace-layout">
    <nav class="decision-trace-rail" aria-label={copy.eyebrow}>
      {stageOrder.map((stage, stageIndex) => (
        <section class="decision-trace-stage" data-stage={stage}>
          <header>
            <span>{String(stageIndex + 1).padStart(2, "0")}</span>
            <h2>{stageLabels[stage]}</h2>
            <strong>{byStage[stage]?.length ?? 0}</strong>
          </header>
          {(byStage[stage]?.length ?? 0) > 0 ? (
            <div class="decision-trace-stage-items">
              {byStage[stage].map((node) => (
                <button
                  type="button"
                  class="decision-trace-node"
                  data-trace-node={node.id}
                  aria-pressed={selected?.id === node.id ? "true" : "false"}
                >
                  <span class:list={["decision-stage-mark", `is-${stage}`]}></span>
                  <span>{node.label}</span>
                </button>
              ))}
            </div>
          ) : <p>{copy.empty}</p>}
        </section>
      ))}
    </nav>

    <article class="decision-trace-preview" aria-live="polite">
      <p class="decision-eyebrow">{copy.preview}</p>
      <div class="decision-preview-heading">
        <span class:list={["decision-stage-mark", selected && `is-${selected.stage}`]} data-preview-mark></span>
        <div>
          <span data-preview-stage>{selected ? stageLabels[selected.stage] : copy.decision}</span>
          <h2 data-preview-label>{selected?.label ?? decisionTitle}</h2>
        </div>
      </div>
      <p class="decision-preview-summary" data-preview-summary>{selected?.summary ?? decisionStatement}</p>
      <div class="decision-preview-status" data-preview-status hidden={!selected?.status}>{selected?.status}</div>
      <a class="decision-action decision-action-secondary" data-preview-link href={selected?.deep_link ?? "#"} hidden={!selected?.deep_link}>Open</a>
      <details class="decision-technical-details">
        <summary>{copy.details}</summary>
        <dl data-preview-metadata>
          <div><dt>ID</dt><dd><code>{selected?.id ?? decisionId}</code></dd></div>
          {selected && Object.entries(selected.metadata).map(([key, value]) => <div><dt>{key}</dt><dd><code>{typeof value === "string" ? value : JSON.stringify(value)}</code></dd></div>)}
        </dl>
      </details>
    </article>
  </div>
  <script is:inline type="application/json" data-trace-nodes set:html={serializedNodes}></script>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-trace-workspace]");
  if (root) {
    const stageLabels = JSON.parse(root.dataset.stageLabels || "{}");
    const source = root.querySelector<HTMLScriptElement>("[data-trace-nodes]");
    const nodes = JSON.parse(source?.textContent || "[]") as Array<Record<string, unknown>>;
    const byId = new Map(nodes.map((node) => [String(node.id), node]));
    const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-trace-node]")];
    const selectNode = (id: string) => {
      const node = byId.get(id);
      if (!node) return;
      for (const button of buttons) button.setAttribute("aria-pressed", String(button.dataset.traceNode === id));
      const stage = String(node.stage || "decision");
      const mark = root.querySelector<HTMLElement>("[data-preview-mark]");
      if (mark) mark.className = `decision-stage-mark is-${stage}`;
      const stageElement = root.querySelector<HTMLElement>("[data-preview-stage]");
      const label = root.querySelector<HTMLElement>("[data-preview-label]");
      const summary = root.querySelector<HTMLElement>("[data-preview-summary]");
      const status = root.querySelector<HTMLElement>("[data-preview-status]");
      const link = root.querySelector<HTMLAnchorElement>("[data-preview-link]");
      if (stageElement) stageElement.textContent = stageLabels[stage] || stage;
      if (label) label.textContent = String(node.label || "");
      if (summary) summary.textContent = String(node.summary || "—");
      if (status) {
        status.textContent = String(node.status || "");
        status.hidden = !node.status;
      }
      if (link) {
        const deepLink = typeof node.deep_link === "string" ? node.deep_link : "";
        link.hidden = !deepLink;
        if (deepLink) link.href = deepLink;
      }
      const metadata = root.querySelector<HTMLElement>("[data-preview-metadata]");
      if (metadata) {
        const details = node.metadata && typeof node.metadata === "object" ? node.metadata as Record<string, unknown> : {};
        metadata.replaceChildren(...Object.entries({ ID: node.id, ...details }).map(([key, value]) => {
          const row = document.createElement("div");
          const term = document.createElement("dt");
          const description = document.createElement("dd");
          const code = document.createElement("code");
          term.textContent = key;
          code.textContent = typeof value === "string" ? value : JSON.stringify(value);
          description.appendChild(code);
          row.appendChild(term);
          row.appendChild(description);
          return row;
        }));
      }
    };
    for (const button of buttons) button.addEventListener("click", () => selectNode(button.dataset.traceNode || ""));
  }
</script>
