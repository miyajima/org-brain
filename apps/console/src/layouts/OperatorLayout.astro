---
import "../styles/operator.css";
import { operatorRequestUrl, localText, operatorScope, operatorHref, operatorIdentity } from "../lib/operator-console";
interface Props { title?: string; active?: "home" | "knowledge" | "settings"; }
const navigationUrl = operatorRequestUrl(Astro.request);
const { title = "OrgBrain", active = "home" } = Astro.props;
Astro.response.headers.set("Cache-Control", "private, no-store");
const scope = operatorScope(Astro.url, Astro.request.headers.get("cookie"));
const t = localText(scope.lang);
const identity = await operatorIdentity(Astro.request);
const person = identity.data?.profile?.display_name || identity.data?.auth?.display_name || t("アカウント", "Account", "账户");
const nav = [
 { key: "home", href: "/", label: t("ホーム", "Home", "首页"), icon: "M3 10 12 3l9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z" },
 { key: "knowledge", href: "/knowledge", label: t("知識", "Knowledge", "知识"), icon: "M4 3h12v18H4zM8 7h4M8 11h4M20 5v16" },
 { key: "settings", href: "/settings", label: t("管理", "Manage", "管理"), icon: "M4 6h16M4 12h16M4 18h16M8 3v6M16 9v6M10 15v6" }
];
---
<!doctype html>
<html lang={scope.lang}>
 <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="color-scheme" content="light" /><link rel="icon" href="data:," /><title>{title} · OrgBrain</title></head>
 <body>
  <a class="op-skip" href="#main">{t("本文へ移動", "Skip to content", "跳至正文")}</a>
  <div class="op-shell">
   <aside class="op-sidebar">
    <a class="op-brand" href={operatorHref(navigationUrl, "/")} aria-label="OrgBrain"><svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true"><path fill="currentColor" d="M4 4h8v8H4zM16 4h8v8h-8zM4 16h8v8H4z"/><circle cx="20" cy="20" r="4" fill="currentColor"/></svg><span>OrgBrain</span></a>
    <p class="op-workspace-name">{identity.data?.console_context?.tenant?.display_name || scope.tenantId}</p>
    <nav aria-label={t("メインナビゲーション", "Main navigation", "主导航")}>{nav.map(item => <a href={operatorHref(navigationUrl, item.href)} aria-current={active === item.key ? "page" : undefined}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={item.icon}/></svg><span>{item.label}</span></a>)}</nav>
    <div class="op-sidebar-footer"><span class="op-avatar" aria-hidden="true">{String(person).slice(0, 1).toUpperCase()}</span><a href={operatorHref(navigationUrl, "/settings", { section: "profile" })}>{person}</a></div>
   </aside>
   <div class="op-workspace">
    <header class="op-topbar">
     <form method="get" class="op-scope-form" aria-label={t("表示範囲", "Display scope", "显示范围")}>
      {Array.from(Astro.url.searchParams.entries()).filter(([key]) => !["tenant_id", "project_id", "id", "selected", "saved", "cursor", "before", "page"].includes(key)).map(([key,value]) => <input type="hidden" name={key} value={value}/>)}
      <input type="hidden" name="tenant_id" value={scope.tenantId}/>
      <label for="scope-project"><span class="op-scope-full">{t("プロジェクト", "Project", "项目")}</span><span class="op-scope-short">{t("対象", "Scope", "范围")}</span></label>
      <input id="scope-project" name="project_id" value={scope.projectId} placeholder={t("すべて", "All projects", "全部项目")} list="op-project-options" autocomplete="off"/>
      <datalist id="op-project-options"><slot name="projects"/></datalist>
      <button class="op-quiet" type="submit">{t("切替", "Apply", "切换")}</button>
     </form>
     <div class="op-topbar-end"><a class="op-search-shortcut" href={operatorHref(navigationUrl, "/knowledge")}>{t("知識を探す", "Find knowledge", "查找知识")}<kbd>/</kbd></a><form method="get" aria-label={t("言語", "Language", "语言")} class="op-locale-form">{Array.from(Astro.url.searchParams.entries()).filter(([key]) => key !== "lang").map(([key,value]) => <input type="hidden" name={key} value={value}/>)}<label class="op-sr" for="op-locale">{t("言語", "Language", "语言")}</label><select id="op-locale" name="lang" data-locale-select><option value="ja" selected={scope.lang === "ja"}>日本語</option><option value="en" selected={scope.lang === "en"}>English</option><option value="zh" selected={scope.lang === "zh"}>中文</option></select><button type="submit" class="op-quiet op-locale-submit">{t("変更", "Change", "更改")}</button></form></div>
    </header>
    <main id="main" tabindex="-1"><slot/></main>
    <footer class="op-footer"><span>OrgBrain</span><span>{t("知識を、次の仕事へ。", "Knowledge for the next task.", "让知识服务下一项工作。")}</span></footer>
   </div>
  </div>
  <dialog class="op-confirm" data-op-confirm><form method="dialog"><h2>{t("変更を確認", "Review change", "确认更改")}</h2><p data-confirm-description></p><p class="op-muted">{t("対象と変更内容を確認してから実行してください。", "Review the target and changes before applying.", "请确认对象和更改内容后执行。")}</p><div class="op-actions"><button value="cancel" class="op-secondary" autofocus>{t("キャンセル", "Cancel", "取消")}</button><button value="apply">{t("変更を適用", "Apply change", "应用更改")}</button></div></form></dialog>
  <script>
   import "../lib/operator-client";
  </script>
 </body>
</html>
