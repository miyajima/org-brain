---
import "../styles/global.css";
import brandMark from "../../../../assets/brand/org-brain-avatar.png";
import { dashboardTenantFromCookie } from "../lib/dashboard-page";
import { insightsUiBehavior, processInsightsUiModeFallback, resolveRequestInsightsUiMode } from "../lib/insights-ui-mode";

const { title = "Org Brain Console", lang = "en", wide = false } = Astro.props;
const currentPath = Astro.url.pathname;
type LayoutLocale = "en" | "ja" | "zh";
const locale: LayoutLocale = lang === "ja" || lang === "zh" ? lang : "en";
const navCopy = {
  en: {
    overview: "Overview",
    activity: "Activity",
    connections: "Knowledge connections",
    history: "Knowledge history",
    memories: "Memories",
    decisions: "Decisions",
    menu: "Menu",
    management: "Manage",
    dashboard: "Dashboard",
    legacyDashboard: "Legacy Dashboard",
    labs: "Labs · Overview",
    memoryExplorer: "Memory Explorer",
    decisionEditor: "Decision Editor",
    resources: "Resources",
    groups: "Groups",
    users: "Users",
    organization: "Organization",
    categories: "Business Categories",
    profile: "Profile",
    operations: "Operations",
    newTask: "New Task",
    tasks: "Tasks"
  },
  ja: {
    overview: "概要",
    activity: "活動",
    connections: "知識のつながり",
    history: "知識の履歴",
    memories: "メモリ",
    decisions: "判断",
    menu: "メニュー",
    management: "管理",
    dashboard: "ダッシュボード",
    legacyDashboard: "従来のダッシュボード",
    labs: "Labs · 新しい概要",
    memoryExplorer: "メモリエクスプローラー",
    decisionEditor: "判断エディター",
    resources: "資料・成果物",
    groups: "グループ",
    users: "ユーザー",
    organization: "組織",
    categories: "業務カテゴリ",
    profile: "プロフィール",
    operations: "運用",
    newTask: "Task作成",
    tasks: "Task一覧"
  },
  zh: {
    overview: "概览",
    activity: "活动",
    connections: "知识关联",
    history: "知识历史",
    memories: "记忆",
    decisions: "决策",
    menu: "菜单",
    management: "管理",
    dashboard: "仪表盘",
    legacyDashboard: "旧版仪表盘",
    labs: "Labs · 新概览",
    memoryExplorer: "记忆浏览器",
    decisionEditor: "决策编辑器",
    resources: "资料与成果",
    groups: "群组",
    users: "用户",
    organization: "组织",
    categories: "业务类别",
    profile: "个人资料",
    operations: "运维",
    newTask: "新建任务",
    tasks: "任务"
  }
}[locale];
const insightsUiMode = await resolveRequestInsightsUiMode(
  Astro.locals,
  processInsightsUiModeFallback()
);
const insightsBehavior = insightsUiBehavior(insightsUiMode);
const tenantId = Astro.url.searchParams.get("tenant_id")?.trim() || dashboardTenantFromCookie(Astro.request.headers.get("cookie"));
const projectId = Astro.url.searchParams.get("project_id")?.trim();
const requestedLang = Astro.url.searchParams.get("lang")?.trim();
const withScope = (href: string) => {
  const target = new URL(href, Astro.url);
  if (tenantId) target.searchParams.set("tenant_id", tenantId);
  if (projectId) target.searchParams.set("project_id", projectId);
  if (requestedLang === "en" || requestedLang === "ja" || requestedLang === "zh") {
    target.searchParams.set("lang", requestedLang);
  } else if (locale !== "en") {
    target.searchParams.set("lang", locale);
  }
  return `${target.pathname}${target.search}`;
};

const isActive = (href: string) => {
  if (href === "/") return currentPath === "/";
  if (href === "/overview") return currentPath === "/overview";
  if (href === "/memories/constellation") return currentPath === "/memories" || currentPath.startsWith("/memories/");
  if (href === "/decisions/history") return currentPath === "/decisions" || currentPath.startsWith("/decisions/");
  if (href === "/tasks") return currentPath === "/tasks" || (currentPath.startsWith("/tasks/") && currentPath !== "/tasks/new");
  if (href === "/tasks/new") return currentPath === "/tasks/new";
  if (href === "/decisions") return currentPath === "/decisions";
  if (href === "/resources") return currentPath === "/resources";
  if (href === "/groups") return currentPath === "/groups";
  if (href === "/users") return currentPath === "/users";
  if (href === "/organization") return currentPath === "/organization";
  if (href === "/business-categories") return currentPath === "/business-categories";
  if (href === "/profile") return currentPath === "/profile";
  if (href === "/operations") return currentPath === "/operations";
  return currentPath === href;
};
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050910" />
    <link rel="icon" href="data:," />
    <title>{title}</title>
  </head>
  <body>
    <div class="console-shell">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(22,135,255,0.08),transparent_28%),radial-gradient(circle_at_bottom_right,rgba(255,255,255,0.06),transparent_22%)]"></div>
      <nav class:list={["console-nav", insightsBehavior.useInsightsNavigation && "console-nav-insights"]}>
        <a class="console-brand" href={withScope("/")} aria-label="Org Brain">
          <img src={brandMark.src} width="28" height="28" alt="" />
          <span>Org Brain</span>
        </a>
        {insightsBehavior.useInsightsNavigation ? (
          <>
            <div class="console-primary-links">
              <a class="console-nav-link" href={withScope("/")} aria-current={isActive("/overview") || currentPath === "/" ? "page" : undefined}>{navCopy.activity}</a>
              <a class="console-nav-link" href={withScope("/memories/constellation")} aria-current={isActive("/memories/constellation") ? "page" : undefined}>{navCopy.connections}</a>
              <a class="console-nav-link" href={withScope("/decisions/history")} aria-current={isActive("/decisions/history") ? "page" : undefined}>{navCopy.history}</a>
              <a class="console-nav-link" href={withScope("/tasks")} aria-current={isActive("/tasks") ? "page" : undefined}>{navCopy.tasks}</a>
            </div>
            <details class="console-nav-menu">
              <summary>{navCopy.management}</summary>
              <div class="console-nav-menu-panel">
                {insightsBehavior.showLegacyDashboard && <a href={withScope("/dashboard")} aria-current={currentPath === "/dashboard" ? "page" : undefined}>{navCopy.legacyDashboard}</a>}
                <a href={withScope("/memories")} aria-current={currentPath === "/memories" ? "page" : undefined}>{navCopy.memoryExplorer}</a>
                <a href={withScope("/decisions")} aria-current={currentPath === "/decisions" ? "page" : undefined}>{navCopy.decisionEditor}</a>
                <a href={withScope("/resources")} aria-current={isActive("/resources") ? "page" : undefined}>{navCopy.resources}</a>
                <a href={withScope("/groups")} aria-current={isActive("/groups") ? "page" : undefined}>{navCopy.groups}</a>
                <a href={withScope("/users")} aria-current={isActive("/users") ? "page" : undefined}>{navCopy.users}</a>
                <a href={withScope("/organization")} aria-current={isActive("/organization") ? "page" : undefined}>{navCopy.organization}</a>
                <a href={withScope("/business-categories")} aria-current={isActive("/business-categories") ? "page" : undefined}>{navCopy.categories}</a>
                <a href={withScope("/profile")} aria-current={isActive("/profile") ? "page" : undefined}>{navCopy.profile}</a>
                <a href={withScope("/operations")} aria-current={isActive("/operations") ? "page" : undefined}>{navCopy.operations}</a>
                <a href={withScope("/tasks/new")} aria-current={isActive("/tasks/new") ? "page" : undefined}>{navCopy.newTask}</a>
              </div>
            </details>
            <details class="console-mobile-nav">
              <summary>{navCopy.menu}</summary>
              <div class="console-mobile-nav-panel">
                <a href={withScope("/")} aria-current={isActive("/overview") || currentPath === "/" ? "page" : undefined}>{navCopy.activity}</a>
                <a href={withScope("/memories/constellation")} aria-current={isActive("/memories/constellation") ? "page" : undefined}>{navCopy.connections}</a>
                <a href={withScope("/decisions/history")} aria-current={isActive("/decisions/history") ? "page" : undefined}>{navCopy.history}</a>
                <a href={withScope("/tasks")} aria-current={isActive("/tasks") ? "page" : undefined}>{navCopy.tasks}</a>
                <span>{navCopy.management}</span>
                <a href={withScope("/memories")}>{navCopy.memoryExplorer}</a>
                <a href={withScope("/decisions")}>{navCopy.decisionEditor}</a>
                <a href={withScope("/resources")}>{navCopy.resources}</a>
                <a href={withScope("/operations")}>{navCopy.operations}</a>
                <a href={withScope("/tasks/new")}>{navCopy.newTask}</a>
              </div>
            </details>
          </>
        ) : (
          <div class="console-primary-links console-legacy-links">
            <a class="console-nav-link" href={withScope("/")} aria-current={isActive("/") ? "page" : undefined}>{navCopy.dashboard}</a>
            {insightsBehavior.showOverviewLab && <a class="console-nav-link console-labs-link" href={withScope("/overview")} aria-current={isActive("/overview") ? "page" : undefined}>{navCopy.labs}</a>}
            <a class="console-nav-link" href={withScope("/memories")} aria-current={isActive("/memories") ? "page" : undefined}>{navCopy.memories}</a>
            <a class="console-nav-link" href={withScope("/decisions")} aria-current={isActive("/decisions") ? "page" : undefined}>{navCopy.decisions}</a>
            <a class="console-nav-link" href={withScope("/resources")} aria-current={isActive("/resources") ? "page" : undefined}>{navCopy.resources}</a>
            <a class="console-nav-link" href={withScope("/groups")} aria-current={isActive("/groups") ? "page" : undefined}>{navCopy.groups}</a>
            <a class="console-nav-link" href={withScope("/users")} aria-current={isActive("/users") ? "page" : undefined}>{navCopy.users}</a>
            <a class="console-nav-link" href={withScope("/organization")} aria-current={isActive("/organization") ? "page" : undefined}>{navCopy.organization}</a>
            <a class="console-nav-link" href={withScope("/business-categories")} aria-current={isActive("/business-categories") ? "page" : undefined}>{navCopy.categories}</a>
            <a class="console-nav-link" href={withScope("/profile")} aria-current={isActive("/profile") ? "page" : undefined}>{navCopy.profile}</a>
            <a class="console-nav-link" href={withScope("/operations")} aria-current={isActive("/operations") ? "page" : undefined}>{navCopy.operations}</a>
            <a class="console-nav-link" href={withScope("/tasks/new")} aria-current={isActive("/tasks/new") ? "page" : undefined}>{navCopy.newTask}</a>
            <a class="console-nav-link" href={withScope("/tasks")} aria-current={isActive("/tasks") ? "page" : undefined}>{navCopy.tasks}</a>
          </div>
        )}
      </nav>
      <main class:list={["console-main", wide && "console-main-wide"]}>
        <slot />
      </main>
    </div>
  </body>
</html>
