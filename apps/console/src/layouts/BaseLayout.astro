---
import OperatorLayout from "./OperatorLayout.astro";
import "../styles/global.css";
import "../styles/operator.css";
import "../styles/operator-domain-workspace.css";
const { title = "OrgBrain" } = Astro.props;
const path = Astro.url.pathname;
const active = path.startsWith("/memories") || path.startsWith("/decisions") || path.startsWith("/resources") || path === "/map" ? "knowledge" : "settings";
---
<OperatorLayout title={title} active={active}>
 <div class="op-legacy"><slot /></div>
</OperatorLayout>
