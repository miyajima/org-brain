---
import "../styles/global.css";
import brandMark from "../../../../assets/brand/org-brain-avatar.png";
import { dashboardTenantFromCookie } from "../lib/dashboard-page";
import { adminCommonCopy } from "../lib/admin-ui";
import { decisionConsoleBehavior, processDecisionConsoleModeFallback, resolveRequestDecisionConsoleMode } from "../lib/decision-console-mode";
import { insightsUiBehavior, processInsightsUiModeFallback, resolveRequestInsightsUiMode } from "../lib/insights-ui-mode";
import { layoutCopy, layoutNavLabels } from "../lib/console-locale";

type LayoutLocale = "en" | "ja" | "zh";
type ConsoleNavGroup = "primary" | "knowledge" | "organization" | "system";
type ConsoleNavItem = {
  id: string;
  href: string;
  group: ConsoleNavGroup;
  labels: Record<LayoutLocale, string>;
  activeMatcher: (path: string) => boolean;
};
type ConsoleContext = {
  mode: "personal" | "team";
  effective_permissions: string[];
  can_manage_users: boolean;
  can_manage_groups: boolean;
  can_manage_clients: boolean;
  tenant: { id: string };
  project: { id: string } | null;
  counts: { active_users: number; active_groups: number; active_projects: number };
};

const { title = "Org Brain Console", lang = "en", wide = false } = Astro.props;
const currentPath = Astro.url.pathname;
const requestedLang = Astro.url.searchParams.get("lang")?.trim();
const propLocale: LayoutLocale = lang === "ja" || lang === "zh" ? lang : "en";
const locale: LayoutLocale = requestedLang === "ja" || requestedLang === "zh" || requestedLang === "en" ? requestedLang : propLocale;
const localeCopy = layoutCopy(locale);
const groupLabels: Record<Exclude<ConsoleNavGroup, "primary">, string> = {
  knowledge: localeCopy.knowledge,
  organization: localeCopy.organization,
  system: localeCopy.system
};
const menuLabels = localeCopy;
const commonCopy = adminCommonCopy[locale];
const exact = (href: string) => (path: string) => path === href;
const starts = (href: string) => (path: string) => path === href || path.startsWith(`${href}/`);
const item = (
  id: string,
  href: string,
  group: ConsoleNavGroup,
  labels: Record<LayoutLocale, string>,
  activeMatcher = exact(href)
): ConsoleNavItem => ({ id, href, group, labels, activeMatcher });

const insightsUiMode = await resolveRequestInsightsUiMode(Astro.locals, processInsightsUiModeFallback());
const insightsBehavior = insightsUiBehavior(insightsUiMode);
const decisionConsoleMode = await resolveRequestDecisionConsoleMode(Astro.locals, processDecisionConsoleModeFallback());
const decisionBehavior = decisionConsoleBehavior(decisionConsoleMode);
const homeHref = decisionBehavior.useDecisionNavigation ? "/" : insightsBehavior.useInsightsNavigation ? "/overview" : "/";
const primaryItems: ConsoleNavItem[] = decisionBehavior.useDecisionNavigation ? [
  item("decisions", "/", "primary", layoutNavLabels("decisions"), (path) => path === "/" || (starts("/decisions")(path) && path !== "/decisions/new" && path !== "/decisions/history")),
  item("map", "/map", "primary", layoutNavLabels("map"), starts("/map")),
  item("skills", "/skills", "primary", layoutNavLabels("skills"), starts("/skills")),
  item("agents", "/agents", "primary", layoutNavLabels("agents"), starts("/agents")),
  item("reviews", "/reviews", "primary", layoutNavLabels("reviews"), starts("/reviews"))
] : insightsBehavior.useInsightsNavigation ? [
  item("activity", "/overview", "primary", layoutNavLabels("activity"), (path) => path === "/" || path === "/overview"),
  item("connections", "/memories/constellation", "primary", layoutNavLabels("connections")),
  item("history", "/decisions/history", "primary", layoutNavLabels("history")),
  item("tasks", "/tasks", "primary", layoutNavLabels("tasks"), (path) => starts("/tasks")(path) && path !== "/tasks/new")
] : [
  item("dashboard", "/", "primary", layoutNavLabels("dashboard")),
  item("memories", "/memories", "primary", layoutNavLabels("memories"), starts("/memories")),
  item("decisions", "/decisions", "primary", layoutNavLabels("decisions"), starts("/decisions")),
  item("tasks", "/tasks", "primary", layoutNavLabels("tasks"), (path) => starts("/tasks")(path) && path !== "/tasks/new")
];
const managementItems: ConsoleNavItem[] = [
  item("memory-explorer", "/memories", "knowledge", layoutNavLabels("memory-explorer")),
  item("memory-impact", "/memory-impact", "knowledge", layoutNavLabels("memory-impact")),
  item("decision-editor", decisionBehavior.enabled ? "/decisions/new" : "/decisions", "knowledge", layoutNavLabels("decision-editor")),
  item("resources", "/resources", "knowledge", layoutNavLabels("resources")),
  item("knowledge-dashboard", "/dashboard/knowledge", "knowledge", layoutNavLabels("knowledge-dashboard"), starts("/dashboard/knowledge")),
  item("retrospectives", "/retrospectives", "knowledge", layoutNavLabels("retrospectives"), starts("/retrospectives")),
  item("improvement-actions", "/improvement-actions", "knowledge", layoutNavLabels("improvement-actions"), starts("/improvement-actions")),
  item("knowledge-pack-onboarding", "/knowledge-packs/onboarding", "knowledge", layoutNavLabels("knowledge-pack-onboarding"), starts("/knowledge-packs")),
  item("domain-packs", "/domain-packs", "knowledge", layoutNavLabels("domain-packs"), starts("/domain-packs")),
  item("domain-workspaces", "/domain-workspaces", "knowledge", layoutNavLabels("domain-workspaces"), starts("/domain-workspaces")),
  item("domain-metrics", "/domain-metrics", "knowledge", layoutNavLabels("domain-metrics"), starts("/domain-metrics")),
  ...(decisionBehavior.enabled ? [
    item("knowledge-history", "/decisions/history", "knowledge", layoutNavLabels("knowledge-history"))
  ] : []),
  item("groups", "/groups", "organization", layoutNavLabels("groups"), starts("/groups")),
  item("users", "/users", "organization", layoutNavLabels("users")),
  item("organization", "/organization", "organization", layoutNavLabels("organization")),
  item("categories", "/business-categories", "organization", layoutNavLabels("categories")),
  item("clients", "/client-installations", "system", layoutNavLabels("clients")),
  item("operations", "/operations", "system", layoutNavLabels("operations")),
  item("profile", "/profile", "system", layoutNavLabels("profile")),
  item("new-task", "/tasks/new", "system", layoutNavLabels("new-task"))
];
const tenantId = Astro.url.searchParams.get("tenant_id")?.trim() || dashboardTenantFromCookie(Astro.request.headers.get("cookie")) || "default";
const projectId = Astro.url.searchParams.get("project_id")?.trim();
let consoleContext: ConsoleContext | null = null;
try {
  const identityUrl = new URL("/api/v1/auth/me", Astro.url);
  identityUrl.searchParams.set("tenant_id", tenantId);
  if (projectId) identityUrl.searchParams.set("project_id", projectId);
  const cookie = Astro.request.headers.get("cookie");
  const accessJwt = Astro.request.headers.get("cf-access-jwt-assertion");
  const response = await fetch(identityUrl, {
    headers: {
      ...(cookie ? { cookie } : {}),
      ...(accessJwt ? { "cf-access-jwt-assertion": accessJwt } : {})
    }
  });
  if (response.ok) {
    const payload = await response.json() as { data?: { console_context?: ConsoleContext } };
    consoleContext = payload.data?.console_context ?? null;
  }
} catch {
  // Backward compatibility: an older API or unavailable identity endpoint keeps the existing navigation.
}
const teamSetupLabels = layoutNavLabels("team-setup");
const hiddenForPersonal = new Set(["groups", "users", "organization", "categories"]);
const visibleManagementItems = managementItems.filter((navItem) => {
  if (!consoleContext) return true;
  if (consoleContext.mode === "personal" && hiddenForPersonal.has(navItem.id)) return false;
  if (navItem.id === "users" && !consoleContext.can_manage_users) return false;
  if ((navItem.id === "groups" || navItem.id === "organization" || navItem.id === "categories") && !consoleContext.can_manage_groups) return false;
  if (navItem.id === "clients" && !consoleContext.can_manage_clients) return false;
  return true;
});
if (consoleContext?.mode === "personal") {
  visibleManagementItems.push(item("team-setup", "/organization?setup=team", "organization", teamSetupLabels));
}
const contextParamsByPath: Record<string, readonly string[]> = {
  "/skills": ["decision_id", "source_hash"],
  "/agents": ["agent_id", "decision_id", "source_hash"],
  "/map": ["decision_id"],
  "/reviews": ["decision_id"]
};
const withScope = (href: string) => {
  const target = new URL(href, Astro.url);
  if (tenantId) target.searchParams.set("tenant_id", tenantId);
  if (projectId) target.searchParams.set("project_id", projectId);
  target.searchParams.set("lang", locale);
  for (const key of contextParamsByPath[target.pathname] ?? []) {
    const value = Astro.url.searchParams.get(key)?.trim();
    if (value) target.searchParams.set(key, value);
  }
  return `${target.pathname}${target.search}`;
};
const groupedItems = (["knowledge", "organization", "system"] as const).map((group) => ({
  group,
  label: groupLabels[group],
  items: visibleManagementItems.filter((navItem) => navItem.group === group)
}));
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#050910" />
    <link rel="icon" href="data:," />
    <title>{title}</title>
  </head>
  <body>
    <a class="console-skip-link" href="#console-main" data-console-skip-link>{commonCopy.skipToContent}</a>
    <div class="console-shell">
      <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_top,rgba(22,135,255,0.08),transparent_28%),radial-gradient(circle_at_bottom_right,rgba(255,255,255,0.06),transparent_22%)]"></div>
      <nav class:list={["console-nav", (decisionBehavior.useDecisionNavigation || insightsBehavior.useInsightsNavigation) && "console-nav-insights"]} aria-label="Org Brain">
        <a class="console-brand" href={withScope(homeHref)} aria-label="Org Brain">
          <img src={brandMark.src} width="28" height="28" alt="" />
          <span>Org Brain</span>
          {decisionBehavior.showBetaLabel && <span class="console-beta-label">Beta</span>}
        </a>
        {consoleContext && (
          <span class="console-context-chip" title={consoleContext.effective_permissions.join(", ")}>
            {consoleContext.mode === "personal" ? ({ en: "Personal", ja: "個人", zh: "个人" } as const)[locale] : ({ en: "Team", ja: "チーム", zh: "团队" } as const)[locale]}
            {` · ${consoleContext.tenant.id}${consoleContext.project ? ` / ${consoleContext.project.id}` : ""}`}
          </span>
        )}
        <div class="console-primary-links">
          {primaryItems.map((navItem) => (
            <a class="console-nav-link" href={withScope(navItem.href)} aria-current={navItem.activeMatcher(currentPath) ? "page" : undefined}>{navItem.labels[locale]}</a>
          ))}
        </div>
        <details class="console-nav-menu">
          <summary>{menuLabels.management}</summary>
          <div class="console-nav-menu-panel">
            {groupedItems.map(({ group, label, items }) => (
              <section class="console-nav-group" aria-labelledby={`desktop-nav-${group}`}>
                <h2 id={`desktop-nav-${group}`}>{label}</h2>
                {items.map((navItem) => (
                  <a href={withScope(navItem.href)} aria-current={navItem.activeMatcher(currentPath) ? "page" : undefined}>{navItem.labels[locale]}</a>
                ))}
              </section>
            ))}
          </div>
        </details>
        <details class="console-mobile-nav">
          <summary>{menuLabels.menu}</summary>
          <div class="console-mobile-nav-panel">
            <section class="console-nav-group console-nav-group-primary" aria-label={menuLabels.menu}>
              {primaryItems.map((navItem) => (
                <a href={withScope(navItem.href)} aria-current={navItem.activeMatcher(currentPath) ? "page" : undefined}>{navItem.labels[locale]}</a>
              ))}
            </section>
            {groupedItems.map(({ group, label, items }) => (
              <section class="console-nav-group" aria-labelledby={`mobile-nav-${group}`}>
                <h2 id={`mobile-nav-${group}`}>{label}</h2>
                {items.map((navItem) => (
                  <a href={withScope(navItem.href)} aria-current={navItem.activeMatcher(currentPath) ? "page" : undefined}>{navItem.labels[locale]}</a>
                ))}
              </section>
            ))}
          </div>
        </details>
      </nav>
      <main id="console-main" class:list={["console-main", wide && "console-main-wide"]} tabindex="-1">
        <slot />
      </main>
    </div>
    <script>
      const skipLink = document.querySelector<HTMLAnchorElement>("[data-console-skip-link]");
      const main = document.querySelector<HTMLElement>("#console-main");
      skipLink?.addEventListener("click", () => {
        requestAnimationFrame(() => main?.focus({ preventScroll: true }));
      });
      main?.addEventListener("keydown", (event) => {
        if (event.key !== "Tab" || event.shiftKey || event.target !== main) return;
        const first = [...main.querySelectorAll<HTMLElement>(
          'a[href]:not([hidden]), button:not([disabled]):not([hidden]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"]):not([hidden])'
        )].find((element) => element.getClientRects().length > 0);
        if (!first) return;
        event.preventDefault();
        first.focus();
      });
    </script>
  </body>
</html>
