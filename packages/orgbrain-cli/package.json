    "js-tiktoken": "1.0.21",
    "zod": "4.3.6"
  },
  "scripts": {
    "prepack": "node ../../scripts/build-wiki.mjs && node ../../scripts/build-standalone.mjs packages/orgbrain-cli/dist/orgbrain.mjs"
