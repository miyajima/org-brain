{
  "name": "orgbrain",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Local-first, auditable memory and decision CLI for AI agents",
  "type": "module",
  "bin": {
    "orgbrain": "./dist/orgbrain.mjs"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "os": [
    "darwin",
