{
  "name": "orgbrain",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Local-first, auditable memory and decision CLI for AI agents",
  "type": "module",
  "bin": {
    "orgbrain": "./dist/orgbrain.mjs"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "publishConfig": {
    "access": "public",
    "executableFiles": [
      "bin/darwin-arm64/orgbrain-wiki-engine",
      "bin/darwin-x64/orgbrain-wiki-engine",
      "bin/linux-arm64/orgbrain-wiki-engine",
      "bin/linux-x64/orgbrain-wiki-engine",
      "bin/win32-arm64/orgbrain-wiki-engine.exe",
      "bin/win32-x64/orgbrain-wiki-engine.exe"
    ]
  },
  "files": [
    "dist",
    "bin",
    "assets/wiki",
    "skills/org-brain-wiki"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "acorn": "8.19.0",
    "js-tiktoken": "1.0.21",
    "parse5": "8.0.0",
    "zod": "^4.6.7"
  },
  "scripts": {
    "prepack": "node ../../scripts/build-wiki.mjs && node ../../scripts/build-standalone.mjs packages/orgbrain-cli/dist/orgbrain.mjs"
  },
  "devDependencies": {
    "@org-brain/shared": "workspace:*"
  }
}
