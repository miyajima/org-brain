{
  "contract_version": "domain-pack/v1",
  "pack_id": "function.sre",
  "version": "1.0.0",
  "classification": "function",
  "title": "SRE",
  "description": "Services, dependencies, SLOs, incidents, and reliability outcomes.",
  "language": "ja",
  "min_orgbrain_version": "0.2.0",
  "dependencies": [],
  "object_types": [
    { "key": "service", "label": "Service", "allowed_relations": ["depends_on", "governed_by_slo"] },
    { "key": "dependency", "label": "Dependency" },
    { "key": "slo", "label": "SLO" },
    { "key": "incident", "label": "Incident", "allowed_relations": ["affects"] }
  ],
  "metrics": [
    { "key": "availability", "label": "Availability", "origin_type": "pack", "scope_type": "managed_object", "source_type": "connector", "unit": "percent", "aggregation_window": "P30D", "freshness_seconds": 300, "target_direction": "increase", "connector": { "adapter_id": "observability", "query_template": "availability_v1" } },
    { "key": "error_budget_burn_rate", "label": "Error Budget Burn Rate", "origin_type": "pack", "scope_type": "managed_object", "source_type": "connector", "unit": "ratio", "aggregation_window": "PT1H", "freshness_seconds": 300, "target_direction": "decrease", "connector": { "adapter_id": "observability", "query_template": "error_budget_burn_rate_v1" } },
    { "key": "latency_p95", "label": "p95 latency", "origin_type": "pack", "scope_type": "managed_object", "source_type": "connector", "unit": "milliseconds", "aggregation_window": "PT1H", "freshness_seconds": 300, "target_direction": "decrease", "connector": { "adapter_id": "observability", "query_template": "latency_p95_v1" } },
    { "key": "http_5xx_rate", "label": "5xx rate", "origin_type": "pack", "scope_type": "managed_object", "source_type": "connector", "unit": "percent", "aggregation_window": "PT1H", "freshness_seconds": 300, "target_direction": "decrease", "connector": { "adapter_id": "observability", "query_template": "http_5xx_rate_v1" } },
    { "key": "mttr", "label": "MTTR", "origin_type": "pack", "scope_type": "tenant", "source_type": "connector", "unit": "minutes", "aggregation_window": "P90D", "freshness_seconds": 3600, "target_direction": "decrease", "connector": { "adapter_id": "incident-management", "query_template": "mttr_v1" } }
  ],
  "dashboards": [{ "key": "sre-overview", "title": "SRE Overview", "widgets": [
    { "key": "reliability", "kind": "metric", "title": "Reliability", "metric_keys": ["availability", "error_budget_burn_rate", "latency_p95", "http_5xx_rate", "mttr"], "layout": { "x": 0, "y": 0, "w": 12, "h": 3 } },
    { "key": "decision-trace", "kind": "decision_trace", "title": "Decision trace", "layout": { "x": 0, "y": 3, "w": 12, "h": 6 } }
  ] }],
  "connectors": [{ "adapter_id": "observability", "description": "Validated Datadog or Prometheus aggregate adapter" }, { "adapter_id": "incident-management", "description": "Validated incident aggregate adapter" }],
  "assets": [{ "asset_key": "service-degradation-response", "asset_type": "workflow", "version": "1.0.0" }],
  "loadout_templates": [{ "key": "sre-oncall", "asset_keys": ["service-degradation-response"] }],
  "example_refs": ["examples/story-v1.json"]
}
