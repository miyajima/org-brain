    { "key": "cac", "label": "CAC", "origin_type": "pack", "scope_type": "managed_object", "source_type": "connector", "unit": "jpy", "aggregation_window": "P30D", "dimensions": ["channel"], "freshness_seconds": 86400, "target_direction": "decrease", "connector": { "adapter_id": "product-analytics", "query_template": "cac_v1" } },
