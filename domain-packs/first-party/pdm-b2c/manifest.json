    { "key": "contribution_ltv_90d", "label": "90日Contribution LTV", "origin_type": "pack", "scope_type": "managed_object", "source_type": "connector", "unit": "jpy", "aggregation_window": "P90D", "freshness_seconds": 86400, "target_direction": "increase", "connector": { "adapter_id": "commerce", "query_template": "contribution_ltv_90d_v1" } },
    { "key": "ltv_cac", "label": "LTV / CAC", "origin_type": "pack", "scope_type": "managed_object", "source_type": "derived", "unit": "ratio", "aggregation_window": "P90D", "freshness_seconds": 86400, "target_direction": "increase", "formula": { "operation": "ratio", "metric_keys": ["contribution_ltv_90d", "cac"] } },
    { "key": "contribution_margin_per_buyer", "label": "購入者当たりContribution Margin", "origin_type": "pack", "scope_type": "managed_object", "source_type": "connector", "unit": "jpy", "aggregation_window": "P30D", "freshness_seconds": 86400, "target_direction": "increase", "connector": { "adapter_id": "commerce", "query_template": "contribution_margin_per_buyer_v1" } },
    { "key": "coupon_dependency_rate", "label": "coupon依存率", "origin_type": "pack", "scope_type": "managed_object", "source_type": "connector", "unit": "percent", "aggregation_window": "P30D", "freshness_seconds": 86400, "target_direction": "decrease", "connector": { "adapter_id": "commerce", "query_template": "coupon_dependency_rate_v1" } },
    { "key": "category_coverage", "label": "category coverage", "origin_type": "pack", "scope_type": "managed_object", "source_type": "connector", "unit": "percent", "aggregation_window": "P1D", "dimensions": ["category"], "freshness_seconds": 3600, "target_direction": "increase", "connector": { "adapter_id": "catalog", "query_template": "category_coverage_v1" } },
    { "key": "inventory_fulfillment_rate", "label": "在庫充足率", "origin_type": "pack", "scope_type": "managed_object", "source_type": "connector", "unit": "percent", "aggregation_window": "P1D", "dimensions": ["category"], "freshness_seconds": 3600, "target_direction": "increase", "connector": { "adapter_id": "catalog", "query_template": "inventory_fulfillment_rate_v1" } },
    { "key": "price_competitiveness", "label": "価格競争力", "origin_type": "pack", "scope_type": "managed_object", "source_type": "connector", "unit": "index", "aggregation_window": "P1D", "dimensions": ["category"], "freshness_seconds": 86400, "target_direction": "increase", "connector": { "adapter_id": "catalog", "query_template": "price_competitiveness_v1" } },
    { "key": "delivery_promise_rate", "label": "配送予定遵守率", "origin_type": "pack", "scope_type": "managed_object", "source_type": "connector", "unit": "percent", "aggregation_window": "P30D", "freshness_seconds": 86400, "target_direction": "increase", "connector": { "adapter_id": "commerce", "query_template": "delivery_promise_rate_v1" } },
    { "key": "review_score", "label": "Review score", "origin_type": "pack", "scope_type": "managed_object", "source_type": "connector", "unit": "score", "aggregation_window": "P30D", "freshness_seconds": 86400, "target_direction": "increase", "connector": { "adapter_id": "commerce", "query_template": "review_score_v1" } }
  ],
  "dashboards": [{ "key": "pdm-b2c-overview", "title": "PdM B2C Marketplace Overview", "widgets": [
    { "key": "acquisition", "kind": "metric", "title": "獲得", "metric_keys": ["new_users", "cac", "organic_share", "activation_rate", "campaign_d7_retention"], "layout": { "x": 0, "y": 0, "w": 6, "h": 3 } },
    { "key": "first-value", "kind": "metric", "title": "初回価値体験", "metric_keys": ["activation_rate", "time_to_first_value_p75", "first_search_success_rate", "zero_result_rate", "day0_favorite_rate"], "layout": { "x": 6, "y": 0, "w": 6, "h": 3 } },
    { "key": "retention", "kind": "trend", "title": "Engagement・Retention", "metric_keys": ["dau_mau", "d1_retention", "d7_retention", "d30_retention", "weekly_visits", "feature_usage_rate"], "layout": { "x": 0, "y": 3, "w": 6, "h": 4 } },
    { "key": "purchase", "kind": "metric", "title": "購買Funnel", "metric_keys": ["search_to_detail_rate", "detail_to_cart_rate", "cart_to_purchase_rate", "purchase_conversion", "repeat_purchase_rate", "cancellation_refund_rate"], "layout": { "x": 6, "y": 3, "w": 6, "h": 4 } },
    { "key": "unit-economics", "kind": "metric", "title": "Unit Economics", "metric_keys": ["arpu", "contribution_ltv_90d", "ltv_cac", "contribution_margin_per_buyer", "coupon_dependency_rate"], "layout": { "x": 0, "y": 7, "w": 6, "h": 3 } },
    { "key": "market-quality", "kind": "metric", "title": "マーケット品質", "metric_keys": ["category_coverage", "zero_result_rate", "inventory_fulfillment_rate", "price_competitiveness", "delivery_promise_rate", "review_score"], "layout": { "x": 6, "y": 7, "w": 6, "h": 3 } },
    { "key": "decision-trace", "kind": "decision_trace", "title": "Decision trace", "layout": { "x": 0, "y": 10, "w": 12, "h": 6 } }
  ] }],
  "connectors": [
    { "adapter_id": "product-analytics", "description": "Validated aggregate product analytics adapter" },
    { "adapter_id": "search-analytics", "description": "Validated aggregate search analytics adapter" },
    { "adapter_id": "commerce", "description": "Validated aggregate commerce adapter" },
    { "adapter_id": "catalog", "description": "Validated aggregate catalog adapter" }
  ],
  "assets": [
