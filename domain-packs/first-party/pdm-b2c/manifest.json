    { "key": "purchase_conversion", "label": "Purchase Conversion", "origin_type": "pack", "scope_type": "managed_object", "source_type": "connector", "unit": "percent", "aggregation_window": "P7D", "freshness_seconds": 3600, "target_direction": "increase", "connector": { "adapter_id": "product-analytics", "query_template": "purchase_conversion_v1" } },
