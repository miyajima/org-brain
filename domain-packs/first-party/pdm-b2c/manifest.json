    { "key": "first_search_success_rate", "label": "初回検索成功率", "origin_type": "pack", "scope_type": "managed_object", "source_type": "connector", "unit": "percent", "aggregation_window": "P7D", "freshness_seconds": 3600, "target_direction": "increase", "connector": { "adapter_id": "product-analytics", "query_template": "first_search_success_rate_v1" } },
