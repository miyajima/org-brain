    { "asset_key": "b2c-product-experiment-review", "asset_type": "playbook", "version": "1.0.0" }
  ],
  "loadout_templates": [{ "key": "pdm-b2c-marketplace", "asset_keys": ["consumer-funnel-diagnosis-to-experiment", "b2c-product-experiment-review"] }],
  "example_refs": ["examples/story-v1.json"]
}
