    { "key": "feature_usage_rate", "label": "検索・お気に入り・通知利用率", "origin_type": "pack", "scope_type": "managed_object", "source_type": "connector", "unit": "percent", "aggregation_window": "P7D", "dimensions": ["feature"], "freshness_seconds": 3600, "target_direction": "increase", "connector": { "adapter_id": "product-analytics", "query_template": "feature_usage_rate_v1" } },
    { "key": "search_to_detail_rate", "label": "検索→商品詳細率", "origin_type": "pack", "scope_type": "managed_object", "source_type": "connector", "unit": "percent", "aggregation_window": "P7D", "freshness_seconds": 3600, "target_direction": "increase", "connector": { "adapter_id": "product-analytics", "query_template": "search_to_detail_rate_v1" } },
    { "key": "detail_to_cart_rate", "label": "商品詳細→カート率", "origin_type": "pack", "scope_type": "managed_object", "source_type": "connector", "unit": "percent", "aggregation_window": "P7D", "freshness_seconds": 3600, "target_direction": "increase", "connector": { "adapter_id": "product-analytics", "query_template": "detail_to_cart_rate_v1" } },
