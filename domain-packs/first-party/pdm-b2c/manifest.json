    { "key": "d7_retention", "label": "D7 Retention", "origin_type": "pack", "scope_type": "managed_object", "source_type": "connector", "unit": "percent", "aggregation_window": "P7D", "dimensions": ["cohort"], "freshness_seconds": 86400, "target_direction": "increase", "connector": { "adapter_id": "product-analytics", "query_template": "d7_retention_v1" } },
