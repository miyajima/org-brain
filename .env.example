# Org Brain local defaults
ORGBRAIN_LOCAL_DB=~/.org-brain/memory.sqlite

# Optional API bridge values for self-hosted Cloudflare or the managed SaaS.
# Do not commit real secrets.
# Cloudflare-backed memory is opt-in. Keep both OFF for local-only personal use.
ORGBRAIN_ENABLE_CLOUD_MEMORY=false
ORGBRAIN_ENABLE_ORG_SHARING=false
ORGBRAIN_API_URL=http://127.0.0.1:8787
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
ORGBRAIN_API_KEY=dev-org-brain-api-key
# Single-tenant fallback. A workspace-specific tenant in workspaces.json wins.
ORGBRAIN_TENANT_ID=default
# Optional local routing files. The defaults are normally sufficient.
ORGBRAIN_WORKSPACES_FILE=~/.config/org-brain/workspaces.json
# Read-only migration source; retained for backward compatibility.
ORGBRAIN_PROJECT_NAMES_FILE=~/.config/org-brain/project-names.json
# Optional cloud autonomy policy. Invalid JSON fails closed to shadow.
# AUTONOMY_POLICY_JSON={"mode":"shadow","profile":"balanced"}
# Optional managed AI council endpoint. Missing/unavailable judges fail closed to quarantine.
# AUTONOMY_JUDGE_URL=
# AUTONOMY_JUDGE_API_KEY=
# Optional local adapters. They must export runAutonomyJudge and return signed,
# privacy-safe judgments; missing adapters fail closed to quarantine.
# ORGBRAIN_AUTONOMY_JUDGE_RUNNER=
# ORGBRAIN_AUTONOMY_QUARANTINE_RUNNER=
# Optional one-shot qualification adapter. It exports
# runAutonomyQualification({ workspace, policy, state_directory }) and returns
# only signed machine-reference/canary evidence; failure leaves the scope in shadow.
# ORGBRAIN_AUTONOMY_QUALIFICATION_RUNNER=
# ORGBRAIN_AUTONOMY_STATE_DIR=~/.config/org-brain/autonomy
# Compatibility override for operator scripts; prefer workspaces.json.
# ORGBRAIN_PROJECT_ROOTS={"org-brain":"/absolute/path/to/org-brain"}

# Gateway-side identity examples:
# API key requests use the grant principal as canonical identity.
# Cloudflare Access and generic OIDC requests use user:<JWT sub> as canonical identity.
# Configure these in apps/api-gateway/.dev.vars or the deployed Worker env.
# Remote MCP is fail-closed Access auth by default. During migration only, set
# MCP_AUTH_MODE=dual; after client migration return it to access.
MCP_AUTH_MODE=access
MCP_ACCESS_AUD=
ACCESS_TEAM_DOMAIN=
# ACCESS_JWKS_JSON is intended for local tests; production normally fetches Access certs.
# ACCESS_JWKS_JSON=

# Optional benchmark judge key.
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
