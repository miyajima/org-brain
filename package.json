{
  "name": "orgbrain",
  "private": false,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Local-first, auditable memory and decision layer for AI agents",
  "type": "module",
  "bin": {
    "orgbrain": "./scripts/local-memory.mjs"
  },
  "files": [
    "scripts/local-memory.mjs",
    "scripts/lib/local-memory-store.mjs",
    "scripts/local-mcp.mjs",
    "scripts/cloud-operations.mjs",
    "scripts/connector-setup.mjs",
    "scripts/hook-memory-bridge.mjs",
    "scripts/lib/local-embedding.mjs",
    "scripts/lib/retrieval-units.mjs",
    "scripts/lib/memory-mode.mjs",
    "scripts/lib/memory-quality.mjs",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "dist/orgbrain.mjs",
    "docs/LOCAL_MIGRATION.md",
    "docs/THREAT_MODEL.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:standalone": "node ./scripts/build-standalone.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm run test:node && pnpm run test:scripts && pnpm -r --if-present test",
    "test:node": "node --test ./scripts/agent-messages.test.mjs ./scripts/local-memory.test.mjs ./scripts/product-longmemeval-benchmark.test.mjs ./scripts/product-longmemeval-answer-judge.test.mjs ./scripts/create-longmemeval-unseen-holdout.test.mjs ./scripts/product-locomo-holdout.test.mjs ./scripts/product-beam-retrieval.test.mjs ./scripts/product-beam-answer-judge.test.mjs ./scripts/competitive-memory-benchmark.test.mjs ./scripts/summarize-competitor-longmemeval.test.mjs ./scripts/benchmark-bridges/cognee.test.mjs ./scripts/benchmark-bridges/gbrain.test.mjs ./scripts/benchmark-bridges/mem0.test.mjs ./scripts/benchmark-bridges/precisionmem-orgbrain.test.mjs ./scripts/cloud-operations.test.mjs ./scripts/connector-setup.test.mjs ./scripts/verify-cloud-restore-drill.test.mjs",
    "test:scripts": "vitest run ./scripts/hook-memory-bridge.test.mjs ./scripts/memory-cleanup.test.mjs ./scripts/memory-quality-backfill.test.mjs ./scripts/memory-quality.test.mjs ./scripts/memory-rationale-backfill.test.mjs ./scripts/memory-token-benchmark.test.mjs ./scripts/sync-agents-memory.test.mjs",
    "lint": "pnpm -r --if-present lint",
    "local:memory": "node ./scripts/local-memory.mjs",
    "agmsg": "node ./scripts/agent-messages.mjs",
    "hook:bridge": "node ./scripts/hook-memory-bridge.mjs",
    "sync:agents-memory": "node ./scripts/sync-agents-memory.mjs",
    "sync:openclaw-memory": "node ./scripts/sync-openclaw-memory.mjs",
    "docs:seed": "node ./scripts/seed-knowledge-docs.mjs",
    "memories:maintain": "node ./scripts/memory-maintenance.mjs",
    "memories:cleanup": "node ./scripts/memory-cleanup.mjs",
    "memories:quality-backfill": "node ./scripts/memory-quality-backfill.mjs",
    "memories:project-snapshot": "node ./scripts/project-current-state-snapshot.mjs",
    "memories:backfill-rationales": "node ./scripts/memory-rationale-backfill.mjs",
    "usage:status": "node ./skills/org-brain-usage-status/scripts/report-usage-status.mjs",
    "metrics:report": "node ./scripts/retrieval-metrics-report.mjs",
    "metrics:replay": "node ./scripts/retrieval-metrics-replay.mjs",
    "metrics:rollup": "node ./scripts/retrieval-metrics-rollup.mjs",
    "measurement:report": "node ./scripts/measurement-report.mjs",
    "benchmark:tokens": "node ./scripts/memory-token-benchmark.mjs",
    "benchmark:competitive": "node ./scripts/competitive-memory-benchmark.mjs",
    "benchmark:product-longmemeval": "node ./scripts/product-longmemeval-benchmark.mjs",
    "benchmark:product-locomo-holdout": "node ./scripts/product-locomo-holdout.mjs",
    "benchmark:product-beam": "node ./scripts/product-beam-retrieval.mjs",
    "benchmark:scale": "node ./scripts/local-scale-benchmark.mjs",
    "restore:drill": "node ./scripts/restore-drill.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260405.1",
    "rollup": "^4.60.1",
    "typescript": "^5.8.2",
    "vitest": "^2.1.8"
  }
}
