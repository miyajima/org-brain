{
  "name": "@org-brain/workspace",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Local-first, auditable memory and decision layer for AI agents",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:standalone": "node ./scripts/build-standalone.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm run test:node && pnpm run test:scripts && pnpm -r --if-present test",
    "test:node": "node --test ./scripts/agent-messages.test.mjs ./scripts/codex-memory-context.test.mjs ./scripts/dashboard-live-smoke.test.mjs ./scripts/personal-maintenance.test.mjs ./scripts/local-memory.test.mjs ./scripts/schema-parity.test.mjs ./scripts/wrangler-config-parity.test.mjs ./scripts/ops-watchdog.test.mjs ./scripts/prepare-cloud-restore-drill.test.mjs ./packages/benchmarks/scripts/local-scale-benchmark.test.mjs ./packages/benchmarks/scripts/product-longmemeval-benchmark.test.mjs ./packages/benchmarks/scripts/product-longmemeval-answer-judge.test.mjs ./packages/benchmarks/scripts/create-longmemeval-unseen-holdout.test.mjs ./packages/benchmarks/scripts/seal-final-memory-evaluation.test.mjs ./packages/benchmarks/scripts/product-locomo-holdout.test.mjs ./packages/benchmarks/scripts/product-beam-retrieval.test.mjs ./packages/benchmarks/scripts/product-beam-answer-judge.test.mjs ./packages/benchmarks/scripts/competitive-memory-benchmark.test.mjs ./packages/benchmarks/scripts/summarize-competitor-longmemeval.test.mjs ./packages/benchmarks/scripts/benchmark-bridges/cognee.test.mjs ./packages/benchmarks/scripts/benchmark-bridges/gbrain.test.mjs ./packages/benchmarks/scripts/benchmark-bridges/mem0.test.mjs ./packages/benchmarks/scripts/benchmark-bridges/hindsight.test.mjs ./packages/benchmarks/scripts/benchmark-bridges/mnemosyne.test.mjs ./packages/benchmarks/scripts/benchmark-bridges/precisionmem-orgbrain.test.mjs ./scripts/cloud-operations.test.mjs ./scripts/connector-setup.test.mjs ./scripts/verify-cloud-restore-drill.test.mjs",
    "smoke:dashboard": "node ./scripts/dashboard-live-smoke.mjs",
    "test:scripts": "vitest run ./scripts/hook-memory-bridge.test.mjs ./scripts/business-category-backfill.test.mjs ./scripts/memory-cleanup.test.mjs ./scripts/memory-quality-backfill.test.mjs ./scripts/memory-quality.test.mjs ./scripts/memory-rationale-backfill.test.mjs ./packages/benchmarks/scripts/memory-token-benchmark.test.mjs ./scripts/sync-agents-memory.test.mjs",
    "test:dashboard-performance": "pnpm --filter @org-brain/api-gateway test:performance",
    "lint": "eslint apps packages scripts --max-warnings=0",
    "local:memory": "node ./packages/orgbrain-cli/src/local-memory.mjs",
    "local:prod-data": "node ./scripts/local-prod-data.mjs",
    "local:api": "WRANGLER_LOG_PATH=.local/production-dump/wrangler-logs apps/api-gateway/node_modules/.bin/wrangler dev --port 8787 --persist-to .local/production-dump/local-state --config apps/api-gateway/wrangler.local.toml",
    "local:console": "cd apps/console && node_modules/.bin/astro dev --host 127.0.0.1 --port 4321",
    "agmsg": "node ./scripts/agent-messages.mjs",
    "hook:bridge": "node ./packages/orgbrain-cli/src/hook-memory-bridge.mjs",
    "sync:agents-memory": "node ./scripts/sync-agents-memory.mjs",
    "sync:openclaw-memory": "node ./scripts/sync-openclaw-memory.mjs",
    "docs:seed": "node ./scripts/seed-knowledge-docs.mjs",
    "memories:maintain": "node ./scripts/memory-maintenance.mjs",
    "memories:cleanup": "node ./scripts/memory-cleanup.mjs",
    "memories:quality-backfill": "node ./scripts/memory-quality-backfill.mjs",
    "memories:project-snapshot": "node ./scripts/project-current-state-snapshot.mjs",
    "memories:backfill-rationales": "node ./scripts/memory-rationale-backfill.mjs",
    "memories:backfill-classification": "node ./scripts/business-category-backfill.mjs",
    "usage:status": "node ./skills/org-brain-usage-status/scripts/report-usage-status.mjs",
    "metrics:report": "node ./scripts/retrieval-metrics-report.mjs",
    "metrics:replay": "node ./scripts/retrieval-metrics-replay.mjs",
    "metrics:rollup": "node ./scripts/retrieval-metrics-rollup.mjs",
    "metrics:memory-impact": "node ./packages/orgbrain-cli/src/local-memory.mjs metrics memory-impact",
    "measurement:report": "node ./scripts/measurement-report.mjs",
    "benchmark:tokens": "node ./packages/benchmarks/scripts/memory-token-benchmark.mjs",
    "benchmark:competitive": "node ./packages/benchmarks/scripts/competitive-memory-benchmark.mjs",
    "benchmark:seal-final-200": "node ./packages/benchmarks/scripts/seal-final-memory-evaluation.mjs",
    "benchmark:product-longmemeval": "node ./packages/benchmarks/scripts/product-longmemeval-benchmark.mjs",
    "benchmark:product-locomo-holdout": "node ./packages/benchmarks/scripts/product-locomo-holdout.mjs",
    "benchmark:product-beam": "node ./packages/benchmarks/scripts/product-beam-retrieval.mjs",
    "benchmark:scale": "node ./packages/benchmarks/scripts/local-scale-benchmark.mjs",
    "restore:drill": "node ./scripts/restore-drill.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260405.1",
    "eslint": "^9.39.1",
    "orgbrain": "workspace:*",
    "rollup": "^4.60.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.48.0",
    "vitest": "^2.1.8"
  }
}
