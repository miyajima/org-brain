{
  "name": "@org-brain/workspace",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Local-first, auditable memory and decision layer for AI agents",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:standalone": "node ./scripts/build-standalone.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm run test:node && pnpm run test:scripts && pnpm run test:autonomy && pnpm -r --if-present test",
    "test:autonomy": "node --test ./scripts/autonomy-policy.test.mjs ./scripts/autonomy-cli.test.mjs ./scripts/memory-ingestion-machine-reference.test.mjs ./scripts/memory-ingestion-machine-reference-generator.test.mjs",
    "packs:validate": "node ./scripts/validate-domain-packs.mjs",
    "test:domain-packs": "node --test ./scripts/domain-packs.test.mjs",
    "test:node": "node --test ./scripts/agent-messages.test.mjs ./scripts/autonomy-policy.test.mjs ./scripts/codex-memory-context.test.mjs ./scripts/codex-session-import.test.mjs ./scripts/memory-ingestion-regression.test.mjs ./scripts/memory-ingestion-storage-regression.test.mjs ./scripts/memory-ingestion-evaluate.test.mjs ./scripts/memory-ingestion-oracle.test.mjs ./scripts/memory-ingestion-calibration.test.mjs ./scripts/memory-contract-v2.test.mjs ./scripts/memory-contract-v2-contract-check.test.mjs ./scripts/dashboard-live-smoke.test.mjs ./scripts/personal-maintenance.test.mjs ./scripts/memory-repair.test.mjs ./scripts/memory-quality-audit.test.mjs ./scripts/local-memory.test.mjs ./scripts/schema-parity.test.mjs ./scripts/wrangler-config-parity.test.mjs ./scripts/ops-watchdog.test.mjs ./scripts/prepare-cloud-restore-drill.test.mjs ./packages/benchmarks/scripts/local-scale-benchmark.test.mjs ./packages/benchmarks/scripts/product-longmemeval-benchmark.test.mjs ./packages/benchmarks/scripts/product-longmemeval-answer-judge.test.mjs ./packages/benchmarks/scripts/create-longmemeval-unseen-holdout.test.mjs ./packages/benchmarks/scripts/seal-final-memory-evaluation.test.mjs ./packages/benchmarks/scripts/product-locomo-holdout.test.mjs ./packages/benchmarks/scripts/product-beam-retrieval.test.mjs ./packages/benchmarks/scripts/product-beam-answer-judge.test.mjs ./packages/benchmarks/scripts/benchmark-bridges/cognee.test.mjs ./packages/benchmarks/scripts/benchmark-bridges/gbrain.test.mjs ./packages/benchmarks/scripts/benchmark-bridges/mem0.test.mjs ./packages/benchmarks/scripts/benchmark-bridges/hindsight.test.mjs ./packages/benchmarks/scripts/benchmark-bridges/mnemosyne.test.mjs ./packages/benchmarks/scripts/benchmark-bridges/precisionmem-orgbrain.test.mjs ./scripts/cloud-operations.test.mjs ./scripts/connector-setup.test.mjs ./scripts/verify-cloud-restore-drill.test.mjs",
    "test:local-qwen": "node ./scripts/with-local-qwen.mjs -- node --test ./scripts/local-qwen-embedding.test.mjs",
    "smoke:dashboard": "node ./scripts/dashboard-live-smoke.mjs",
    "smoke:api": "node ./scripts/api-integration-smoke.mjs",
    "smoke:domain-workspaces": "node ./scripts/domain-workspace-smoke.mjs",
    "smoke:memory-v2": "node ./scripts/memory-v2-live-smoke.mjs",
    "test:scripts": "vitest run ./scripts/hook-memory-bridge.test.mjs ./scripts/codex-session-hook-replay.test.mjs ./scripts/memory-learning-corpus.test.mjs ./scripts/derive-memory-hook-profile.test.mjs ./scripts/memory-capture-gold-seed.test.mjs ./scripts/business-category-backfill.test.mjs ./scripts/memory-cleanup.test.mjs ./scripts/memory-quality-backfill.test.mjs ./scripts/memory-quality.test.mjs ./scripts/memory-rationale-backfill.test.mjs ./packages/benchmarks/scripts/memory-token-benchmark.test.mjs ./scripts/sync-agents-memory.test.mjs",
    "test:dashboard-performance": "pnpm --filter @org-brain/api-gateway test:performance",
    "lint": "eslint apps packages scripts --max-warnings=0",
    "local:memory": "node ./packages/orgbrain-cli/src/local-memory.mjs",
    "local:prod-data": "node ./scripts/local-prod-data.mjs",
    "local:api": "WRANGLER_LOG_PATH=.local/production-dump/wrangler-logs apps/api-gateway/node_modules/.bin/wrangler dev --port 8787 --persist-to .local/production-dump/local-state --config apps/api-gateway/wrangler.local.toml",
    "local:console": "cd apps/console && ORGBRAIN_CONSOLE_RUNTIME=node API_BASE_URL=http://127.0.0.1:8787 INTERNAL_API_KEY=dev-org-brain-api-key INSIGHTS_UI_MODE=on MEMORY_QUALITY_UI_MODE=on ACCESS_JWT_REQUIRED=false node_modules/.bin/astro dev --host 127.0.0.1 --port 4321",
    "agmsg": "node ./scripts/agent-messages.mjs",
    "hook:bridge": "node ./packages/orgbrain-cli/src/hook-memory-bridge.mjs",
    "sync:agents-memory": "node ./scripts/sync-agents-memory.mjs",
    "sync:openclaw-memory": "node ./scripts/sync-openclaw-memory.mjs",
    "docs:seed": "node ./scripts/seed-knowledge-docs.mjs",
    "memories:maintain": "node ./scripts/memory-maintenance.mjs",
    "memories:replay-codex": "node ./scripts/codex-session-hook-replay.mjs",
    "memories:build-learning-corpus": "node ./scripts/memory-learning-corpus.mjs",
    "memories:build-ingestion-regression": "node ./scripts/memory-ingestion-regression.mjs",
    "memories:regress-ingestion-storage": "node ./scripts/memory-ingestion-storage-regression.mjs",
    "memories:seed-ingestion-local": "node ./scripts/memory-ingestion-local-seed.mjs",
    "memories:evaluate-ingestion": "node ./scripts/memory-ingestion-evaluate.mjs",
    "memories:view-quality-run": "node ./scripts/memory-quality-run.mjs",
    "memories:dispose-quality-run": "node ./scripts/memory-quality-run.mjs --dispose",
    "memories:smoke-new-session-local": "node ./scripts/memory-new-session-local-smoke.mjs",
    "memories:qualify-ingestion-oracle": "node ./scripts/memory-ingestion-oracle.mjs",
    "memories:calibrate-ingestion": "node ./scripts/memory-ingestion-calibration.mjs",
    "memories:machine-reference": "node ./scripts/memory-ingestion-machine-reference-cli.mjs",
    "memories:baseline-learning": "node ./scripts/memory-learning-baseline.mjs",
    "memories:certify-quality": "node ./scripts/memory-quality-certify.mjs",
    "smoke:memory-learning": "node ./scripts/memory-learning-live-smoke.mjs",
    "memories:derive-hook-config": "node ./scripts/derive-memory-hook-profile.mjs",
    "memories:seed-gold": "node ./scripts/memory-capture-gold-seed.mjs",
    "memories:repair": "node ./scripts/memory-repair.mjs",
    "memories:repair-batch": "node ./scripts/memory-repair-project-batch.mjs",
    "memories:audit": "node ./scripts/memory-quality-audit.mjs",
    "migrations:remote-validate": "node ./scripts/validate-remote-migrations.mjs",
    "contract:check": "node ./scripts/memory-contract-v2-contract-check.mjs",
    "memories:cleanup": "node ./scripts/memory-cleanup.mjs",
    "memories:quality-backfill": "node ./scripts/memory-quality-backfill.mjs",
    "memories:project-snapshot": "node ./scripts/project-current-state-snapshot.mjs",
    "memories:backfill-rationales": "node ./scripts/memory-rationale-backfill.mjs",
    "memories:backfill-classification": "node ./scripts/business-category-backfill.mjs",
    "usage:status": "node ./skills/org-brain-usage-status/scripts/report-usage-status.mjs",
    "metrics:report": "node ./scripts/retrieval-metrics-report.mjs",
    "metrics:replay": "node ./scripts/retrieval-metrics-replay.mjs",
    "metrics:rollup": "node ./scripts/retrieval-metrics-rollup.mjs",
    "metrics:memory-impact": "node ./packages/orgbrain-cli/src/local-memory.mjs metrics memory-impact",
    "measurement:report": "node ./scripts/measurement-report.mjs",
    "benchmark:tokens": "node ./packages/benchmarks/scripts/memory-token-benchmark.mjs",
    "benchmark:competitive": "node ./packages/benchmarks/scripts/competitive-memory-benchmark.mjs",
    "benchmark:seal-final-200": "node ./packages/benchmarks/scripts/seal-final-memory-evaluation.mjs",
    "benchmark:product-longmemeval": "node ./packages/benchmarks/scripts/product-longmemeval-benchmark.mjs",
    "benchmark:product-locomo-holdout": "node ./packages/benchmarks/scripts/product-locomo-holdout.mjs",
    "benchmark:product-beam": "node ./packages/benchmarks/scripts/product-beam-retrieval.mjs",
    "benchmark:scale": "node ./packages/benchmarks/scripts/local-scale-benchmark.mjs",
    "restore:drill": "node ./scripts/restore-drill.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260405.1",
    "eslint": "^9.39.1",
    "orgbrain": "workspace:*",
    "rollup": "^4.60.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.48.0",
    "vitest": "^2.1.8"
  }
}
