        "query": {
          "engine": "cloudflare-d1",
          "language": "sql",
          "sql": "SELECT COUNT(*) AS total, SUM(CASE WHEN COALESCE(m.lifecycle_state,'active') != 'suppressed' AND COALESCE(m.deleted_at,0)=0 THEN 1 ELSE 0 END) AS active FROM memories m WHERE m.tenant_id='default' AND m.project_id='org-brain';",
          "description": "org-brainプロジェクトの総件数とactive件数を集計し、同じ母集団に対して検証・証拠・再利用規則の欠損を算出。",
